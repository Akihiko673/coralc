mod libc = import("std/platform/libc.crl");
mod ast = import("ast/ast.crl");
mod scopes = import("typecheck/scopes.crl");
mod types = import("typecheck/types.crl");
mod str = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");
mod wallvm = import("lib/wallvm/wallvm.crl");
mod ir_types = import("lib/wallvm/ir_types.crl");
mod ir_builder = import("lib/wallvm/ir_builder.crl");
mod ir_opcodes = import("lib/wallvm/ir_opcodes.crl");
mod expr = import("typecheck/expr.crl");
mod lex = import("lexer");
mod parse = import("parser");

struct FuncGen
{
    ir_types.IrContext* ctx;
    ir_types.IrModule* irMod;
    ir_types.IrFunc* func;
    ir_builder.IrBuilder* bd;
    scopes.Scope* top;
    scopes.ModuleTable* mods;
    str.strView filename;
    str.strView* flagNames;
    str.strView* flagVals;
    u32 nflags;
    bool debug;
    str.strView* localNames;
    ir_types.IrValue** localPtrs;
    u32 nlocals;
    u32 capLocals;
    bool terminated;
}
str.strView flagValueEmit(FuncGen* fg, str.strView name)
{
    for (u32 i = 0; i < fg.nflags; i++) if (strEq(fg.flagNames[i], name)) return fg.flagVals[i];
    for (u32 i = 0; i < fg.nflags; i++) {
        if (fg.flagNames[i].len == name.len) {
            bool eq = true;
            for (u32 k = 0; k < name.len; k++) {
                u8 a = fg.flagNames[i].ptr[k]; if (a >= 'A' && a <= 'Z') a = a + 32;
                u8 b = name.ptr[k]; if (b >= 'A' && b <= 'Z') b = b + 32;
                if (a != b) { eq = false; break; }
            }
            if (eq) return fg.flagVals[i];
        }
    }
    if (fg.nflags == 0) {
        if (name.len==8) {
            bool isPlatform=true;
            const char* p="platform";
            for(u32 k=0;k<8;k++){u8 a=name.ptr[k]; if(a>='A'&&a<='Z') a+=32; if(a!=(u8)p[k]){isPlatform=false;break;}}
            if(isPlatform) return str.strView::fromCstr("LINUX");
        }
        if (name.len==4) {
            bool isArch=true;
            const char* p="arch";
            for(u32 k=0;k<4;k++){u8 a=name.ptr[k]; if(a>='A'&&a<='Z') a+=32; if(a!=(u8)p[k]){isArch=false;break;}}
            if(isArch) return str.strView::fromCstr("x86_64");
        }
    }
    return str.strView::empty();
}

bool strEq(str.strView a, str.strView b)
{
    if (a.len != b.len) return false;
    return libc.memcmp(a.ptr, b.ptr, a.len) == 0;
}

bool opEq(str.strView a, const char* b)
{
    u64 n = 0; while (b[n]) n++;
    if (a.len != n) return false;
    for (u64 i = 0; i < n; i++) if (a.ptr[i] != (u8)b[i]) return false;
    return true;
}

ir_types.IrType* mapCType(FuncGen* fg, types.CType* t)
{
    if (t == null) return fg.ctx.tyVoid();
    t = types.effective(t);
    if (t == null) return fg.ctx.tyVoid();
    if (t->kind == types.TY_VOID) return fg.ctx.tyVoid();
    if (t->kind == types.TY_BOOL) return fg.ctx.tyInt(1);
    if (t->kind == types.TY_CHAR) return fg.ctx.tyInt(8);
    if (t->kind == types.TY_INT) { u32 w = t->width; if (w == 0) w = 32; return fg.ctx.tyInt(w); }
    if (t->kind == types.TY_FLOAT) return fg.ctx.tyDouble();
    if (t->kind == types.TY_PTR || t->kind == types.TY_SLICE)
    {
        ir_types.IrType* e = t->elem ? mapCType(fg, t->elem) : fg.ctx.tyInt(8);
        return fg.ctx.tyPtr(e);
    }
    if (t->kind == types.TY_ARRAY)
    {
        ir_types.IrType* e = t->elem ? mapCType(fg, t->elem) : fg.ctx.tyInt(8);
        u32 c = t->countKnown ? (u32)t->count : 0;
        if (c == 0) return fg.ctx.tyPtr(e);
        return fg.ctx.tyArray(e, c);
    }
    if (t->kind == types.TY_FUNC)
    {
        ir_types.IrType* rt = t->ret ? mapCType(fg, t->ret) : fg.ctx.tyVoid();
        if (t->nparams == 0) return fg.ctx.tyFunc(rt, null, 0, t->variadic);
        ir_types.IrType** ps = mman.alloc<ir_types.IrType*>(t->nparams);
        for (u32 i = 0; i < t->nparams; i++) ps[i] = t->params[i] ? mapCType(fg, t->params[i]) : fg.ctx.tyInt(64);
        return fg.ctx.tyFunc(rt, ps, t->nparams, t->variadic);
    }
    // structs/enums: opaque byte blocks sized by the layout calc so alloca
    // reserves the full storage; field access goes through byte-offset GEPs.
    if (t->kind == types.TY_NAMED)
    {
        u32 sz = cSize(t, fg.top);
        if (sz == 0) sz = 8;
        return fg.ctx.tyArray(fg.ctx.tyInt(8), sz);
    }
    return fg.ctx.tyInt(64);
}

ir_types.IrType* mapTypeExpr(FuncGen* fg, ast.TypeExpr* te)
{
    if (te == null) return fg.ctx.tyVoid();
    types.CType* ct = scopes.resolveTypeExpr(te, fg.top, fg.mods, null, 0);
    if (ct == null) return fg.ctx.tyInt(64);
    return mapCType(fg, ct);
}

ir_types.IrValue* findLocal(FuncGen* fg, str.strView name)
{
    for (u32 i = fg.nlocals; i > 0; i--)
        if (strEq(fg.localNames[i-1], name)) return fg.localPtrs[i-1];
    return null;
}

void addLocal(FuncGen* fg, str.strView name, ir_types.IrValue* ptr)
{
    if (fg.nlocals >= fg.capLocals)
    {
        u32 nc = fg.capLocals ? fg.capLocals*2 : 16;
        str.strView* nn = mman.alloc<str.strView>(nc);
        ir_types.IrValue** np = mman.alloc<ir_types.IrValue*>(nc);
        for (u32 i = 0; i < fg.nlocals; i++) { nn[i]=fg.localNames[i]; np[i]=fg.localPtrs[i]; }
        if (fg.localNames) mman.dealloc<str.strView>(fg.localNames);
        if (fg.localPtrs) mman.dealloc<ir_types.IrValue*>(fg.localPtrs);
        fg.localNames = nn; fg.localPtrs = np; fg.capLocals = nc;
    }
    fg.localNames[fg.nlocals] = name;
    fg.localPtrs[fg.nlocals] = ptr;
    fg.nlocals++;
}

ir_types.IrValue* asVal(ir_types.IrInst* i) { return &i->base; }
ir_types.IrValue* dbgVal(FuncGen* fg, ast.Expr* e, ir_types.IrInst* inst) { setDbgExpr(fg, inst, e); return asVal(inst); }
void setDbgExpr(FuncGen* fg, ir_types.IrInst* inst, ast.Expr* e)
{
    if (!fg.debug || inst == null || e == null) return;
    u32 len = 0; while (fg.filename.ptr[len] && len < fg.filename.len) len++;
    char* copy = mman.alloc<char>(fg.filename.len + 1);
    for (u32 i = 0; i < fg.filename.len; i++) copy[i] = (char)fg.filename.ptr[i];
    copy[fg.filename.len] = 0;
    inst.setDebugLoc(copy, e->line, e->col);
}
void setDbgStmt(FuncGen* fg, ir_types.IrInst* inst, ast.Stmt* s)
{
    if (!fg.debug || inst == null || s == null) return;
    char* copy = mman.alloc<char>(fg.filename.len + 1);
    for (u32 i = 0; i < fg.filename.len; i++) copy[i] = (char)fg.filename.ptr[i];
    copy[fg.filename.len] = 0;
    inst.setDebugLoc(copy, s->line, s->col);
}
u32 cSize(types.CType* ct, scopes.Scope* top)
{
    if (ct == null) return 0;
    ct = types.effective(ct);
    if (ct == null) return 0;
    switch (ct->kind)
    {
    case types.TY_VOID: return 0;
    case types.TY_BOOL: return 1;
    case types.TY_CHAR: return 1;
    case types.TY_INT: return ct->width ? (ct->width + 7)/8 : 4;
    case types.TY_FLOAT: return ct->width ? (ct->width + 7)/8 : 8;
    case types.TY_PTR: return 8;
    case types.TY_FUNC: return 8;
    case types.TY_SLICE: return 16;
    case types.TY_ARRAY:
        if (ct->elem == null) return 8;
        { u32 es = cSize(ct->elem, top); if (ct->countKnown) return es * (u32)ct->count; return es; }
    case types.TY_NAMED:
        if (ct->decl != null && ct->decl->kind == ast.DT_STRUCT) return ct->decl->nfields * 8;
        return 8;
    default: return 8;
    }
}
u32 cAlign(types.CType* ct, scopes.Scope* top)
{
    if (ct == null) return 1;
    ct = types.effective(ct);
    if (ct == null) return 1;
    switch (ct->kind)
    {
    case types.TY_VOID: return 1;
    case types.TY_BOOL: return 1;
    case types.TY_CHAR: return 1;
    case types.TY_INT: return ct->width ? (ct->width + 7)/8 : 4;
    case types.TY_FLOAT: return ct->width ? (ct->width + 7)/8 : 8;
    case types.TY_PTR: return 8;
    case types.TY_FUNC: return 8;
    case types.TY_SLICE: return 8;
    case types.TY_ARRAY: if (ct->elem) return cAlign(ct->elem, top); return 8;
    case types.TY_NAMED:
        if (ct->decl != null && ct->decl->kind == ast.DT_STRUCT)
        {
            u32 m = 1;
            for (u32 i = 0; i < ct->decl->nfields; i++)
            {
                types.CType* ft = scopes.resolveTypeExpr(ct->decl->fields[i].type, top, null, null, 0);
                u32 a = cAlign(ft, top);
                if (a > m) m = a;
            }
            return m;
        }
        return 8;
    default: return 8;
    }
}
u64 parseIntLit(str.strView s)
{
    u64 v = 0;
    bool hex = s.len > 2 && s.ptr[0]=='0' && (s.ptr[1]=='x' || s.ptr[1]=='X');
    u32 i = hex ? 2 : 0;
    for (; i < s.len; i++)
    {
        u8 c = s.ptr[i];
        if (c >= '0' && c <= '9') v = v* (hex?16:10) + (c-'0');
        else if (hex && c >= 'a' && c <= 'f') v = v*16 + 10 + (c-'a');
        else if (hex && c >= 'A' && c <= 'F') v = v*16 + 10 + (c-'A');
        else break;
    }
    return v;
}

ir_types.IrValue* genExpr(FuncGen* fg, ast.Expr* e);

// storeToLhs: emit the store half of an assignment for any lvalue form:
// plain locals, derefs (*p / p[0] handled by caller), and struct fields.
void storeToLhs(FuncGen* fg, ast.Expr* a, ir_types.IrValue* rv)
{
    if (a == null || rv == null) return;
    if (a->kind == ast.EX_IDENT)
    {
        ir_types.IrValue* ptr = findLocal(fg, a->text);
        if (ptr != null) { fg.bd.store(rv, ptr); return; }
        return;
    }
    if (a->kind == ast.EX_DOT || a->kind == ast.EX_ARROW)
    {
        ir_types.IrValue* fp = fieldAddress(fg, a);
        if (fp != null) { fg.bd.store(rv, fp); return; }
        return;
    }
    if (a->kind == ast.EX_UNARY && opEq(a->text, "*"))
    {
        ir_types.IrValue* ptr = genExpr(fg, a->a);
        if (ptr != null) fg.bd.store(rv, ptr);
        return;
    }
    if (a->kind == ast.EX_DEREF)
    {
        ir_types.IrValue* ptr = genExpr(fg, a->a);
        if (ptr != null) fg.bd.store(rv, ptr);
        return;
    }
    if (a->kind == ast.EX_INDEX)
    {
        // arr[i] = v / p[i] = v
        ir_types.IrValue* basePtr = null;
        if (a->a->kind == ast.EX_IDENT) basePtr = findLocal(fg, a->a->text);
        if (basePtr == null) basePtr = genExpr(fg, a->a);
        if (basePtr == null) return;
        // local array alloca: gep on element index directly
        bool isArraySlot = basePtr->type != null && basePtr->type->kind == ir_types.IrTypeKind::Ptr
            && basePtr->type->elem != null && basePtr->type->elem->kind == ir_types.IrTypeKind::Array;
        ir_types.IrValue* idxs[1];
        idxs[0] = genExpr(fg, a->b);
        if (idxs[0] == null) return;
        ir_types.IrInst* gp = fg.bd.gep(basePtr, idxs, 1);
        fg.bd.store(rv, &gp->base);
        (void)isArraySlot;
        return;
    }
}

// structFieldOffset: byte offset of field `name` in `sd` honouring
// reorder/packed layout modes. Returns false when the field is absent.
bool structFieldOffset(FuncGen* fg, ast.Decl* sd, str.strView name, u32* outOff)
{
    u32 fieldIdx = (u32)-1;
    for (u32 fi = 0; fi < sd->nfields; fi++)
        if (strEq(sd->fields[fi].name, name)) { fieldIdx = fi; break; }
    if (fieldIdx == (u32)-1) return false;
    bool isPacked = sd->layoutMode == 2 || sd->layoutMode == 3;
    bool isReorder = sd->layoutMode == 1 || sd->layoutMode == 3;
    u32 nf = sd->nfields;
    u32 orderArr[64];
    u32* order = orderArr;
    bool heapOrder = nf > 64;
    if (heapOrder) order = mman.alloc<u32>(nf);
    for (u32 f = 0; f < nf; f++) order[f] = f;
    if (isReorder && nf > 1)
    {
        for (u32 i = 0; i < nf; i++)
            for (u32 j = i+1; j < nf; j++)
            {
                types.CType* ti = scopes.resolveTypeExpr(sd->fields[order[i]].type, fg.top, fg.mods, null, 0);
                types.CType* tj = scopes.resolveTypeExpr(sd->fields[order[j]].type, fg.top, fg.mods, null, 0);
                u32 si = cSize(ti, fg.top);
                u32 sj = cSize(tj, fg.top);
                u32 ai = cAlign(ti, fg.top);
                u32 aj = cAlign(tj, fg.top);
                bool swap = false;
                if (ai != aj) swap = aj > ai;
                else swap = sj > si;
                if (swap) { u32 tmp = order[i]; order[i]=order[j]; order[j]=tmp; }
            }
    }
    u32 cur = 0;
    bool found = false;
    for (u32 idx = 0; idx < nf; idx++)
    {
        u32 f = order[idx];
        types.CType* ft = scopes.resolveTypeExpr(sd->fields[f].type, fg.top, fg.mods, null, 0);
        u32 al = cAlign(ft, fg.top);
        u32 sz = cSize(ft, fg.top);
        if (!isPacked && al > 0) { u32 pad = (al - (cur % al)) % al; cur += pad; }
        if (f == fieldIdx) { *outOff = cur; found = true; break; }
        cur += sz;
    }
    if (heapOrder) mman.dealloc<u32>(order);
    return found;
}

// fieldAddress: IR pointer to the member of a DOT/ARROW expression, or null.
// Handles `v.field` (local alloca base), `p->field` / `p.field` (pointer
// base), and nested chains. honours reorder/packed layouts.
ir_types.IrValue* fieldAddress(FuncGen* fg, ast.Expr* e)
{
    types.CType* baseTy = expr.inferredType(e->a);
    if (baseTy != null) baseTy = types.effective(baseTy);
    ast.Decl* structDecl = null;
    if (baseTy != null && baseTy->kind == types.TY_NAMED && baseTy->decl != null && baseTy->decl->kind == ast.DT_STRUCT)
    {
        // value receiver: `.` on a struct value -> use its alloca directly
        structDecl = baseTy->decl;
    }
    else if (baseTy != null && (baseTy->kind == types.TY_PTR || baseTy->kind == types.TY_SLICE)
             && baseTy->elem != null && baseTy->elem->kind == types.TY_NAMED
             && baseTy->elem->decl != null && baseTy->elem->decl->kind == ast.DT_STRUCT)
    {
        // pointer receiver: `.` or `->` on a pointer derefs implicitly here
        // because genExpr on the ident already loaded; we need the ADDRESS,
        // so re-derive it from the local alloca when possible.
        structDecl = baseTy->elem->decl;
    }
    if (structDecl == null) return null;
    u32 off = 0;
    if (!structFieldOffset(fg, structDecl, e->text, &off)) return null;

    ir_types.IrValue* basePtr = null;
    if (e->a->kind == ast.EX_IDENT)
        basePtr = findLocal(fg, e->a->text);
    if (basePtr == null)
    {
        // chained access (a.b.c): recurse for the inner address
        if ((e->a->kind == ast.EX_DOT || e->a->kind == ast.EX_ARROW))
            basePtr = fieldAddress(fg, e->a);
        else
            basePtr = genExpr(fg, e->a);
    }
    if (basePtr == null) return null;

    ir_types.IrType* i8Ptr = fg.ctx.tyPtr(fg.ctx.tyInt(8));
    ir_types.IrValue* casted = basePtr;
    if (basePtr->type != i8Ptr)
    {
        ir_types.IrInst* bc = fg.bd.bitcast(basePtr, i8Ptr);
        casted = &bc->base;
    }
    ir_types.IrValue* offVal = fg.ctx.constInt(fg.ctx.tyInt(64), off);
    ir_types.IrValue* idxs[1]; idxs[0] = offVal;
    ir_types.IrInst* gep = fg.bd.gep(casted, idxs, 1);

    ast.StructField* sf = null;
    for (u32 fi = 0; fi < structDecl->nfields; fi++)
        if (strEq(structDecl->fields[fi].name, e->text)) { sf = &structDecl->fields[fi]; break; }
    types.CType* fct = sf != null ? scopes.resolveTypeExpr(sf->type, fg.top, fg.mods, null, 0) : null;
    ir_types.IrType* fieldIrTy = fct ? mapCType(fg, fct) : fg.ctx.tyInt(64);
    ir_types.IrType* fieldPtrTy = fg.ctx.tyPtr(fieldIrTy);
    ir_types.IrInst* bc2 = fg.bd.bitcast(&gep->base, fieldPtrTy);
    return &bc2->base;
}

ir_types.IrValue* genBinary(FuncGen* fg, ast.Expr* e)
{
    str.strView op = e->text;
    ast.Expr* a = e->a;
    ast.Expr* b = e->b;
    if (opEq(op, "="))
    {
        // compound-assign desugar: a op= b -> a = a op b
        if (op.len >= 2 && op.ptr[op.len-1] == (u8)'=' && op.ptr[op.len-2] != (u8)'='
            && op.ptr[op.len-2] != (u8)'!' && op.ptr[op.len-2] != (u8)'<'
            && op.ptr[op.len-2] != (u8)'>')
        {
            char binOp[4]; u32 bo = 0;
            for (u32 i = 0; i + 1 < op.len; i++) binOp[bo++] = (char)op.ptr[i];
            binOp[bo] = 0;
            ast.Expr lhsCopy = *a;
            ir_types.IrValue* cur = genExpr(fg, &lhsCopy);
            ir_types.IrValue* rv = genExpr(fg, b);
            if (cur == null) return rv;
            if (rv == null) return cur;
            ir_types.IrInst* t = null;
            bool flt = (cur->type && cur->type->kind == ir_types.IrTypeKind::Float);
            if (bo == 1 && binOp[0] == '+') t = flt ? fg.bd.fadd(cur, rv) : fg.bd.add(cur, rv);
            else if (bo == 1 && binOp[0] == '-') t = flt ? fg.bd.fsub(cur, rv) : fg.bd.sub(cur, rv);
            else if (bo == 1 && binOp[0] == '*') t = flt ? fg.bd.fmul(cur, rv) : fg.bd.mul(cur, rv);
            else if (bo == 1 && binOp[0] == '/') t = flt ? fg.bd.fdiv(cur, rv) : fg.bd.sdiv(cur, rv);
            else if (bo == 1 && binOp[0] == '%') t = fg.bd.srem(cur, rv);
            else if (bo == 1 && binOp[0] == '&') t = fg.bd.andOp(cur, rv);
            else if (bo == 1 && binOp[0] == '|') t = fg.bd.orOp(cur, rv);
            else if (bo == 1 && binOp[0] == '^') t = fg.bd.xorOp(cur, rv);
            else if (bo == 2 && binOp[0] == '<' && binOp[1] == '<') t = fg.bd.shl(cur, rv);
            else if (bo == 2 && binOp[0] == '>' && binOp[1] == '>') t = fg.bd.ashr(cur, rv);
            if (t != null)
            {
                setDbgExpr(fg, t, e);
                ir_types.IrValue* res = &t->base;
                storeToLhs(fg, a, res);
                return res;
            }
            return rv;
        }
        ir_types.IrValue* rv = genExpr(fg, b);
        storeToLhs(fg, a, rv);
        return rv;
    }
    ir_types.IrValue* l = genExpr(fg, a);
    ir_types.IrValue* r = genExpr(fg, b);
    if (l == null) l = fg.ctx.constInt(fg.ctx.tyInt(64), 0);
    if (r == null) r = fg.ctx.constInt(fg.ctx.tyInt(64), 0);
    types.CType* lt = a ? expr.inferredType(a) : null;
    types.CType* rt = b ? expr.inferredType(b) : null;
    bool isFloat = (lt && lt->kind == types.TY_FLOAT) || (rt && rt->kind == types.TY_FLOAT);
    if (isFloat) isFloat = true;
    else if (l->type && l->type->kind == ir_types.IrTypeKind::Float) isFloat = true;
    else if (r->type && r->type->kind == ir_types.IrTypeKind::Float) isFloat = true;
    if (isFloat)
    {
        ir_types.IrInst* t = null;
        if (opEq(op, "+")) t = fg.bd.fadd(l, r);
        else if (opEq(op, "-")) t = fg.bd.fsub(l, r);
        else if (opEq(op, "*")) t = fg.bd.fmul(l, r);
        else if (opEq(op, "/")) t = fg.bd.fdiv(l, r);
        else if (opEq(op, "==")) t = fg.bd.fcmp(ir_opcodes.IrFCmpPred::Oeq, l, r);
        else if (opEq(op, "!=")) t = fg.bd.fcmp(ir_opcodes.IrFCmpPred::One, l, r);
        else if (opEq(op, "<")) t = fg.bd.fcmp(ir_opcodes.IrFCmpPred::Olt, l, r);
        else if (opEq(op, "<=")) t = fg.bd.fcmp(ir_opcodes.IrFCmpPred::Ole, l, r);
        else if (opEq(op, ">")) t = fg.bd.fcmp(ir_opcodes.IrFCmpPred::Ogt, l, r);
        else if (opEq(op, ">=")) t = fg.bd.fcmp(ir_opcodes.IrFCmpPred::Oge, l, r);
        else t = fg.bd.fadd(l, r);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, "+")) { ir_types.IrInst* t = fg.bd.add(l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, "-")) { ir_types.IrInst* t = fg.bd.sub(l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, "*")) { ir_types.IrInst* t = fg.bd.mul(l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, "/"))
    {
        bool uns = (lt && lt->kind == types.TY_INT && !lt->isSigned) || (rt && rt->kind == types.TY_INT && !rt->isSigned);
        ir_types.IrInst* t = uns ? fg.bd.udiv(l, r) : fg.bd.sdiv(l, r);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, "%"))
    {
        bool uns = (lt && lt->kind == types.TY_INT && !lt->isSigned) || (rt && rt->kind == types.TY_INT && !rt->isSigned);
        ir_types.IrInst* t = uns ? fg.bd.urem(l, r) : fg.bd.srem(l, r);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, "&")) { ir_types.IrInst* t = fg.bd.andOp(l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, "|")) { ir_types.IrInst* t = fg.bd.orOp(l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, "^")) { ir_types.IrInst* t = fg.bd.xorOp(l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, "<<")) { ir_types.IrInst* t = fg.bd.shl(l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, ">>"))
    {
        bool uns = lt && lt->kind == types.TY_INT && !lt->isSigned;
        ir_types.IrInst* t = uns ? fg.bd.lshr(l, r) : fg.bd.ashr(l, r);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, "==")) { ir_types.IrInst* t = fg.bd.icmp(ir_opcodes.IrICmpPred::Eq, l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, "!=")) { ir_types.IrInst* t = fg.bd.icmp(ir_opcodes.IrICmpPred::Ne, l, r); setDbgExpr(fg, t, e); return &t->base; }
    if (opEq(op, "<"))
    {
        bool uns = lt && lt->kind == types.TY_INT && !lt->isSigned;
        ir_types.IrInst* t = fg.bd.icmp(uns ? ir_opcodes.IrICmpPred::Ult : ir_opcodes.IrICmpPred::Slt, l, r);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, "<="))
    {
        bool uns = lt && lt->kind == types.TY_INT && !lt->isSigned;
        ir_types.IrInst* t = fg.bd.icmp(uns ? ir_opcodes.IrICmpPred::Ule : ir_opcodes.IrICmpPred::Sle, l, r);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, ">"))
    {
        bool uns = lt && lt->kind == types.TY_INT && !lt->isSigned;
        ir_types.IrInst* t = fg.bd.icmp(uns ? ir_opcodes.IrICmpPred::Ugt : ir_opcodes.IrICmpPred::Sgt, l, r);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, ">="))
    {
        bool uns = lt && lt->kind == types.TY_INT && !lt->isSigned;
        ir_types.IrInst* t = fg.bd.icmp(uns ? ir_opcodes.IrICmpPred::Uge : ir_opcodes.IrICmpPred::Sge, l, r);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, "&&"))
    {
        ir_types.IrValue* z = fg.ctx.constInt(fg.ctx.tyInt(1), 0);
        ir_types.IrInst* c1 = fg.bd.icmp(ir_opcodes.IrICmpPred::Ne, l, z);
        ir_types.IrInst* c2 = fg.bd.icmp(ir_opcodes.IrICmpPred::Ne, r, z);
        ir_types.IrInst* t = fg.bd.andOp(&c1->base, &c2->base);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    if (opEq(op, "||"))
    {
        ir_types.IrValue* z = fg.ctx.constInt(fg.ctx.tyInt(1), 0);
        ir_types.IrInst* c1 = fg.bd.icmp(ir_opcodes.IrICmpPred::Ne, l, z);
        ir_types.IrInst* c2 = fg.bd.icmp(ir_opcodes.IrICmpPred::Ne, r, z);
        ir_types.IrInst* t = fg.bd.orOp(&c1->base, &c2->base);
        setDbgExpr(fg, t, e);
        return &t->base;
    }
    ir_types.IrInst* t = fg.bd.add(l, r);
    setDbgExpr(fg, t, e);
    return &t->base;
}

ir_types.IrValue* genExpr(FuncGen* fg, ast.Expr* e)
{
    if (e == null) return null;
    if (fg.terminated) return null;
    switch (e->kind)
    {
    case ast.EX_INT:
    {
        u64 v = parseIntLit(e->text);
        bool neg = false;
        if (e->text.len > 0 && e->text.ptr[0] == '-') neg = true;
        if (neg) v = (u64)(0 - (i64)v);
        return fg.ctx.constInt(fg.ctx.tyInt(64), v);
    }
    case ast.EX_FLOAT:
    {
        f64 fv = 0; u64 raw = 0;
        if (e->text.len > 0)
        {
            u64 v = 0; bool dot = false; f64 div = 1;
            for (u32 i = 0; i < e->text.len; i++)
            {
                u8 c = e->text.ptr[i];
                if (c == '.') { dot = true; continue; }
                if (c >= '0' && c <= '9')
                {
                    if (!dot) v = v*10 + (c-'0');
                    else { div *= 10; fv = fv + (f64)(c-'0')/div; }
                }
            }
            if (!dot) fv = (f64)v;
            else fv += (f64)v;
            mman.copy<u8>((u8*)&raw, (u8*)&fv, 8);
        }
        return fg.ctx.constFloat(fg.ctx.tyDouble(), fv);
    }
    case ast.EX_BOOL:
        return fg.ctx.constInt(fg.ctx.tyInt(1), opEq(e->text, "true") ? 1 : 0);
    case ast.EX_NULL:
        return fg.ctx.constInt(fg.ctx.tyPtr(fg.ctx.tyInt(8)), 0);
    case ast.EX_CHAR:
    {
        u64 v = 0;
        if (e->text.len >= 3) v = e->text.ptr[1];
        else if (e->text.len == 1) v = e->text.ptr[0];
        return fg.ctx.constInt(fg.ctx.tyInt(8), v);
    }
    case ast.EX_STR:
    {
        return fg.ctx.constInt(fg.ctx.tyPtr(fg.ctx.tyInt(8)), 0);
    }
    case ast.EX_IDENT:
    {
        ir_types.IrValue* ptr = findLocal(fg, e->text);
        if (ptr != null)
        {
            ir_types.IrType* ty = ptr->type;
            if (ty && ty->kind == ir_types.IrTypeKind::Ptr && ty->elem)
                return dbgVal(fg, e, fg.bd.load(ty->elem, ptr));
            return dbgVal(fg, e, fg.bd.load(fg.ctx.tyInt(64), ptr));
        }
        scopes.Sym* s = scopes.scopeLookup(fg.top, e->text);
        if (s != null && s->kind == scopes.SYM_FUNC)
        {
            for (u32 i = 0; i < fg.irMod.nfuncs; i++)
                if (strEq(str.strView::fromCstr(fg.irMod.funcs[i].base.name), e->text))
                    return &fg.irMod.funcs[i].base;
            return fg.ctx.constInt(fg.ctx.tyPtr(fg.ctx.tyInt(8)), 0);
        }
        return fg.ctx.constInt(fg.ctx.tyInt(64), 0);
    }
    case ast.EX_PAREN:
        return genExpr(fg, e->a);
    case ast.EX_UNARY:
    {
        if (e->post) return genExpr(fg, e->a);
        if (opEq(e->text, "-"))
        {
            ir_types.IrValue* v = genExpr(fg, e->a);
            if (v && v->type && v->type->kind == ir_types.IrTypeKind::Float) {
                ir_types.IrValue* z = fg.ctx.constFloat(v->type, 0.0);
                return dbgVal(fg, e, fg.bd.fsub(z, v));
            }
            return dbgVal(fg, e, fg.bd.neg(v));
        }
        if (opEq(e->text, "!"))
        {
            ir_types.IrValue* v = genExpr(fg, e->a);
            ir_types.IrValue* z = fg.ctx.constInt(v->type ? v->type : fg.ctx.tyInt(1), 0);
            return dbgVal(fg, e, fg.bd.icmp(ir_opcodes.IrICmpPred::Eq, v, z));
        }
        if (opEq(e->text, "~")) return dbgVal(fg, e, fg.bd.notOp(genExpr(fg, e->a)));
        if (opEq(e->text, "*"))
        {
            ir_types.IrValue* ptr = genExpr(fg, e->a);
            ir_types.IrType* ty = ptr && ptr->type && ptr->type->kind==ir_types.IrTypeKind::Ptr && ptr->type->elem ? ptr->type->elem : fg.ctx.tyInt(64);
            return dbgVal(fg, e, fg.bd.load(ty, ptr));
        }
        if (opEq(e->text, "&"))
        {
            if (e->a && e->a->kind == ast.EX_IDENT)
            {
                ir_types.IrValue* ptr = findLocal(fg, e->a->text);
                if (ptr != null) return ptr;
            }
            return genExpr(fg, e->a);
        }
        if (opEq(e->text, "+")) return genExpr(fg, e->a);
        return genExpr(fg, e->a);
    }
    case ast.EX_BINARY:
        return genBinary(fg, e);
    case ast.EX_TERNARY:
    {
        ir_types.IrValue* c = genExpr(fg, e->a);
        ir_types.IrValue* t = genExpr(fg, e->b);
        ir_types.IrValue* f = genExpr(fg, e->c);
        return dbgVal(fg, e, fg.bd.select(c, t, f));
    }
    case ast.EX_CALL:
    {
        ir_types.IrValue* callee = null;
        if (e->a)
        {
            if (e->a->kind == ast.EX_IDENT)
            {
                scopes.Sym* s = scopes.scopeLookup(fg.top, e->a->text);
                if (s != null && s->type != null && s->type->kind == types.TY_FUNC)
                {
                    for (u32 i = 0; i < fg.irMod.nfuncs; i++)
                    {
                        if (strEq(str.strView::fromCstr(fg.irMod.funcs[i].base.name), e->a->text))
                            { callee = &fg.irMod.funcs[i].base; break; }
                    }
                }
                if (callee == null) callee = genExpr(fg, e->a);
            } else callee = genExpr(fg, e->a);
        }
        if (callee == null) callee = fg.ctx.constInt(fg.ctx.tyPtr(fg.ctx.tyInt(8)), 0);
        u32 n = e->nargs;
        ir_types.IrValue** args = null;
        if (n > 0)
        {
            args = mman.alloc<ir_types.IrValue*>(n);
            for (u32 i = 0; i < n; i++) args[i] = genExpr(fg, e->args[i]);
        }
        ir_types.IrInst* ci = fg.bd.call(callee, args, n);
        if (args) mman.dealloc<ir_types.IrValue*>(args);
        if (ci->base.type && ci->base.type->kind == ir_types.IrTypeKind::Void) return null;
        return &ci->base;
    }
    case ast.EX_CAST:
    {
        ir_types.IrValue* v = genExpr(fg, e->a);
        ir_types.IrType* dt = mapTypeExpr(fg, e->type);
        if (v == null || dt == null) return v;
        if (v->type == dt) return v;
        if (v->type && v->type->kind == ir_types.IrTypeKind::Float && dt->kind == ir_types.IrTypeKind::Float)
        {
            if (v->type->width == 64 && dt->width == 32) return dbgVal(fg, e, fg.bd.fpTrunc(v, dt));
            if (v->type->width == 32 && dt->width == 64) return dbgVal(fg, e, fg.bd.fpExt(v, dt));
            return v;
        }
        if (v->type && v->type->kind == ir_types.IrTypeKind::Float) return dbgVal(fg, e, fg.bd.fpToSi(v, dt));
        if (dt->kind == ir_types.IrTypeKind::Float)
        {
            if (v->type && v->type->width == 64) return dbgVal(fg, e, fg.bd.siToFp(v, dt));
            return dbgVal(fg, e, fg.bd.siToFp(v, dt));
        }
        if (v->type && dt->width > v->type->width) return dbgVal(fg, e, fg.bd.sext(v, dt));
        if (v->type && dt->width < v->type->width) return dbgVal(fg, e, fg.bd.trunc(v, dt));
        return dbgVal(fg, e, fg.bd.bitcast(v, dt));
    }
    case ast.EX_DOT:
    case ast.EX_ARROW:
        {
            ir_types.IrValue* fp = fieldAddress(fg, e);
            if (fp != null)
            {
                ir_types.IrType* ft = fp->type;
                ir_types.IrType* et2 = ft && ft->kind == ir_types.IrTypeKind::Ptr && ft->elem ? ft->elem : fg.ctx.tyInt(64);
                return dbgVal(fg, e, fg.bd.load(et2, fp));
            }
            return genExpr(fg, e->a);
        }
    case ast.EX_INDEX:
    {
        ir_types.IrValue* base = genExpr(fg, e->a);
        ir_types.IrValue* idx = genExpr(fg, e->b);
        ir_types.IrValue* idxs[1]; idxs[0]=idx;
        ir_types.IrInst* gp = fg.bd.gep(base, idxs, 1);
        ir_types.IrType* et = base->type && base->type->kind==ir_types.IrTypeKind::Ptr && base->type->elem ? base->type->elem : fg.ctx.tyInt(64);
        if (et->kind == ir_types.IrTypeKind::Array && et->elem) et = et->elem;
        return dbgVal(fg, e, fg.bd.load(et, &gp->base));
    }
    case ast.EX_DEREF:
    {
        ir_types.IrValue* p = genExpr(fg, e->a);
        ir_types.IrType* et = p->type && p->type->kind==ir_types.IrTypeKind::Ptr ? p->type->elem : fg.ctx.tyInt(64);
        return dbgVal(fg, e, fg.bd.load(et, p));
    }
    case ast.EX_ADDR:
    {
        if (e->a && e->a->kind == ast.EX_IDENT)
        {
            ir_types.IrValue* ptr = findLocal(fg, e->a->text);
            if (ptr != null) return ptr;
        }
        return genExpr(fg, e->a);
    }
    default:
        return fg.ctx.constInt(fg.ctx.tyInt(64), 0);
    }
}

void genStmt(FuncGen* fg, ast.Stmt* s);

void genBlockStmts(FuncGen* fg, ast.Stmt* blk)
{
    if (blk == null) return;
    if (blk->kind == ast.ST_BLOCK)
    {
        for (u32 i = 0; i < blk->nstmts; i++) genStmt(fg, blk->stmts[i]);
        return;
    }
    genStmt(fg, blk);
}

void genStmt(FuncGen* fg, ast.Stmt* s)
{
    if (s == null || fg.terminated) return;
    switch (s->kind)
    {
    case ast.ST_BLOCK:
        for (u32 i = 0; i < s->nstmts; i++) genStmt(fg, s->stmts[i]);
        break;
    case ast.ST_VAR:
    {
        if (s->stmts != null && s->nstmts > 0)
        {
            for (u32 i = 0; i < s->nstmts; i++) genStmt(fg, s->stmts[i]);
            break;
        }
        ir_types.IrType* ty = s->type ? mapTypeExpr(fg, s->type) : fg.ctx.tyInt(64);
        ir_types.IrInst* al = fg.bd.alloca(ty);
        addLocal(fg, s->text, &al->base);
        if (s->a != null)
        {
            ir_types.IrValue* v = genExpr(fg, s->a);
            if (v != null) fg.bd.store(v, &al->base);
        }
        break;
    }
    case ast.ST_RETURN:
    {
        if (s->a != null)
        {
            ir_types.IrValue* v = genExpr(fg, s->a);
            if (v != null) fg.bd.ret(v);
            else fg.bd.retVoid();
        } else fg.bd.retVoid();
        fg.terminated = true;
        break;
    }
    case ast.ST_EXPR:
        if (s->a) genExpr(fg, s->a);
        break;
    case ast.ST_IF:
    {
        ir_types.IrValue* c = genExpr(fg, s->a);
        if (c == null) c = fg.ctx.constInt(fg.ctx.tyInt(1), 0);
        if (c->type && c->type->width != 1)
        {
            ir_types.IrValue* z = fg.ctx.constInt(c->type, 0);
            c = dbgVal(fg, s->a, fg.bd.icmp(ir_opcodes.IrICmpPred::Ne, c, z));
        }
        ir_types.IrBlock* thenBb = fg.ctx.createBlock("if.then");
        ir_types.IrBlock* elseBb = s->body2 ? fg.ctx.createBlock("if.else") : null;
        ir_types.IrBlock* joinBb = fg.ctx.createBlock("if.join");
        fg.func.addBlock(thenBb);
        if (elseBb) fg.func.addBlock(elseBb);
        fg.func.addBlock(joinBb);
        if (elseBb) fg.bd.condBr(c, thenBb, elseBb);
        else fg.bd.condBr(c, thenBb, joinBb);
        bool savedTerm = fg.terminated;
        fg.bd.pos(thenBb, null); fg.terminated = false;
        genBlockStmts(fg, s->body);
        if (!fg.terminated) fg.bd.br(joinBb);
        if (elseBb)
        {
            fg.bd.pos(elseBb, null); fg.terminated = false;
            genBlockStmts(fg, s->body2);
            if (!fg.terminated) fg.bd.br(joinBb);
        }
        fg.bd.pos(joinBb, null); fg.terminated = false;
        if (savedTerm) {}
        break;
    }
    case ast.ST_WHILE:
    {
        ir_types.IrBlock* head = fg.ctx.createBlock("while.head");
        ir_types.IrBlock* body = fg.ctx.createBlock("while.body");
        ir_types.IrBlock* exit = fg.ctx.createBlock("while.exit");
        fg.func.addBlock(head); fg.func.addBlock(body); fg.func.addBlock(exit);
        fg.bd.br(head);
        fg.bd.pos(head, null);
        ir_types.IrValue* c = genExpr(fg, s->a);
        if (c == null) c = fg.ctx.constInt(fg.ctx.tyInt(1), 0);
        if (c->type && c->type->width != 1)
        {
            ir_types.IrValue* z = fg.ctx.constInt(c->type, 0);
            c = dbgVal(fg, s->a, fg.bd.icmp(ir_opcodes.IrICmpPred::Ne, c, z));
        }
        fg.bd.condBr(c, body, exit);
        fg.bd.pos(body, null); fg.terminated = false;
        genBlockStmts(fg, s->body);
        if (!fg.terminated) fg.bd.br(head);
        fg.bd.pos(exit, null); fg.terminated = false;
        break;
    }
    case ast.ST_FOR:
    {
        if (s->init) genStmt(fg, s->init);
        ir_types.IrBlock* head = fg.ctx.createBlock("for.head");
        ir_types.IrBlock* body = fg.ctx.createBlock("for.body");
        ir_types.IrBlock* exit = fg.ctx.createBlock("for.exit");
        fg.func.addBlock(head); fg.func.addBlock(body); fg.func.addBlock(exit);
        fg.bd.br(head);
        fg.bd.pos(head, null);
        if (s->b != null)
        {
            ir_types.IrValue* c = genExpr(fg, s->b);
            if (c == null) c = fg.ctx.constInt(fg.ctx.tyInt(1), 1);
            if (c->type && c->type->width != 1)
            {
                ir_types.IrValue* z = fg.ctx.constInt(c->type, 0);
                c = dbgVal(fg, s->b, fg.bd.icmp(ir_opcodes.IrICmpPred::Ne, c, z));
            }
            fg.bd.condBr(c, body, exit);
        } else fg.bd.br(body);
        fg.bd.pos(body, null); fg.terminated = false;
        genBlockStmts(fg, s->body);
        if (s->c != null && !fg.terminated) genExpr(fg, s->c);
        if (!fg.terminated) fg.bd.br(head);
        fg.bd.pos(exit, null); fg.terminated = false;
        break;
    }
    case ast.ST_LOOP:
    {
        ir_types.IrBlock* body = fg.ctx.createBlock("loop.body");
        ir_types.IrBlock* exit = fg.ctx.createBlock("loop.exit");
        fg.func.addBlock(body); fg.func.addBlock(exit);
        fg.bd.br(body);
        fg.bd.pos(body, null); fg.terminated = false;
        genBlockStmts(fg, s->body);
        if (!fg.terminated) fg.bd.br(body);
        fg.bd.pos(exit, null); fg.terminated = false;
        break;
    }
    case ast.ST_FLAG:
    {
        str.strView sel = flagValueEmit(fg, s->text);
        bool handled = false;
        for (u32 ci = 0; ci < s->ncases; ci++)
        {
            ast.StmtCase* sc = s->cases[ci];
            if (sc == null || sc->value == null) continue;
            if (strEq(sc->value->text, sel))
            {
                for (u32 k = 0; k < sc->nbody; k++) genStmt(fg, sc->body[k]);
                handled = true;
                break;
            }
        }
        if (!handled && s->defaultCase != null)
            for (u32 k = 0; k < s->defaultCase->nbody; k++) genStmt(fg, s->defaultCase->body[k]);
        break;
    }
    case ast.ST_FORIN:
    {
        types.CType* itTy = s->a ? expr.inferredType(s->a) : null;
        types.CType* elemTy = itTy ? itTy->elem : null;
        if (elemTy == null && itTy != null && itTy->kind == types.TY_SLICE) elemTy = itTy->elem;
        if (elemTy == null) elemTy = s->type ? scopes.resolveTypeExpr(s->type, fg.top, fg.mods, null, 0) : null;
        ir_types.IrType* elemIrTy = elemTy ? mapCType(fg, elemTy) : fg.ctx.tyInt(64);
        ir_types.IrValue* container = s->a ? genExpr(fg, s->a) : null;
        if (container == null) break;
        ir_types.IrType* containerTy = container->type;
        ir_types.IrValue* lenVal = null;
        ir_types.IrValue* ptrVal = container;
        if (itTy != null && itTy->kind == types.TY_ARRAY && itTy->countKnown) lenVal = fg.ctx.constInt(fg.ctx.tyInt(64), itTy->count);
        else if (containerTy != null && containerTy->kind == ir_types.IrTypeKind::Ptr) lenVal = fg.ctx.constInt(fg.ctx.tyInt(64), 0);
        else lenVal = fg.ctx.constInt(fg.ctx.tyInt(64), 0);
        // handle slice-like container where len is field
        if (itTy != null && (itTy->kind == types.TY_SLICE || itTy->kind == types.TY_ARRAY))
        {
                // for slice, need len from struct; for now use 0
        }
        ir_types.IrInst* idxAlloca = fg.bd.alloca(fg.ctx.tyInt(64));
        fg.bd.store(fg.ctx.constInt(fg.ctx.tyInt(64), 0), &idxAlloca->base);
        ir_types.IrInst* varAlloca = fg.bd.alloca(elemIrTy);
        addLocal(fg, s->text, &varAlloca->base);
        ir_types.IrBlock* head = fg.ctx.createBlock("forin.head");
        ir_types.IrBlock* body = fg.ctx.createBlock("forin.body");
        ir_types.IrBlock* exit = fg.ctx.createBlock("forin.exit");
        fg.func.addBlock(head); fg.func.addBlock(body); fg.func.addBlock(exit);
        fg.bd.br(head);
        fg.bd.pos(head, null);
        ir_types.IrValue* idxVal = dbgVal(fg, s->a, fg.bd.load(fg.ctx.tyInt(64), &idxAlloca->base));
        ir_types.IrValue* cond = dbgVal(fg, s->a, fg.bd.icmp(ir_opcodes.IrICmpPred::Ult, idxVal, lenVal));
        fg.bd.condBr(cond, body, exit);
        fg.bd.pos(body, null); fg.terminated = false;
        ir_types.IrValue* idxs[1]; idxs[0] = idxVal;
        ir_types.IrInst* gep = fg.bd.gep(ptrVal, idxs, 1);
        ir_types.IrValue* elem = dbgVal(fg, s->a, fg.bd.load(elemIrTy, &gep->base));
        fg.bd.store(elem, &varAlloca->base);
        genBlockStmts(fg, s->body);
        if (!fg.terminated)
        {
            ir_types.IrValue* cur = dbgVal(fg, s->a, fg.bd.load(fg.ctx.tyInt(64), &idxAlloca->base));
            ir_types.IrValue* one = fg.ctx.constInt(fg.ctx.tyInt(64), 1);
            ir_types.IrValue* nxt = dbgVal(fg, s->a, fg.bd.add(cur, one));
            fg.bd.store(nxt, &idxAlloca->base);
            fg.bd.br(head);
        }
        fg.bd.pos(exit, null); fg.terminated = false;
        break;
    }
    case ast.ST_BREAK:
    case ast.ST_CONTINUE:
        break;
    case ast.ST_ASSERT:
        if (s->a) genExpr(fg, s->a);
        break;
    case ast.ST_DEFER:
        if (s->body) genBlockStmts(fg, s->body);
        break;
    case ast.ST_ASM:
    {
        genAsm(fg, s);
        break;
    }
    default:
        break;
    }
}

// parseExprSnippet: run the real lexer+parser over a raw operand source
// slice (e.g. `(u64)addr` or `length`) and return the ast.Expr. The buffer
// stays alive for the compiler process lifetime (mman arena).
ast.Expr* parseExprSnippet(FuncGen* fg, const char* src, u32 len)
{
    char* buf = mman.alloc<char>(len + 1);
    for (u32 i = 0; i < len; i++) buf[i] = src[i];
    buf[len] = 0;
    lex.Lexer lx = lex.Lexer::new((const u8*)buf, len);
    lex.LexResult lr = lx.lex();
    if (lr.n == 0) return null;
    str.strView sv = str.strView::fromParts(buf, len);
    parse.Parser p = parse.Parser::new(lr.toks, lr.n, (const u8*)buf, len, sv);
    return p.parseExpr();
}

// genAsm: lower a GCC-style extended asm block into an InlineAsm instruction.
//
//   asm volatile { "tmpl %0 .. %1" : "=a"(out1), "=r"(out2) : "D"(in1), "r"(in2) : "rcx", "memory" }
//
// Operand numbering follows GCC: outputs get %0..%nOut-1, inputs continue
// %nOut... Input expressions are evaluated into IR values and passed as
// instruction operands; outputs are the locals' allocas, and a register
// -constrained first output ("=a"/"=r") receives the asm result stored back
// after the block. Clobbers are appended to the template as a trailing
// "# clobber:" comment line so the .wir records them for the backend.
void genAsm(FuncGen* fg, ast.Stmt* s)
{
    const char* raw = s->text.ptr ? (const char*)s->text.ptr : "";
    u32 rlen = s->text.len;
    // slice between the outer braces
    u32 lbrace = 0; u32 rbrace = 0;
    for (u32 i = 0; i < rlen; i++) if (raw[i] == '{') { lbrace = i+1; break; }
    for (u32 i = rlen; i > 0; i--) if (raw[i-1] == '}') { rbrace = i-1; break; }
    if (lbrace >= rbrace) return;
    const char* body = raw + lbrace;
    u32 blen = rbrace - lbrace;

    // split template / outputs / inputs / clobbers at top-level colons
    u32 secStart[4]; u32 secLen[4]; u32 nsec = 0;
    u32 depth = 0; bool inStr = false; u32 start = 0;
    for (u32 i = 0; i <= blen; i++)
    {
        char c = i < blen ? body[i] : ':';
        bool atEnd = i == blen;
        if (inStr)
        {
            if (c == '"') inStr = false;
            continue;
        }
        if (c == '"') { inStr = true; continue; }
        if (c == '(' || c == '[') { depth++; continue; }
        if (c == ')' || c == ']') { if (depth) depth--; continue; }
        if ((c == ':' && depth == 0) || atEnd)
        {
            if (nsec < 4) { secStart[nsec] = start; secLen[nsec] = i - start; nsec++; }
            start = i + 1;
            if (atEnd) break;
        }
    }

    // template: concatenated string literals with escapes resolved
    str.String tmpl = str.String::new();
    {
        u32 ts = secStart[0], tl = nsec > 0 ? secLen[0] : 0;
        u32 i = 0;
        while (i < tl)
        {
            if (body[ts + i] != '"') { i++; continue; }
            i++;
            while (i < tl && body[ts + i] != '"')
            {
                char c = body[ts + i];
                if (c == '\\' && i + 1 < tl)
                {
                    char n = body[ts + i + 1];
                    if (n == 'n') tmpl.pushChar('\n');
                    else if (n == 't') tmpl.pushChar('\t');
                    else if (n == '\\') tmpl.pushChar('\\');
                    else if (n == '"') tmpl.pushChar('"');
                    else if (n == '0') tmpl.pushChar('\0');
                    else { tmpl.pushChar('\\'); tmpl.pushChar(n); }
                    i += 2;
                    continue;
                }
                tmpl.pushChar(c);
                i++;
            }
            i++;
        }
    }

    // operand list parser: "constr"(expr) pairs -> constraints + exprs
    const u32 MAXOP = 16;
    ast.Expr* outExprs[16];
    ast.Expr* inExprs[16];
    char outConstr[192];
    char inConstr[192];
    u32 nOut = 0;
    u32 nIn = 0;
    for (u32 z = 0; z < 192; z++) { outConstr[z] = 0; inConstr[z] = 0; }
    for (u32 sec = 1; sec < 3 && sec < nsec; sec++)
    {
        u32 ss = secStart[sec], sl = secLen[sec];
        u32 i = 0;
        while (i < sl)
        {
            while (i < sl && (body[ss+i] == ' ' || body[ss+i] == ',' || body[ss+i] == '\n' || body[ss+i] == '\t')) i++;
            if (i >= sl || body[ss+i] != '"') break;
            i++;
            char* dst = (sec == 1) ? outConstr + nOut * 12 : inConstr + nIn * 12;
            u32 ci = 0;
            while (i < sl && body[ss+i] != '"' && ci < 11) { dst[ci++] = body[ss+i]; i++; }
            dst[ci] = 0;
            if (i < sl && body[ss+i] == '"') i++;
            while (i < sl && (body[ss+i] == ' ' || body[ss+i] == '(')) i++;
            // capture the parenthesized expr source
            u32 d = 1; u32 es = i;
            while (i < sl && d > 0)
            {
                char c = body[ss+i];
                if (c == '(') d++;
                else if (c == ')') d--;
                if (d == 0) break;
                i++;
            }
            u32 el = i > es ? i - es : 0;
            if (i < sl) i++;
            if (el == 0) continue;
            // re-parse through the real parser by wrapping in parens
            ast.Expr* parsed = parseExprSnippet(fg, body + ss + es, el);
            if (parsed == null) continue;
            if (sec == 1 && nOut < MAXOP) { outExprs[nOut++] = parsed; }
            else if (sec == 2 && nIn < MAXOP) { inExprs[nIn++] = parsed; }
        }
    }

    // clobbers: quoted names appended as a comment on the template
    if (nsec >= 4 && secLen[3] > 0)
    {
        u32 cs = secStart[3], cl = secLen[3];
        bool any = false;
        for (u32 i = 0; i < cl; i++) if (body[cs+i] == '"') { any = true; break; }
        if (any)
        {
            tmpl.pushView(str.strView::fromCstr("\n\t# clobber:"));
            bool lastQ = true;
            for (u32 i = 0; i < cl; i++)
            {
                char c = body[cs+i];
                if (c == '"') { if (!lastQ) tmpl.pushChar(' '); lastQ = false; continue; }
                if (!lastQ) tmpl.pushChar(c);
            }
        }
    }

    // evaluate input operands into IR values
    ir_types.IrValue* args[2 * MAXOP];
    u32 nargs = 0;
    ir_types.IrType* retTy = fg.ctx.tyVoid();
    ir_types.IrValue* regOutPtr = null;
    for (u32 k = 0; k < nOut && k < MAXOP; k++)
    {
        ast.Expr* oe = outExprs[k];
        ir_types.IrValue* ptr = null;
        if (oe->kind == ast.EX_IDENT) ptr = findLocal(fg, oe->text);
        else if (oe->kind == ast.EX_UNARY && opEq(oe->text, "*")) ptr = genExpr(fg, oe->a);
        else if (oe->kind == ast.EX_DEREF) ptr = genExpr(fg, oe->a);
        if (ptr == null) continue;
        args[nargs++] = ptr;
        // first '='-constrained output bound to a register receives rax/ret
        bool isWrite = false;
        for (u32 q = 0; q < 11 && outConstr[k * 12 + q]; q++) if (outConstr[k * 12 + q] == '=') { isWrite = true; break; }
        if (isWrite && regOutPtr == null)
        {
            bool isReg = false;
            for (u32 q = 0; q < 11 && outConstr[k * 12 + q]; q++)
            {
                char cc = outConstr[k * 12 + q];
                if (cc == 'a' || cc == 'r') { isReg = true; break; }
            }
            if (isReg)
            {
                regOutPtr = ptr;
                ir_types.IrType* et = ptr->type;
                if (et && et->kind == ir_types.IrTypeKind::Ptr && et->elem) retTy = et->elem;
            }
        }
    }
    for (u32 k = 0; k < nIn && k < MAXOP; k++)
    {
        ir_types.IrValue* v = genExpr(fg, inExprs[k]);
        if (v == null) v = fg.ctx.constInt(fg.ctx.tyInt(64), 0);
        args[nargs++] = v;
    }

    // emit
    u32 tlen = tmpl.len;
    char* tcopy = mman.alloc<char>(tlen + 1);
    for (u32 i = 0; i < tlen; i++) tcopy[i] = tmpl.ptr[i];
    tcopy[tlen] = 0;
    tmpl.free();
    ir_types.IrInst* ia = fg.bd.inlineAsm(tcopy, args, nargs, retTy);
    setDbgStmt(fg, ia, s);
    // write the register-constrained result back to its variable slot
    if (regOutPtr != null && retTy->kind != ir_types.IrTypeKind::Void)
        fg.bd.store(&ia->base, regOutPtr);
}

void dumpIR(ir_types.IrModule* irMod, void* f)
{
    const char* hdr = "; WallVM IR\n";
    u64 n = 0; while (hdr[n]) n++; libc.fwrite((u8*)hdr,1,n,f);
    for (u32 i = 0; i < irMod.nfuncs; i++)
    {
        ir_types.IrFunc* fn = irMod.funcs[i];
        const char* fnName = fn.base.name ? fn.base.name : "anon";
        if (fn.isExtern) libc.fwrite((u8*)"extern func @",1,12,f);
        else libc.fwrite((u8*)"func @",1,6,f);
        u64 l=0; while(fnName[l]) l++; libc.fwrite((u8*)fnName,1,l,f);
        const char* rt = fn.retType ? ir_types.irTypeStr(fn.retType) : "void";
        libc.fwrite((u8*)" -> ",1,4,f);
        u64 rl=0; while(rt[rl]) rl++; libc.fwrite((u8*)rt,1,rl,f);
        libc.fwrite((u8*)" {\n",1,3,f);
        for (u32 b = 0; b < fn.nblocks; b++)
        {
            ir_types.IrBlock* bb = fn.blocks[b];
            const char* bn = bb.base.name ? bb.base.name : "bb";
            libc.fwrite((u8*)"  block %",1,9,f);
            u64 bl=0; while(bn[bl]) bl++; libc.fwrite((u8*)bn,1,bl,f);
            libc.fwrite((u8*)":\n",1,2,f);
            for (u32 k = 0; k < bb.ninsts; k++)
            {
                ir_types.IrInst* ins = bb.insts[k];
                const char* op = ir_opcodes.irOpcodeStr(ins.opcode);
                libc.fwrite((u8*)"    %",1,5,f);
                u8 idb[32]; i32 nid = libc.snprintf(idb,32,"%u = ", ins.base.id);
                if (nid>0) libc.fwrite(idb,1,(u64)nid,f);
                u64 ol=0; while(op[ol]) ol++; libc.fwrite((u8*)op,1,ol,f);
                if (ins.base.type)
                {
                    const char* ts = ir_types.irTypeStr(ins.base.type);
                    libc.fwrite((u8*)" ",1,1,f);
                    u64 tl=0; while(ts[tl]) tl++; libc.fwrite((u8*)ts,1,tl,f);
                }
                if (ins.nops > 0)
                {
                    libc.fwrite((u8*)" [",1,2,f);
                    for (u32 o = 0; o < ins.nops; o++)
                    {
                        if (o>0) libc.fwrite((u8*)", ",1,2,f);
                        ir_types.IrValue* v = ins.ops[o];
                        if (v == null) { libc.fwrite((u8*)"null",1,4,f); continue; }
                        if (v->kind == ir_types.IrValueKind::ConstInt)
                        {
                            // InlineAsm's first operand carries the asm text as
                            // a pointer constant; render the string itself.
                            if (ins.opcode == ir_opcodes.IrOpcode::InlineAsm && o == 0 && v.valData != 0)
                            {
                                const char* astr = (const char*)(u64)v.valData;
                                libc.fwrite((u8*)"\"",1,1,f);
                                u64 al = 0; while (astr[al]) al++;
                                libc.fwrite((u8*)astr,1,al,f);
                                libc.fwrite((u8*)"\"",1,1,f);
                            }
                            else
                            {
                                u8 nb[32]; i32 nn = libc.snprintf(nb,32,"%lu", v.valData);
                                if (nn>0) libc.fwrite(nb,1,(u64)nn,f);
                            }
                        } else if (v->kind == ir_types.IrValueKind::ConstFloat)
                        {
                            libc.fwrite((u8*)"float",1,5,f);
                        } else {
                            u8 nb[32]; i32 nn = libc.snprintf(nb,32,"%%%u", v.id);
                            if (nn>0) libc.fwrite(nb,1,(u64)nn,f);
                            if (v->name) { libc.fwrite((u8*)"(",1,1,f);
                                u64 vl=0;
                                while(v->name[vl]) vl++;
                                libc.fwrite((u8*)v->name,1,vl,f);
                                libc.fwrite((u8*)")",1,1,f);
                            }
                        }
                    }
                    libc.fwrite((u8*)"]",1,1,f);
                }
                libc.fwrite((u8*)"\n",1,1,f);
            }
        }
        libc.fwrite((u8*)"}\n\n",1,2,f);
    }
}

pub ir_types.IrModule* buildModule(ast.Program* prog, scopes.Scope* top,
                                    scopes.ModuleTable* mods, str.strView path,
                                    u32 optLevel, bool debug,
                                    ir_types.IrContext** outCtx)
{
    ir_types.IrContext* ctx = ir_types.irCtxCreate();
    char mn[256]; u32 ml = 0;
    for (u32 i = 0; i < path.len && ml < 255; i++)
    {
        u8 c = path.ptr[i];
        if (c == '/' || c == '\\') mn[ml++] = '_';
        else if (c == '.' ) break;
        else mn[ml++] = (char)c;
    }
    mn[ml]=0;
    if (ml==0) { mn[0]='m'; mn[1]='o'; mn[2]='d'; mn[3]=0; }
    ir_types.IrModule* irMod = ctx.createModule(mn);
    *outCtx = ctx;
    for (u32 i = 0; i < prog.ndecls; i++)
    {
        ast.Decl* d = prog.decls[i];
        if (d == null) continue;
        if (d->kind == ast.DT_STRUCT && d->ngenerics == 0)
        {
            bool isPacked = d->layoutMode == 2 || d->layoutMode == 3;
            bool isReorder = d->layoutMode == 1 || d->layoutMode == 3;
            u32 nf = d->nfields;
            if (nf == 0) continue;
            ir_types.IrType** fTypes = mman.alloc<ir_types.IrType*>(nf);
            char** fNames = mman.alloc<char*>(nf);
            u32* order = null;
            if (isReorder && nf > 1)
            {
                order = mman.alloc<u32>(nf);
                for (u32 f = 0; f < nf; f++) order[f] = f;
                for (u32 a = 0; a < nf; a++)
                    for (u32 b = a+1; b < nf; b++)
                    {
                        types.CType* ta = scopes.resolveTypeExpr(d->fields[order[a]].type, top, mods, null, 0);
                        types.CType* tb = scopes.resolveTypeExpr(d->fields[order[b]].type, top, mods, null, 0);
                        u32 sa = cSize(ta, top);
                        u32 sb = cSize(tb, top);
                        u32 aa = cAlign(ta, top);
                        u32 ab = cAlign(tb, top);
                        bool swap = false;
                        if (aa != ab) swap = ab > aa;
                        else swap = sb > sa;
                        if (swap) { u32 tmp = order[a]; order[a]=order[b]; order[b]=tmp; }
                    }
            }
            for (u32 idx = 0; idx < nf; idx++)
            {
                u32 f = isReorder ? order[idx] : idx;
                types.CType* ft = scopes.resolveTypeExpr(d->fields[f].type, top, mods, null, 0);
                ir_types.IrType* irt = ft ? null : ctx.tyInt(8);
                if (ft != null)
                {
                    FuncGen tmpFg; tmpFg.ctx = ctx; tmpFg.top = top; tmpFg.mods = mods;
                    irt = mapCType(&tmpFg, ft);
                }
                fTypes[idx] = irt ? irt : ctx.tyInt(8);
                u32 nl = d->fields[f].name.len;
                char* nc = mman.alloc<char>(nl+1);
                for (u32 k = 0; k < nl; k++) nc[k] = (char)d->fields[f].name.ptr[k];
                nc[nl]=0;
                fNames[idx] = nc;
            }
            if (order) mman.dealloc<u32>(order);
            char nb[256]; u32 nbl = 0;
            for (u32 k = 0; k < d->name.len && nbl < 255; k++) nb[nbl++] = (char)d->name.ptr[k];
            nb[nbl]=0;
            ir_types.IrStructType* st = ctx.createStructType(nb, fTypes, fNames, nf);
            if (isPacked)
            {
                // createStructType laid out with natural padding; packed modes
                // strip every gap. st->fieldTypes is already in layout order
                // (sorted when reorder is set), so offsets pack tightly.
                u32 cur = 0;
                for (u32 fi = 0; fi < st->nfields; fi++)
                {
                    st->offsets[fi] = cur;
                    cur += ctx.irTypeSizeOf(st->fieldTypes[fi]);
                }
                st->size = cur;
            }
            irMod.addStruct(st);
            continue;
        }
        if (d->kind == ast.DT_FLAG)
        {
            // top-level flag: emit chosen case's inner decls that are funcs/structs
            str.strView sel = str.strView::empty();
            // flag values are not directly available in emitIR's prog, but check.crl already expanded DT_FLAG for top-level,
            // so this case should not occur if check expanded. Keep as fallback: emit nothing.
            continue;
        }
        if (d->kind == ast.DT_EXTERN)
        {
            const char* ename = null;
            char eb[256]; u32 el = 0;
            for (u32 k = 0; k < d->name.len && el < 255; k++) eb[el++] = (char)d->name.ptr[k];
            eb[el]=0; ename = eb;
            if (el==0) continue;
            FuncGen tfg; tfg.ctx = ctx; tfg.top = top; tfg.mods = mods;
            types.CType* eret = d->type ? scopes.resolveTypeExpr(d->type, top, mods, null, 0) : null;
            ir_types.IrType* ert = eret ? mapCType(&tfg, eret) : ctx.tyVoid();
            u32 enps = d->nparams;
            ir_types.IrType** epTys = null;
            if (enps > 0) {
                epTys = mman.alloc<ir_types.IrType*>(enps);
                for (u32 p = 0; p < enps; p++)
                    epTys[p] = d->params[p].type ? mapCType(&tfg, scopes.resolveTypeExpr(d->params[p].type, top, mods, null, 0)) : ctx.tyInt(64);
            }
            ir_types.IrFunc* efn = ctx.createFunc(ename, ert, epTys, enps);
            efn.isExtern = true;
            if (d->cc.len > 0) {
                char* ccCopy = mman.alloc<char>(d->cc.len + 1);
                for (u32 k = 0; k < d->cc.len; k++) ccCopy[k] = (char)d->cc.ptr[k];
                ccCopy[d->cc.len]=0;
                efn.externLib = ccCopy;
            }
            irMod.addFunc(efn);
            continue;
        }
        if (d->kind != ast.DT_FUNC) continue;
        if (d->body == null) continue;
        if (d->ngenerics > 0) continue;
        const char* fname = null;
        char fb[256]; u32 fl = 0;
        for (u32 k = 0; k < d->name.len && fl < 255; k++) fb[fl++] = (char)d->name.ptr[k];
        fb[fl]=0; fname = fb;
        if (fl==0) continue;

        FuncGen fg;
        fg.ctx = ctx; fg.irMod = irMod; fg.top = top; fg.mods = mods;
        fg.filename = path;
        fg.flagNames = null; fg.flagVals = null; fg.nflags = 0;
        fg.debug = debug;
        fg.localNames = null; fg.localPtrs = null; fg.nlocals = 0; fg.capLocals = 0; fg.terminated = false;

        types.CType* retCt = d->type ? scopes.resolveTypeExpr(d->type, top, mods, null, 0) : null;
        ir_types.IrType* retTy = retCt ? mapCType(&fg, retCt) : ctx.tyVoid();
        if (d->noreturn) retTy = ctx.tyVoid();

        u32 nps = d->nparams;
        ir_types.IrType** pTys = null;
        if (nps > 0)
        {
            pTys = mman.alloc<ir_types.IrType*>(nps);
            for (u32 p = 0; p < nps; p++)
                pTys[p] = d->params[p].type ? mapCType(&fg, scopes.resolveTypeExpr(d->params[p].type, top, mods, null, 0)) : ctx.tyInt(64);
        }
        ir_types.IrFunc* fn = ctx.createFunc(fname, retTy, pTys, nps);
        irMod.addFunc(fn);
        fg.func = fn;
        ir_types.IrBlock* entry = ctx.createBlock("entry");
        fn.addBlock(entry);
        ir_builder.IrBuilder bd = ir_builder.IrBuilder::new(ctx);
        bd.pos(entry, null);
        fg.bd = &bd;

        for (u32 p = 0; p < nps; p++)
        {
            ir_types.IrType* pt = pTys[p] ? pTys[p] : ctx.tyInt(64);
            ir_types.IrInst* al = bd.alloca(pt);
            char pb[64]; u32 pl=0;
            for (u32 k=0;k<d->params[p].name.len&&pl<63;k++) pb[pl++]=(char)d->params[p].name.ptr[k];
            pb[pl]=0;
            ir_types.IrValue* pv = mman.alloc<ir_types.IrValue>(1);
            pv->kind = (ir_types.IrValueKind)0;
            pv->type = pt;
            pv->id = ctx.nextValueId();
            pv->valData = 0;
            pv->name = null;
            pv->users = null;
            pv->nusers = 0;
            pv->capUsers = 0;
            if (pl>0)
            {
                char* nc = mman.alloc<char>(pl+1);
                for (u32 k=0;k<pl;k++) nc[k]=pb[k]; nc[pl]=0;
                pv->name = nc;
            }
            bd.store(pv, &al->base);
            str.strView pn = d->params[p].name;
            addLocal(&fg, pn, &al->base);
        }

        genBlockStmts(&fg, d->body);
        if (!fg.terminated)
        {
            if (retTy->kind == ir_types.IrTypeKind::Void) bd.retVoid();
            else
            {
                ir_types.IrValue* z = null;
                if (retTy->kind == ir_types.IrTypeKind::Float) z = ctx.constFloat(retTy, 0.0);
                else z = ctx.constInt(retTy, 0);
                bd.ret(z);
            }
        }
        if (optLevel > 0) wallvm.irOptimize(fn, ctx, optLevel);
        if (fg.localNames) mman.dealloc<str.strView>(fg.localNames);
        if (fg.localPtrs) mman.dealloc<ir_types.IrValue*>(fg.localPtrs);
        if (pTys) mman.dealloc<ir_types.IrType*>(pTys);
    }
    return irMod;
}
pub void emitIR(ast.Program* prog, scopes.Scope* top, scopes.ModuleTable* mods, str.strView path, u32 optLevel, bool debug)
{
    str.String opath = str.String::new();
    u32 lastDot = 0; bool dot = false;
    for (u32 k = 0; k < path.len; k++) if (path.ptr[k] == (u8)'.') { lastDot = k; dot = true; }
    if (dot) opath.pushView(str.strView::fromParts(path.ptr, lastDot));
    else opath.pushView(path);
    opath.pushCstr(".wir");
    ir_types.IrContext* ctx = null;
    ir_types.IrModule* irMod = buildModule(prog, top, mods, path, optLevel, debug, &ctx);
    void* f = libc.fopen(opath.asCstr(), (const u8*)"wb");
    if (f != null)
    {
        dumpIR(irMod, f);
        libc.fclose(f);
        libc.write(1, (const u8*)"wrote ", 6);
        libc.write(1, (const u8*)opath.asCstr(), opath.len);
        libc.write(1, (const u8*)"\n", 1);
    } else libc.write(2, (const u8*)"coralc: cannot open output .ir\n", 28);
    opath.free();
}