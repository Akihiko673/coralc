mod ast = import("ast/ast.crl");
mod scopes = import("typecheck/scopes.crl");
mod str = import("std/text/string.crl");
mod emitc = import("emitc");
mod emitir = import("emitir");
mod emits = import("emits");
mod loader = import("typecheck/loader.crl");

// emit.crl: codegen dispatch. Each target lives in its own module:
//   emitc.crl  - C header (declarations only)
//   emitir.crl - WallVM IR
//   emits.crl  - native assembly

pub void emitH(ast.Program* prog, scopes.Scope* top, scopes.ModuleTable* mods, str.strView path, bool debug)
{
    emitc.emitH(prog, top, mods, path, debug);
}

pub void emitIR(ast.Program* prog, scopes.Scope* top, scopes.ModuleTable* mods, str.strView path, u32 optLevel, bool debug)
{
    emitir.emitIR(prog, top, mods, path, optLevel, debug);
}

pub void emitAsm(ast.Program* prog, scopes.Scope* top, scopes.ModuleTable* mods, str.strView path, u32 optLevel, bool debug, str.strView* flagNames, str.strView* flagVals, u32 nflags)
{
    emits.emitAsm(prog, top, mods, path, optLevel, debug, flagNames, flagVals, nflags);
}
