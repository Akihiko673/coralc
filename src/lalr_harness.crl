mod libc = import("std/platform/libc.crl");
mod mman = import("std/memory/mman.crl");
mod lalr = import("lalr.crl");

const u32 T_EOF = 0;

void put(u8* s, u32 n) { libc.write(1, s, n); }

void num(u64 v)
{
    char tmp[24];
    u32 p = 24;
    if (v == 0) tmp[--p] = '0';
    while (v) { tmp[--p] = (char)('0' + v % 10); v /= 10; }
    while (p < 24) put((u8*)&tmp[p++], 1);
}

void nl() { put((u8*)"\n", 1); }

struct Driver
{
    lalr.Grammar g;
    lalr.Tables t;
    u32 stack[512];
    u32 sp;

    void dump()
    {
        for (u32 s = 0; s < self.t.nstates; s++)
        {
            put((u8*)"st ", 3);
            num(s);
            put((u8*)" ", 1);
            for (u32 tk = 0; tk < self.t.nterms; tk++)
            {
                lalr.Entry* en = &self.t.act[s * self.t.nterms + tk];
                if (en->kind == lalr.ACT_ERROR) put((u8*)"-", 1);
                else if (en->kind == lalr.ACT_SHIFT) { put((u8*)"s", 1); num(en->a); }
                else if (en->kind == lalr.ACT_REDUCE) { put((u8*)"r", 1); num(en->a); }
                else put((u8*)"a", 1);
                put((u8*)" ", 1);
            }
            put((u8*)"goto:", 5);
            for (u32 nt = 0; nt < self.t.nnonterms; nt++)
            {
                u32 go = self.t.gotos[s * self.t.nnonterms + nt];
                if (go == lalr.NO_STATE) put((u8*)"- ", 2);
                else { num(go); put((u8*)" ", 1); }
            }
            nl();
        }
    }

    void reset() { self.sp = 0; self.stack[0] = 0; self.stack[1] = 0; }

    bool parse(u32* toks, u32 n)
    {
        self.reset();
        u32 ip = 0;
        while (true)
        {
            u32 state = self.stack[self.sp];
            u32 tok = ip < n ? toks[ip] : T_EOF;
            lalr.Entry* en = &self.t.act[state * self.t.nterms + tok];
            if (en->kind == lalr.ACT_SHIFT)
            {
                if (self.sp + 1 >= 512) return false;
                self.sp++;
                self.stack[self.sp] = en->a;
                ip++;
            }
            else if (en->kind == lalr.ACT_REDUCE)
            {
                lalr.Prod* pr = &self.g.prods[en->a];
                if (pr->nrhs > self.sp) return false;
                self.sp -= pr->nrhs;
                u32 top = self.stack[self.sp];
                u32 go = self.t.gotos[top * self.t.nnonterms + (pr->head - lalr.NT_BASE)];
                if (go == lalr.NO_STATE) return false;
                self.sp++;
                self.stack[self.sp] = go;
            }
            else if (en->kind == lalr.ACT_ACCEPT)
                return ip == n && self.sp == 1;
            else
                return false;
        }
    }
};

// arithmetic grammar: E -> E + E | E * E | ( E ) | n
lalr.Grammar arithG()
{
    lalr.Grammar g;
    g.nterms = 6;
    g.nnonterms = 1;
    g.nprods = 5;
    g.prods = mman.alloc<lalr.Prod>(5);
    g.start = lalr.NT_BASE + 0;

    lalr.Prod* p = g.prods;

    lalr.Prod p0; p0.head = lalr.NT_BASE + 1;
    p0.rhs = mman.alloc<u32>(1);
    p0.rhs[0] = lalr.NT_BASE + 0;
    p0.nrhs = 1; p0.prec = 0;
    p0.assoc = 0;
    p0.action = 0;
    p[0] = p0;
    lalr.Prod p1;
    p1.head = lalr.NT_BASE + 0;
    p1.rhs = mman.alloc<u32>(3);
    p1.rhs[0] = lalr.NT_BASE + 0;
    p1.rhs[1] = 2;
    p1.rhs[2] = lalr.NT_BASE + 0;
    p1.nrhs = 3;
    p1.prec = 1;
    p1.assoc = lalr.ASSOC_LEFT; p1.action = 0; p[1] = p1;
    lalr.Prod p2; p2.head = lalr.NT_BASE + 0;
    p2.rhs = mman.alloc<u32>(3);
    p2.rhs[0] = lalr.NT_BASE + 0;
    p2.rhs[1] = 3;
    p2.rhs[2] = lalr.NT_BASE + 0;
    p2.nrhs = 3;
    p2.prec = 2;
    p2.assoc = lalr.ASSOC_LEFT;
    p2.action = 0;
    p[2] = p2;
    lalr.Prod p3;
    p3.head = lalr.NT_BASE + 0;
    p3.rhs = mman.alloc<u32>(3);
    p3.rhs[0] = 4;
    p3.rhs[1] = lalr.NT_BASE + 0;
    p3.rhs[2] = 5;
    p3.nrhs = 3;
    p3.prec = 0;
    p3.assoc = 0;
    p3.action = 0;
    p[3] = p3;
    lalr.Prod p4;
    p4.head = lalr.NT_BASE + 0;
    p4.rhs = mman.alloc<u32>(1);
    p4.rhs[0] = 1;
    p4.nrhs = 1;
    p4.prec = 0;
    p4.assoc = 0;
    p4.action = 0;
    p[4] = p4;
    return g;
}

// DeRemer grammar: S -> a A d | b B d | a B e | b A e ; A -> c ; B -> c
// canonical LR(1) has 14 states; the only same-core pair ({A->c., B->c.}
// after "a c" / after "b c") carries lookaheads {d},{e} vs {e},{d}, so
// merging it would create a reduce-reduce conflict: the grammar is LR(1)
// but NOT LALR(1). The generator refuses such merges -> 14, 0 conflicts.
lalr.Grammar lalrG()
{
    lalr.Grammar g;
    g.nterms = 6;
    g.nnonterms = 4;
    g.nprods = 7;
    g.prods = mman.alloc<lalr.Prod>(7);
    g.start = lalr.NT_BASE + 0;

    lalr.Prod* p = g.prods;
    lalr.Prod p0;
    p0.head = lalr.NT_BASE + 4;
    p0.rhs = mman.alloc<u32>(1);
    p0.rhs[0] = lalr.NT_BASE + 0;
    p0.nrhs = 1; p0.prec = 0; p0.assoc = 0;
    p0.action = 0; p[0] = p0;
    lalr.Prod p1;
    p1.head = lalr.NT_BASE + 0;
    p1.rhs = mman.alloc<u32>(3);
    p1.rhs[0] = 1;
    p1.rhs[1] = lalr.NT_BASE + 1;
    p1.rhs[2] = 4;
    p1.nrhs = 3;
    p1.prec = 0;
    p1.assoc = 0;
    p1.action = 0;
    p[1] = p1;
    lalr.Prod p2;
    p2.head = lalr.NT_BASE + 0;
    p2.rhs = mman.alloc<u32>(3);
    p2.rhs[0] = 2;
    p2.rhs[1] = lalr.NT_BASE + 2;
    p2.rhs[2] = 4;
    p2.nrhs = 3;
    p2.prec = 0;
    p2.assoc = 0;
    p2.action = 0;
    p[2] = p2;
    lalr.Prod p3;
    p3.head = lalr.NT_BASE + 0;
    p3.rhs = mman.alloc<u32>(3);
    p3.rhs[0] = 1;
    p3.rhs[1] = lalr.NT_BASE + 2;
    p3.rhs[2] = 5;
    p3.nrhs = 3;
    p3.prec = 0;
    p3.assoc = 0;
    p3.action = 0;
    p[3] = p3;
    lalr.Prod p4;
    p4.head = lalr.NT_BASE + 0;
    p4.rhs = mman.alloc<u32>(3);
    p4.rhs[0] = 2;
    p4.rhs[1] = lalr.NT_BASE + 1;
    p4.rhs[2] = 5;
    p4.nrhs = 3;
    p4.prec = 0;
    p4.assoc = 0;
    p4.action = 0;
    p[4] = p4;
    lalr.Prod p5;
    p5.head = lalr.NT_BASE + 1;
    p5.rhs = mman.alloc<u32>(1);
    p5.rhs[0] = 3;
    p5.nrhs = 1;
    p5.prec = 0;
    p5.assoc = 0;
    p5.action = 0;
    p[5] = p5;
    lalr.Prod p6;
    p6.head = lalr.NT_BASE + 2;
    p6.rhs = mman.alloc<u32>(1);
    p6.rhs[0] = 3;
    p6.nrhs = 1;
    p6.prec = 0;
    p6.assoc = 0;
    p6.action = 0;
    p[6] = p6;
    return g;
}

bool check(bool ok, u8* what, u32 wl)
{
    if (ok) { put((u8*)"PASS ", 5); }
    else { put((u8*)"FAIL ", 5); }
    put(what, wl);
    nl();
    return ok;
}

i32 main(i32 argc, char** argv)
{
    mman.initDefaultAllocator();
    u32 fails = 0;

    {
        lalr.Generator gen = lalr.Generator::new(arithG());
        lalr.Tables t;
        gen.build(&t);
        check(t.nstates == 10, (u8*)"arith states == 10", 18);
        num(t.nconflicts); put((u8*)" arith conflicts\n", 17);

        Driver dr;
        dr.g = arithG();
        dr.t = t;
        dr.dump();
        u32 n3[3] = { 1, 2, 1 };
        if (!check(dr.parse(n3, 3), (u8*)"arith n+n", 9)) fails++;
        u32 n5[5] = { 1, 3, 1, 2, 1 };
        if (!check(dr.parse(n5, 5), (u8*)"arith n*n+n", 11)) fails++;
        u32 p5[5] = { 4, 1, 2, 1, 5 };
        if (!check(dr.parse(p5, 5), (u8*)"arith (n+n)", 11)) fails++;
        u32 bad[2] = { 1, 2 };
        if (!check(!dr.parse(bad, 2), (u8*)"arith n+ reject", 15)) fails++;
        gen.free();
        if (t.conflicts) mman.dealloc<lalr.Conflict>(t.conflicts);
    }

    {
        lalr.Generator gen = lalr.Generator::new(lalrG());
        lalr.Tables t;
        gen.build(&t);
        check(t.nstates == 14, (u8*)"deremer states == 14", 20);
        num(t.nconflicts); put((u8*)" deremer conflicts\n", 19);

        Driver dr;
        dr.g = lalrG();
        dr.t = t;
        u32 a[3] = { 1, 3, 4 };
        if (!check(dr.parse(a, 3), (u8*)"deremer a c d", 13)) fails++;
        u32 b[3] = { 2, 3, 4 };
        if (!check(dr.parse(b, 3), (u8*)"deremer b c d", 13)) fails++;
        u32 c[3] = { 1, 3, 5 };
        if (!check(dr.parse(c, 3), (u8*)"deremer a c e", 13)) fails++;
        u32 d[3] = { 2, 3, 5 };
        if (!check(dr.parse(d, 3), (u8*)"deremer b c e", 13)) fails++;
        gen.free();
        if (t.conflicts) mman.dealloc<lalr.Conflict>(t.conflicts);
    }

    put(fails == 0 ? (u8*)"ALL PASS\n" : (u8*)"SOME FAIL\n", fails == 0 ? 9 : 11);
    return fails == 0 ? 0 : 1;
}