// Tests for the self-host statement/declaration parser: lex each source,
// parse a full program with the LALR tables, and check acceptance /
// rejection. A tiny decl summary is printed on failure for diagnosis.

mod libc = import("std/platform/libc.crl");
mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod lex = import("lexer");
mod tok = import("token");
mod stmt = import("stmt_parser");
mod ast = import("ast/ast.crl");

const u32 TRACE_IDX = 38;

str.strView PROGS[] = {
    "void main() { return 0; }",
    "u32 add(u32 a, u32 b) { u32 c = a + b; return c; }",
    "pub u64 g_counter = 0;",
    "i32 main(i32 argc, u8** argv);",
    "pub static u32 helper() { return 1; }",
    "inline i32 min(i32 a, i32 b) { if (a < b) return a; return b; }",
    "static void reset() {}",
    "extern(\"c\") void* malloc(u64 size);",
    "extern(\"c\") i32 printf(const char* fmt, ...);",
    "extern(\"c\") i32 errno;",
    "extern u8** environ;",
    "const u64 MAX = 100;",
    "const u32 CAP;",
    "const ANSWER = 40 + 2;",
    "pub const u32 BUF_CAP = 64;",
    "u32 a, b, c;",
    "pub u8 buf[64];",
    "u64 arr[16] = { 1, 2 };",
    "const char* CP = 0;",
    "my.ns.Widget w;",
    "flag (ARCH) { x86_64: u64 step() { return 1; } default: u64 step() { return 3; } }",
    "flag (ZERO_BSS) { off: default: u8* p = &x; u32 job() { return 0; } }",
    "flag (N) { default: }",
    "void f(u32 x) { switch (x) { case 0: x = 1; break; case 1: case 2: x = 3; default: x = 9; } }",
    "void f() { for (var i = 0; i < 10; i = i + 1) { } }",
    "void f() { for (u32 j = 0; j < 10; j++) { } }",
    "void f() { for (;;) { break; } }",
    "void f(u8* list) { for (var i : list) { continue; } }",
    "void f(u32 x) { if (x > 0) x = 1; else if (x < 0) x = 2; else x = 3; }",
    "void f(u32 x) { while (x > 0) { x = x - 1; } if (x) { x = 4; } }",
    "void f() { u32 i; i = 5; }",
    "extern(\"c\") u32 twice(u32 x) { return x * 2; }",
    "void f() { { } }",
    "void f() { ; ; }",
    "extern(\"c\") @[noret] void exit(i32 code);",
    "extern(\"c\") void log(i32 level, u8* msg, ...);",
    "flag (platform) { LINUX: flag (ARCH) { x86_64: i32 main(i32 argc, u8** argv); } }",
    "void f() { const u64 t = 3; u64 u = t * 2; }",
    "void f() { u32 x; x = (u32)(x + 1); return; }",
};

str.strView BADPROGS[] = {
    "void f() { return }",
    "void f() { for (; ) }",
    "void f() { switch (x) { case 1 } }",
    "flag (X) { default }",
    "extern(\"c\") void f(;",
    ") {}",
    "void f() { u32 = 5; }",
    "flag { x: }",
    "void f() { if (x) }",
    "u32 f( ) { return 1 }",
    "void f() { case 1: }",
};

void put(u8* s, u32 n) { libc.write(1, s, n); }
void nl() { put((u8*)"\n", 1); }

str.strView termText(u32 id)
{
    if (id >= tok.TOK_ANON_FIRST && id < tok.TOK_ANON_FIRST + tok.NUM_ANON)
        return tok.ANON_TERMS[id - tok.TOK_ANON_FIRST];
    return str.strView::fromCstr("???");
}

void dumpProd(lalr.Prod* p, u32 i)
{
    u8 b[120];
    u32 bl = 0;
    num(b, &bl, i);
    put(b, bl);
    put((u8*)" a", 2);
    bl = 0;
    num(b, &bl, p->action);
    put(b, bl);
    put((u8*)" :", 2);
    for (u32 k = 0; k < p->nrhs; k++)
    {
        u32 s = p->rhs[k];
        put((u8*)" ", 1);
        if (s >= lalr.NT_BASE)
        {
            bl = 0;
            num(b, &bl, s - lalr.NT_BASE);
            put(b, bl);
        }
        else
        {
            str.strView t = termText(s);
            libc.write(1, (const u8*)t.ptr, (u32)t.len);
        }
    }
    nl();
}

void num(u8* buf, u32* bl, u32 v)
{
    char tmp[12];
    u32 p = 12;
    if (v == 0) tmp[--p] = '0';
    while (v) { tmp[--p] = (char)('0' + v % 10); v /= 10; }
    while (p < 12) buf[(*bl)++] = (u8)tmp[p++];
}

void dumpRow(stmt.StmtParser p, u32 s)
{
    u8 b[64];
    u32 bl = 0;
    put((u8*)"row st=", 7);
    num(b, &bl, s);
    put(b, bl);
    for (u32 tc = 0; tc < p.t.nterms; tc++)
    {
        lalr.Entry* a = &p.t.act[s * p.t.nterms + tc];
        if (a->kind == lalr.ACT_ERROR) continue;
        put((u8*)" ", 1);
        str.strView tt = termText(tc);
        put((const u8*)tt.ptr, tt.len);
        put((u8*)"=", 1);
        if (a->kind == lalr.ACT_SHIFT) put((u8*)"s", 1);
        else if (a->kind == lalr.ACT_REDUCE) put((u8*)"r", 1);
        else if (a->kind == lalr.ACT_ACCEPT) put((u8*)"a", 1);
        bl = 0;
        num(b, &bl, a->a);
        put(b, bl);
    }
    nl();
}

i32 main(i32 argc, char** argv)
{
    mman.initDefaultAllocator();
    u32 fails = 0;
    stmt.StmtParser p = stmt.StmtParser::new();
    if (p.t.nconflicts > 0)
    {
        put((u8*)"conflicts:\n", 11);
        for (u32 i = 0; i < p.t.nconflicts; i++)
        {
            lalr.Conflict* cf = &p.t.conflicts[i];
            u8 b[96];
            u32 bl = 0;
            put((u8*)"  st=", 5);
            num(b, &bl, cf->state);
            put(b, bl);
            put((u8*)" sym=", 5);
            bl = 0;
            num(b, &bl, cf->sym);
            put(b, bl);
            put(cf->kind == 0 ? (u8*)" s/r " : (u8*)" r/r ", 5);
            bl = 0;
            num(b, &bl, cf->winner);
            put(b, bl);
            put((u8*)" vs ", 4);
            bl = 0;
            num(b, &bl, cf->loser);
            put(b, bl);
            nl();
        }
    }

    for (u32 i = 0; i < p.g.nprods; i++)
    {
        dumpProd(&p.g.prods[i], i);
    }

    {
        u8 b[64];
        u32 bl = 0;
        put((u8*)"ns=", 3);
        num(b, &bl, p.t.nstates);
        put(b, bl);
        put((u8*)" nt=", 4);
        bl = 0;
        num(b, &bl, p.t.nterms);
        put(b, bl);
        put((u8*)" nnt=", 5);
        bl = 0;
        num(b, &bl, p.t.nnonterms);
        put(b, bl);
        nl();
        u8* nbl = mman.alloc<u8>(p.g.nnonterms);
        for (u32 i = 0; i < p.g.nnonterms; i++) nbl[i] = 0;
        u32 nw = (p.g.nterms + p.g.nnonterms + 1) * 8;
        u64* fr = mman.alloc<u64>(nw);
        for (u32 i = 0; i < nw; i++) fr[i] = 0;
        for (u32 t = 0; t < p.g.nterms; t++) fr[t * 8 + (t >> 6)] |= 1ull << (t & 63);
        bool ch = true;
        while (ch)
        {
            ch = false;
            for (u32 pp = 0; pp < p.g.nprods; pp++)
            {
                lalr.Prod* pr = &p.g.prods[pp];
                u64* a = fr + (pr->head - lalr.NT_BASE + p.g.nterms) * 8;
                bool all = true;
                for (u32 i = 0; i < pr->nrhs; i++)
                {
                    u32 s = pr->rhs[i];
                    bool isnt = s >= lalr.NT_BASE;
                    bool ntr = isnt && nbl[s - lalr.NT_BASE];
                    if (!isnt)
                    {
                        a[s >> 6] |= 1ull << (s & 63);
                        all = false;
                        break;
                    }
                    u64* f = fr + (s - lalr.NT_BASE + p.g.nterms) * 8;
                    for (u32 w = 0; w < 8; w++)
                    {
                        if ((a[w] | f[w]) != a[w]) ch = true;
                        a[w] |= f[w];
                    }
                    if (!ntr) { all = false; break; }
                }
                if ((pr->nrhs == 0 || all) && !nbl[pr->head - lalr.NT_BASE])
                {
                    nbl[pr->head - lalr.NT_BASE] = 1;
                    ch = true;
                }
            }
        }
        put((u8*)"FIRST(DECL):", 12);
        for (u32 t = 0; t < p.g.nterms; t++)
        {
            if ((fr[(2 + p.g.nterms) * 8 + (t >> 6)] >> (t & 63)) & 1ull)
            {
                put((u8*)" ", 1);
                str.strView tt = termText(t);
                libc.write(1, (const u8*)tt.ptr, (u32)tt.len);
            }
        }
        nl();
        put((u8*)"FIRST(FUNC):", 12);
        for (u32 t = 0; t < p.g.nterms; t++)
        {
            if ((fr[(3 + p.g.nterms) * 8 + (t >> 6)] >> (t & 63)) & 1ull)
            {
                put((u8*)" ", 1);
                str.strView tt = termText(t);
                libc.write(1, (const u8*)tt.ptr, (u32)tt.len);
            }
        }
        nl();
        put((u8*)"FIRST(TYPE):", 12);
        for (u32 t = 0; t < p.g.nterms; t++)
        {
            if ((fr[(5 + p.g.nterms) * 8 + (t >> 6)] >> (t & 63)) & 1ull)
            {
                put((u8*)" ", 1);
                str.strView tt = termText(t);
                libc.write(1, (const u8*)tt.ptr, (u32)tt.len);
            }
        }
        nl();
        put((u8*)"row0 non-errors:", 17);
        nl();
        for (u32 tt = 0; tt < p.t.nterms; tt++)
        {
            lalr.Entry* en = &p.t.act[tt];
            if (en->kind != lalr.ACT_ERROR)
            {
                str.strView t = termText(tt);
                put((u8*)"  ", 2);
                libc.write(1, (const u8*)t.ptr, (u32)t.len);
                put((u8*)" k", 2);
                bl = 0;
                num(b, &bl, en->kind);
                put(b, bl);
                put((u8*)" a", 2);
                bl = 0;
                num(b, &bl, en->a);
                put(b, bl);
                nl();
            }
        }
        if (lalr.NO_STATE != 0) dumpRow(p, 2);
        if (p.t.nstates > 100) dumpRow(p, 100);
        if (p.t.nstates > 133) dumpRow(p, 133);
        if (p.t.nstates > 23) dumpRow(p, 23);
        if (p.t.nstates > 155) dumpRow(p, 155);
        if (p.t.nstates > 169) dumpRow(p, 169);
        if (p.t.nstates > 181) dumpRow(p, 181);
        if (p.t.nstates > 191) dumpRow(p, 191);
        if (p.t.nstates > 201) dumpRow(p, 201);
        put((u8*)"nullable DECLS:", 15);
        bl = 0;
        num(b, &bl, (u32)nbl[1]);
        put(b, bl);
        put((u8*)" PREF:", 6);
        bl = 0;
        num(b, &bl, (u32)nbl[4]);
        put(b, bl);
        nl();
    }

    for (u32 i = 0; i < 38; i++)
    {
        str.strView src = PROGS[i];
        lex.Lexer l = lex.Lexer::new((const u8*)src.ptr, (u32)src.len);
        lex.LexResult r = l.lex();
        ast.Program* pr = null;
        if (i == TRACE_IDX) p.trace = true;
        if (r.nerrs == 0) pr = p.parseProgram((u8*)src.ptr, r.toks, r.n);
        p.trace = false;
        bool ok = pr != null;
        if (!ok) fails++;
        put(ok ? (u8*)"PASS " : (u8*)"FAIL ", 5);
        put((u8*)"prog\n", 5);
        if (!ok)
        {
            put((u8*)"  src: ", 6);
            libc.write(1, (u8*)src.ptr, (u32)src.len);
            nl();
        }
        if (r.toks) mman.dealloc<tok.LexTok>(r.toks);
        if (r.errs) mman.dealloc<tok.LexErr>(r.errs);
        if (pr)
        {
            for (u32 di = 0; di < pr->ndecls; di++)
            {
                ast.Decl* d = pr->decls[di];
                u8 b[96];
                u32 bl = 0;
                put((u8*)"  d", 3);
                num(b, &bl, di);
                put(b, bl);
                put((u8*)" kind=", 6);
                bl = 0;
                num(b, &bl, d->kind);
                put(b, bl);
                put((u8*)" name=", 6);
                bl = 0;
                num(b, &bl, (u32)d->name.len);
                put(b, bl);
                put((u8*)" ty=", 4);
                bl = 0;
                num(b, &bl, (u32)(u64)d->type);
                put(b, bl);
                nl();
            }
            ast.freeProgram(pr);
        }
    }

    for (u32 i = 0; i < 11; i++)
    {
        str.strView src = BADPROGS[i];
        lex.Lexer l = lex.Lexer::new((const u8*)src.ptr, (u32)src.len);
        lex.LexResult r = l.lex();
        ast.Program* pr = null;
        if (r.nerrs == 0) pr = p.parseProgram((u8*)src.ptr, r.toks, r.n);
        bool ok = pr == null;
        if (!ok) fails++;
        put(ok ? (u8*)"PASS " : (u8*)"FAIL ", ok ? 5 : 5);
        put((u8*)"bad\n", 4);
        if (!ok)
        {
            put((u8*)"  src: ", 6);
            libc.write(1, (u8*)src.ptr, (u32)src.len);
            nl();
        }
        if (r.toks) mman.dealloc<tok.LexTok>(r.toks);
        if (r.errs) mman.dealloc<tok.LexErr>(r.errs);
        if (pr) ast.freeProgram(pr);
    }

    p.free();
    put(fails == 0 ? (u8*)"ALL PASS\n" : (u8*)"SOME FAIL\n", fails == 0 ? 9 : 11);
    return fails == 0 ? 0 : 1;
}