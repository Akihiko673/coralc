// Tests for the self-host expression exprP: lex each source, parse with
// the LALR tables, and compare the AST dump against the expected s-expr
// (or expect rejection).

mod libc = import("std/platform/libc.crl");
mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod lex = import("lexer");
mod tok = import("token");
mod exprP = import("expr_parser");
mod ast = import("ast/ast.crl");

str.strView SOURCES[] = {
    "1 + 2", "a + b * c", "a * b + c", "(a + b) * c",
    "-a * b", "a - -b", "x = y = 3", "a ? b : c",
    "a ? b : c ? d : e", "f(1, x)", "f()", "f(1)(2)",
    "a.b.c", "a->b", "a[i] + 1", "a[i][j]", "a++", "++a",
    "!true", "~x", "&p", "*p", "1 << 2 + 3", "a == b < c",
    "a && b || c", "a | b & c", "5 % 2", "(1)", "- -x",
    "a = b ? c : d", "a ? b : c = d", "a < b > c", "x = y",
    "(i32)x", "(u8)(a + b)", "sizeof(i32)", "sizeof(x)",
    "sizeof(u8) + 1", "(i32)-x", "(i64)(a.b)", "(char)'x'",
    "(a)", "(u32)(u8)y",
    "vec!<u32>", "f!<i32>(1, x)", "a.b!<u8>", "f!<Node>()",
    "m!<u64>->get()", "x!<T, u8, Node>", "vec!<u32> + 1",
    "f!<i64>(a) - 2",
    "f!<isize, usize>",
};

str.strView EXPECTS[] = {
    "(+ 1 2)", "(+ a (* b c))", "(+ (* a b) c)", "(* (paren (+ a b)) c)",
    "(* (- a) b)", "(- a (- b))", "(= x (= y 3))", "(?: a b c)",
    "(?: a b (?: c d e))", "(call f 1 x)", "(call f)", "(call (call f 1) 2)",
    "(. (. a b) c)", "(-> a b)", "(+ (index a i) 1)", "(index (index a i) j)",
    "(++ a)", "(++ a)", "(! true)", "(~ x)", "(& p)", "(* p)",
    "(<< 1 (+ 2 3))", "(== a (< b c))", "(|| (&& a b) c)", "(| a (& b c))",
    "(% 5 2)", "(paren 1)", "(- (- x))", "(= a (?: b c d))",
    "(= (?: a b c) d)", "(> (< a b) c)", "(= x y)",
    "(cast i32 x)", "(cast u8 (paren (+ a b)))", "(sizeof i32)",
    "(sizeof x)", "(+ (sizeof u8) 1)", "(cast i32 (- x))",
    "(cast i64 (paren (. a b)))", "(cast char 'x')", "(paren a)",
    "(cast u32 (cast u8 y))",
    "(generic vec ty u32)",
    "(call (generic f ty i32) 1 x)",
    "(generic (. a b) ty u8)",
    "(call (generic f ty Node))",
    "(call (-> (generic m ty u64) get))",
    "(generic x ty T ty u8 ty Node)",
    "(+ (generic vec ty u32) 1)",
    "(- (call (generic f ty i64) a) 2)",
    "(generic f ty isize ty usize)",
};

str.strView BAD[] = {
    "1 2", "1 +", "(1 + 2", "a ? b", "f(1,", "a b", "a ?", "1 + *",
    "sizeof(i32", "(i32)", "sizeof()", "(u8) x y", "x sizeof", "(i32)i32",
    "sizeof(f(1))",
    "f!<>", "f!<u32", "f!<u32,>",
    "m!<v!<u64>>", // nested generics need '>>' closing-depth (statements phase)
};

void put(u8* s, u32 n) { libc.write(1, s, n); }
void nl() { put((u8*)"\n", 1); }

void app(u8* out, u32* n, const char* s)
{
    u32 i = 0;
    while (s[i]) { out[*n] = (u8)s[i]; (*n)++; i++; }
}

void dumpTo(ast.Expr* e, u8* out, u32* n)
{
    switch (e->kind)
    {
    case ast.EX_INT:
    case ast.EX_FLOAT:
    case ast.EX_STR:
    case ast.EX_CHAR:
    case ast.EX_IDENT:
    case ast.EX_BOOL:
    {
        u32 i = 0;
        while (i < e->text.len) { out[*n] = (u8)e->text.ptr[i]; (*n)++; i++; }
        return;
    }
    case ast.EX_NULL:
        app(out, n, "null");
        return;
    case ast.EX_DEREF:
    case ast.EX_ADDR:
    {
        app(out, n, "(");
        if (e->kind == ast.EX_DEREF) app(out, n, "*"); else app(out, n, "&");
        app(out, n, " ");
        dumpTo(e->a, out, n);
        app(out, n, ")");
        return;
    }
    case ast.EX_BINARY:
    case ast.EX_UNARY:
    {
        app(out, n, "(");
        u32 i = 0;
        while (i < e->text.len) { out[*n] = (u8)e->text.ptr[i]; (*n)++; i++; }
        app(out, n, " ");
        dumpTo(e->a, out, n);
        if (e->kind == ast.EX_BINARY)
        {
            app(out, n, " ");
            dumpTo(e->b, out, n);
        }
        app(out, n, ")");
        return;
    }
    case ast.EX_TERNARY:
        app(out, n, "(?: ");
        dumpTo(e->a, out, n);
        app(out, n, " ");
        dumpTo(e->b, out, n);
        app(out, n, " ");
        dumpTo(e->c, out, n);
        app(out, n, ")");
        return;
    case ast.EX_CALL:
    {
        app(out, n, "(call ");
        dumpTo(e->a, out, n);
        for (u32 k = 0; k < e->nargs; k++)
        {
            app(out, n, " ");
            dumpTo(e->args[k], out, n);
        }
        app(out, n, ")");
        return;
    }
    case ast.EX_GENERIC:
    {
        app(out, n, "(generic ");
        dumpTo(e->a, out, n);
        for (u32 k = 0; k < e->nargs; k++)
        {
            app(out, n, " ");
            dumpTo(e->args[k], out, n);
        }
        app(out, n, ")");
        return;
    }
    case ast.EX_DOT:
    case ast.EX_ARROW:
    {
        app(out, n, e->kind == ast.EX_DOT ? "(. " : "(-> ");
        dumpTo(e->a, out, n);
        app(out, n, " ");
        u32 i = 0;
        while (i < e->text.len) { out[*n] = (u8)e->text.ptr[i]; (*n)++; i++; }
        app(out, n, ")");
        return;
    }
    case ast.EX_INDEX:
        app(out, n, "(index ");
        dumpTo(e->a, out, n);
        app(out, n, " ");
        dumpTo(e->b, out, n);
        app(out, n, ")");
        return;
    case ast.EX_PAREN:
        app(out, n, "(paren ");
        dumpTo(e->a, out, n);
        app(out, n, ")");
        return;
    case ast.EX_TYPELIT:
        app(out, n, "ty ");
        {
            u32 i = 0;
            while (i < e->text.len) { out[*n] = (u8)e->text.ptr[i]; (*n)++; i++; }
        }
        return;
    case ast.EX_CAST:
        app(out, n, "(cast ");
        {
            u32 i = 0;
            while (i < e->text.len) { out[*n] = (u8)e->text.ptr[i]; (*n)++; i++; }
        }
        app(out, n, " ");
        dumpTo(e->a, out, n);
        app(out, n, ")");
        return;
    case ast.EX_SIZEOF:
        app(out, n, "(sizeof ");
        {
            u32 i = 0;
            while (i < e->text.len) { out[*n] = (u8)e->text.ptr[i]; (*n)++; i++; }
        }
        app(out, n, ")");
        return;
    default:
        app(out, n, "?");
        return;
    }
}

bool viewEq(u8* a, u32 alen, str.strView b)
{
    if (alen != b.len) return false;
    for (u32 i = 0; i < alen; i++)
        if (a[i] != (u8)b.ptr[i]) return false;
    return true;
}

bool check(bool ok, u8* what, u32 wl)
{
    if (ok) put((u8*)"PASS ", 5);
    else put((u8*)"FAIL ", 5);
    put(what, wl);
    nl();
    return ok;
}

i32 main(i32 argc, char** argv)
{
    u32 fails = 0;
    exprP.ExprParser p;
    p = exprP.ExprParser::new();

    for (u32 i = 0; i < 52; i++)
    {
        str.strView src = SOURCES[i];
        lex.Lexer l = lex.Lexer::new((const u8*)src.ptr, (u32)src.len);
        lex.LexResult r = l.lex();
        ast.Expr* e = null;
        if (r.nerrs == 0) e = p.parse((u8*)src.ptr, r.toks, r.n);
        u8 buf[512];
        u32 blen = 0;
        if (e) dumpTo(e, buf, &blen);
        bool ok = e != null && viewEq(buf, blen, EXPECTS[i]);
        if (!ok) fails++;
        check(ok, (u8*)"expr", 4);
        if (!ok)
        {
            put((u8*)"  src: ", 6);
            libc.write(1, (u8*)src.ptr, (u32)src.len);
            nl();
            put((u8*)"  got: ", 6);
            libc.write(1, buf, blen);
            nl();
            put((u8*)"  want: ", 7);
            libc.write(1, (u8*)EXPECTS[i].ptr, (u32)EXPECTS[i].len);
            nl();
        }
        if (r.toks) mman.dealloc<tok.LexTok>(r.toks);
        if (r.errs) mman.dealloc<tok.LexErr>(r.errs);
        if (e) ast.freeExpr(e);
    }

    for (u32 i = 0; i < 19; i++)
    {
        str.strView src = BAD[i];
        lex.Lexer l = lex.Lexer::new((const u8*)src.ptr, (u32)src.len);
        lex.LexResult r = l.lex();
        ast.Expr* e = null;
        if (r.nerrs == 0) e = p.parse((u8*)src.ptr, r.toks, r.n);
        bool ok = e == null;
        if (!ok) fails++;
        check(ok, (u8*)"bad", 3);
        if (!ok)
        {
            put((u8*)"  src: ", 6);
            libc.write(1, (u8*)src.ptr, (u32)src.len);
            nl();
        }
        if (r.toks) mman.dealloc<tok.LexTok>(r.toks);
        if (r.errs) mman.dealloc<tok.LexErr>(r.errs);
        if (e) ast.freeExpr(e);
    }

    p.free();
    put(fails == 0 ? (u8*)"ALL PASS\n" : (u8*)"SOME FAIL\n", fails == 0 ? 9 : 11);
    return fails == 0 ? 0 : 1;
}