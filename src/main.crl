mod libc = import("std/platform/libc.crl");
mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod ast = import("ast/ast.crl");
mod tok = import("token");
mod lex = import("lexer");
mod stmtP = import("stmt_parser");
mod lalr = import("lalr");

const u32 MAX_FILE = 16 * 1024 * 1024;

u8* readFile(str.strView path, u32* outLen)
{
    i32 fd = libc.open(path.ptr, 0, 0);
    if (fd < 0) return null;
    u64 cap = 65536;
    u8* buf = mman.alloc<u8>(cap);
    u32 n = 0;
    for (;;)
    {
        if (n + 4096 > cap)
        {
            u64 nc = cap * 2;
            u8* nb = mman.alloc<u8>(nc);
            for (u32 i = 0; i < n; i++) nb[i] = buf[i];
            mman.dealloc<u8>(buf);
            buf = nb;
            cap = nc;
        }
        i64 r = libc.read(fd, buf + n, 4096);
        if (r <= 0) break;
        n += (u32)r;
    }
    libc.close(fd);
    *outLen = n;
    return buf;
}

// Validate a type-argument list whose open ('<' or '!<') sits at ltPos, at
// nesting depth `depth`. Records every '>>' closer that should be split into
// two '>' into spl[]. Returns true on a well-formed list and sets *outEnd past
// the closer and *dblClose when a '>>' closed two levels at once.
bool matchGenArgs(tok.LexTok* toks, u32 n, u32 ltPos, u32 depth,
                  u32* spl, u32* nspl, u32* outEnd, bool* dblClose,
                  u32 tLt, u32 tGt, u32 tGtGt, u32 tComma, u32 tConst,
                  u32 tColonColon, u32 tTypeMin, u32 tTypeMax, u32 tIdent,
                  u32 tBangLt)
{
    u32 i = ltPos + 1;
    while (true)
    {
        if (i >= n) return false;
        u32 tid = toks[i].id;
        if (tid == tComma) { i++; continue; }
        if (tid == tGt) { *outEnd = i + 1; *dblClose = false; return true; }
        if (tid == tGtGt)
        {
            if (depth < 2 || *nspl >= 32) return false;
            spl[(*nspl)++] = i;
            *outEnd = i + 1; *dblClose = true; return true;
        }
        if (tid == tConst) { i++; if (i >= n) return false; tid = toks[i].id; }
        if (tid != tIdent && (tid < tTypeMin || tid > tTypeMax)) return false;
        i++;
        while (i + 1 < n && toks[i].id == tColonColon &&
               (toks[i + 1].id == tIdent ||
                (toks[i + 1].id >= tTypeMin && toks[i + 1].id <= tTypeMax)))
            i += 2;
        if (i < n && (toks[i].id == tLt || toks[i].id == tBangLt))
        {
            u32 ne; bool nd;
            if (!matchGenArgs(toks, n, i, depth + 1, spl, nspl, &ne, &nd,
                             tLt, tGt, tGtGt, tComma, tConst, tColonColon,
                             tTypeMin, tTypeMax, tIdent, tBangLt)) return false;
            if (nd) { *outEnd = ne; *dblClose = false; return true; }
            i = ne;
        }
    }
}

// Split '>>' tokens that close generic argument lists into individual '>'
// tokens so the LALR type/decl grammars can parse nested generics
// (e.g. `option<HashMapEntry<K, V>>`). Shift-right '>>' that is not inside a
// generic span is preserved: a generic span is only entered on a valid
// `NAME <` / `NAME !<` type-argument list (mirroring expr_parser.probeGeneric).
tok.LexTok* splitGenericShifts(tok.LexTok* toks, u32* pntoks)
{
    u32 n = *pntoks;
    u32 tLt = tok.terminalId(str.strView::fromCstr("<"));
    u32 tGt = tok.terminalId(str.strView::fromCstr(">"));
    u32 tGtGt = tok.terminalId(str.strView::fromCstr(">>"));
    u32 tBangLt = tok.terminalId(str.strView::fromCstr("!<"));
    u32 tComma = tok.terminalId(str.strView::fromCstr(","));
    u32 tConst = tok.terminalId(str.strView::fromCstr("const"));
    u32 tColonColon = tok.terminalId(str.strView::fromCstr("::"));
    u32 tTypeMin = tok.terminalId(str.strView::fromCstr("i8"));
    u32 tTypeMax = tok.terminalId(str.strView::fromCstr("usize"));
    u32 tIdent = tok.TOK_IDENT;

    u32* spl = mman.alloc<u32>(n);
    u32 nspl = 0;
    for (u32 i = 0; i + 1 < n; i++)
    {
        u32 tid = toks[i].id;
        if (tid == tIdent || (tid >= tTypeMin && tid <= tTypeMax))
        {
            u32 nxt = toks[i + 1].id;
            if (nxt == tLt || nxt == tBangLt)
            {
                u32 end; bool dbl;
                u32 s0 = nspl;
                if (matchGenArgs(toks, n, i + 1, 1, spl, &nspl, &end, &dbl,
                                 tLt, tGt, tGtGt, tComma, tConst, tColonColon,
                                 tTypeMin, tTypeMax, tIdent, tBangLt))
                {
                    i = end - 1;
                    continue;
                }
                nspl = s0;
            }
        }
    }
    if (nspl == 0)
    {
        mman.dealloc<u32>(spl);
        return toks;
    }
    u8* mark = mman.alloc<u8>(n);
    for (u32 k = 0; k < n; k++) mark[k] = 0;
    for (u32 k = 0; k < nspl; k++) mark[spl[k]] = 1;
    u32 outN = n + nspl;
    tok.LexTok* out = mman.alloc<tok.LexTok>(outN);
    u32 o = 0;
    for (u32 i = 0; i < n; i++)
    {
        if (mark[i])
        {
            out[o] = toks[i];
            out[o].id = tGt;
            o++;
            out[o] = toks[i];
            out[o].id = tGt;
            out[o].start = toks[i].start + 1;
            out[o].len = 1;
            o++;
        }
        else
        {
            out[o] = toks[i];
            o++;
        }
    }
    mman.dealloc<u8>(mark);
    mman.dealloc<u32>(spl);
    *pntoks = outN;
    return out;
}

void dumptoks(const u8* src, tok.LexTok* toks, u32 n, tok.LexErr* errs, u32 nerrs)
{
    for (u32 i = 0; i < n; i++)
    {
        tok.LexTok* t = &toks[i];
        if (t->id == tok.TOK_EOF) { libc.write(2, "EOF\n", 4); break; }
        u8 buf[80];
        u32 bl = 0;
        selfNum(buf, &bl, t->row);
        buf[bl++] = ':';
        selfNum(buf, &bl, t->col);
        buf[bl++] = ' ';
        str.strView cls = str.strView::empty();
        if (t->id == tok.TOK_IDENT) cls = str.strView::fromCstr("ident");
        else if (t->id == tok.TOK_INT) cls = str.strView::fromCstr("int");
        else if (t->id == tok.TOK_FLOAT) cls = str.strView::fromCstr("float");
        else if (t->id == tok.TOK_STR) cls = str.strView::fromCstr("str");
        else if (t->id == tok.TOK_CHAR) cls = str.strView::fromCstr("char");
        else cls = str.strView::fromCstr("tok");
        u32 cl = 0;
        while (cl < cls.len) { buf[bl++] = (u8)cls.ptr[cl]; cl++; }
        buf[bl++] = ' ';
        u32 w = t->len;
        if (w > 40) w = 40;
        for (u32 j = 0; j < w; j++) buf[bl++] = src[t->start + j];
        buf[bl++] = '\n';
        libc.write(2, buf, bl);
    }
    for (u32 i = 0; i < nerrs; i++)
    {
        libc.write(2, "lex error: ", 11);
        libc.write(2, errs[i].msg.ptr, errs[i].msg.len);
        u8 eb[16];
        u32 ebl = 0;
        eb[ebl++] = ' ';
        selfNum(eb, &ebl, errs[i].row);
        eb[ebl++] = ':';
        selfNum(eb, &ebl, errs[i].col);
        eb[ebl++] = '\n';
        libc.write(2, eb, ebl);
    }
}

void selfNum(u8* buf, u32* bl, u32 v)
{
    char tmp[12];
    u32 p = 12;
    if (v == 0) tmp[--p] = '0';
    while (v) { tmp[--p] = (char)('0' + v % 10); v /= 10; }
    while (p < 12) buf[(*bl)++] = (u8)tmp[p++];
}

i32 main(i32 argc, char** argv)
{
    mman.initDefaultAllocator();
    if (argc < 2) return 1;
    bool dump = false;
    bool gdump = false;
    i32 first = 1;
    if (argv[1][0] == '-' && argv[1][1] == 't')
    {
        dump = true;
        first = 2;
    }
    if (argv[1][0] == '-' && argv[1][1] == 'g')
    {
        gdump = true;
        first = 2;
    }
    i32 fails = 0;
    stmtP.StmtParser stp = stmtP.StmtParser::new();
    stp.trace = dump;
    stp.dumpGrammar = gdump;
    for (i32 fi = first; fi < argc; fi++)
    {
        str.strView path = str.strView::fromCstr(argv[fi]);
        u32 len = 0;
        u8* src = readFile(path, &len);
        if (!src)
        {
            libc.write(2, "can't open ", 11);
            libc.write(2, path.ptr, path.len);
            libc.write(2, "\n", 1);
            fails++;
            continue;
        }
        libc.write(2, "==> ", 4);
        libc.write(2, path.ptr, path.len);
        libc.write(2, "\n", 1);
        lex.Lexer lx = lex.Lexer::new(src, len);
        lex.LexResult lr = lx.lex();
        if (lr.nerrs == 0)
            lr.toks = splitGenericShifts(lr.toks, &lr.n);
        if (lr.nerrs > 0)
        {
            for (u32 i = 0; i < lr.nerrs; i++)
            {
                libc.write(2, "lex error: ", 11);
                libc.write(2, lr.errs[i].msg.ptr, lr.errs[i].msg.len);
                u8 eb2[16];
                u32 ebl2 = 0;
                eb2[ebl2++] = ' ';
                selfNum(eb2, &ebl2, lr.errs[i].row);
                eb2[ebl2++] = ':';
                selfNum(eb2, &ebl2, lr.errs[i].col);
                eb2[ebl2++] = '\n';
                libc.write(2, eb2, ebl2);
            }
            fails++;
        }
        else
        {
            if (dump)
                dumptoks(src, lr.toks, lr.n, lr.errs, lr.nerrs);
            ast.Program* prog = stp.parseProgram(src, lr.toks, lr.n);
            if (prog == null)
            {
                libc.write(2, "parse error at ", 15);
                libc.write(2, "tid ", 4);
                u8 eb[32];
                u32 el = 0;
                selfNum(eb, &el, stp.errTid);
                libc.write(2, eb, el);
                libc.write(2, " ", 1);
                el = 0;
                selfNum(eb, &el, stp.errRow);
                eb[el++] = ':';
                selfNum(eb, &el, stp.errCol);
                eb[el++] = '\n';
                libc.write(2, eb, el);
                el = 0;
                selfNum(eb, &el, stp.errState);
                eb[el++] = '\n';
                libc.write(2, eb, el);
                fails++;
            }
        }
    }
    stp.free();
    libc.write(2, fails == 0 ? "LEX OK\n" : "LEX FAIL\n", fails == 0 ? 7 : 9);
    return fails == 0 ? 0 : 1;
}