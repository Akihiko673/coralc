mod str = import("std/text/string");

// Token ids for literals and EOF
pub const u32 TOK_EOF = 0;
pub const u32 TOK_IDENT = 1;
pub const u32 TOK_INT = 2;
pub const u32 TOK_FLOAT = 3;
pub const u32 TOK_STR = 4;
pub const u32 TOK_CHAR = 5;
pub const u32 TOK_ANON_FIRST = 6;

// Keyword / operator / punctuation ids. Each is TOK_ANON_FIRST + index into
// ANON_TERMS below; the parser must use these names, never raw numbers.
pub const u32 T_MOD = 6;
pub const u32 T_IMPORT = 7;
pub const u32 T_PUB = 8;
pub const u32 T_STATIC = 9;
pub const u32 T_INLINE = 10;
pub const u32 T_STRUCT = 11;
pub const u32 T_ENUM = 12;
pub const u32 T_TRAIT = 13;
pub const u32 T_CONST = 14;
pub const u32 T_VAR = 15;
pub const u32 T_CONSTEXPR = 16;
pub const u32 T_TYPEDEF = 17;
pub const u32 T_DISTINCT = 18;
pub const u32 T_EXTERN = 19;
pub const u32 T_IF = 20;
pub const u32 T_ELSE = 21;
pub const u32 T_WHILE = 22;
pub const u32 T_FOR = 23;
pub const u32 T_LOOP = 24;
pub const u32 T_SWITCH = 25;
pub const u32 T_CASE = 26;
pub const u32 T_DEFAULT = 27;
pub const u32 T_BREAK = 28;
pub const u32 T_CONTINUE = 29;
pub const u32 T_RETURN = 30;
pub const u32 T_DEFER = 31;
pub const u32 T_COMPTIME = 32;
pub const u32 T_FLAG = 33;
pub const u32 T_ASM = 34;
