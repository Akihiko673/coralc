pub struct LexTok
{
    u32 id;
    u32 start;
    u32 len;
    u32 row;
    u32 col;
}

pub struct LexErr
{
    u32 start;
    u32 row;
    u32 col;
    str.strView code;
    str.strView msg;
    str.strView help;
}

// Keywords are matched by full word; the keyword must also appear in
// ANON_TERMS so terminalId() yields the right id.
pub str.strView KW_TERMS[] = {
    "mod", "import", "pub", "static",
    "inline", "struct", "enum", "trait",
    "const", "constexpr", "var", "typedef",
    "distinct", "extern", "if", "else",
    "while", "for", "loop", "switch",
    "case", "default", "break", "continue",
    "return", "defer", "comptime", "flag",
    "asm", "volatile", "sizeof", "true",
    "false", "null", "self", "i8", "i16", "i32", "i64",
    "u8", "u16", "u32", "u64", "f32", "f64",
    "bool", "char", "void", "isize", "usize",
    "assert",
};

// Operators and punctuation, longest first so scanPunct matches greedily.
// No legacy @[...] / @name attributes here: attributes are [[...]] for
// declarations and @[[...]] /
// as separate tokens.
pub str.strView OP_TERMS[] = {
    "<<=", ">>=", "...",
    "=>", "+=", "-=",
    "*=", "/=", "%=",
    "&=", "|=", "^=",
    "==", "!=",
    "!<", "<=", ">=",
    "&&", "||",
    "<<", ">>",
    "++", "--",
    "->", "::",
    "=", "<", ">",
    "!", "~",
    "+", "-", "*", "/",
    "%", "&", "|", "^",
    ".", ",", ":", ";",
    "?", "@", "#",
    "(", ")",
    "{", "}",
    "[", "]",
};

// Ordering below defines the numeric ids: id = TOK_ANON_FIRST + index.
// Do not reorder without updating the T_* constants above.
pub str.strView ANON_TERMS[] = {
    "mod", "import", "pub",
    "static", "inline", "struct",
    "enum", "trait", "const",
    "var", "constexpr", "typedef",
    "distinct", "extern", "if",
    "else", "while", "for",
    "loop", "switch", "case",
    "default", "break", "continue",
    "return", "defer", "comptime",
    "flag", "asm", "volatile",
    "sizeof", "true", "false",
    "null", "self", "i8", "i16", "i32",
    "i64", "u8", "u16", "u32",
    "u64", "f32", "f64",
    "bool", "char", "void",
    "isize", "usize", "<<=",
    ">>=", "...", "=>", "+=",
    "-=", "*=", "/=", "%=",
    "&=", "|=", "^=", "==",
    "!=", "!<", "<=", ">=",
    "&&", "||", "<<", ">>",
    "++", "--", "->", "::",
    "=", "<", ">", "!", "~",
    "+", "-", "*", "/", "%",
    "&", "|", "^", ".", ",",
    ":", ";", "?", "@", "(",
    ")", "{", "}", "[", "]",
    "assert",
};

pub const u32 NUM_OP = 51;      // OP_TERMS length (scanPunct bound)
pub const u32 NUM_KW = 51;      // KW_TERMS length (scanWord bound)
pub const u32 NUM_ANON = 101;   // ANON_TERMS length

pub u32 terminalId(str.strView s)
{
    for (u32 i = 0; i < NUM_ANON; i++)
    {
        str.strView t = ANON_TERMS[i];
        u32 j = 0;
        while (j < t.len && j < s.len && t.ptr[j] == s.ptr[j]) j++;
        if (j == t.len && j == s.len) return TOK_ANON_FIRST + i;
    }
    return 0xFFFFFFFF;
}