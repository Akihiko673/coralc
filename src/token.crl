pub const u32 T_SELF = 40;
pub const u32 T_I8 = 41;
pub const u32 T_I16 = 42;
pub const u32 T_I32 = 43;
pub const u32 T_I64 = 44;
pub const u32 T_U8 = 45;
pub const u32 T_U16 = 46;
pub const u32 T_U32 = 47;
pub const u32 T_U64 = 48;
pub const u32 T_F32 = 49;
pub const u32 T_F64 = 50;
pub const u32 T_BOOL = 51;
pub const u32 T_CHAR = 52;
pub const u32 T_VOID = 53;
pub const u32 T_ISIZE = 54;
pub const u32 T_USIZE = 55;
pub const u32 T_SHL_EQ = 56;
pub const u32 T_SHR_EQ = 57;
pub const u32 T_ELLIPSIS = 58;
pub const u32 T_RARROW = 59;
pub const u32 T_PLUS_EQ = 60;
pub const u32 T_MINUS_EQ = 61;
pub const u32 T_STAR_EQ = 62;
pub const u32 T_SLASH_EQ = 63;
pub const u32 T_PERCENT_EQ = 64;
pub const u32 T_AMP_EQ = 65;
pub const u32 T_PIPE_EQ = 66;
pub const u32 T_CARET_EQ = 67;
pub const u32 T_EQ = 68;
pub const u32 T_NE = 69;
pub const u32 T_BANG_LT = 70;
pub const u32 T_LE = 71;
pub const u32 T_GE = 72;
pub const u32 T_AND = 73;
pub const u32 T_OR = 74;
pub const u32 T_SHL = 75;
pub const u32 T_SHR = 76;
pub const u32 T_INC = 77;
pub const u32 T_DEC = 78;
pub const u32 T_ARROW = 79;
pub const u32 T_COLON_COLON = 80;
pub const u32 T_ASSIGN = 81;
pub const u32 T_LT = 82;
pub const u32 T_GT = 83;
