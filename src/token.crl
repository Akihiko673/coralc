pub const u32 T_TILDE = 85;
pub const u32 T_PLUS = 86;
pub const u32 T_MINUS = 87;
pub const u32 T_STAR = 88;
pub const u32 T_SLASH = 89;
pub const u32 T_PERCENT = 90;
pub const u32 T_AMP = 91;
