// On-demand import loader: reads, lexes, and parses imported modules so the
// typechecker can resolve CROSS-FILE symbols (struct statics like
// strView::fromParts, String::new) against their REAL declarations instead of
// hardcoded name/arity tables. Imported programs are only used for
// declaration lookup; body typing stays per-file.
mod ast = import("ast/ast.crl");
mod str = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");
mod libc = import("std/platform/libc.crl");
mod tok = import("token");
mod lex = import("lexer");
mod parse = import("parser");

pub struct Loader
{
    ast.Program** progs;
    char** paths;
    u32 n;
    u32 cap;
    char* exeDir;
}

Loader* loaderNew(char* exeDir)
{
    Loader* L = mman.alloc<Loader>(1);
    L->progs = null;
    L->paths = null;
    L->n = 0;
    L->cap = 0;
    L->exeDir = exeDir;
    return L;
}

bool loaderHas(Loader* L, const char* path, u32 len)
{
    for (u32 i = 0; i < L->n; i++)
    {
        u32 pl = 0;
        while (L->paths[i][pl] != 0) pl++;
        if (pl == len && libc.memcmp((const void*)L->paths[i], (const void*)path, len) == 0) return true;
    }
    return false;
}

void loaderAdd(Loader* L, ast.Program* p, const char* path, u32 len)
{
    if (L->n >= L->cap)
    {
        u32 nc = L->cap ? L->cap * 2 : 8;
        ast.Program** na = mman.alloc<ast.Program*>(nc);
        char** nb = mman.alloc<char*>(nc);
        for (u32 i = 0; i < L->n; i++) { na[i] = L->progs[i]; nb[i] = L->paths[i]; }
        L->progs = na;
        L->paths = nb;
        L->cap = nc;
    }
    char* dup = mman.alloc<char>(len + 1);
    for (u32 i = 0; i < len; i++) dup[i] = path[i];
    dup[len] = 0;
    L->progs[L->n] = p;
    L->paths[L->n] = dup;
    L->n++;
}

// whole-file read; false when the file cannot be opened.
bool loaderRead(const char* path, u8** out, u32* outLen)
{
    void* f = libc.fopen(path, "rb");
    if (f == null) return false;
    u64 cap = 1 << 16;
    u8* buf = mman.alloc<u8>(cap);
    u64 used = 0;
    for (;;)
    {
        u64 got = libc.fread(buf + used, 1, cap - used, f);
        used += got;
        if (got == 0) break;
        if (used == cap)
        {
            u64 nc = cap * 2;
            buf = mman.realloc<u8>(buf, nc);
            cap = nc;
        }
    }
    libc.fclose(f);
    *out = buf;
    *outLen = (u32)used;
    return true;
}

// build "prefix/imp[.crl]" into out; returns the byte count written.
u32 buildPath(char* out, u32 outCap, const char* prefix, u32 plen, str.strView imp, bool addCrl)
{
    u32 n = 0;
    if (plen > 0)
    {
        if (plen + 1 >= outCap) return 0;
        for (u32 i = 0; i < plen; i++) out[n++] = prefix[i];
        out[n++] = '/';
    }
    if (imp.len + 1 >= outCap) return 0;
    for (u32 i = 0; i < imp.len; i++) out[n++] = imp.ptr[i];
    if (addCrl)
    {
        if (n + 5 >= outCap) return 0;
        out[n++] = '.';
        out[n++] = 'c';
        out[n++] = 'r';
        out[n++] = 'l';
    }
    out[n] = 0;
    return n;
}

// resolve `imp` relative to the compiler dir (reference folder `lib2`, then
// `lib`) and the compiled file's own directory chain, storing the resolved
// path in out (ONLY VALID until the next resolveImport call on the same
// buffer). Returns the path length, or 0 when the file does not exist.
u32 resolveImport(str.strView imp, str.strView curPath, char* exeDir, char* out, u32 outCap)
{
    bool hasDot = false;
    for (u32 i = 0; i < imp.len; i++)
        if (imp.ptr[i] == '.') hasDot = true;
    bool addCrl = !hasDot;
    u8* tmp = null;
    u32 tmpLen = 0;
    char fld[512];
    // compiler dir reference folder: <exeDir>/lib2 (becomes lib later)
    if (exeDir != null)
    {
        u32 dn = strlenAt(exeDir);
        const char* r = "lib2";
        u32 rl = 4;
        if (dn + 1 + rl < 512)
        {
            u32 n2 = 0;
            for (u32 i = 0; i < dn; i++) fld[n2++] = exeDir[i];
            fld[n2++] = '/';
            for (u32 i = 0; i < rl; i++) fld[n2++] = r[i];
            fld[n2] = 0;
            u32 n = buildPath(out, outCap, fld, n2, imp, addCrl);
            if (n > 0 && loaderRead(out, &tmp, &tmpLen)) return n;
        }
    }
    // directory chain of the compiled file, innermost first
    for (u32 i = 0; i < curPath.len; i++)
    {
        if (curPath.ptr[i] == '/')
        {
            u32 n = buildPath(out, outCap, curPath.ptr, i, imp, addCrl);
            if (n > 0 && loaderRead(out, &tmp, &tmpLen)) return n;
        }
    }
    // cwd
    {
        u32 n = buildPath(out, outCap, "", 0, imp, addCrl);
        if (n > 0 && loaderRead(out, &tmp, &tmpLen)) return n;
    }
    return 0;
}

u32 strlenAt(const char* s)
{
    u32 n = 0;
    while (s[n] != 0) n++;
    return n;
}

ast.Program* loadOne(Loader* L, const char* resolved, u32 resLen)
{
    if (loaderHas(L, resolved, resLen)) return loaderGet(L, resolved, resLen);
    u8* src = null;
    u32 srclen = 0;
    if (!loaderRead(resolved, &src, &srclen)) return null;
    lex.Lexer lx = lex.Lexer::new(src, srclen);
    lex.LexResult lr = lx.lex();
    if (lr.nerrs > 0) return null;
    parse.Parser p = parse.Parser::new(lr.toks, lr.n, src, srclen,
                                       str.strView::fromCstr(resolved));
    ast.Program* prog = p.parseProgram();
    if (prog == null) return null;
    // register BEFORE recursing so import cycles terminate
    loaderAdd(L, prog, resolved, resLen);
    char buf[512];
    for (u32 i = 0; i < prog->ndecls; i++)
    {
        ast.Decl* d = prog->decls[i];
        if (d != null && d->kind == ast.DT_IMPORT)
        {
            u32 rl = resolveImport(d->text, str.strView::fromCstr(resolved), L->exeDir, buf, 512);
            if (rl > 0) loadOne(L, buf, rl);
        }
    }
    return prog;
}

ast.Program* loaderGet(Loader* L, const char* path, u32 len)
{
    for (u32 i = 0; i < L->n; i++)
    {
        u32 pl = 0;
        while (L->paths[i][pl] != 0) pl++;
        if (pl == len && libc.memcmp((const void*)L->paths[i], (const void*)path, len) == 0)
            return L->progs[i];
    }
    return null;
}

// public entry: load a module import (imp text + the importing file's path).
ast.Program* loaderLoad(Loader* L, str.strView imp, str.strView curPath)
{
    char buf[512];
    u32 rl = resolveImport(imp, curPath, L->exeDir, buf, 512);
    if (rl == 0) return null;
    return loadOne(L, buf, rl);
}