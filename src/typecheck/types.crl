// Type representation and resolution for the semantic passes.
// Types are small refcount-free trees (the checker never frees them; the
// compiler process is short-lived). `resolveTypeExpr` turns a parsed
// AST TypeExpr into a CType. Module-qualified names that cannot be resolved
// in this file (imported modules are opaque here until the import pass) come
// back as TY_UNKNOWN so the strict typing rules degrade gracefully.
mod ast = import("ast/ast.crl");
mod str = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");
mod libc = import("std/platform/libc.crl");

pub const u32 TY_UNKNOWN = 0;   // unresolved / poison / opaque module escape
pub const u32 TY_VOID = 1;
pub const u32 TY_BOOL = 2;
pub const u32 TY_CHAR = 3;
pub const u32 TY_INT = 4;
pub const u32 TY_FLOAT = 5;
pub const u32 TY_PTR = 6;
pub const u32 TY_ARRAY = 7;     // fixed array with known or unknown extent
pub const u32 TY_SLICE = 8;     // unsized array (TYP_ARRAY without count)
pub const u32 TY_FUNC = 9;
pub const u32 TY_NAMED = 10;    // struct/enum/typedef/distinct instance
pub const u32 TY_NULL = 11;     // the null literal type

pub struct CType
{
    u32 kind;
    u32 width;          // INT/FLOAT bits: 8/16/32/64
    bool isSigned;      // INT
    CType* elem;        // PTR/SLICE/ARRAY element
    u64 count;          // ARRAY extent (0 when unknown)
    bool countKnown;
    CType* ret;         // FUNC return
    CType** params;     // FUNC params
    u32 nparams;
    bool variadic;      // FUNC
    ast.Decl* decl;     // NAMED: the resolved decl (struct/enum/typedef/distinct)
    str.strView name;   // canonical display name (may carry generic args)
    bool isConstPtr;    // PTR: const-qualified pointer
    u32 line;
    u32 col;
}

// primitive type table: i8..i64, u8..u64, f32/f64, bool, char, void,
// isize/usize. Returns false for non-primitive names.
bool primType(str.strView n, CType* out)
{
    out->kind = TY_UNKNOWN;
    out->width = 0;
    out->isSigned = false;
    out->elem = null;
    out->count = 0;
    out->countKnown = false;
    out->ret = null;
    out->params = null;
    out->nparams = 0;
    out->variadic = false;
    out->decl = null;
    out->name = n;
    out->isConstPtr = false;
    out->line = 0;
    out->col = 0;
    if (n.len == 2)
    {
        bool i = n.ptr[0] == 'i';
        bool u = n.ptr[0] == 'u';
        u64 w = 0;
        if (n.ptr[1] == '8') w = 8;
        else if (n.ptr[1] == '1' && n.len == 3) w = 16;
        else if (n.ptr[1] == '3' && n.len == 3) w = 32;
        else if (n.ptr[1] == '6' && n.len == 3) w = 64;
        if (w > 0 && (i || u))
        {
            out->kind = TY_INT;
            out->width = w;
            out->isSigned = i;
            return true;
        }
    }
    if (n.len == 3 && n.ptr[0] == 'f' && n.ptr[1] == '3' && n.ptr[2] == '2')
    {
        out->kind = TY_FLOAT;
        out->width = 32;
        return true;
    }
    if (n.len == 3 && n.ptr[0] == 'f' && n.ptr[1] == '6' && n.ptr[2] == '4')
    {
        out->kind = TY_FLOAT;
        out->width = 64;
        return true;
    }
    if (n.len == 4 && n.ptr[0] == 'b' && n.ptr[1] == 'o' && n.ptr[2] == 'o' && n.ptr[3] == 'l')
    {
        out->kind = TY_BOOL;
        return true;
    }
    if (n.len == 4 && n.ptr[0] == 'c' && n.ptr[1] == 'h' && n.ptr[2] == 'a' && n.ptr[3] == 'r')
    {
        out->kind = TY_CHAR;
        return true;
    }
    if (n.len == 4 && n.ptr[0] == 'v' && n.ptr[1] == 'o' && n.ptr[2] == 'i' && n.ptr[3] == 'd')
    {
        out->kind = TY_VOID;
        return true;
    }
    if (n.len == 5 && n.ptr[0] == 'i' && n.ptr[1] == 's' && n.ptr[2] == 'i' && n.ptr[3] == 'z' && n.ptr[4] == 'e')
    {
        out->kind = TY_INT;
        out->width = 64;
        out->isSigned = true;
        return true;
    }
    if (n.len == 5 && n.ptr[0] == 'u' && n.ptr[1] == 's' && n.ptr[2] == 'i' && n.ptr[3] == 'z' && n.ptr[4] == 'e')
    {
        out->kind = TY_INT;
        out->width = 64;
        out->isSigned = false;
        return true;
    }
    return false;
}

// hoisted: does a CType carry a name (NAMED/UNKNOWN)?
bool isNamedKind(u32 k)
{
    return k == TY_NAMED || k == TY_UNKNOWN;
}

u64 intFitsMax(u32 width)
{
    if (width >= 64) return 0xFFFFFFFFFFFFFFFFu;
    if (width == 32) return 0xFFFFFFFFu;
    if (width == 16) return 0xFFFFu;
    return 0xFFu;
}

// Does an integer literal VALUE (as unsigned magnitude + signedness of the
// literal) fit into an int/bool/char type? `neg` marks signed literals.
bool intFits(bool isSigned, u64 mag, u32 width, bool litSigned)
{
    if (width >= 64)
    {
        if (isSigned)
        {
            // -9223372036854775808 .. 9223372036854775807
            if (litSigned && mag > 0x8000000000000000u) return false;
            return true;
        }
        return true;
    }
    u64 m = intFitsMax(width);
    if (isSigned)
    {
        i64 half = ((i64)1 << (i64)(width - 1u));
        if (litSigned)
        {
            if ((i64)mag > (i64)half) return false;
        }
        else
        {
            if (mag > (u64)half) return false;
        }
        return true;
    }
    return mag <= m;
}

bool typesEqual(CType* a, CType* b)
{
    if (a == null || b == null) return false;
    if (a->kind == TY_UNKNOWN || b->kind == TY_UNKNOWN) return false;
    if (a->kind != b->kind) return false;
    switch (a->kind)
    {
    case TY_VOID:
    case TY_BOOL:
        return true;
    case TY_CHAR:
        return true;
    case TY_INT:
        return a->width == b->width && a->isSigned == b->isSigned;
    case TY_FLOAT:
        return a->width == b->width;
    case TY_PTR:
    case TY_SLICE:
        if (a->isConstPtr != b->isConstPtr) return false;
        return typesEqual(a->elem, b->elem);
    case TY_ARRAY:
        if (!a->countKnown || !b->countKnown) return false;
        if (a->count != b->count) return false;
        return typesEqual(a->elem, b->elem);
    case TY_NULL:
        return true;
    case TY_FUNC:
        if (a->nparams != b->nparams || a->variadic != b->variadic) return false;
        for (u32 i = 0; i < a->nparams; i++)
        {
            if (!typesEqual(a->params[i], b->params[i])) return false;
        }
        return typesEqual(a->ret, b->ret);
    case TY_NAMED:
        return a->decl == b->decl && a->name.len == b->name.len
            && libc.memcmp((const void*)a->name.ptr, (const void*)b->name.ptr, a->name.len) == 0;
    }
    return false;
}

// Effective type for assignment/comparison: typedefs expand to their base;
// distincts stay opaque (only identical distincts match).
CType* effective(CType* t)
{
    if (t == null) return null;
    if (t->kind == TY_NAMED && t->decl != null && t->decl->kind == ast.DT_TYPEDEF)
        return effective(t->elem);
    return t;
}

// Reverse typedef expansion for display purposes.
str.strView typeName(CType* t)
{
    if (t == null) return str.strView::fromCstr("?");
    if (t->kind == TY_UNKNOWN) return str.strView::fromCstr("?");
    if (t->kind == TY_NAMED && t->name.len > 0) return t->name;
    if (t->kind == TY_INT)
    {
        if (t->width == 8) return t->isSigned ? str.strView::fromCstr("i8") : str.strView::fromCstr("u8");
        if (t->width == 16) return t->isSigned ? str.strView::fromCstr("i16") : str.strView::fromCstr("u16");
        if (t->width == 32) return t->isSigned ? str.strView::fromCstr("i32") : str.strView::fromCstr("u32");
        return t->isSigned ? str.strView::fromCstr("i64") : str.strView::fromCstr("u64");
    }
    return str.strView::fromCstr("?");
}

// Parse the numeric body of an integer literal (no suffix) into u64,
// marking whether the value is negative (leading minus handled by EX_UNARY).
// Returns true on success; `neg` means the value was written as `-x`.
bool parseUIntBody(str.strView s, u64* out)
{
    if (s.len == 0) return false;
    u64 v = 0;
    bool hex = false;
    if (s.len > 2 && s.ptr[0] == '0' && (s.ptr[1] == 'x' || s.ptr[1] == 'X')) hex = true;
    u32 i = hex ? 2 : 0;
    while (i < s.len)
    {
        u8 c = (u8)s.ptr[i];
        u32 d = 0;
        if (c >= '0' && c <= '9') d = c - '0';
        else if (hex && c >= 'a' && c <= 'f') d = 10 + (c - 'a');
        else if (hex && c >= 'A' && c <= 'F') d = 10 + (c - 'A');
        else return false;
        v = v * (hex ? 16u : 10u) + d;
        i++;
    }
    *out = v;
    return true;
}

// Parse an integer literal Expr into a magnitude + literal-signedness.
// Returns false if it cannot be treated as a plain integer literal.
// Handles decimal/hex bodies and a trailing u/l/ul suffix.
bool literalIntInfo(str.strView text, u64* mag, bool* litSigned, u32* forcedWidth)
{
    *mag = 0;
    *litSigned = true;
    *forcedWidth = 0;
    if (text.len == 0) return false;
    // peel suffix
    u32 n = text.len;
    u32 suf = 0; // 0 none, 1 u, 2 l, 3 ul
    bool singleLit = false;
    if (n >= 1)
    {
        u8 last = (u8)text.ptr[n - 1];
        if (last == 'u' || last == 'U')
        {
            n--;
            suf = 1;
            singleLit = true;
        }
        else if (last == 'l' || last == 'L')
        {
            n--;
            suf = 2;
            singleLit = true;
        }
    }
    if (n >= 1 && singleLit)
    {
        u8 last = (u8)text.ptr[n - 1];
        if (last == 'l' || last == 'L')
        {
            n--;
            if (suf == 1) suf = 3;
        }
    }
    str.strView body = str.strView::fromParts(text.ptr, n);
    if (!parseUIntBody(body, mag)) return false;
    if (suf == 1) *forcedWidth = 32;
    else if (suf == 2) *forcedWidth = 64;
    else if (suf == 3) { *forcedWidth = 64; *litSigned = false; }
    return true;
}

// Type of a bare integer literal in untyped context (no annotation):
// default i32, widen by value fit; suffix forces a concrete width.
CType* literalIntDefaultType(str.strView text)
{
    CType* t = mman.alloc<CType>(1);
    t->kind = TY_INT;
    t->width = 32;
    t->isSigned = true;
    u64 mag = 0;
    bool neg = false;
    u32 fw = 0;
    if (literalIntInfo(text, &mag, &neg, &fw))
    {
        if (fw == 0)
        {
            if (intFits(true, mag, 32, neg)) { t->width = 32; t->isSigned = true; }
            else if (intFits(false, mag, 32, false)) { t->width = 32; t->isSigned = false; }
            else if (intFits(true, mag, 64, neg)) { t->width = 64; t->isSigned = true; }
            else { t->width = 64; t->isSigned = false; }
        }
        else
        {
            t->width = fw;
            t->isSigned = !neg; // u suffix => unsigned
        }
    }
    return t;
}

bool fitsType(TY_INT, u32 width, bool isSigned, str.strView text, u64* magOut, bool* litSignedOut)
{
    u64 mag = 0;
    bool neg = true;
    u32 fw = 0;
    if (!literalIntInfo(text, &mag, &neg, &fw)) return false;
    if (magOut != null) *magOut = mag;
    if (litSignedOut != null) *litSignedOut = neg;
    if (!intFits(isSigned, mag, width, neg)) return false;
    return true;
}

str.strView TEXT_NULL = str.strView::fromCstr("null");
str.strView TEXT_TRUE = str.strView::fromCstr("true");
str.strView TEXT_FALSE = str.strView::fromCstr("false");