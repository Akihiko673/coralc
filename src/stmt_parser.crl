// Self-host statement/declaration parser: LALR(1) tables generated at
// startup from a statement-level grammar, driven over lexer tokens to
// build the ast.Stmt / ast.Decl tree. Expressions are embedded at ES
// slots: each ES is an epsilon nonterminal whose reduction the driver
// intercepts to run expr_parser.parseFrom over the token stream, with
// stop tokens = the terminals that end the slot.
//
// The statement grammar is pure LALR(1) around the ES slots. One context
// needs a two-token lookahead, the classic typedef-name ambiguity (x = 5;
// vs Type x;): in states that both carry an ES slot and shift an IDENT
// into a type, the driver peeks the next token; if it cannot continue a
// type the IDENT starts an expression instead (the lexer-hack equivalent
// for table-driven C parsers).

mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod tok = import("token");
mod ast = import("ast/ast.crl");
mod lalr = import("lalr");
mod exprP = import("expr_parser");
mod res = import("std/data/result.crl");
mod libc = import("std/platform/libc.crl");

// reduce actions
const u32 AC_PASS = 0;
const u32 AC_NONE = 1;          // push null
const u32 AC_PROG = 2;          // PROG -> DECLS
const u32 AC_L1 = 3;            // build 1-elem SList
const u32 AC_APP = 4;           // append item to SList
const u32 AC_PREF0 = 5;         // PREF -> eps (flags = 0)
const u32 AC_PUB = 6;           // PREF -> PREF pub
const u32 AC_STATIC = 7;        // PREF -> PREF static
const u32 AC_INLINE = 8;        // PREF -> PREF inline
const u32 AC_CONSTMOD = 9;      // PREF -> PREF const
const u32 AC_TBASE = 10;        // TBASE -> TYPEKW | IDENT
const u32 AC_TDOT = 11;         // TBASE -> TBASE . IDENT
const u32 AC_TSTAR = 12;        // TYPE -> TYPE *
const u32 AC_TARR = 13;         // TYPE -> TYPE [ ES ]
const u32 AC_TGEN = 14;         // TYPE -> TBASE < TYPES >
const u32 AC_PARAM = 15;        // PARAM -> PREF TYPE IDENT?
const u32 AC_PARAMS1 = 16;      // PARAMS -> PARAM REST
const u32 AC_RESTAPP = 17;      // REST -> , PARAM REST
const u32 AC_VARARG = 18;       // REST -> , ...
const u32 AC_BLOCK = 19;        // BLOCK -> { STMTS }
const u32 AC_EXPR = 20;         // EXPR -> ES ;
const u32 AC_VARDECL = 21;      // VARDECL -> TYPE IDENT VARREST ;
const u32 AC_VRINIT = 22;       // VARREST -> = ES
const u32 AC_VRARR = 23;        // VARREST -> [ ES ]
const u32 AC_VRBOTH = 24;       // VARREST -> [ ES ] = ES
const u32 AC_VRNAMES = 25;      // VARREST -> , IDENTS
const u32 AC_CONSTD = 26;       // const decl
const u32 AC_CONSTS = 27;       // const stmt
const u32 AC_RETURN0 = 28;      // RETURN -> return ;
const u32 AC_RETURN = 29;       // RETURN -> return ES ;
const u32 AC_IF = 30;
const u32 AC_WHILE = 31;
const u32 AC_FOR = 32;
const u32 AC_VARFOR = 33;       // FORINIT -> var IDENT = ES
const u32 AC_VARFORIN = 34;     // FORINIT -> var IDENT : ES
const u32 AC_VARFOR2 = 35;      // FORINIT -> TYPE IDENT = ES
const u32 AC_SWITCH = 36;
const u32 AC_SWCASE = 37;       // CASEV -> case ES : STMTS
const u32 AC_SWDEF = 38;        // SWSECTION -> default : STMTS
const u32 AC_FLAGSTMT = 39;
const u32 AC_FLAGDECL = 40;
const u32 AC_FCASEC = 41;       // FCASE -> IDENT : DECLS
const u32 AC_FCASED = 42;       // FLAGSECTION -> default : DECLS
const u32 AC_FUNC = 43;
const u32 AC_EXTERN_F = 44;
const u32 AC_EXTERN_V = 45;
const u32 AC_BREAK = 46;
const u32 AC_CONT = 47;
const u32 AC_FORINIT = 48;      // FORINIT -> ES_SEMI (wraps expr in ST_EXPR)
const u32 AC_LDECLS = 49;       // DECLS -> e (EMPTY K_DECL list, no slot read)
const u32 AC_ES_SEMI = 50;      // stops { ';' }
const u32 AC_ES_RPAR = 51;      // stops { ')' }
const u32 AC_ES_RBKT = 52;      // stops { ']' }
const u32 AC_ES_COLON = 53;     // stops { ':' }
const u32 AC_ES_BOTH = 54;      // stops { ';' ')' }
const u32 AC_VRAW = 60;         // VARDECL -> TYPE IDENT VARREST ; (raw parts)
const u32 AC_WRAPV = 61;        // STMT -> VARDECL (VRaw -> Stmt)
const u32 AC_MKVD = 62;         // DECL -> VARDECL (VRaw -> DT_VAR Decl)
const u32 AC_MKVDP = 63;        // DECL -> PREF VARDECL (flags + VRaw)
const u32 AC_FUNCP = 64;        // FUNC -> PREF TYPE IDENT ( PARAMS ) ;
const u32 AC_FUNC0 = 65;        // FUNC0 -> TYPE IDENT ( PARAMS ) BLOCK
const u32 AC_FUNCP0 = 66;       // FUNC0 -> TYPE IDENT ( PARAMS ) ;
const u32 AC_CONST0 = 67;       // CONST0 -> const IDENT = ES ;
const u32 AC_EXTERN_V0 = 68;    // EXT0 -> extern TYPE IDENT ;
const u32 AC_LSTMT = 55;        // STMTS -> e (EMPTY K_STMT list)
const u32 AC_LSW = 56;          // SWBODY -> e (EMPTY K_STMT list)
const u32 AC_LFLAG = 57;        // FLAGBODY -> e (EMPTY K_DECL list)
const u32 AC_LIDENT = 58;       // IDENTS -> e (EMPTY K_VIEW list)
const u32 AC_RAPP = 59;         // STMTS/SWBODY/FLAGBODY -> item list (right-rec)
const u32 AC_LPARAMS = 69;      // PARAMS -> e (EMPTY PList)
const u32 AC_ES_RCURLY = 70;    // stops { ',' '}' }
const u32 AC_FORIN = 71;        // FOR -> for ( FORINIT ) STMT (range-for)
const u32 AC_VRBOTHL = 72;      // VARREST -> [ ES_RBKT ] = { ES_RCURLY INLIST }
const u32 AC_LIN = 73;          // INLIST -> e (EMPTY K_EXPR list)
const u32 AC_INAPP = 74;        // INLIST -> , ES_RCURLY INLIST
const u32 AC_MODULE = 75;       // MODULE -> ATTRS mod IDENT = import ( STR ) ;
const u32 AC_STRUCT = 76;       // STRUCT -> ATTRS PREF struct IDENT { SBLOCK }
const u32 AC_STRUCTG = 77;      // STRUCT -> ATTRS PREF struct IDENT < TYPES > { SBLOCK }
const u32 AC_ENUM = 78;         // ENUM -> ATTRS enum IDENT { EVARIANTS }
const u32 AC_SFIELD = 79;       // SFIELD -> PREF TYPE IDENT ( ; | [ ES_RBKT ] ; )
const u32 AC_LSBLOCK = 80;      // SBLOCK -> e (EMPTY K_SITEM list)
const u32 AC_SITEMW = 81;       // SITEM -> SMETHOD
const u32 AC_SITEMW0 = 82;      // SITEM -> SMETHOD0
const u32 AC_EXTERN_FB = 83;    // EXTB -> extern ( STR ) ATTRS TYPE IDENT ( PARAMS ) BLOCK
const u32 AC_FUNC0G = 84;       // FUNC0 -> TYPE IDENT !< TYPES > ( PARAMS ) BLOCK
const u32 AC_FUNCP0G = 85;      // FUNC0 -> TYPE IDENT !< TYPES > ( PARAMS ) ;
const u32 AC_FUNCG = 86;        // FUNC -> PREF TYPE IDENT !< TYPES > ( PARAMS ) BLOCK
const u32 AC_FUNCPG = 87;       // FUNC -> PREF TYPE IDENT !< TYPES > ( PARAMS ) ;
const u32 AC_TGEN2 = 88;        // TYPE -> TBASE < TYPES , TCONSTS >
const u32 AC_TGEN3 = 89;        // TYPE -> TBASE < TCONSTS >
const u32 AC_CONSTINT = 90;     // TCONSTS -> INT (const-expr entry)
const u32 AC_CONSTAPP = 91;     // TCONSTS -> TCONSTS , INT

// nonterminal indices
const u32 N_PROG = 0;
const u32 N_DECLS = 1;
const u32 N_DECL = 2;
const u32 N_FUNC = 3;
const u32 N_PREF = 4;
const u32 N_TYPE = 5;
const u32 N_TBASE = 6;
const u32 N_TYPES = 7;
const u32 N_PARAMS = 8;
const u32 N_PARAM = 9;
const u32 N_REST = 10;
const u32 N_BLOCK = 11;
const u32 N_STMTS = 12;
const u32 N_STMT = 13;
const u32 N_EXPR = 14;
const u32 N_RETURN = 15;
const u32 N_IF = 16;
const u32 N_ELSE = 17;
const u32 N_WHILE = 18;
const u32 N_FOR = 19;
const u32 N_FORINIT = 20;
const u32 N_SWITCH = 21;
const u32 N_SWBODY = 22;
const u32 N_SWSECTION = 23;
const u32 N_CASEV = 24;
const u32 N_FLAGSTMT = 25;
const u32 N_FLAGDECL = 26;
const u32 N_FLAGBODY = 27;
const u32 N_FLAGSECTION = 28;
const u32 N_FCASE = 29;
const u32 N_CONSTD = 30;
const u32 N_CONSTS = 31;
const u32 N_VARDECL = 32;
const u32 N_VARREST = 33;
const u32 N_IDENTS = 34;
const u32 N_ATTRS = 35;
const u32 N_EXT = 36;
const u32 N_BREAK = 37;
const u32 N_CONT = 38;
const u32 N_ES_SEMI = 39;
const u32 N_ES_RPAR = 40;
const u32 N_ES_RBKT = 41;
const u32 N_ES_COLON = 42;
const u32 N_ES_BOTH = 43;
const u32 N_TYPEKW = 44;
const u32 N_FUNC0 = 45;
const u32 N_CONST0 = 46;
const u32 N_AUG = 47;
const u32 N_ES_RCURLY = 48;
const u32 N_INLIST = 49;
const u32 N_MODULE = 50;    // mod IDENT = import ( STR ) ;
const u32 N_STRUCT = 51;    // struct IDENT { SBLOCK }
const u32 N_ENUM = 52;      // enum IDENT { EVARIANTS }
const u32 N_SBLOCK = 53;    // struct member block
const u32 N_SITEM = 54;     // struct member
const u32 N_SFIELD = 55;    // struct field decl
const u32 N_SMETHOD = 56;   // struct method decl
const u32 N_SMETHOD0 = 57;  // struct method decl (no generics)
const u32 N_EVARIANTS = 58; // enum variant list
const u32 N_EXTB = 59;      // extern-with-body decl
const u32 N_CSEBODY = 60;   // flag case body: DECL list (distinct from DECLS
                            // so its epsilon lookahead is not polluted by the
                            // right-recursive DECLS list states)
const u32 N_TCONSTS = 61;   // trailing const-expr args of TYPES (<u64, 3>)
const u32 N_COUNT = 62;

// precedence levels (higher wins)
const u32 PREC_ES = 1;      // ES / ATTRS epsilon productions
const u32 PREC_PREF = 3;    // PREF epsilon: must beat type-keyword/IDENT
                            // shifts so function/param decls always push PREF
const u32 PREC_DECLS = 3;   // DECLS epsilon beats an IDENT shift (flag cases)
const u32 PREC_IDENT = 2;   // shift IDENT beats epsilon reductions
const u32 PREC_TYPEKW = 4;  // type-keyword shifts beat PREF/DECLS epsilons so
                            // case bodies etc. start their decl directly
const u32 PREC_SEMI = 2;    // 'return ;' shifts (empty return)
const u32 PREC_DEFAULT = 4; // 'default :' shifts over DECLS epsilon
const u32 PREC_CSEBODY = 4; // case-body epsilon beats PREF epsilon so a next
                            // case label (IDENT) ends the body instead of
                            // continuing a DECL

const u32 FLAG_PUB = 1;
const u32 FLAG_STATIC = 2;
const u32 FLAG_INLINE = 4;

const u32 STKMAX = 256;

str.strView TYPEKWS[] = {
    "u8", "u16", "u32", "u64", "i8", "i16", "i32",
    "i64", "f32", "f64", "bool", "char", "void",
    "isize", "usize"
};

str.strView ATTRTOKS[] = {
    "@[forced_unsafe_cast]", "@[forced_null_deref]", "@[no_warn_unsafe]",
    "@[forced_pointer]", "@no_null", "@[noret]", "@reorder", "@packed"
};

// semantic slot kinds (for cleanup on failed parses)
const u32 K_NULL = 0;
const u32 K_INT = 1;
const u32 K_EXPR = 2;
const u32 K_TYPE = 3;
const u32 K_STMT = 4;
const u32 K_DECL = 5;
const u32 K_LIST = 6;       // SList*
const u32 K_PLIST = 7;      // PList*
const u32 K_CASE = 8;       // StmtCase*
const u32 K_FCASE = 9;      // FCase*
const u32 K_VIEW = 10;      // str.strView*
const u32 K_PARAM = 11;     // ast.Param*
const u32 K_VRES = 12;      // VRes*
const u32 K_PROG = 13;      // ast.Program*
const u32 K_VRAW = 14;      // VRaw* (raw var-decl parts)
const u32 K_SITEM = 15;     // SItem* (struct member)

pub struct SList
{
    u64* a;
    u32 n;
    u32 cap;
    u8 itemKind;
}

pub struct PList
{
    u64* a;
    u32 n;
    u32 cap;
    bool variadic;
}

pub struct VRes
{
    u64 init;   // Expr* or 0
    u64 arr;    // Expr* or 0
    u64 names;  // SList* of strView* or 0
}

pub struct VRaw
{
    u64 type;   // TypeExpr*
    u64 name;   // strView*
    u64 init;   // Expr* or 0
    u64 arr;    // Expr* or 0
    u64 names;  // SList* of strView* or 0
}

pub struct FCase
{
    u64 name;   // strView*
    u64 decls;  // SList* of Decl*
}

pub struct SItem
{
    bool isMethod;
    u64 v;      // ast.Decl* (method) or ast.StructField* (field)
}

SList* listNew(u8 itemKind)
{
    SList* l = mman.alloc<SList>(1);
    l->a = null;
    l->n = 0;
    l->cap = 0;
    l->itemKind = itemKind;
    return l;
}

void listAppend(SList* l, u64 v)
{
    if (l->n >= l->cap)
    {
        u32 nc = l->cap ? l->cap * 2 : 8;
        u64* na = mman.alloc<u64>(nc);
        for (u32 i = 0; i < l->n; i++) na[i] = l->a[i];
        if (l->a) mman.dealloc<u64>(l->a);
        l->a = na;
        l->cap = nc;
    }
    l->a[l->n++] = v;
}

PList* plistNew()
{
    PList* l = mman.alloc<PList>(1);
    l->a = null;
    l->n = 0;
    l->cap = 0;
    l->variadic = false;
    return l;
}

void plistAppend(PList* l, u64 v)
{
    if (l->n >= l->cap)
    {
        u32 nc = l->cap ? l->cap * 2 : 8;
        u64* na = mman.alloc<u64>(nc);
        for (u32 i = 0; i < l->n; i++) na[i] = l->a[i];
        if (l->a) mman.dealloc<u64>(l->a);
        l->a = na;
        l->cap = nc;
    }
    l->a[l->n++] = v;
}

u32 esStops(u32 es, u32* st)
{
    if (es == AC_ES_SEMI) { st[0] = tok.terminalId(str.strView::fromCstr(";")); return 1; }
    if (es == AC_ES_RPAR) { st[0] = tok.terminalId(str.strView::fromCstr(")")); return 1; }
    if (es == AC_ES_RBKT) { st[0] = tok.terminalId(str.strView::fromCstr("]")); return 1; }
    if (es == AC_ES_COLON) { st[0] = tok.terminalId(str.strView::fromCstr(":")); return 1; }
    if (es == AC_ES_RCURLY)
    {
        st[0] = tok.terminalId(str.strView::fromCstr(","));
        st[1] = tok.terminalId(str.strView::fromCstr("}"));
        return 2;
    }
    st[0] = tok.terminalId(str.strView::fromCstr(";"));
    st[1] = tok.terminalId(str.strView::fromCstr(")"));
    return 2;
}

u32 esNonterm(u32 es)
{
    if (es == AC_ES_SEMI) return N_ES_SEMI;
    if (es == AC_ES_RPAR) return N_ES_RPAR;
    if (es == AC_ES_RBKT) return N_ES_RBKT;
    if (es == AC_ES_COLON) return N_ES_COLON;
    if (es == AC_ES_RCURLY) return N_ES_RCURLY;
    return N_ES_BOTH;
}

bool inStops(u32 tid, const u32* stops, u32 nstops)
{
    for (u32 i = 0; i < nstops; i++)
        if (stops[i] == tid) return true;
    return false;
}

u32 termId(u8* s) { return tok.terminalId(str.strView::fromCstr((const char*)s)); }

void addProd(lalr.Grammar* g, u32 i, u32 head, u32 n, const u32* rhs,
             u32 prec, u32 assoc, u32 action)
{
    lalr.Prod* p = &g->prods[i];
    p->head = head;
    p->nrhs = n;
    p->prec = prec;
    p->assoc = assoc;
    p->action = action;
    p->rhs = mman.alloc<u32>(n);
    for (u32 k = 0; k < n; k++) p->rhs[k] = rhs[k];
}

lalr.Grammar stmtGrammar()
{
    lalr.Grammar g;
    g.nterms = tok.TOK_ANON_FIRST + tok.NUM_ANON;
    g.nnonterms = N_COUNT;
    g.prods = mman.alloc<lalr.Prod>(256);
    g.start = lalr.NT_BASE + N_PROG;
    g.termPrec = mman.alloc<u32>(g.nterms);
    for (u32 i = 0; i < g.nterms; i++) g.termPrec[i] = 0;

    for (u32 k = 0; k < 15; k++)
        g.termPrec[termId((u8*)TYPEKWS[k].ptr)] = PREC_TYPEKW;
    for (u32 k = 0; k < 8; k++)
        g.termPrec[termId((u8*)ATTRTOKS[k].ptr)] = PREC_ES + 1;
    g.termPrec[termId((u8*)"{")] = PREC_ES + 1;
    g.termPrec[tok.TOK_IDENT] = PREC_IDENT;
    g.termPrec[termId((u8*)"default")] = PREC_DEFAULT;
    g.termPrec[termId((u8*)";")] = PREC_SEMI;
    g.termPrec[termId((u8*)"const")] = PREC_PREF;

    u32 i = 0;
    u32 r1[1];
    u32 r2[2];
    u32 r3[3];
    u32 r4[4];
    u32 r5[5];
    u32 r6[8];
    u32 r7[7];
    u32 r8[9];
    u32 r9[10];
    u32 r10[10];
    u32 r11[11];

    r1[0] = lalr.NT_BASE + N_PROG;
    addProd(&g, i++, lalr.NT_BASE + N_AUG, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_DECLS;
    addProd(&g, i++, lalr.NT_BASE + N_PROG, 1, r1, 0, 0, AC_PROG);
    addProd(&g, i++, lalr.NT_BASE + N_DECLS, 0, null, PREC_DECLS, 0, AC_LDECLS);
    r2[0] = lalr.NT_BASE + N_DECLS; r2[1] = lalr.NT_BASE + N_DECL;
    addProd(&g, i++, lalr.NT_BASE + N_DECLS, 2, r2, 0, 0, AC_APP);
    r1[0] = lalr.NT_BASE + N_FUNC;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_FUNC0;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_EXT;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_CONSTD;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_CONST0;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_FLAGDECL;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_VARDECL;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_MKVD);
    r2[0] = lalr.NT_BASE + N_PREF; r2[1] = lalr.NT_BASE + N_VARDECL;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 2, r2, 0, 0, AC_MKVDP);
    r1[0] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_NONE);
    r1[0] = lalr.NT_BASE + N_MODULE;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_STRUCT;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_ENUM;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);
    r1[0] = lalr.NT_BASE + N_EXTB;
    addProd(&g, i++, lalr.NT_BASE + N_DECL, 1, r1, 0, 0, AC_PASS);

    r7[0] = lalr.NT_BASE + N_PREF;
    r7[1] = lalr.NT_BASE + N_TYPE;
    r7[2] = tok.TOK_IDENT;
    r7[3] = termId((u8*)"(");
    r7[4] = lalr.NT_BASE + N_PARAMS;
    r7[5] = termId((u8*)")");
    r7[6] = lalr.NT_BASE + N_BLOCK;
    addProd(&g, i++, lalr.NT_BASE + N_FUNC, 7, r7, 0, 0, AC_FUNC);
    r7[6] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_FUNC, 7, r7, 0, 0, AC_FUNCP);
    r9[0] = lalr.NT_BASE + N_PREF;
    r9[1] = lalr.NT_BASE + N_TYPE;
    r9[2] = tok.TOK_IDENT;
    r9[3] = termId((u8*)"!<");
    r9[4] = lalr.NT_BASE + N_TYPES;
    r9[5] = termId((u8*)">");
    r9[6] = termId((u8*)"(");
    r9[7] = lalr.NT_BASE + N_PARAMS;
    r9[8] = termId((u8*)")");
    r9[9] = lalr.NT_BASE + N_BLOCK;
    addProd(&g, i++, lalr.NT_BASE + N_FUNC, 10, r9, 0, 0, AC_FUNCG);
    r9[9] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_FUNC, 10, r9, 0, 0, AC_FUNCPG);
    r6[0] = lalr.NT_BASE + N_TYPE;
    r6[1] = tok.TOK_IDENT;
    r6[2] = termId((u8*)"(");
    r6[3] = lalr.NT_BASE + N_PARAMS;
    r6[4] = termId((u8*)")");
    r6[5] = lalr.NT_BASE + N_BLOCK;
    addProd(&g, i++, lalr.NT_BASE + N_FUNC0, 6, r6, 0, 0, AC_FUNC0);
    r6[5] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_FUNC0, 6, r6, 0, 0, AC_FUNCP0);
    r8[0] = lalr.NT_BASE + N_TYPE;
    r8[1] = tok.TOK_IDENT;
    r8[2] = termId((u8*)"!<");
    r8[3] = lalr.NT_BASE + N_TYPES;
    r8[4] = termId((u8*)">");
    r8[5] = termId((u8*)"(");
    r8[6] = lalr.NT_BASE + N_PARAMS;
    r8[7] = termId((u8*)")");
    r8[8] = lalr.NT_BASE + N_BLOCK;
    addProd(&g, i++, lalr.NT_BASE + N_FUNC0, 9, r8, 0, 0, AC_FUNC0G);
    r8[8] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_FUNC0, 9, r8, 0, 0, AC_FUNCP0G);
    addProd(&g, i++, lalr.NT_BASE + N_PREF, 0, null, PREC_PREF, lalr.ASSOC_RIGHT, AC_PREF0);
