            d->ndecls = 0;
            d->cases = null;
            d->caseNames = null;
            d->caseLens = null;
            d->ncases = 0;
            d->defaultBody = null;
            d->ndeclDefault = 0;
            d->line = line;
            d->col = col;
            self.freeView((u64)s);
            self.freeView((u64)ccs);
            self.push((u64)d, K_DECL);
            return;
        }
        case AC_EXTERN_V:
        {
            str.strView* ccs = (str.strView*)(u64)self.sem[base + 2];
            ast.TypeExpr* ty = (ast.TypeExpr*)(u64)self.sem[base + 5];
            str.strView* s = (str.strView*)(u64)self.sem[base + 6];
            ast.Decl* d = mman.alloc<ast.Decl>(1);
            d->kind = ast.DT_EXTERN;
            d->name = *s;
            d->text = str.strView::empty();
            d->type = ty;
            d->value = null;
            d->exported = false;
            d->isStatic = false;
            d->isInline = false;
            d->isExtern = true;
            d->noreturn = false;
            d->isVar = true;
            d->cc = *ccs;
            d->structName = str.strView::empty();
            d->traitName = str.strView::empty();
            d->generics = null;
            d->ngenerics = 0;
            d->fields = null;
            d->nfields = 0;
            d->variants = null;
            d->nvariants = 0;
            d->params = null;
            d->nparams = 0;
            d->variadic = false;
            d->body = null;
            d->decls = null;
            d->ndecls = 0;
            d->cases = null;
            d->caseNames = null;
            d->caseLens = null;
            d->ncases = 0;
            d->defaultBody = null;
            d->ndeclDefault = 0;
            d->line = line;
            d->col = col;
            self.freeView((u64)s);
            self.freeView((u64)ccs);
            self.push((u64)d, K_DECL);
            return;
        }
        case AC_EXTERN_V0:
        {
            ast.TypeExpr* ty = (ast.TypeExpr*)(u64)self.sem[base + 1];
            str.strView* s = (str.strView*)(u64)self.sem[base + 2];
            ast.Decl* d = mman.alloc<ast.Decl>(1);
            d->kind = ast.DT_EXTERN;
            d->name = *s;
            d->text = str.strView::empty();
            d->type = ty;
            d->value = null;
            d->exported = false;
            d->isStatic = false;
            d->isInline = false;
            d->isExtern = true;
            d->noreturn = false;
            d->isVar = true;
            d->cc = str.strView::empty();
            d->structName = str.strView::empty();
            d->traitName = str.strView::empty();
            d->generics = null;
            d->ngenerics = 0;
            d->fields = null;
            d->nfields = 0;
            d->variants = null;
            d->nvariants = 0;
            d->params = null;
            d->nparams = 0;
            d->variadic = false;
            d->body = null;
            d->decls = null;
            d->ndecls = 0;
            d->cases = null;
            d->caseNames = null;
            d->caseLens = null;
            d->ncases = 0;
            d->defaultBody = null;
            d->ndeclDefault = 0;
            d->line = line;
            d->col = col;
            self.freeView((u64)s);
            self.push((u64)d, K_DECL);
            return;
        }
        case AC_BREAK:
        {
            ast.Stmt* s = mman.alloc<ast.Stmt>(1);
            s->kind = ast.ST_BREAK;
            s->text = str.strView::empty();
            s->type = null;
            s->a = null;
            s->b = null;
            s->c = null;
            s->body = null;
            s->body2 = null;
            s->init = null;
            s->stmts = null;
            s->nstmts = 0;
            s->cases = null;
            s->ncases = 0;
            s->defaultCase = null;
            s->line = line;
            s->col = col;
            self.push((u64)s, K_STMT);
            return;
        }
        case AC_CONT:
        {
            ast.Stmt* s = mman.alloc<ast.Stmt>(1);
            s->kind = ast.ST_CONTINUE;
            s->text = str.strView::empty();
            s->type = null;
            s->a = null;
            s->b = null;
            s->c = null;
            s->body = null;
            s->body2 = null;
            s->init = null;
            s->stmts = null;
            s->nstmts = 0;
            s->cases = null;
            s->ncases = 0;
            s->defaultCase = null;
            s->line = line;
            s->col = col;
            self.push((u64)s, K_STMT);
            return;
        }
        case AC_PROG:
        {
            SList* l = (SList*)(u64)self.sem[base];
            u32 nn = 0;
            for (u32 k = 0; k < l->n; k++)
                if (l->a[k]) nn++;
            ast.Program* pr = mman.alloc<ast.Program>(1);
            pr->decls = mman.alloc<ast.Decl*>(nn);
            pr->ndecls = nn;
            u32 j = 0;
            for (u32 k = 0; k < l->n; k++)
                if (l->a[k]) pr->decls[j++] = (ast.Decl*)(u64)l->a[k];
            if (l->a) mman.dealloc<u64>(l->a);
            mman.dealloc<SList>(l);
            pr->filename = str.strView::empty();
            self.push((u64)pr, K_PROG);
            return;
        }

        case AC_LSBLOCK:
            self.push((u64)listNew(K_SITEM), K_LIST);
            return;
        case AC_SITEMW:
        {
            SItem* it = mman.alloc<SItem>(1);
            it->isMethod = true;
            it->v = self.sem[base];
            self.push((u64)it, K_SITEM);
            return;
        }
        case AC_SITEMW0:
        {
            SItem* it = mman.alloc<SItem>(1);
            it->isMethod = true;
            it->v = self.sem[base];
            self.push((u64)it, K_SITEM);
            return;
        }
        case AC_SFIELD:
        {
            ast.TypeExpr* ty = (ast.TypeExpr*)(u64)self.sem[base];
            str.strView* s = (str.strView*)(u64)self.sem[base + 1];
            ast.StructField* f = mman.alloc<ast.StructField>(1);
            f->name = *s;
            if (n == 6)
            {
                ast.TypeExpr* p = mman.alloc<ast.TypeExpr>(1);
                p->kind = ast.TYP_ARRAY;
                p->elem = ty;
                p->count = (ast.Expr*)(u64)self.sem[base + 3];
                p->name.ptr = null;
                p->name.len = 0;
                p->args = null;
                p->nargs = 0;
                p->cargs = null;
                p->ncargs = 0;
                p->ret = null;
                p->isConst = false;
                p->line = 0;
                p->col = 0;
                ty = p;
            }
            f->type = ty;
            self.freeView((u64)s);
            SItem* it = mman.alloc<SItem>(1);
            it->isMethod = false;
            it->v = (u64)f;
            self.push((u64)it, K_SITEM);
            return;
        }
        case AC_MODULE:
        {
            str.strView* s = (str.strView*)(u64)self.sem[base + 2];
            str.strView* p = (str.strView*)(u64)self.sem[base + 6];
            ast.Decl* d = mman.alloc<ast.Decl>(1);
            d->kind = ast.DT_MODULE;
            d->name = *s;
            d->text = *p;
            d->type = null;
            d->value = null;
            d->exported = false;
            d->isStatic = false;
            d->isInline = false;
            d->isExtern = false;
            d->noreturn = false;
            d->isVar = false;
            d->cc = str.strView::empty();
            d->structName = str.strView::empty();
            d->traitName = str.strView::empty();
            d->generics = null;
            d->ngenerics = 0;
            d->fields = null;
            d->nfields = 0;
            d->variants = null;
            d->nvariants = 0;
            d->params = null;
            d->nparams = 0;
            d->variadic = false;
            d->body = null;
            d->decls = null;
            d->ndecls = 0;
            d->cases = null;
            d->caseNames = null;
            d->caseLens = null;
            d->ncases = 0;
            d->defaultBody = null;
            d->ndeclDefault = 0;
            d->line = 0;
            d->col = 0;
            self.freeView((u64)s);
            self.freeView((u64)p);
            self.push((u64)d, K_DECL);
            return;
        }
        case AC_STRUCT:
        case AC_STRUCTG:
        {
            u32 flags = (u32)(u64)self.sem[base];
            str.strView* s = (str.strView*)(u64)self.sem[base + 3];
            SList* l = (SList*)(u64)self.sem[n == 7 ? 5 : 8];
            ast.Decl* d = mman.alloc<ast.Decl>(1);
            d->kind = ast.DT_STRUCT;
            d->name = *s;
            d->text = str.strView::empty();
            d->type = null;
            d->value = null;
            d->exported = (flags & FLAG_PUB) != 0;
            d->isStatic = false;
            d->isInline = false;
            d->isExtern = false;
            d->noreturn = false;
            d->isVar = false;
            d->cc = str.strView::empty();
            d->structName = str.strView::empty();
            d->traitName = str.strView::empty();
            d->generics = null;
            d->ngenerics = 0;
            d->fields = null;
            d->nfields = 0;
            d->variants = null;
            d->nvariants = 0;
            d->params = null;
            d->nparams = 0;
            d->variadic = false;
            d->body = null;
            d->decls = null;
            d->ndecls = 0;
            d->cases = null;
            d->caseNames = null;
            d->caseLens = null;
            d->ncases = 0;
            d->defaultBody = null;
            d->ndeclDefault = 0;
            d->line = 0;
            d->col = 0;
            if (n == 10)
            {
                SList* tl = (SList*)(u64)self.sem[base + 5];
                if (tl)
                {
                    if (tl->n > 0)
                    {
                        d->generics = mman.alloc<str.strView>(tl->n);
                        d->ngenerics = tl->n;
                        for (u32 k = 0; k < tl->n; k++)
                        {
                            ast.TypeExpr* t = (ast.TypeExpr*)(u64)tl->a[k];
                            d->generics[k] = t->name;
                            ast.freeType(t);
                        }
                    }
                    if (tl->a) mman.dealloc<u64>(tl->a);
                    mman.dealloc<SList>(tl);
                }
            }
            if (l)
            {
                u32 nf = 0;
                u32 nm = 0;
                for (u32 k = 0; k < l->n; k++)
                {
                    SItem* it = (SItem*)(u64)l->a[k];
                    if (!it) continue;
                    if (it->isMethod) nm++;
                    else nf++;
                }
                if (nf > 0)
                {
                    d->fields = mman.alloc<ast.StructField>(nf);
                    d->nfields = nf;
                    u32 j = 0;
                    for (u32 k = 0; k < l->n; k++)
                    {
                        SItem* it = (SItem*)(u64)l->a[k];
                        if (!it || it->isMethod) continue;
                        d->fields[j++] = *(ast.StructField*)(u64)it->v;
                        mman.dealloc<ast.StructField>((ast.StructField*)(u64)it->v);
                        mman.dealloc<SItem>(it);
                        l->a[k] = 0;
                    }
                }
                if (nm > 0)
                {
                    d->decls = mman.alloc<ast.Decl*>(nm);
                    d->ndecls = nm;
                    u32 j = 0;
                    for (u32 k = 0; k < l->n; k++)
                    {
                        SItem* it = (SItem*)(u64)l->a[k];
                        if (!it || !it->isMethod) continue;
                        ast.Decl* m = (ast.Decl*)(u64)it->v;
                        m->structName = d->name;
                        d->decls[j++] = m;
                        mman.dealloc<SItem>(it);
                        l->a[k] = 0;
                    }
                }
                for (u32 k = 0; k < l->n; k++)
                {
                    SItem* it = (SItem*)(u64)l->a[k];
                    if (!it) continue;
                    if (it->isMethod)
                        ast.freeDecl((ast.Decl*)(u64)it->v);
                    else
                    {
                        ast.freeType(((ast.StructField*)(u64)it->v)->type);
                        mman.dealloc<ast.StructField>((ast.StructField*)(u64)it->v);
                    }
                    mman.dealloc<SItem>(it);
                }
                if (l->a) mman.dealloc<u64>(l->a);
                mman.dealloc<SList>(l);
            }
            self.freeView((u64)s);
            self.push((u64)d, K_DECL);
            return;
        }
        case AC_ENUM:
        {
            str.strView* s = (str.strView*)(u64)self.sem[base + 2];
            SList* l = (SList*)(u64)self.sem[base + 4];
            ast.Decl* d = mman.alloc<ast.Decl>(1);
            d->kind = ast.DT_ENUM;
            d->name = *s;
            d->text = str.strView::empty();
            d->type = null;
            d->value = null;
            d->exported = false;
            d->isStatic = false;
            d->isInline = false;
            d->isExtern = false;
            d->noreturn = false;
            d->isVar = false;
            d->cc = str.strView::empty();
            d->structName = str.strView::empty();
            d->traitName = str.strView::empty();
            d->generics = null;
            d->ngenerics = 0;
            d->fields = null;
            d->nfields = 0;
            d->variants = null;
            d->nvariants = 0;
            d->params = null;
            d->nparams = 0;
            d->variadic = false;
            d->body = null;
            d->decls = null;
            d->ndecls = 0;
            d->cases = null;
            d->caseNames = null;
            d->caseLens = null;
            d->ncases = 0;
            d->defaultBody = null;
            d->ndeclDefault = 0;
            d->line = 0;
            d->col = 0;
            if (l && l->n > 0)
            {
                d->variants = mman.alloc<ast.EnumVariant>(l->n);
                d->nvariants = l->n;
                for (u32 k = 0; k < l->n; k++)
                {
                    str.strView* v = (str.strView*)(u64)l->a[k];
                    d->variants[k].name = *v;
                    d->variants[k].value = null;
                    mman.dealloc<str.strView>(v);
                }
                if (l->a) mman.dealloc<u64>(l->a);
                mman.dealloc<SList>(l);
            }
            self.freeView((u64)s);
            self.push((u64)d, K_DECL);
            return;
        }
        case AC_EXTERN_FB:
        {
            str.strView* ccs = (str.strView*)(u64)self.sem[base + 2];
            ast.TypeExpr* ty = (ast.TypeExpr*)(u64)self.sem[base + 5];
            str.strView* s = (str.strView*)(u64)self.sem[base + 6];
            PList* pl = (PList*)(u64)self.sem[base + 8];
            ast.Decl* d = mman.alloc<ast.Decl>(1);
            d->kind = ast.DT_FUNC;
            d->name = *s;
            d->text = str.strView::empty();
            d->type = ty;
            d->value = null;
            d->exported = false;
            d->isStatic = false;
            d->isInline = false;
            d->isExtern = true;
            d->noreturn = false;
            d->isVar = false;
            d->cc = *ccs;
            d->structName = str.strView::empty();
            d->traitName = str.strView::empty();
            d->generics = null;
            d->ngenerics = 0;
            d->fields = null;
            d->nfields = 0;
            d->variants = null;
            d->nvariants = 0;
            d->params = mman.alloc<ast.Param>(pl->n);
            d->nparams = pl->n;
            for (u32 k = 0; k < pl->n; k++)
                d->params[k] = *(ast.Param*)(u64)pl->a[k];
            d->variadic = pl->variadic;
            if (pl->a) mman.dealloc<u64>(pl->a);
            mman.dealloc<PList>(pl);
            d->body = (ast.Stmt*)(u64)self.sem[base + 10];
            d->decls = null;
            d->ndecls = 0;
            d->cases = null;
            d->caseNames = null;
            d->caseLens = null;
            d->ncases = 0;
            d->defaultBody = null;
            d->ndeclDefault = 0;
            d->line = line;
            d->col = col;
            self.freeView((u64)s);
            self.freeView((u64)ccs);
            self.push((u64)d, K_DECL);
            return;
        }
        default:
            self.push(0, K_NULL);
            return;
        }
    }

    ast.Program* parseProgram(u8* src, tok.LexTok* toks, u32 ntoks)
    {
        self.src = src;
        self.toks = toks;
        self.ntoks = ntoks;
        self.sp = 0;
        self.sv = 0;
        self.ip = 0;
        self.stk[0] = 0;
        while (true)
        {
            u32 state = self.stk[self.sp];
            u32 tid = self.ip < self.ntoks ? self.toks[self.ip].id : tok.TOK_EOF;
            lalr.Entry* en = &self.t.act[state * self.t.nterms + tid];
            u8 es = self.esType[state];
            if (self.trace)
            {
                u8 b[64];
                u32 bl = 0;
                libc.write(1, (u8*)"[", 1);
                self.num(b, &bl, self.ip);
                libc.write(1, b, bl);
                libc.write(1, (u8*)" st", 3);
                bl = 0;
                self.num(b, &bl, state);
                libc.write(1, b, bl);
                libc.write(1, (u8*)" t", 2);
                bl = 0;
                self.num(b, &bl, tid);
                libc.write(1, b, bl);
                libc.write(1, (u8*)" es", 3);
                bl = 0;
                self.num(b, &bl, (u32)es);
                libc.write(1, b, bl);
                libc.write(1, (u8*)" k", 2);
                bl = 0;
                self.num(b, &bl, en->kind);
                libc.write(1, b, bl);
                libc.write(1, (u8*)" a", 2);
                bl = 0;
                self.num(b, &bl, en->a);
                libc.write(1, b, bl);
                libc.write(1, (u8*)"\n", 1);
            }
            bool identOverride = en->kind == lalr.ACT_SHIFT && tid == tok.TOK_IDENT
                                 && es != 0xFF && !self.identContinuesType(self.ip);
            if (es != 0xFF && (en->kind == lalr.ACT_ERROR || identOverride))
            {
                u64 val = 0;
                if (!self.intercept(es, &val))
                {
                    self.errRow = self.toks[self.ip].row;
                    self.errCol = self.toks[self.ip].col;
                    self.errTid = self.toks[self.ip].id;
                    self.errState = state;
                    {
                        u8 bb[60];
                        u32 bbl = 0;
                        u32 ip0 = self.ip; self.num(bb, &bbl, ip0);
                        bb[bbl++] = ' '; self.num(bb, &bbl, self.toks[ip0].row);
                        bb[bbl++] = ':'; self.num(bb, &bbl, self.toks[ip0].col);
                        bb[bbl++] = ' ';
                        for (u32 zz = 0; zz < self.sp && zz < 6; zz++) { self.num(bb, &bbl, self.stk[self.sp - zz]); bb[bbl++] = ' '; }
                        bb[bbl++] = '\n';
                        libc.write(2, bb, bbl);
                    }
                    self.clearSem();
                    return null;
                }
                if (self.sp + 1 >= STKMAX || self.sv >= STKMAX)
                {
                    self.clearSem();
                    return null;
                }
                self.sem[self.sv] = val;
                self.skind[self.sv] = val ? K_EXPR : K_NULL;
                self.sline[self.sv] = self.ip < self.ntoks ? self.toks[self.ip].row : 0;
                self.scol[self.sv] = self.ip < self.ntoks ? self.toks[self.ip].col : 0;
                self.sv++;
                u32 go = self.t.gotos[state * self.t.nnonterms + esNonterm(es)];
                if (go == lalr.NO_STATE)
                {
                    self.clearSem();
                    return null;
                }
                self.sp++;
                self.stk[self.sp] = go;
                continue;
            }
            if (en->kind == lalr.ACT_SHIFT)
            {
                if (self.sp + 1 >= STKMAX || self.sv >= STKMAX)
                {
                    self.clearSem();
                    return null;
                }
                self.sp++;
                self.stk[self.sp] = en->a;
                self.sem[self.sv] = self.shiftVal(tid);
                self.sline[self.sv] = self.toks[self.ip].row;
                self.scol[self.sv] = self.toks[self.ip].col;
                self.sv++;
                self.ip++;
            }
            else if (en->kind == lalr.ACT_REDUCE)
            {
                lalr.Prod* pr = &self.g.prods[en->a];
                if (pr->action >= AC_ES_SEMI && pr->action <= AC_ES_BOTH)
                {
                    u64 val = 0;
                    if (!self.intercept(pr->action, &val))
                    {
                        self.clearSem();
                        return null;
                    }
                    if (self.sv >= STKMAX || self.sp + 1 >= STKMAX)
                    {
                        self.clearSem();
                        return null;
                    }
                    self.sem[self.sv] = val;
                    self.skind[self.sv] = val ? K_EXPR : K_NULL;
                    self.sline[self.sv] = self.ip < self.ntoks ? self.toks[self.ip].row : 0;
                    self.scol[self.sv] = self.ip < self.ntoks ? self.toks[self.ip].col : 0;
                    self.sv++;
                    u32 go = self.t.gotos[state * self.t.nnonterms + (pr->head - lalr.NT_BASE)];
                    if (go == lalr.NO_STATE)
                    {
                        self.clearSem();
                        return null;
                    }
                    self.sp++;
                    self.stk[self.sp] = go;
                }
                else
                {
                    if (pr->nrhs > self.sp)
                    {
                        self.clearSem();
                        return null;
                    }
                    self.sp -= pr->nrhs;
                    self.apply(pr, pr->nrhs);
                    if (self.sv == 0)
                    {
                        self.clearSem();
                        return null;
                    }
                    u32 top = self.stk[self.sp];
                    u32 headIdx = pr->head - lalr.NT_BASE;
                    if (headIdx >= self.t.nnonterms)
                    {
                        self.clearSem();
                        return null;
                    }
                    u32 go = self.t.gotos[top * self.t.nnonterms + headIdx];
                    if (go == lalr.NO_STATE)
                    {
                        self.clearSem();
                        return null;
                    }
                    self.sp++;
                    self.stk[self.sp] = go;
                }
            }
            else if (en->kind == lalr.ACT_ACCEPT)
            {
                if (self.ip == self.ntoks - 1 && self.sv == 1 &&
                    self.skind[self.sv - 1] == K_PROG)
                    return (ast.Program*)(u64)self.sem[0];
                self.clearSem();
                return null;
            }
            else
            {
                if (self.ip < self.ntoks)
                {
                    self.errRow = self.toks[self.ip].row;
                    self.errCol = self.toks[self.ip].col;
                    self.errTid = self.toks[self.ip].id;
                    self.errState = state;
                }
                self.clearSem();
                return null;
            }
        }
    }
}