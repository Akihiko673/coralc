    r11[9] = termId((u8*)")");
    r11[10] = lalr.NT_BASE + N_BLOCK;
    addProd(&g, i++, lalr.NT_BASE + N_EXTB, 11, r11, 0, 0, AC_EXTERN_FB);

    r2[0] = termId((u8*)"break");
    r2[1] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_BREAK, 2, r2, 0, 0, AC_BREAK);
    r2[0] = termId((u8*)"continue");
    r2[1] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_CONT, 2, r2, 0, 0, AC_CONT);

    addProd(&g, i++, lalr.NT_BASE + N_ES_SEMI, 0, null, PREC_ES, lalr.ASSOC_RIGHT, AC_ES_SEMI);
    addProd(&g, i++, lalr.NT_BASE + N_ES_RPAR, 0, null, PREC_ES, lalr.ASSOC_RIGHT, AC_ES_RPAR);
    addProd(&g, i++, lalr.NT_BASE + N_ES_RBKT, 0, null, PREC_ES, lalr.ASSOC_RIGHT, AC_ES_RBKT);
    addProd(&g, i++, lalr.NT_BASE + N_ES_COLON, 0, null, PREC_ES, lalr.ASSOC_RIGHT, AC_ES_COLON);
    addProd(&g, i++, lalr.NT_BASE + N_ES_BOTH, 0, null, PREC_ES, lalr.ASSOC_RIGHT, AC_ES_BOTH);
    addProd(&g, i++, lalr.NT_BASE + N_ES_RCURLY, 0, null, PREC_ES, lalr.ASSOC_RIGHT, AC_ES_RCURLY);
    r9[0] = lalr.NT_BASE + N_ATTRS;
    r9[1] = termId((u8*)"mod");
    r9[2] = tok.TOK_IDENT;
    r9[3] = termId((u8*)"=");
    r9[4] = termId((u8*)"import");
    r9[5] = termId((u8*)"(");
    r9[6] = tok.TOK_STR;
    r9[7] = termId((u8*)")");
    r9[8] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_MODULE, 9, r9, 0, 0, AC_MODULE);
    r7[0] = lalr.NT_BASE + N_PREF;
    r7[1] = lalr.NT_BASE + N_ATTRS;
    r7[2] = termId((u8*)"struct");
    r7[3] = tok.TOK_IDENT;
    r7[4] = termId((u8*)"{");
    r7[5] = lalr.NT_BASE + N_SBLOCK;
    r7[6] = termId((u8*)"}");
    addProd(&g, i++, lalr.NT_BASE + N_STRUCT, 7, r7, 0, 0, AC_STRUCT);
    r10[0] = lalr.NT_BASE + N_PREF;
    r10[1] = lalr.NT_BASE + N_ATTRS;
    r10[2] = termId((u8*)"struct");
    r10[3] = tok.TOK_IDENT;
    r10[4] = termId((u8*)"<");
    r10[5] = lalr.NT_BASE + N_TYPES;
    r10[6] = termId((u8*)">");
    r10[7] = termId((u8*)"{");
    r10[8] = lalr.NT_BASE + N_SBLOCK;
    r10[9] = termId((u8*)"}");
    addProd(&g, i++, lalr.NT_BASE + N_STRUCT, 10, r10, 0, 0, AC_STRUCTG);
    r6[0] = lalr.NT_BASE + N_PREF;
    r6[1] = lalr.NT_BASE + N_ATTRS;
    r6[2] = termId((u8*)"enum");
    r6[3] = tok.TOK_IDENT;
    r6[4] = termId((u8*)"{");
    r6[5] = lalr.NT_BASE + N_EVARIANTS;
    r6[6] = termId((u8*)"}");
    addProd(&g, i++, lalr.NT_BASE + N_ENUM, 7, r6, 0, 0, AC_ENUM);
    addProd(&g, i++, lalr.NT_BASE + N_SBLOCK, 0, null, 0, 0, AC_LSBLOCK);
    r2[0] = lalr.NT_BASE + N_SBLOCK;
    r2[1] = lalr.NT_BASE + N_SITEM;
    addProd(&g, i++, lalr.NT_BASE + N_SBLOCK, 2, r2, 0, 0, AC_APP);
    r1[0] = lalr.NT_BASE + N_SMETHOD;
    addProd(&g, i++, lalr.NT_BASE + N_SITEM, 1, r1, 0, 0, AC_SITEMW);
    r1[0] = lalr.NT_BASE + N_SMETHOD0;
    addProd(&g, i++, lalr.NT_BASE + N_SITEM, 1, r1, 0, 0, AC_SITEMW0);
    r1[0] = lalr.NT_BASE + N_SFIELD;
    addProd(&g, i++, lalr.NT_BASE + N_SITEM, 1, r1, 0, 0, AC_PASS);
    r1[0] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_SITEM, 1, r1, 0, 0, AC_NONE);
    r7[0] = lalr.NT_BASE + N_PREF;
    r7[1] = lalr.NT_BASE + N_TYPE;
    r7[2] = tok.TOK_IDENT;
    r7[3] = termId((u8*)"(");
    r7[4] = lalr.NT_BASE + N_PARAMS;
    r7[5] = termId((u8*)")");
    r7[6] = lalr.NT_BASE + N_BLOCK;
    addProd(&g, i++, lalr.NT_BASE + N_SMETHOD, 7, r7, 0, 0, AC_FUNC);
    r7[0] = lalr.NT_BASE + N_PREF;
    r7[1] = lalr.NT_BASE + N_TYPE;
    r7[2] = tok.TOK_IDENT;
    r7[3] = termId((u8*)"(");
    r7[4] = lalr.NT_BASE + N_PARAMS;
    r7[5] = termId((u8*)")");
    r7[6] = lalr.NT_BASE + N_BLOCK;
    addProd(&g, i++, lalr.NT_BASE + N_SMETHOD0, 7, r7, 0, 0, AC_FUNC0);
    r4[0] = lalr.NT_BASE + N_PREF;
    r4[1] = lalr.NT_BASE + N_TYPE;
    r4[2] = tok.TOK_IDENT;
    r4[3] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_SFIELD, 4, r4, 0, 0, AC_SFIELD);
    r7[0] = lalr.NT_BASE + N_PREF;
    r7[1] = lalr.NT_BASE + N_TYPE;
    r7[2] = tok.TOK_IDENT;
    r7[3] = termId((u8*)"[");
    r7[4] = lalr.NT_BASE + N_ES_RBKT;
    r7[5] = termId((u8*)"]");
    r7[6] = termId((u8*)";");
    addProd(&g, i++, lalr.NT_BASE + N_SFIELD, 7, r7, 0, 0, AC_SFIELD);
    addProd(&g, i++, lalr.NT_BASE + N_EVARIANTS, 0, null, 0, 0, AC_LIDENT);
    r1[0] = tok.TOK_IDENT;
    addProd(&g, i++, lalr.NT_BASE + N_EVARIANTS, 1, r1, 0, 0, AC_L1);
    r3[0] = lalr.NT_BASE + N_EVARIANTS;
    r3[1] = termId((u8*)",");
    r3[2] = tok.TOK_IDENT;
    addProd(&g, i++, lalr.NT_BASE + N_EVARIANTS, 3, r3, 0, 0, AC_APP);

    g.nprods = i;
    return g;
}

pub struct StmtParser
{
    exprP.ExprParser exp;
    lalr.Grammar g;
    lalr.Tables t;
    u8* esType;     // per state: ES action id or 0xFF
    u8* src;
    tok.LexTok* toks;
    u32 ntoks;
    u32 ip;
    u32 stk[STKMAX];
    u32 sp;
    u64 sem[STKMAX];
    u8 skind[STKMAX];
    u32 sline[STKMAX];
    u32 scol[STKMAX];
    u32 sv;
    u32 tTypeMinId;
    u32 tTypeMaxId;
    bool trace;     // debug: print each driver step
    u32 errRow;
    u32 errCol;
    u32 errTid;
    u32 errState;

    static StmtParser new()
    {
        StmtParser p;
        p.exp = exprP.ExprParser::new();
        p.g = stmtGrammar();
        {
            lalr.Generator gen = lalr.Generator::new(p.g);
            gen.build(&p.t);
            gen.free();
        }
        p.src = null;
        p.toks = null;
        p.ntoks = 0;
        p.ip = 0;
        p.sp = 0;
        p.sv = 0;
        p.tTypeMinId = tok.terminalId(str.strView::fromCstr("i8"));
        p.tTypeMaxId = tok.terminalId(str.strView::fromCstr("usize"));
        p.trace = false;
        p.esType = mman.alloc<u8>(p.t.nstates);
        for (u32 s = 0; s < p.t.nstates; s++)
        {
            u8 et = 0xFF;
            for (u32 tt = 0; tt < p.t.nterms; tt++)
            {
                lalr.Entry* en = &p.t.act[s * p.t.nterms + tt];
                if (en->kind == lalr.ACT_REDUCE)
                {
                    u32 a = p.g.prods[en->a].action;
                    if ((a >= AC_ES_SEMI && a <= AC_ES_BOTH) || a == AC_ES_RCURLY) { et = (u8)a; break; }
                    if (p.g.prods[en->a].nrhs > 0)
                    {
                        u32 esn = p.g.prods[en->a].rhs[0];
                        if (esn >= lalr.NT_BASE && esn < lalr.NT_BASE + N_COUNT)
                            esn -= lalr.NT_BASE;
                        else
                            esn = 999;
                        if (esn >= N_ES_SEMI && esn <= N_ES_BOTH)
                        {
                            et = (u8)(AC_ES_SEMI + (esn - N_ES_SEMI));
                            break;
                        }
                        if (esn == N_ES_RCURLY) { et = (u8)AC_ES_RCURLY; break; }
                    }
                }
            }
            if (et == 0xFF && p.t.gotos[s * p.t.nnonterms + N_ES_SEMI] != lalr.NO_STATE)
                et = (u8)AC_ES_SEMI;
            p.esType[s] = et;
        }
        return p;
    }

    void free()
    {
        for (u32 i = 0; i < self.g.nprods; i++)
            if (self.g.prods[i].rhs) mman.dealloc<u32>(self.g.prods[i].rhs);
        if (self.g.prods) mman.dealloc<lalr.Prod>(self.g.prods);
        if (self.g.termPrec) mman.dealloc<u32>(self.g.termPrec);
        if (self.t.act) mman.dealloc<lalr.Entry>(self.t.act);
        if (self.t.gotos) mman.dealloc<u32>(self.t.gotos);
        if (self.t.conflicts) mman.dealloc<lalr.Conflict>(self.t.conflicts);
        if (self.esType) mman.dealloc<u8>(self.esType);
        self.exp.free();
    }

    void num(u8* buf, u32* bl, u32 v)
    {
        char tmp[12];
        u32 p = 12;
        if (v == 0) tmp[--p] = '0';
        while (v) { tmp[--p] = (char)('0' + v % 10); v /= 10; }
        while (p < 12) buf[(*bl)++] = (u8)tmp[p++];
    }

    // value pushed for a shifted token: a strView for IDENT / type
    // keywords / string literals, else 0
    u64 shiftVal(u32 tid)
    {
        if (tid == tok.TOK_IDENT || tid == tok.TOK_STR ||
            (tid >= self.tTypeMinId && tid <= self.tTypeMaxId))
        {
            tok.LexTok* tt = &self.toks[self.ip];
            str.strView* v = mman.alloc<str.strView>(1);
            *v = str.strView::fromParts((const char*)self.src + tt->start, tt->len);
            self.skind[self.sv] = K_VIEW;
            return (u64)v;
        }
        self.skind[self.sv] = K_NULL;
        return 0;
    }

    // two-token lookahead for the typedef ambiguity: in a state with an ES
    // slot, an IDENT that the table would shift into a type starts an
    // expression unless the next token continues a type name
    bool identContinuesType(u32 at)
    {
        if (at + 1 >= self.ntoks) return false;
        u32 n = self.toks[at + 1].id;
        if (n == tok.TOK_IDENT) return true;
        if (n == termId((u8*)"<"))
        {
            if (at + 2 >= self.ntoks) return false;
            u32 t = self.toks[at + 2].id;
            if (t != tok.TOK_IDENT && (t < self.tTypeMinId || t > self.tTypeMaxId)) return false;
            if (at + 3 >= self.ntoks) return true;
            u32 o = self.toks[at + 3].id;
            return o == termId((u8*)">") || o == termId((u8*)",");
        }
        if (n != termId((u8*)".")) return false;
        if (at + 2 >= self.ntoks) return false;
        if (self.toks[at + 2].id != tok.TOK_IDENT) return false;
        if (at + 3 >= self.ntoks) return true;
        u32 o = self.toks[at + 3].id;
        return o != termId((u8*)"(") && o != termId((u8*)"=");
    }

    // runs the expression sub-parser at the current token for an ES slot;
    // empty when the next token is a stop. Sets *out and advances self.ip.
    bool intercept(u32 action, u64* out)
    {
        u32 stops[2];
        u32 nstops = esStops(action, stops);
        u64 val = 0;
        if (self.ip < self.ntoks && inStops(self.toks[self.ip].id, stops, nstops))
        {
            *out = 0;
            return true;
        }
        u32 consumed = 0;
        res.Result<ast.Expr*, exprP.ParseErr> r = self.exp.parseFrom(
            self.src, self.toks, self.ntoks, self.ip, stops, nstops, &consumed);
        if (r.isErr()) return false;
        ast.Expr* e = r.value;
        val = (u64)e;
        self.ip = consumed;
        *out = val;
        return true;
    }

    void freeView(u64 v)
    {
        if (v) mman.dealloc<str.strView>((str.strView*)(u64)v);
    }

    void freeListRec(SList* l)
    {
        if (l == null) return;
        for (u32 i = 0; i < l->n; i++)
        {
            u64 v = l->a[i];
            switch (l->itemKind)
            {
            case K_EXPR: ast.freeExpr((ast.Expr*)(u64)v); break;
            case K_TYPE: ast.freeType((ast.TypeExpr*)(u64)v); break;
            case K_STMT: ast.freeStmt((ast.Stmt*)(u64)v); break;
            case K_DECL: ast.freeDecl((ast.Decl*)(u64)v); break;
            case K_VIEW: self.freeView(v); break;
            case K_PARAM:
                if (v)
                {
                    ast.Param* pp = (ast.Param*)(u64)v;
                    ast.freeType(pp->type);
                    mman.dealloc<ast.Param>(pp);
                }
                break;
            case K_CASE:
            {
                ast.StmtCase* sc = (ast.StmtCase*)(u64)v;
                if (sc)
                {
                    ast.freeExpr(sc->value);
                    if (sc->body)
                    {
                        for (u32 k = 0; k < sc->nbody; k++) ast.freeStmt(sc->body[k]);
                        mman.dealloc<ast.Stmt*>(sc->body);
                    }
                    mman.dealloc<ast.StmtCase>(sc);
                }
                break;
            }
            case K_FCASE:
            {
                FCase* fc = (FCase*)(u64)v;
                self.freeView(fc->name);
                self.freeListRec((SList*)(u64)fc->decls);
                mman.dealloc<FCase>(fc);
                break;
            }
            case K_VRAW:
            {
                VRaw* vr = (VRaw*)(u64)v;
                ast.freeType((ast.TypeExpr*)(u64)vr->type);
                self.freeView(vr->name);
                ast.freeExpr((ast.Expr*)(u64)vr->init);
                ast.freeExpr((ast.Expr*)(u64)vr->arr);
                self.freeListRec((SList*)(u64)vr->names);
                mman.dealloc<VRaw>(vr);
                break;
            }
            case K_SITEM:
            {
                SItem* it = (SItem*)(u64)v;
                if (it)
                {
                    if (it->isMethod)
                        ast.freeDecl((ast.Decl*)(u64)it->v);
                    else
                    {
                        ast.StructField* f = (ast.StructField*)(u64)it->v;
                        if (f)
                        {
                            ast.freeType(f->type);
                            mman.dealloc<ast.StructField>(f);
                        }
                    }
                    mman.dealloc<SItem>(it);
                }
                break;
            }
            default:
                break;
            }
        }
        if (l->a) mman.dealloc<u64>(l->a);
        mman.dealloc<SList>(l);
    }

    // frees every live semantic value (failed parses; the caller cannot
    // use them afterwards)
    void clearSem()
    {
        for (u32 k = 0; k < self.sv; k++)
        {
            u64 v = self.sem[k];
            if (v == 0) continue;
            switch (self.skind[k])
            {
            case K_EXPR: ast.freeExpr((ast.Expr*)(u64)v); break;
            case K_TYPE: ast.freeType((ast.TypeExpr*)(u64)v); break;
            case K_STMT: ast.freeStmt((ast.Stmt*)(u64)v); break;
            case K_DECL: ast.freeDecl((ast.Decl*)(u64)v); break;
            case K_LIST: self.freeListRec((SList*)(u64)v); break;
            case K_PLIST:
            {
                PList* pl = (PList*)(u64)v;
                if (pl->a)
                {
                    for (u32 i = 0; i < pl->n; i++)
                    {
                        ast.Param* pp = (ast.Param*)(u64)pl->a[i];
                        if (pp) { ast.freeType(pp->type); mman.dealloc<ast.Param>(pp); }
                    }
                    mman.dealloc<u64>(pl->a);
                }
                mman.dealloc<PList>(pl);
                break;
            }
            case K_CASE:
            {
                ast.StmtCase* sc = (ast.StmtCase*)(u64)v;
                ast.freeExpr(sc->value);
                if (sc->body)
                {
                    for (u32 i = 0; i < sc->nbody; i++) ast.freeStmt(sc->body[i]);
                    mman.dealloc<ast.Stmt*>(sc->body);
                }
                mman.dealloc<ast.StmtCase>(sc);
                break;
            }
            case K_FCASE:
            {
                FCase* fc = (FCase*)(u64)v;
                self.freeView(fc->name);
                self.freeListRec((SList*)(u64)fc->decls);
                mman.dealloc<FCase>(fc);
                break;
            }
            case K_VIEW: self.freeView(v); break;
            case K_SITEM:
            {
                SItem* it = (SItem*)(u64)v;
                if (it)
                {
                    if (it->isMethod)
                        ast.freeDecl((ast.Decl*)(u64)it->v);
                    else
                    {
                        ast.StructField* f = (ast.StructField*)(u64)it->v;
                        if (f)
                        {
                            ast.freeType(f->type);
                            mman.dealloc<ast.StructField>(f);
                        }
                    }
                    mman.dealloc<SItem>(it);
                }
                break;
            }
            case K_PARAM:
            {
                ast.Param* pp = (ast.Param*)(u64)v;
                ast.freeType(pp->type);
                mman.dealloc<ast.Param>(pp);
                break;
            }
            case K_VRES:
            {
                VRes* vr = (VRes*)(u64)v;
                ast.freeExpr((ast.Expr*)(u64)vr->init);
                ast.freeExpr((ast.Expr*)(u64)vr->arr);
                self.freeListRec((SList*)(u64)vr->names);
                mman.dealloc<VRes>(vr);
                break;
            }
            case K_VRAW:
            {
                VRaw* vr = (VRaw*)(u64)v;
                ast.freeType((ast.TypeExpr*)(u64)vr->type);
                self.freeView(vr->name);
                ast.freeExpr((ast.Expr*)(u64)vr->init);
                ast.freeExpr((ast.Expr*)(u64)vr->arr);
                self.freeListRec((SList*)(u64)vr->names);
                mman.dealloc<VRaw>(vr);
                break;
            }
            case K_PROG:
                ast.freeProgram((ast.Program*)(u64)v);
                break;
            default:
                break;
            }
        }
        self.sv = 0;
    }

    void push(u64 v, u8 kind)
    {
        self.sem[self.sv] = v;
        self.skind[self.sv] = kind;
        self.sline[self.sv] = 0;
        self.scol[self.sv] = 0;
        self.sv++;
    }

    // pops n slots from base and builds the AST value for production pr
    void apply(lalr.Prod* pr, u32 n)
    {
        u32 base = self.sv - n;
        u32 line = self.sline[base];
        u32 col = self.scol[base];
        self.sv = base;
        u64 v = 0;
        u8 kind = K_NULL;
        switch (pr->action)
        {
        case AC_PASS:
            v = self.sem[base];
            kind = self.skind[base];
            self.push(v, kind);
            return;
        case AC_NONE:
            self.push(0, K_NULL);
            return;
        case AC_L1:
        {
            SList* l = listNew((u8)self.skind[base]);
            listAppend(l, self.sem[base]);
            self.push((u64)l, K_LIST);
            return;
        }
        case AC_APP:
        {
            SList* l = (SList*)(u64)self.sem[base];
            listAppend(l, self.sem[base + 1]);
            self.push((u64)l, K_LIST);
            return;
        }
        case AC_CONSTINT:
        {
            ast.Expr* e = mman.alloc<ast.Expr>(1);
            e->kind = ast.EX_INT;
            tok.LexTok* lt = &self.toks[self.ip - 1];
            e->text = str.strView::fromParts((const char*)self.src + lt->start, lt->len);
            e->a = null;
            e->b = null;
            e->c = null;
            e->args = null;
            e->nargs = 0;
            e->names = null;
            e->type = null;
            e->targs = null;
            e->ntargs = 0;
            e->post = false;
            e->line = line;
            e->col = col;
            SList* l = listNew(K_EXPR);
            listAppend(l, (u64)e);
            self.push((u64)l, K_LIST);
            return;
        }
        case AC_CONSTAPP:
        {
            SList* l = (SList*)(u64)self.sem[base];
            ast.Expr* e = mman.alloc<ast.Expr>(1);
            e->kind = ast.EX_INT;
            tok.LexTok* lt = &self.toks[self.ip - 1];
            e->text = str.strView::fromParts((const char*)self.src + lt->start, lt->len);
            e->a = null;
            e->b = null;
            e->c = null;
            e->args = null;
            e->nargs = 0;
            e->names = null;
            e->type = null;
            e->targs = null;
            e->ntargs = 0;
            e->post = false;
            e->line = line;
            e->col = col;
            listAppend(l, (u64)e);
            self.push((u64)l, K_LIST);
            return;
        }
        case AC_RAPP:
        {
            SList* l = (SList*)(u64)self.sem[base + 1];
            listAppend(l, self.sem[base]);
            self.push((u64)l, K_LIST);
            return;
        }
        case AC_LDECLS:
            self.push((u64)listNew(K_DECL), K_LIST);
            return;
        case AC_LSTMT:
            self.push((u64)listNew(K_STMT), K_LIST);
            return;
        case AC_LSW:
            self.push((u64)listNew(K_STMT), K_LIST);
            return;
        case AC_LFLAG:
            self.push((u64)listNew(K_DECL), K_LIST);
            return;
        case AC_LIDENT:
            self.push((u64)listNew(K_VIEW), K_LIST);
