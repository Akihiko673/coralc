// Output shape:
//   error[C0024]: <concise summary>
//     ┌─► <file>:<line>:<col>
//     │
//     │   <lineno> │ <source line>
//     │   <lineno> │ <source line>      (error line)
//     |                       ▲
//     │                       ╰─ <help / suggestion>
//
// Every diagnostic funnels through `diag`, which owns the formatting. Call
// sites report a stable CODE (e.g. "LEX-0001", "TC-0213") plus a location and
// an optional help line; error.crl renders everything.
mod str = import("std/text/string.crl");
mod libc = import("std/platform/libc.crl");

pub const u8 LVL_ERROR = 0;
pub const u8 LVL_WARN = 1;
pub const u8 LVL_INFO = 2;
pub const u8 LVL_NOTE = 3;

// Return the 1-based source line `line` as a view (without the newline).
strView extractLine(strView src, u32 line)
{
    u64 idx = 0;
    u32 cur = 1;
    while (cur < line && idx < src.len)
    {
        if (src.ptr[idx] == '\n') cur++;
        idx++;
    }
    if (cur < line) return strView::empty();
    u64 start = idx;
    while (idx < src.len && src.ptr[idx] != '\n') idx++;
    return strView::fromParts(src.ptr + start, idx - start);
}

void pushUint(str.String* s, u32 v)
{
    u8 tmp[20];
    i32 n = libc.snprintf(tmp, 20, "%u", v);
    if (n < 0) n = 0;
    if ((u64)n > 20) n = 20;
    s->pushView(strView::fromParts((const char*)tmp, (u64)n));
}

// Number of decimal digits needed to render `v`.
u32 digits(u32 v)
{
    u32 d = 1;
    while (v >= 10) { v /= 10; d++; }
    return d;
}

// Right-align `v` in a field of width `w` using spaces.
void pushPadUint(str.String* s, u32 v, u32 w)
{
    u32 d = digits(v);
    if (w > d) for (u32 i = 0; i < w - d; i++) s->pushChar(' ');
    pushUint(s, v);
}

// The primary diagnostic sink. `code` may be empty (then no `[CODE]` is
// shown). `help` may be empty (then no suggestion line is rendered).
pub void diag(strView code, strView filename, strView src, u32 line, u32 col,
              u8 level, strView msg, strView help)
{
    str.String s = str.String::new();

    // ANSI colour helpers (ESC byte 27 followed by a suffix; avoids \x in
    // string literals so the bootstrap compiler accepts them).
    u8 ESC = 27;
    strView C_RESET = strView::fromCstr("[0m");
    strView C_LEVEL = strView::fromCstr("[1;31m"); // error: bold red
    strView C_CODE  = strView::fromCstr("[35m");   // code: magenta
    strView C_BOX   = strView::fromCstr("[90m");   // box / gutter: grey
    strView C_CARET = strView::fromCstr("[1;31m"); // caret: bold red
    strView C_HELP  = strView::fromCstr("[36m");   // help: cyan
    if (level == LVL_WARN) C_LEVEL = strView::fromCstr("[33m");
    else if (level == LVL_INFO || level == LVL_NOTE) C_LEVEL = strView::fromCstr("[36m");

    // header: error[CODE]: msg  (or error: msg)
    s.pushChar((char)ESC);
    s.pushView(C_LEVEL);
    if (level == LVL_ERROR) s.pushView(strView::fromCstr("error"));
    else if (level == LVL_WARN) s.pushView(strView::fromCstr("warning"));
    else if (level == LVL_INFO) s.pushView(strView::fromCstr("info"));
    else s.pushView(strView::fromCstr("note"));
    if (code.len > 0)
    {
        s.pushChar((char)ESC);
        s.pushView(C_CODE);
        s.pushChar('[');
        s.pushView(code);
        s.pushChar(']');
    }
    s.pushChar((char)ESC);
    s.pushView(C_RESET);
    s.pushView(strView::fromCstr(": "));
    s.pushView(msg);
    s.pushChar('\n');

    // location line
    s.pushChar((char)ESC);
    s.pushView(C_BOX);
    s.pushView(strView::fromCstr("  ┌─► "));
    s.pushChar((char)ESC);
    s.pushView(C_RESET);
    s.pushView(filename);
    s.pushChar(':');
    pushUint(&s, line);
    s.pushChar(':');
    pushUint(&s, col);
    s.pushChar('\n');

    // blank gutter
    s.pushChar((char)ESC);
    s.pushView(C_BOX);
    s.pushView(strView::fromCstr("  │\n"));
    s.pushChar((char)ESC);
    s.pushView(C_RESET);

    u32 numW = digits(line);
    if (numW < 2) numW = 2;

    for (i32 off = -1; off <= 0; off++)
    {
        i32 ln = (i32)line + off;
        if (ln < 1) continue;
        strView lt = extractLine(src, (u32)ln);
        if (lt.len == 0 && off != 0) continue;

        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("  │ "));
        pushPadUint(&s, (u32)ln, numW);
        s.pushView(strView::fromCstr(" │ "));
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        s.pushView(lt);
        s.pushChar('\n');
    }

    u32 prefixLen = 4 + numW + 3;
    i32 caretSpaces = (i32)prefixLen + (i32)col - 4;
    if (caretSpaces < 0) caretSpaces = 0;
    s.pushChar((char)ESC);
    s.pushView(C_BOX);
    s.pushView(strView::fromCstr("  |"));
    s.pushChar((char)ESC);
    s.pushView(C_RESET);
    for (i32 i = 0; i < caretSpaces; i++) s.pushChar(' ');
    s.pushChar((char)ESC);
    s.pushView(C_CARET);
    s.pushView(strView::fromCstr("▲"));
    s.pushChar((char)ESC);
    s.pushView(C_RESET);
    s.pushChar('\n');

    // help / suggestion line
    if (help.len > 0)
    {
        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("  │"));
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        for (i32 i = 0; i < caretSpaces; i++) s.pushChar(' ');
        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("╰─ "));
        s.pushChar((char)ESC);
        s.pushView(C_HELP);
        s.pushView(help);
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        s.pushChar('\n');
    }
    if (code.len > 0)
    {
        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("  │"));
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        for (i32 i = 0; i < caretSpaces; i++) s.pushChar(' ');
        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("╰─ "));
        s.pushChar((char)ESC);
        s.pushView(strView::fromCstr("[90m"));
        s.pushView(strView::fromCstr("try `coralc --explain "));
        s.pushView(code);
        s.pushView(strView::fromCstr("` for more information"));
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        s.pushChar('\n');
    }

    libc.write(2, s.asU8(), s.len);
    s.free();
}

// Backward-compatible clang-style entry point. Renders the rich format with no
// code and `ctx` used as the help/suggestion line.
pub void reportLevel(strView filename, strView src, u32 line, u32 col, u8 level,
                     strView msg, strView ctx)
{
    diag(strView::empty(), filename, src, line, col, level, msg, ctx);
}

// Coded diagnostic entry point (preferred for new call sites).
pub void reportCode(strView code, strView filename, strView src, u32 line, u32 col,
                    u8 level, strView msg, strView help)
{
    diag(code, filename, src, line, col, level, msg, help);
}

pub void report(strView filename, strView src, u32 line, u32 col,
                strView msg, strView ctx)
{
    reportLevel(filename, src, line, col, LVL_ERROR, msg, ctx);
}

bool codeEq(strView a, const char* b) {
    u64 n=0; while(b[n]) n++;
    if (a.len!=n) return false;
    for (u64 i=0;i<n;i++) if(a.ptr[i]!= (u8)b[i]) return false;
    return true;
}
pub void explain(strView code)
{
    bool found = false;
    u8 ESC = 27;
    str.String s = str.String::new();
    s.pushChar((char)ESC); s.pushView(strView::fromCstr("[1m"));
    s.pushView(strView::fromCstr("explain: "));
    s.pushView(code);
    s.pushChar((char)ESC); s.pushView(strView::fromCstr("[0m")); s.pushChar('\n');
    if (codeEq(code,"LEX-0001")) { s.pushView(strView::fromCstr("stray token: a character that is not a valid operator or literal. Remove it or use a valid token; try `[[attr]]` for attributes, not `@[...]`. Example: `[[reorder]] struct S {}`\n")); found=true; }
    else if (codeEq(code,"LEX-0007")) { s.pushView(strView::fromCstr("invalid attribute syntax: `@[...]` and `@name` are rejected at the lexer. Use `[[attr]]` on declarations (e.g. `[[reorder]] struct S {}` or `[[reorder, packed]]`) or `@[[ATTR]]` at module/file level.\n")); found=true; }
    else if (codeEq(code,"TC-TYPE")) { s.pushView(strView::fromCstr("unknown type: the return type, variable type, or parameter type names an undeclared type. Declare a `struct`, `enum`, `typedef`, `distinct`, or use a primitive: i8/u8/i16/u16/i32/u32/i64/u64/f32/f64/bool/char/void/isize/usize. Example: `i32 foo() {}` not `loo foo()`. Typedef aliases ARE valid as return types because they unwrap to their underlying type.\n")); found=true; }
    else if (codeEq(code,"TC-RETURN")) { s.pushView(strView::fromCstr("return mismatch covers three cases:\n  1) void function with `return <value>;` — use bare `return;` or change signature to `T func()`.\n  2) non-void function with bare `return;` or falling off the end — add `return <expr>;` on every path. The compiler checks that every non-void function has a return on every path and that `void` functions never return a value.\n  3) value type != declared return type — make them match. `typedef` aliases unwrap and are compatible with their underlying type (MyTypedef -> i32 is OK both ways). `distinct` types are NOT — they require an explicit cast: `return (MyInt)value;` or `return (i32)distinctVal;`.\n")); found=true; }
    else if (codeEq(code,"TC-ASSIGN")) { s.pushView(strView::fromCstr("assignment requires exact type match. Coral has no implicit conversions (except lossless widening and literal fitting). `distinct` types are never implicitly convertible — use `(T)expr`. `typedef` aliases ARE implicitly convertible to/from their underlying type. Use `--fcast` to force all casts (escape hatch).\n")); found=true; }
    else if (codeEq(code,"TC-ARGS")) { s.pushView(strView::fromCstr("call argument does not match parameter type. Check arity and types. `distinct` args need `(T)arg`; `typedef` args are interchangeable. Example: `void needI32(i32 x){} distinct MyInt=i32; MyInt m=(MyInt)5; needI32((i32)m);`.\n")); found=true; }
    if (!found) {
        s.pushView(strView::fromCstr("No detailed explanation available for this code. Common codes: LEX-0001 stray token, LEX-0007 bad attribute, TC-TYPE unknown type, TC-RETURN void/non-void mismatch, TC-ASSIGN no implicit conversion (distinct needs cast, typedef is OK), TC-ARGS call arg mismatch, SYN-1002/1003 parse errors. Try `coralc --explain LEX-0007` etc.\n"));
    }
    s.pushView(strView::fromCstr("\nFor more help, see docs or source: src/typecheck/types.crl and src/error.crl\n"));
    libc.write(1, s.asU8(), s.len);
    s.free();
}
