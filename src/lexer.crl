mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod tok = import("token");

pub struct LexResult
{
    tok.LexTok* toks;
    u32 n;
    tok.LexErr* errs;
    u32 nerrs;
}

pub struct Lexer
{
    const u8* src;
    u32 len;
    u32 pos;
    u32 row;
    u32 col;

    tok.LexTok* toks;
    u32 ntoks;
    u32 cap;
    tok.LexErr* errs;
    u32 nerrs;
    u32 ecap;

    static Lexer new(const u8* src, u32 len)
    {
        Lexer l;
        l.src = src;
        l.len = len;
        l.pos = 0;
        l.row = 1;
        l.col = 1;
        l.toks = null;
        l.ntoks = 0;
        l.cap = 0;
        l.errs = null;
        l.nerrs = 0;
        l.ecap = 0;
        return l;
    }

    void growToks()
    {
        if (self.ntoks < self.cap) return;
        u32 nc = self.cap ? self.cap * 2 : 256;
        tok.LexTok* nt = mman.alloc<tok.LexTok>(nc);
        for (u32 i = 0; i < self.ntoks; i++) nt[i] = self.toks[i];
        if (self.toks) mman.dealloc<tok.LexTok>(self.toks);
        self.toks = nt;
        self.cap = nc;
    }

    void growErrs()
    {
        if (self.nerrs < self.ecap) return;
        u32 nc = self.ecap ? self.ecap * 2 : 16;
        tok.LexErr* ne = mman.alloc<tok.LexErr>(nc);
        for (u32 i = 0; i < self.nerrs; i++) ne[i] = self.errs[i];
        if (self.errs) mman.dealloc<tok.LexErr>(self.errs);
        self.errs = ne;
        self.ecap = nc;
    }

    void emit(u32 id, u32 start, u32 len)
    {
        self.growToks();
        tok.LexTok* t = &self.toks[self.ntoks++];
        t->id = id;
        t->start = start;
        t->len = len;
        t->row = self.row;
        t->col = self.col;
    }

    void errAt(u32 start, str.strView code, str.strView msg, str.strView help)
    {
        self.growErrs();
        tok.LexErr* e = &self.errs[self.nerrs++];
        e->start = start;
        e->row = self.row;
        e->col = self.col;
        e->code = code;
        e->msg = msg;
        e->help = help;
    }

    void advance(u32 n)
    {
        for (u32 i = 0; i < n; i++)
        {
            if (self.src[self.pos] == '\n')
            {
                self.row++;
                self.col = 1;
            }
            else
                self.col++;
            self.pos++;
        }
    }

    bool isWs(u8 c)
    {
        return c == ' ' || c == '\t' || c == '\n' || c == '\r' ||
               c == '\v' || c == '\f';
    }

    bool isDigit(u8 c) { return c >= '0' && c <= '9'; }
    
    bool isHexDig(u8 c)
    {
        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }
    
    bool isIdentStart(u8 c)
    {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
    }
    
    bool isIdentBody(u8 c)
    {
        return self.isIdentStart(c) || (c >= '0' && c <= '9');
    }

    // ditch whitespace (incl U+00A0, U+FEFF) and comments
    bool skipTrivia()
    {
        bool moved = false;
        for (;;)
        {
            if (self.pos >= self.len) return moved;
            u8 c = self.src[self.pos];
            if (self.isWs(c)) { self.advance(1); moved = true; continue; }
            if (c == 0xC2 && self.pos + 1 < self.len && self.src[self.pos + 1] == 0xA0)
            { self.advance(2); moved = true; continue; }
            if (c == 0xEF && self.pos + 2 < self.len &&
                self.src[self.pos + 1] == 0xBB && self.src[self.pos + 2] == 0xBF)
            { self.advance(3); moved = true; continue; }
            if (c == '/' && self.pos + 1 < self.len && self.src[self.pos + 1] == '/')
            {
                while (self.pos < self.len && self.src[self.pos] != '\n') self.advance(1);
                moved = true;
                continue;
            }
            if (c == '/' && self.pos + 1 < self.len && self.src[self.pos + 1] == '*')
            {
                u32 start = self.pos;
                self.advance(2);
                bool closed = false;
                while (self.pos + 1 < self.len)
                {
                    if (self.src[self.pos] == '*' && self.src[self.pos + 1] == '/')
                    {
                        self.advance(2);
                        closed = true;
                        break;
                    }
                    self.advance(1);
                }
                if (!closed)
                    self.errAt(start, str.strView::fromCstr("LEX-0006"), str.strView::fromCstr("unterminated block comment"), str.strView::fromCstr("add a closing '*/' before end of file"));
                moved = true;
                continue;
            }
            return moved;
        }
    }

    // length of each literal alt at pos (0 = no match)
    u32 decIntLen(u32 p)
    {
        if (p >= self.len || !self.isDigit(self.src[p])) return 0;
        u32 i = p;
        while (i < self.len && (self.isDigit(self.src[i]) || self.src[i] == '_')) i++;
        while (i < self.len)
        {
            u8 c = self.src[i];
            if (c == 'u' || c == 'U' || c == 'l' || c == 'L' ||
                c == 'b' || c == 'B' || c == 'o' || c == 'O' ||
                c == 'x' || c == 'X') i++;
            else break;
        }
        return i - p;
    }

    u32 radixLen(u32 p, u8 radix, bool hex)
    {
        // '0' radix 'x'|'o'|'b' already consumed by caller convention,
        // p points at the digit after the radix prefix.
        if (p >= self.len) return 0;
        if (hex && !self.isHexDig(self.src[p])) return 0;
        if (!hex)
        {
            u8 c = self.src[p];
            if (radix == 'o' && !(c >= '0' && c <= '7')) return 0;
            if (radix == 'b' && !(c == '0' || c == '1')) return 0;
        }
        u32 i = p;
        if (hex)
            while (i < self.len && (self.isHexDig(self.src[i]) || self.src[i] == '_')) i++;
        else if (radix == 'o')
            while (i < self.len && ((self.src[i] >= '0' && self.src[i] <= '7') || self.src[i] == '_')) i++;
        else
            while (i < self.len && ((self.src[i] == '0' || self.src[i] == '1') || self.src[i] == '_')) i++;
        while (i < self.len)
        {
            u8 c = self.src[i];
            if (c == 'u' || c == 'U' || c == 'l' || c == 'L') i++;
            else break;
        }
        return i - p;
    }

    u32 floatLen(u32 p)
    {
        if (p >= self.len || !self.isDigit(self.src[p])) return 0;
        u32 i = p;
        while (i < self.len && (self.isDigit(self.src[i]) || self.src[i] == '_')) i++;
        if (i >= self.len || self.src[i] != '.') return 0;
        i++;
        if (i >= self.len || !self.isDigit(self.src[i])) return 0;
        while (i < self.len && (self.isDigit(self.src[i]) || self.src[i] == '_')) i++;
        if (i < self.len && (self.src[i] == 'e' || self.src[i] == 'E'))
        {
            u32 j = i + 1;
            if (j < self.len && (self.src[j] == '+' || self.src[j] == '-')) j++;
            if (j < self.len && self.isDigit(self.src[j]))
            {
                while (j < self.len && self.isDigit(self.src[j])) j++;
                i = j;
            }
        }
        return i - p;
    }

    u32 expFloatLen(u32 p)
    {
        if (p >= self.len || !self.isDigit(self.src[p])) return 0;
        u32 i = p;
        while (i < self.len && (self.isDigit(self.src[i]) || self.src[i] == '_')) i++;
        if (i >= self.len || !(self.src[i] == 'e' || self.src[i] == 'E')) return 0;
        u32 j = i + 1;
        if (j < self.len && (self.src[j] == '+' || self.src[j] == '-')) j++;
        if (j >= self.len || !self.isDigit(self.src[j])) return 0;
        while (j < self.len && self.isDigit(self.src[j])) j++;
        return j - p;
    }

    // Longest literal match, ties resolved by alternation order
    // decimal, hex, octal, binary (then float forms are non-joint)
    void scanNumber()
    {
        u32 p = self.pos;
        u32 best = 0;
        u32 bestId = tok.TOK_INT;
        u32 d = 0, h = 0, o = 0, b = 0, f = 0, e = 0;
        if (p + 1 < self.len && self.src[p] == '0' &&
            (self.src[p + 1] == 'x' || self.src[p + 1] == 'X'))
            h = 2 + self.radixLen(p + 2, 'x', true);
        if (p + 1 < self.len && self.src[p] == '0' &&
            (self.src[p + 1] == 'o' || self.src[p + 1] == 'O'))
            o = 2 + self.radixLen(p + 2, 'o', false);
        if (p + 1 < self.len && self.src[p] == '0' &&
            (self.src[p + 1] == 'b' || self.src[p + 1] == 'B'))
            b = 2 + self.radixLen(p + 2, 'b', false);
        d = self.decIntLen(p);
        f = self.floatLen(p);
        e = self.expFloatLen(p);

        if (h > best) { best = h; bestId = tok.TOK_INT; }
        if (o > best) { best = o; bestId = tok.TOK_INT; }
        if (b > best) { best = b; bestId = tok.TOK_INT; }
        if (d > best) { best = d; bestId = tok.TOK_INT; }
        if (f > best && f > d && f > h && f > o && f > b) { best = f; bestId = tok.TOK_FLOAT; }
        if (e > best && e > d && e > h && e > o && e > b) { best = e; bestId = tok.TOK_FLOAT; }
        if (best == 0)
        {
            self.errAt(p, str.strView::fromCstr("LEX-0004"), str.strView::fromCstr("malformed numeric constant"), str.strView::fromCstr("a numeric constant may have at most one radix point and a valid integer/float suffix"));
            self.advance(1);
            return;
        }
        self.emit(bestId, p, best);
        self.advance(best);
    }

    // Single-line "..." or multi-line """..."""; both maximal-munch.
        // Scans a single-line string starting at p ('"'), returns its total
    // length including both quotes (0 = unterminated at newline/EOF)
    u32 scanStringSingle(u32 p)
    {
        u32 k = p + 1;
        while (k < self.len)
        {
            u8 c = self.src[k];
            if (c == '"') return k + 1 - p;
            if (c == '\\')
            {
                if (k + 1 < self.len) k += 2;
                else k++;
                continue;
            }
            if (c == '\n') return 0;
            k++;
        }
        return 0;
    }

    void scanString()
    {
        u32 p = self.pos;
        bool multi = self.pos + 2 < self.len &&
                     self.src[self.pos + 1] == '"' && self.src[self.pos + 2] == '"';
        u32 consume = 0;
        if (multi)
        {
            u32 k = self.pos + 3;
            while (k < self.len)
            {
                if (self.src[k] == '\\')
                {
                    if (k + 1 < self.len) k += 2;
                    else k++;
                    continue;
                }
                if (self.src[k] == '"' && k + 2 < self.len &&
                    self.src[k + 1] == '"' && self.src[k + 2] == '"')
                {
                    k += 3;
                    consume = k - self.pos;
                    break;
                }
                k++;
            }
            if (consume == 0)
            {
                // No closing """: fall back to single-line scanning so
                // sequences like """" lex as two empty strings instead of
                // an unterminated multi-line literal.
                consume = self.scanStringSingle(p);
                if (consume == 0)
                {
                    self.errAt(p, str.strView::fromCstr("LEX-0003"), str.strView::fromCstr("unterminated string literal"), str.strView::fromCstr("multi-line strings end with '\"\"\"'; single-line strings end with '\"'"));
                    consume = self.len - self.pos;
                }
            }
        }
        else
        {
            consume = self.scanStringSingle(p);
            if (consume == 0)
            {
                self.errAt(p, str.strView::fromCstr("LEX-0003"), str.strView::fromCstr("unterminated string literal"), str.strView::fromCstr("close the string with a matching '\"' before end of line"));
                self.advance(1);
                return;
            }
        }
        self.emit(tok.TOK_STR, p, consume);
        self.advance(consume);
    }

    void scanChar()
    {
        u32 p = self.pos;
        // replacing scanString's single-line logic with exactly one content
        // char (or escape) then a closing quote
        bool valid = false;
        u32 consume = 0;
        if (p + 1 < self.len)
        {
            u8 c = self.src[p + 1];
            if (c != '\'' && c != '\n' && c != '\\')
            {
                if (p + 2 < self.len && self.src[p + 2] == '\'')
                {
                    valid = true;
                    consume = 3;
                }
            }
            else if (c == '\\' && p + 2 < self.len)
            {
                if (p + 3 < self.len && self.src[p + 3] == '\'')
                {
                    valid = true;
                    consume = 4;
                }
            }
        }
        if (!valid)
        {
            self.errAt(p, str.strView::fromCstr("LEX-0005"), str.strView::fromCstr("malformed character literal"), str.strView::fromCstr("a character literal is 'x' or '\\x' (one content char/escape) followed by a closing '''"));
            self.advance(1);
            return;
        }
        self.emit(tok.TOK_CHAR, p, consume);
        self.advance(consume);
    }

    void scanWord()
    {
        u32 p = self.pos;
        u32 i = p;
        while (i < self.len && self.isIdentBody(self.src[i])) i++;
        u32 wid = 0xFFFFFFFF;
        // Whole-word keyword check the scanned span is the full word (the
        // body scan stops at the first nonidentifier char), so it'll 
        // check gainst kw
        for (u32 q = 0; q < tok.NUM_KW; q++)
        {
            str.strView t = tok.KW_TERMS[q];
            u32 j = 0;
            bool match = true;
            while (j < t.len)
            {
                if (p + j >= self.len || t.ptr[j] != (char)self.src[p + j]) { match = false; break; }
                j++;
            }
            if (match && j == i - p)
            {
                wid = tok.terminalId(t);
                break;
            }
        }
        self.emit(wid == 0xFFFFFFFF ? tok.TOK_IDENT : wid, p, i - p);
        self.advance(i - p);
    }

    void scanPunct()
    {
        u32 p = self.pos;
        for (u32 i = 0; i < tok.NUM_OP; i++) // OP_TERMS, longest first
        {
                str.strView t = tok.OP_TERMS[i];
                u32 j = 0;
                while (j < t.len && self.pos + j < self.len && t.ptr[j] == (char)self.src[self.pos + j]) j++;
                if (j == t.len)
                {
                    u32 n = j;
                    // Only @[[ATTR]] is a valid @-form (module-level attr).
                    // @[...] (single bracket) and @name are rejected here so
                    // they never reach the parser.
                    if (n == 1 && (char)t.ptr[0] == '@')
                    {
                        u8 c1 = self.pos + 1 < self.len ? self.src[self.pos + 1] : 0;
                        u8 c2 = self.pos + 2 < self.len ? self.src[self.pos + 2] : 0;
                        if (c1 != '[' || c2 != '[')
                        {
                            self.errAt(p, str.strView::fromCstr("LEX-0007"), str.strView::fromCstr("invalid attribute syntax"), str.strView::fromCstr("attributes are [[attr]] on declarations or @[[ATTR]] at module level"));
                            self.advance(1);
                            return;
                        }
                    }
                    // Prefer longer matches, OP_TERMS is longest first, so
                    // the first full match is the longest
                    self.emit(tok.terminalId(t), p, n);
                    self.advance(n);
                    return;
                }
            }
        self.errAt(p, str.strView::fromCstr("LEX-0001"),
                   str.strView::fromCstr("stray token detected in expression"),
                   str.strView::fromCstr("the character is not a valid operator, identifier, or literal prefix in standard C syntax; remove it or replace it with a valid token"));
        self.advance(1);
    }

    LexResult lex()
    {
        while (self.pos < self.len)
        {
            self.skipTrivia();
            if (self.pos >= self.len) break;
            u8 c = self.src[self.pos];
            if (self.isDigit(c)) { self.scanNumber(); continue; }
            if (c == '"') { self.scanString(); continue; }
            if (c == '\'') { self.scanChar(); continue; }
            if (self.isIdentStart(c)) { self.scanWord(); continue; }
            self.scanPunct();
        }
        self.emit(tok.TOK_EOF, self.pos, 0);
        LexResult r;
        r.toks = self.toks;
        r.n = self.ntoks;
        r.errs = self.errs;
        r.nerrs = self.nerrs;
        return r;
    }
}