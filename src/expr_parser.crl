// Self-host expression parser: LALR(1) tables generated at startup from a
// layered grammar, driven over lexer tokens to build the ast.Expr tree.
// Binary/ternary precedence mirrors py/parser.py's PREC table; the grammar
// is layered per level (J = add, K = mul, ...) so only '=' and '?' need
// precedence/associativity resolution by the generator.

mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod tok = import("token");
mod ast = import("ast/ast.crl");
mod lalr = import("lalr");
mod res = import("std/data/result.crl");

// Where an expression parse failed (row/col/token id of the lookahead).
pub struct ParseErr
{
    u32 row;
    u32 col;
    u32 tid;
}

res.Result<ast.Expr*, ParseErr> okExpr(ast.Expr* e)
{
    res.Result<ast.Expr*, ParseErr> r;
    r.ok = true;
    r.value = e;
    return r;
}

res.Result<ast.Expr*, ParseErr> errExpr(ParseErr pe)
{
    res.Result<ast.Expr*, ParseErr> r;
    r.ok = false;
    r.error = pe;
    return r;
}

// reduce actions
const u32 AC_PASS = 0;      // identity chain (E->B, B->C, ...)
const u32 AC_ASSIGN = 1;    // E = E
const u32 AC_TERN = 2;      // E ? E : E
const u32 AC_LOR = 3;
const u32 AC_LAND = 4;
const u32 AC_BOR = 5;
const u32 AC_BXOR = 6;
const u32 AC_BAND = 7;
const u32 AC_EQ = 8;
const u32 AC_NE = 9;
const u32 AC_LT = 10;
const u32 AC_LE = 11;
const u32 AC_GT = 12;
const u32 AC_GE = 13;
const u32 AC_SHL = 14;
const u32 AC_SHR = 15;
const u32 AC_ADD = 16;
const u32 AC_SUB = 17;
const u32 AC_MUL = 18;
const u32 AC_DIV = 19;
const u32 AC_MOD = 20;
const u32 AC_NEG = 21;
const u32 AC_NOT = 22;
const u32 AC_TILDE = 23;
const u32 AC_POS = 24;
const u32 AC_DEREF = 25;
const u32 AC_ADDR = 26;
const u32 AC_PREINC = 27;
const u32 AC_PREDEC = 28;
const u32 AC_POSTINC = 29;
const u32 AC_POSTDEC = 30;
const u32 AC_CALL = 31;
const u32 AC_CALL0 = 32;
const u32 AC_INDEX = 33;
const u32 AC_DOT = 34;
const u32 AC_ARROW = 35;
const u32 AC_PAREN = 36;
const u32 AC_IDENT = 37;
const u32 AC_INT = 38;
const u32 AC_FLOAT = 39;
const u32 AC_STR = 40;
const u32 AC_CHAR = 41;
const u32 AC_TRUE = 42;
const u32 AC_FALSE = 43;
const u32 AC_NULL = 44;
const u32 AC_LIST = 45;
const u32 AC_LISTAPP = 46;
const u32 AC_CAST = 47;     // U -> ( TC ) U
const u32 AC_SIZEOF = 48;   // U -> sizeof ( T )
const u32 AC_TYPELIT = 49;  // TC -> type keyword (tokenNode pre-built it)
const u32 AC_TCSTAR = 50;   // TC -> TC * : pointer casts
const u32 AC_PLUSEQ = 51;   // E -> E += E
const u32 AC_MINUSEQ = 52;
const u32 AC_MULEQ = 53;
const u32 AC_DIVEQ = 54;
const u32 AC_MODEQ = 55;
const u32 AC_ANDEQ = 56;
const u32 AC_OREQ = 57;
const u32 AC_XOREQ = 58;
const u32 AC_SHLEQ = 59;
const u32 AC_SHREQ = 60;
const u32 AC_TIDENT = 50;   // T -> IDENT (wrap as type literal)
const u32 AC_GENERIC = 51;  // P -> P !< TARGS >
// nonterminal indices
const u32 N_E = 0;
const u32 N_B = 1;
const u32 N_C = 2;
const u32 N_D = 3;
const u32 N_F = 4;
const u32 N_G = 5;
const u32 N_H = 6;
const u32 N_M = 7;   // comparison layer (== <- precedence order)
const u32 N_I = 8;
const u32 N_J = 9;
const u32 N_K = 10;
const u32 N_L = 11;
const u32 N_U = 12;
const u32 N_P = 13;
const u32 N_ARGS = 14;
const u32 N_TC = 15;        // cast types: type keywords only (no IDENT, so
                            // "(ident)" stays a parenthesized expression)
const u32 N_T = 16;         // sizeof types: keywords + IDENT
const u32 N_TARGS = 17;     // generic arg lists: T (, T)*
const u32 N_COUNT = 18;     // AUG head = NT_BASE + N_COUNT

const u32 PREC_ASSIGN = 0;
const u32 PREC_TERNARY = 1;
const u32 PREC_OR = 2;
const u32 PREC_AND = 3;
const u32 PREC_BITOR = 4;
const u32 PREC_BITXOR = 5;
const u32 PREC_BITAND = 6;
const u32 PREC_EQ = 7;
const u32 PREC_CMP = 8;
const u32 PREC_SHIFT = 9;
const u32 PREC_ADD = 10;
const u32 PREC_MUL = 11;
const u32 PREC_UNARY = 12;

const u32 NT = 0x10000;     // lalr.NT_BASE

void addProd(lalr.Grammar* g, u32 i, u32 head, u32 n, const u32* rhs,
             u32 prec, u32 assoc, u32 action)
{
    lalr.Prod* p = &g->prods[i];
    p->head = head;
    p->nrhs = n;
    p->prec = prec;
    p->assoc = assoc;
    p->action = action;
    p->rhs = mman.alloc<u32>(n);
    for (u32 k = 0; k < n; k++) p->rhs[k] = rhs[k];
}

u32 term(u8* s) { return tok.terminalId(str.strView::fromCstr((const char*)s)); }

lalr.Grammar exprGrammar()
{
    lalr.Grammar g;
    g.nterms = tok.TOK_ANON_FIRST + tok.NUM_ANON;   // 6..(5+NUM_ANON) anonymous
    g.nnonterms = N_COUNT;
    g.nprods = 84;
    g.prods = mman.alloc<lalr.Prod>(g.nprods);
    g.start = NT + N_E;
    g.termPrec = mman.alloc<u32>(g.nterms);
    for (u32 i = 0; i < g.nterms; i++) g.termPrec[i] = 0;

    g.termPrec[term((u8*)"=")] = PREC_ASSIGN;
    g.termPrec[term((u8*)"?")] = PREC_TERNARY;
    g.termPrec[term((u8*)"||")] = PREC_OR;
    g.termPrec[term((u8*)"&&")] = PREC_AND;
    g.termPrec[term((u8*)"|")] = PREC_BITOR;
    g.termPrec[term((u8*)"^")] = PREC_BITXOR;
    g.termPrec[term((u8*)"&")] = PREC_BITAND;
    g.termPrec[term((u8*)"==")] = PREC_EQ;
    g.termPrec[term((u8*)"!=")] = PREC_EQ;
    g.termPrec[term((u8*)"<")] = PREC_CMP;
    g.termPrec[term((u8*)"<=")] = PREC_CMP;
    g.termPrec[term((u8*)">")] = PREC_CMP;
    g.termPrec[term((u8*)">=")] = PREC_CMP;
    g.termPrec[term((u8*)"<<")] = PREC_SHIFT;
    g.termPrec[term((u8*)">>")] = PREC_SHIFT;
    g.termPrec[term((u8*)"+")] = PREC_ADD;
    g.termPrec[term((u8*)"-")] = PREC_ADD;
    g.termPrec[term((u8*)"*")] = PREC_MUL;
    g.termPrec[term((u8*)"/")] = PREC_MUL;
    g.termPrec[term((u8*)"%")] = PREC_MUL;

    u32 i = 0;
    u32 r0[1];
    r0[0] = NT + N_E;
    addProd(&g, i++, NT + N_COUNT, 1, r0, 0, 0, AC_PASS);

    u32 r3[3];
    r3[0] = NT + N_E; r3[1] = term((u8*)"="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_ASSIGN);
    r3[1] = term((u8*)"+="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_PLUSEQ);
    r3[1] = term((u8*)"-="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_MINUSEQ);
    r3[1] = term((u8*)"*="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_MULEQ);
    r3[1] = term((u8*)"/="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_DIVEQ);
    r3[1] = term((u8*)"%="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_MODEQ);
    r3[1] = term((u8*)"&="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_ANDEQ);
    r3[1] = term((u8*)"|="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_OREQ);
    r3[1] = term((u8*)"^="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_XOREQ);
    r3[1] = term((u8*)"<<="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_SHLEQ);
    r3[1] = term((u8*)">>="); r3[2] = NT + N_E;
    addProd(&g, i++, NT + N_E, 3, r3, PREC_ASSIGN, lalr.ASSOC_RIGHT, AC_SHREQ);
    u32 r5[5];
    r5[0] = NT + N_E; r5[1] = term((u8*)"?"); r5[2] = NT + N_E;
    r5[3] = term((u8*)":"); r5[4] = NT + N_E;
    addProd(&g, i++, NT + N_E, 5, r5, PREC_TERNARY, lalr.ASSOC_RIGHT, AC_TERN);
    u32 r1[1];
    r1[0] = NT + N_B;
    addProd(&g, i++, NT + N_E, 1, r1, 0, 0, AC_PASS);

    u32 r3b[3];
    r3b[0] = NT + N_B; r3b[1] = term((u8*)"||"); r3b[2] = NT + N_C;
    addProd(&g, i++, NT + N_B, 3, r3b, PREC_OR, lalr.ASSOC_LEFT, AC_LOR);
    r1[0] = NT + N_C;
    addProd(&g, i++, NT + N_B, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_C; r3b[1] = term((u8*)"&&"); r3b[2] = NT + N_D;
    addProd(&g, i++, NT + N_C, 3, r3b, PREC_AND, lalr.ASSOC_LEFT, AC_LAND);
    r1[0] = NT + N_D;
    addProd(&g, i++, NT + N_C, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_D; r3b[1] = term((u8*)"|"); r3b[2] = NT + N_F;
    addProd(&g, i++, NT + N_D, 3, r3b, PREC_BITOR, lalr.ASSOC_LEFT, AC_BOR);
    r1[0] = NT + N_F;
    addProd(&g, i++, NT + N_D, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_F; r3b[1] = term((u8*)"^"); r3b[2] = NT + N_G;
    addProd(&g, i++, NT + N_F, 3, r3b, PREC_BITXOR, lalr.ASSOC_LEFT, AC_BXOR);
    r1[0] = NT + N_G;
    addProd(&g, i++, NT + N_F, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_G; r3b[1] = term((u8*)"&"); r3b[2] = NT + N_H;
    addProd(&g, i++, NT + N_G, 3, r3b, PREC_BITAND, lalr.ASSOC_LEFT, AC_BAND);
    r1[0] = NT + N_H;
    addProd(&g, i++, NT + N_G, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_H; r3b[1] = term((u8*)"=="); r3b[2] = NT + N_M;
    addProd(&g, i++, NT + N_H, 3, r3b, PREC_EQ, lalr.ASSOC_LEFT, AC_EQ);
    r3b[1] = term((u8*)"!=");
    addProd(&g, i++, NT + N_H, 3, r3b, PREC_EQ, lalr.ASSOC_LEFT, AC_NE);
    r1[0] = NT + N_M;
    addProd(&g, i++, NT + N_H, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_M; r3b[1] = term((u8*)"<"); r3b[2] = NT + N_I;
    addProd(&g, i++, NT + N_M, 3, r3b, PREC_CMP, lalr.ASSOC_LEFT, AC_LT);
    r3b[1] = term((u8*)"<=");
    addProd(&g, i++, NT + N_M, 3, r3b, PREC_CMP, lalr.ASSOC_LEFT, AC_LE);
    r3b[1] = term((u8*)">");
    addProd(&g, i++, NT + N_M, 3, r3b, PREC_CMP, lalr.ASSOC_LEFT, AC_GT);
    r3b[1] = term((u8*)">=");
    addProd(&g, i++, NT + N_M, 3, r3b, PREC_CMP, lalr.ASSOC_LEFT, AC_GE);
    r1[0] = NT + N_I;
    addProd(&g, i++, NT + N_M, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_I; r3b[1] = term((u8*)"<<"); r3b[2] = NT + N_J;
    addProd(&g, i++, NT + N_I, 3, r3b, PREC_SHIFT, lalr.ASSOC_LEFT, AC_SHL);
    r3b[1] = term((u8*)">>");
    addProd(&g, i++, NT + N_I, 3, r3b, PREC_SHIFT, lalr.ASSOC_LEFT, AC_SHR);
    r1[0] = NT + N_J;
    addProd(&g, i++, NT + N_I, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_J; r3b[1] = term((u8*)"+"); r3b[2] = NT + N_K;
    addProd(&g, i++, NT + N_J, 3, r3b, PREC_ADD, lalr.ASSOC_LEFT, AC_ADD);
    r3b[1] = term((u8*)"-");
    addProd(&g, i++, NT + N_J, 3, r3b, PREC_ADD, lalr.ASSOC_LEFT, AC_SUB);
    r1[0] = NT + N_K;
    addProd(&g, i++, NT + N_J, 1, r1, 0, 0, AC_PASS);

    r3b[0] = NT + N_K; r3b[1] = term((u8*)"*"); r3b[2] = NT + N_L;
    addProd(&g, i++, NT + N_K, 3, r3b, PREC_MUL, lalr.ASSOC_LEFT, AC_MUL);
    r3b[1] = term((u8*)"/");
    addProd(&g, i++, NT + N_K, 3, r3b, PREC_MUL, lalr.ASSOC_LEFT, AC_DIV);
    r3b[1] = term((u8*)"%");
    addProd(&g, i++, NT + N_K, 3, r3b, PREC_MUL, lalr.ASSOC_LEFT, AC_MOD);
    r1[0] = NT + N_L;
    addProd(&g, i++, NT + N_K, 1, r1, 0, 0, AC_PASS);

    r1[0] = NT + N_U;
    addProd(&g, i++, NT + N_L, 1, r1, 0, 0, AC_PASS);

    u32 r2[2];
    r2[0] = term((u8*)"-"); r2[1] = NT + N_U;
    addProd(&g, i++, NT + N_U, 2, r2, PREC_UNARY, lalr.ASSOC_RIGHT, AC_NEG);
    r2[0] = term((u8*)"!");
    addProd(&g, i++, NT + N_U, 2, r2, PREC_UNARY, lalr.ASSOC_RIGHT, AC_NOT);
    r2[0] = term((u8*)"~");
    addProd(&g, i++, NT + N_U, 2, r2, PREC_UNARY, lalr.ASSOC_RIGHT, AC_TILDE);
    r2[0] = term((u8*)"+");
    addProd(&g, i++, NT + N_U, 2, r2, PREC_UNARY, lalr.ASSOC_RIGHT, AC_POS);
    r2[0] = term((u8*)"*");
    addProd(&g, i++, NT + N_U, 2, r2, PREC_UNARY, lalr.ASSOC_RIGHT, AC_DEREF);
    r2[0] = term((u8*)"&");
    addProd(&g, i++, NT + N_U, 2, r2, PREC_UNARY, lalr.ASSOC_RIGHT, AC_ADDR);
    r2[0] = term((u8*)"++");
    addProd(&g, i++, NT + N_U, 2, r2, PREC_UNARY, lalr.ASSOC_RIGHT, AC_PREINC);
    r2[0] = term((u8*)"--");
    addProd(&g, i++, NT + N_U, 2, r2, PREC_UNARY, lalr.ASSOC_RIGHT, AC_PREDEC);
    u32 r4u[4];
    r4u[0] = term((u8*)"sizeof"); r4u[1] = term((u8*)"("); r4u[2] = NT + N_T; r4u[3] = term((u8*)")");
    addProd(&g, i++, NT + N_U, 4, r4u, PREC_UNARY, lalr.ASSOC_RIGHT, AC_SIZEOF);
    r4u[0] = term((u8*)"("); r4u[1] = NT + N_TC; r4u[2] = term((u8*)")"); r4u[3] = NT + N_U;
    addProd(&g, i++, NT + N_U, 4, r4u, 0, 0, AC_CAST);
    r1[0] = NT + N_P;
    addProd(&g, i++, NT + N_U, 1, r1, 0, 0, AC_PASS);

    u32 r4[4];
    r4[0] = NT + N_P; r4[1] = term((u8*)"("); r4[2] = NT + N_ARGS; r4[3] = term((u8*)")");
    addProd(&g, i++, NT + N_P, 4, r4, 0, 0, AC_CALL);
    r3[0] = NT + N_P; r3[1] = term((u8*)"("); r3[2] = term((u8*)")");
    addProd(&g, i++, NT + N_P, 3, r3, 0, 0, AC_CALL0);
    r4[0] = NT + N_P; r4[1] = term((u8*)"["); r4[2] = NT + N_E; r4[3] = term((u8*)"]");
    addProd(&g, i++, NT + N_P, 4, r4, 0, 0, AC_INDEX);
    r3[0] = NT + N_P; r3[1] = term((u8*)"."); r3[2] = tok.TOK_IDENT;
    addProd(&g, i++, NT + N_P, 3, r3, 0, 0, AC_DOT);
    r3[1] = term((u8*)"->");
    addProd(&g, i++, NT + N_P, 3, r3, 0, 0, AC_ARROW);
    r3[1] = term((u8*)"::");
    addProd(&g, i++, NT + N_P, 3, r3, 0, 0, AC_DOT);
    r2[0] = NT + N_P; r2[1] = term((u8*)"++");
    addProd(&g, i++, NT + N_P, 2, r2, 0, 0, AC_POSTINC);
    r2[1] = term((u8*)"--");
    addProd(&g, i++, NT + N_P, 2, r2, 0, 0, AC_POSTDEC);

    r3[0] = term((u8*)"("); r3[1] = NT + N_E; r3[2] = term((u8*)")");
    addProd(&g, i++, NT + N_P, 3, r3, 0, 0, AC_PAREN);
    u32 r1i[1];
    r1i[0] = tok.TOK_IDENT;
    addProd(&g, i++, NT + N_P, 1, r1i, 0, 0, AC_IDENT);
    r1i[0] = tok.TOK_INT;
    addProd(&g, i++, NT + N_P, 1, r1i, 0, 0, AC_INT);
    r1i[0] = tok.TOK_FLOAT;
    addProd(&g, i++, NT + N_P, 1, r1i, 0, 0, AC_FLOAT);
    r1i[0] = tok.TOK_STR;
    addProd(&g, i++, NT + N_P, 1, r1i, 0, 0, AC_STR);
    r1i[0] = tok.TOK_CHAR;
    addProd(&g, i++, NT + N_P, 1, r1i, 0, 0, AC_CHAR);
    r1i[0] = term((u8*)"true");
    addProd(&g, i++, NT + N_P, 1, r1i, 0, 0, AC_TRUE);
    r1i[0] = term((u8*)"false");
    addProd(&g, i++, NT + N_P, 1, r1i, 0, 0, AC_FALSE);
    r1i[0] = term((u8*)"null");
    addProd(&g, i++, NT + N_P, 1, r1i, 0, 0, AC_NULL);

    r1[0] = NT + N_E;
    addProd(&g, i++, NT + N_ARGS, 1, r1, 0, 0, AC_LIST);
    r3b[0] = NT + N_ARGS; r3b[1] = term((u8*)","); r3b[2] = NT + N_E;
    addProd(&g, i++, NT + N_ARGS, 3, r3b, 0, 0, AC_LISTAPP);

    u32 r1t[1];
    r1t[0] = term((u8*)"i8");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"i16");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"i32");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"i64");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"u8");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"u16");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"u32");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"u64");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"f32");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"f64");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"bool");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"char");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"void");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"isize");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);
    r1t[0] = term((u8*)"usize");
    addProd(&g, i++, NT + N_TC, 1, r1t, 0, 0, AC_TYPELIT);

    r2[0] = NT + N_TC;
    r2[1] = term((u8*)"*");
    addProd(&g, i++, NT + N_TC, 2, r2, 0, 0, AC_TCSTAR);

    r1t[0] = NT + N_TC;
    addProd(&g, i++, NT + N_T, 1, r1t, 0, 0, AC_PASS);
    r1t[0] = tok.TOK_IDENT;
    addProd(&g, i++, NT + N_T, 1, r1t, 0, 0, AC_TIDENT);

    r4[0] = NT + N_T; r4[1] = term((u8*)"!<"); r4[2] = NT + N_TARGS; r4[3] = term((u8*)">");
    addProd(&g, i++, NT + N_T, 4, r4, 0, 0, AC_GENERIC);

    r4[0] = NT + N_P; r4[1] = term((u8*)"!<"); r4[2] = NT + N_TARGS; r4[3] = term((u8*)">");
    addProd(&g, i++, NT + N_P, 4, r4, 0, 0, AC_GENERIC);

    r1[0] = NT + N_T;
    addProd(&g, i++, NT + N_TARGS, 1, r1, 0, 0, AC_LIST);
    r3b[0] = NT + N_TARGS; r3b[1] = term((u8*)","); r3b[2] = NT + N_T;
    addProd(&g, i++, NT + N_TARGS, 3, r3b, 0, 0, AC_LISTAPP);

    return g;
}

const u32 STKMAX = 256;

pub struct ExprParser
{
    lalr.Grammar g;
    lalr.Tables t;
    u8* src;
    tok.LexTok* toks;
    u32 ntoks;
    u32 tTypeMinId;  // token id range covering i8..usize type keywords
    u32 tTypeMaxId;
    u32 tTrueId;
    u32 tFalseId;
    u32 tNullId;
    u32 tLtId;
    u32 tGtId;
    u32 tAssertId;
    u32 tGtGtId;
    u32 tBangLtId;
    u32 tCommaId;
    u32 tConstId;
    u32 tColonColonId;
    u32 tLbraceId;
    u32 tSizeofId;
    u32 scr[128];       // ltPos scratch for nested generic '<' rewrites
    u32 scrSpl[32];     // scratch '>>' positions to split into two '>'
    u32 nScr;
    u32 nSpl;
    u32 errRow;         // failing lookahead position (set by fail())
    u32 errCol;
    u32 errTid;
    u32 stk[STKMAX];
    u32 sp;
    ast.Expr* sem[STKMAX];
    u32 sline[STKMAX];
    u32 scol[STKMAX];
    u32 sv;

    static ExprParser new()
    {
        ExprParser p;
        p.g = exprGrammar();
        lalr.Generator gen = lalr.Generator::new(p.g);
        gen.build(&p.t);
        gen.free();
        p.src = null;
        p.toks = null;
        p.ntoks = 0;
        p.sp = 0;
        p.sv = 0;
        p.tTypeMinId = tok.terminalId(str.strView::fromCstr("i8"));
        p.tTypeMaxId = tok.terminalId(str.strView::fromCstr("usize"));
        p.tTrueId = tok.terminalId(str.strView::fromCstr("true"));
        p.tFalseId = tok.terminalId(str.strView::fromCstr("false"));
        p.tNullId = tok.terminalId(str.strView::fromCstr("null"));
        p.tLtId = tok.terminalId(str.strView::fromCstr("<"));
        p.tGtId = tok.terminalId(str.strView::fromCstr(">"));
        p.tGtGtId = tok.terminalId(str.strView::fromCstr(">>"));
        p.tBangLtId = tok.terminalId(str.strView::fromCstr("!<"));
        p.tCommaId = tok.terminalId(str.strView::fromCstr(","));
        p.tConstId = tok.terminalId(str.strView::fromCstr("const"));
        p.tColonColonId = tok.terminalId(str.strView::fromCstr("::"));
        p.tLbraceId = tok.terminalId(str.strView::fromCstr("{"));
        p.tSizeofId = tok.terminalId(str.strView::fromCstr("sizeof"));
        p.tAssertId = tok.terminalId(str.strView::fromCstr("assert"));
        p.nScr = 0;
        p.nSpl = 0;
        return p;
    }

    void free()
    {
        for (u32 i = 0; i < self.g.nprods; i++)
            if (self.g.prods[i].rhs) mman.dealloc<u32>(self.g.prods[i].rhs);
        if (self.g.prods) mman.dealloc<lalr.Prod>(self.g.prods);
        if (self.g.termPrec) mman.dealloc<u32>(self.g.termPrec);
        if (self.t.act) mman.dealloc<lalr.Entry>(self.t.act);
        if (self.t.gotos) mman.dealloc<u32>(self.t.gotos);
        if (self.t.conflicts) mman.dealloc<lalr.Conflict>(self.t.conflicts);
    }

    ast.Expr* mk(u32 kind, u32 line, u32 col)
    {
        ast.Expr* e = mman.alloc<ast.Expr>(1);
        e->text.ptr = null;
        e->text.len = 0;
        e->a = null;
        e->b = null;
        e->c = null;
        e->args = null;
        e->nargs = 0;
        e->names = null;
        e->type = null;
        e->targs = null;
        e->ntargs = 0;
        e->post = false;
        e->kind = kind;
        e->line = line;
        e->col = col;
        return e;
    }

    ast.Expr* tokenNode(tok.LexTok* t)
    {
        str.strView s = str.strView::fromParts((const char*)self.src + t->start, t->len);
        switch (t->id)
        {
        case tok.TOK_IDENT:
        {
            ast.Expr* e = self.mk(ast.EX_IDENT, t->row, t->col);
            e->text = s;
            return e;
        }
        case tok.TOK_INT:
        {
            ast.Expr* e = self.mk(ast.EX_INT, t->row, t->col);
            e->text = s;
            return e;
        }
        case tok.TOK_FLOAT:
        {
            ast.Expr* e = self.mk(ast.EX_FLOAT, t->row, t->col);
            e->text = s;
            return e;
        }
        case tok.TOK_STR:
        {
            ast.Expr* e = self.mk(ast.EX_STR, t->row, t->col);
            e->text = s;
            return e;
        }
        case tok.TOK_CHAR:
        {
            ast.Expr* e = self.mk(ast.EX_CHAR, t->row, t->col);
            e->text = s;
            return e;
        }
        default:
            break;
        }
        if (t->id >= self.tTypeMinId && t->id <= self.tTypeMaxId)
        {
            ast.Expr* e = self.mk(ast.EX_TYPELIT, t->row, t->col);
            e->text = s;
            return e;
        }
        if (t->id == self.tAssertId)
        {
            ast.Expr* e = self.mk(ast.EX_IDENT, t->row, t->col);
            e->text = s;
            return e;
        }
        if (t->id == self.tTrueId || t->id == self.tFalseId)
        {
            ast.Expr* e = self.mk(ast.EX_BOOL, t->row, t->col);
            e->text = s;
            return e;
        }
        if (t->id == self.tNullId)
        {
            ast.Expr* e = self.mk(ast.EX_NULL, t->row, t->col);
            e->text = s;
            return e;
        }
        return null;
    }

    void apply(lalr.Prod* pr, u32 n)
    {
        u32 base = self.sv - n;
        self.sv = base;
        u32 line = self.sline[base];
        u32 col = self.scol[base];
        ast.Expr* v = null;
        if (pr->action == AC_PASS)
        {
            self.sem[self.sv++] = self.sem[base];
            return;
        }
        if (pr->action == AC_TERN)
        {
            v = self.mk(ast.EX_TERNARY, line, col);
            v->a = self.sem[base];
            v->b = self.sem[base + 2];
            v->c = self.sem[base + 4];
        }
        else if (pr->action == AC_ASSIGN || (pr->action >= AC_LOR && pr->action <= AC_MOD)
                 || (pr->action >= AC_PLUSEQ && pr->action <= AC_SHREQ))
        {
            v = self.mk(ast.EX_BINARY, line, col);
            v->a = self.sem[base];
            v->b = self.sem[base + 2];
            if (pr->action == AC_ASSIGN) v->text = str.strView::fromCstr("=");
            else if (pr->action == AC_PLUSEQ) v->text = str.strView::fromCstr("+=");
            else if (pr->action == AC_MINUSEQ) v->text = str.strView::fromCstr("-=");
            else if (pr->action == AC_MULEQ) v->text = str.strView::fromCstr("*=");
            else if (pr->action == AC_DIVEQ) v->text = str.strView::fromCstr("/=");
            else if (pr->action == AC_MODEQ) v->text = str.strView::fromCstr("%=");
            else if (pr->action == AC_ANDEQ) v->text = str.strView::fromCstr("&=");
            else if (pr->action == AC_OREQ) v->text = str.strView::fromCstr("|=");
            else if (pr->action == AC_XOREQ) v->text = str.strView::fromCstr("^=");
            else if (pr->action == AC_SHLEQ) v->text = str.strView::fromCstr("<<=");
            else if (pr->action == AC_SHREQ) v->text = str.strView::fromCstr(">>=");
            else if (pr->action == AC_LOR) v->text = str.strView::fromCstr("||");
            else if (pr->action == AC_LAND) v->text = str.strView::fromCstr("&&");
            else if (pr->action == AC_BOR) v->text = str.strView::fromCstr("|");
            else if (pr->action == AC_BXOR) v->text = str.strView::fromCstr("^");
            else if (pr->action == AC_BAND) v->text = str.strView::fromCstr("&");
            else if (pr->action == AC_EQ) v->text = str.strView::fromCstr("==");
            else if (pr->action == AC_NE) v->text = str.strView::fromCstr("!=");
            else if (pr->action == AC_LT) v->text = str.strView::fromCstr("<");
            else if (pr->action == AC_LE) v->text = str.strView::fromCstr("<=");
            else if (pr->action == AC_GT) v->text = str.strView::fromCstr(">");
            else if (pr->action == AC_GE) v->text = str.strView::fromCstr(">=");
            else if (pr->action == AC_SHL) v->text = str.strView::fromCstr("<<");
            else if (pr->action == AC_SHR) v->text = str.strView::fromCstr(">>");
            else if (pr->action == AC_ADD) v->text = str.strView::fromCstr("+");
            else if (pr->action == AC_SUB) v->text = str.strView::fromCstr("-");
            else if (pr->action == AC_MUL) v->text = str.strView::fromCstr("*");
            else if (pr->action == AC_DIV) v->text = str.strView::fromCstr("/");
            else if (pr->action == AC_MOD) v->text = str.strView::fromCstr("%");
        }
        else if (pr->action >= AC_NEG && pr->action <= AC_PREDEC)
        {
            u32 kind = ast.EX_UNARY;
            if (pr->action == AC_DEREF) kind = ast.EX_DEREF;
            else if (pr->action == AC_ADDR) kind = ast.EX_ADDR;
            v = self.mk(kind, line, col);
            v->a = self.sem[base + 1];
            if (pr->action == AC_NEG) v->text = str.strView::fromCstr("-");
            else if (pr->action == AC_NOT) v->text = str.strView::fromCstr("!");
            else if (pr->action == AC_TILDE) v->text = str.strView::fromCstr("~");
            else if (pr->action == AC_POS) v->text = str.strView::fromCstr("+");
            else if (pr->action == AC_PREINC) v->text = str.strView::fromCstr("++");
            else if (pr->action == AC_PREDEC) v->text = str.strView::fromCstr("--");
        }
        else if (pr->action == AC_POSTINC || pr->action == AC_POSTDEC)
        {
            v = self.mk(ast.EX_UNARY, line, col);
            v->a = self.sem[base];
            v->post = true;
            v->text = pr->action == AC_POSTINC ? str.strView::fromCstr("++")
                                               : str.strView::fromCstr("--");
        }
        else if (pr->action == AC_CALL)
        {
            ast.Expr* cont = self.sem[base + 2];
            v = self.mk(ast.EX_CALL, line, col);
            v->a = self.sem[base];
            v->args = cont->args;
            v->nargs = cont->nargs;
            mman.dealloc<ast.Expr>(cont);
        }
        else if (pr->action == AC_CALL0)
        {
            v = self.mk(ast.EX_CALL, line, col);
            v->a = self.sem[base];
            v->args = null;
            v->nargs = 0;
        }
        else if (pr->action == AC_GENERIC)
        {
            ast.Expr* cont = self.sem[base + 2];
            v = self.mk(ast.EX_GENERIC, line, col);
            v->a = self.sem[base];
            v->args = cont->args;
            v->nargs = cont->nargs;
            mman.dealloc<ast.Expr>(cont);
        }
        else if (pr->action == AC_INDEX)
        {
            v = self.mk(ast.EX_INDEX, line, col);
            v->a = self.sem[base];
            v->b = self.sem[base + 2];
        }
        else if (pr->action == AC_DOT || pr->action == AC_ARROW)
        {
            ast.Expr* m = self.sem[base + 2];
            v = self.mk(pr->action == AC_DOT ? ast.EX_DOT : ast.EX_ARROW, line, col);
            v->a = self.sem[base];
            v->text = m->text;
            mman.dealloc<ast.Expr>(m);
        }
        else if (pr->action == AC_PAREN)
        {
            v = self.mk(ast.EX_PAREN, line, col);
            v->a = self.sem[base + 1];
        }
        else if ((pr->action >= AC_IDENT && pr->action <= AC_NULL) || pr->action == AC_TYPELIT)
        {
            self.sem[self.sv++] = self.sem[base];
            return;
        }
        else if (pr->action == AC_LIST)
        {
            v = self.mk(ast.EX_INIT, line, col);
            v->args = mman.alloc<ast.Expr*>(1);
            v->args[0] = self.sem[base];
            v->nargs = 1;
        }
        else if (pr->action == AC_LISTAPP)
        {
            ast.Expr* cont = self.sem[base];
            u32 nn = cont->nargs + 1;
            ast.Expr** na = mman.alloc<ast.Expr*>(nn);
            for (u32 k = 0; k < cont->nargs; k++) na[k] = cont->args[k];
            if (cont->args) mman.dealloc<ast.Expr*>(cont->args);
            na[nn - 1] = self.sem[base + 2];
            cont->args = na;
            cont->nargs = nn;
            v = cont;
        }
        else if (pr->action == AC_CAST)
        {
            ast.Expr* ty = self.sem[base + 1];
            v = self.mk(ast.EX_CAST, line, col);
            v->a = self.sem[base + 3];
            v->text = ty->text;
            mman.dealloc<ast.Expr>(ty);
        }
        else if (pr->action == AC_TCSTAR)
        {
            ast.Expr* t = (ast.Expr*)(u64)self.sem[base];
            v = self.mk(ast.EX_TYPELIT, line, col);
            v->text = t->text;
            str.String sb = str.String::new();
            if (v->text.len > 0) sb.pushView(v->text);
            sb.pushView(str.strView::fromCstr("*"));
            v->text = sb.asView();
            mman.dealloc<ast.Expr>(t);
        }
        else if (pr->action == AC_SIZEOF)
        {
            ast.Expr* ty = self.sem[base + 2];
            v = self.mk(ast.EX_SIZEOF, line, col);
            v->text = ty->text;
            mman.dealloc<ast.Expr>(ty);
        }
        else if (pr->action == AC_TIDENT)
        {
            ast.Expr* id = self.sem[base];
            v = self.mk(ast.EX_TYPELIT, line, col);
            v->text = id->text;
            mman.dealloc<ast.Expr>(id);
        }
        else
        {
            self.sem[self.sv++] = null;
            return;
        }

        self.sem[self.sv++] = v;
        self.sline[self.sv - 1] = v->line;
        self.scol[self.sv - 1] = v->col;
    }

    bool inStops(u32 tid, const u32* stops, u32 nstops)
    {
        for (u32 i = 0; i < nstops; i++)
            if (stops[i] == tid) return true;
        return false;
    }

    // True when tid can begin an expression. Used to tell a comparison chain
    // (`a < b > c` keeps the comparison reading) from a generic instantiation
    // (`Foo<T>` is followed by a call, '::', an operator or a stop).
    bool exprStart(u32 tid)
    {
        if (tid == tok.TOK_IDENT || tid == tok.TOK_INT || tid == tok.TOK_FLOAT
            || tid == tok.TOK_STR || tid == tok.TOK_CHAR) return true;
        if (tid == self.tTrueId || tid == self.tFalseId || tid == self.tNullId
            || tid == self.tLbraceId || tid == self.tSizeofId
            || tid == self.tAssertId) return true;
        return false;
    }

    // Matches a plain-`<` type-argument list whose '<' is at ltPos, at
    // nesting depth `depth` (1 = outermost). Args are IDENTs or type
    // keywords, optionally `const`-prefixed or `::`-paths, and may nest
    // further generic types. The list must close with '>' (any depth) or,
    // at depth >= 2, '>>' (which also closes the enclosing list). On
    // success sets *end to the token just past the closer, *doubleClose to
    // true when a '>>' closed this list, and appends every '<' it spans to
    // scr[] and every '>>' closer to scrSpl[]. On any mismatch returns false.
    bool matchArgs(u32 ltPos, u32 depth, u32* end, bool* doubleClose)
    {
        if (self.nScr >= 128) return false;
        self.scr[self.nScr++] = ltPos;
        u32 i = ltPos + 1;
        while (true)
        {
            if (i >= self.ntoks) return false;
            u32 tid = self.toks[i].id;
            if (tid == self.tCommaId) { i++; continue; }
            if (tid == self.tGtId) { *end = i + 1; *doubleClose = false; return true; }
            if (tid == self.tGtGtId)
            {
                if (depth < 2 || self.nSpl >= 32) return false;
                self.scrSpl[self.nSpl++] = i;
                *end = i + 1;
                *doubleClose = true;
                return true;
            }
            if (tid == self.tConstId)
            {
                i++;
                if (i >= self.ntoks) return false;
                tid = self.toks[i].id;
            }
            if (tid != tok.TOK_IDENT && (tid < self.tTypeMinId || tid > self.tTypeMaxId))
                return false;
            i++;
            while (i + 1 < self.ntoks && self.toks[i].id == self.tColonColonId
                   && (self.toks[i + 1].id == tok.TOK_IDENT
                       || (self.toks[i + 1].id >= self.tTypeMinId
                           && self.toks[i + 1].id <= self.tTypeMaxId)))
                i += 2;
            if (i < self.ntoks && self.toks[i].id == self.tLtId)
            {
                u32 ne;
                bool nd;
                if (!self.matchArgs(i, depth + 1, &ne, &nd)) return false;
                if (nd)
                {
                    *end = ne;
                    *doubleClose = false;   // '>>' closed the nested list and us
                    return true;
                }
                i = ne;
            }
        }
    }

    // Probes [start, ntoks) for `IDENT <` pairs forming a valid type-arg
    // list (see matchArgs), scanning up to the first stop token. Outermost
    // matches whose closer is immediately followed by another expression
    // keep their comparison reading (`a < b > c`). Rewrite positions land in
    // rew[] (*nrew, count of '<' to flip to '!<') and spl[] (*nspl, '>>'
    // closers to split into two '>').
    void probeGeneric(u32 start, const u32* stops, u32 nstops,
                      u32* rew, u32* nrew, u32* spl, u32* nspl)
    {
        u32 i = start;
        while (i + 1 < self.ntoks)
        {
            u32 tid = self.toks[i].id;
            if (self.inStops(tid, stops, nstops)) return;
            if (tid == tok.TOK_IDENT && self.toks[i + 1].id == self.tLtId)
            {
                u32 end;
                bool dbl;
                self.nScr = 0;
                self.nSpl = 0;
                if (self.matchArgs(i + 1, 1, &end, &dbl)
                    && !(end < self.ntoks && self.exprStart(self.toks[end].id)))
                {
                    if (*nrew + self.nScr <= 128 && *nspl + self.nSpl <= 32)
                    {
                        for (u32 k = 0; k < self.nScr; k++) rew[(*nrew)++] = self.scr[k];
                        for (u32 k = 0; k < self.nSpl; k++) spl[(*nspl)++] = self.scrSpl[k];
                    }
                    i = end;
                    continue;
                }
            }
            i++;
        }
    }

    // Frees any partially-built nodes on a failed parse (the caller cannot
    // use them). Only called from error paths in parseFrom.
    void clearSem()
    {
        for (u32 k = 0; k < self.sv; k++) ast.freeExpr(self.sem[k]);
        self.sv = 0;
    }

    // Records the failing lookahead, frees partial nodes, returns null.
    ast.Expr* fail(u32 ip)
    {
        if (ip < self.ntoks)
        {
            self.errRow = self.toks[ip].row;
            self.errCol = self.toks[ip].col;
            self.errTid = self.toks[ip].id;
        }
        else
        {
            self.errRow = 0;
            self.errCol = 0;
            self.errTid = tok.TOK_EOF;
        }
        self.clearSem();
        return null;
    }

    ParseErr errFromFail()
    {
        ParseErr pe;
        pe.row = self.errRow;
        pe.col = self.errCol;
        pe.tid = self.errTid;
        return pe;
    }

    // Drives the LALR tables over self.toks from token ip0 until accept or
    // a stop token. Returns the node (and sets *consumed to the token index
    // just past the expression) or null on any parse failure.
    ast.Expr* parseLoop(u32 ip0, const u32* stops, u32 nstops, u32* consumed)
    {
        u32 ip = ip0;
        while (true)
        {
            u32 state = self.stk[self.sp];
            u32 tid = ip < self.ntoks ? self.toks[ip].id : tok.TOK_EOF;
            lalr.Entry* en = &self.t.act[state * self.t.nterms + tid];
            if (en->kind == lalr.ACT_ERROR && ip < self.ntoks
                && self.inStops(tid, stops, nstops))
            {
                if (self.sv == 1)
                {
                    *consumed = ip;
                    return self.sem[0];
                }
                // The stop token ends the expression, but the item
                // lookahead sets never contain stop tokens, so the table
                // has no reduce action for them. Chain-reduce using EOF as
                // the lookahead (it is in the start symbol's lookahead set
                // and stops terminate the same way EOF does), then cut.
                while (self.sv > 1)
                {
                    u32 st = self.stk[self.sp];
                    lalr.Entry* e2 = &self.t.act[st * self.t.nterms + tok.TOK_EOF];
                    if (e2->kind != lalr.ACT_REDUCE) break;
                    lalr.Prod* pr = &self.g.prods[e2->a];
                    if (pr->nrhs > self.sp) break;
                    self.sp -= pr->nrhs;
                    self.apply(pr, pr->nrhs);
                    if (self.sv == 0) break;
                    u32 top = self.stk[self.sp];
                    u32 headIdx = pr->head - lalr.NT_BASE;
                    if (headIdx >= self.t.nnonterms) break;
                    u32 go = self.t.gotos[top * self.t.nnonterms + headIdx];
                    if (go == lalr.NO_STATE) break;
                    self.sp++;
                    self.stk[self.sp] = go;
                }
                if (self.sv == 1)
                {
                    *consumed = ip;
                    return self.sem[0];
                }
                return self.fail(ip);
            }
            if (en->kind == lalr.ACT_SHIFT)
            {
                if (self.sp + 1 >= STKMAX || self.sv >= STKMAX)
                {
                    return self.fail(ip);
                }
                self.sp++;
                self.stk[self.sp] = en->a;
                self.sem[self.sv] = self.tokenNode(&self.toks[ip]);
                self.sline[self.sv] = self.toks[ip].row;
                self.scol[self.sv] = self.toks[ip].col;
                self.sv++;
                ip++;
            }
            else if (en->kind == lalr.ACT_REDUCE)
            {
                lalr.Prod* pr = &self.g.prods[en->a];
                if (pr->nrhs > self.sp)
                {
                    return self.fail(ip);
                }
                self.sp -= pr->nrhs;
                self.apply(pr, pr->nrhs);
                if (self.sv == 0)
                {
                    return self.fail(ip);
                }
                u32 top = self.stk[self.sp];
                u32 headIdx = pr->head - lalr.NT_BASE;
                if (headIdx >= self.t.nnonterms)
                {
                    return self.fail(ip);
                }
                u32 go = self.t.gotos[top * self.t.nnonterms + headIdx];
                if (go == lalr.NO_STATE)
                {
                    return self.fail(ip);
                }
                self.sp++;
                self.stk[self.sp] = go;
            }
            else if (en->kind == lalr.ACT_ACCEPT)
            {
                if (ip == self.ntoks - 1 && self.sv == 1)
                {
                    *consumed = ip;
                    return self.sem[0];
                }
                return self.fail(ip);
            }
            else
            {
                return self.fail(ip);
            }
        }
    }

    // Parses one expression starting at token offset `start` and returns
    // the node plus, in *consumed, the offset just past it (the token that
    // ended the expression, or the EOF token index). A token in `stops`
    // terminates the expression only where the grammar has no transition
    // for it (ACT_ERROR), so tokens that the expression itself legitimately
    // contains (a ternary ':', an argument-list ',') are never cut short.
    // Plain-`<` generic instantiations (IDENT < TARGS >) are recognized by
    // probeGeneric and parsed through the LALR '!<' productions; '>>' that
    // closes two nested levels is split into two '>'.
    // Returns the node, or a ParseErr with the failing lookahead position.
    res.Result<ast.Expr*, ParseErr> parseFrom(u8* src, tok.LexTok* toks,
                                              u32 ntoks, u32 start,
                                              const u32* stops, u32 nstops,
                                              u32* consumed)
    {
        self.src = src;
        self.toks = toks;
        self.ntoks = ntoks;
        self.sp = 0;
        self.sv = 0;
        self.stk[0] = 0;
        u32 rew[128];
        u32 spl[32];
        u32 nrew = 0;
        u32 nspl = 0;
        self.probeGeneric(start, stops, nstops, rew, &nrew, spl, &nspl);
        if (nrew == 0)
        {
            ast.Expr* r = self.parseLoop(start, stops, nstops, consumed);
            if (r == null) return errExpr(self.errFromFail());
            return okExpr(r);
        }

        // A plain-`<` generic was recognized: build an adjusted copy of the
        // window ('<' flipped to '!<', '>>' split into two '>'), parse from
        // it, then map the consumed index back to the original array.
        u32 wN = ntoks - start + nspl;
        tok.LexTok* wToks = mman.alloc<tok.LexTok>(wN);
        u32* origOf = mman.alloc<u32>(wN);
        u32 li = 0;
        for (u32 p = start; p < ntoks; p++)
        {
            bool isSpl = false;
            bool isRew = false;
            for (u32 k = 0; k < nspl; k++) if (spl[k] == p) { isSpl = true; break; }
            for (u32 k = 0; k < nrew; k++) if (rew[k] == p) { isRew = true; break; }
            wToks[li] = toks[p];
            if (isRew) wToks[li].id = self.tBangLtId;
            if (isSpl) wToks[li].id = self.tGtId;
            origOf[li] = p;
            li++;
            if (isSpl)
            {
                wToks[li] = toks[p];
                wToks[li].id = self.tGtId;
                origOf[li] = p;
                li++;
            }
        }
        self.toks = wToks;
        self.ntoks = wN;
        u32 c = 0;
        ast.Expr* r = self.parseLoop(0, stops, nstops, &c);
        self.toks = toks;
        self.ntoks = ntoks;
        mman.dealloc<tok.LexTok>(wToks);
        mman.dealloc<u32>(origOf);
        if (r == null) return errExpr(self.errFromFail());
        *consumed = origOf[c];
        return okExpr(r);
    }

    res.Result<ast.Expr*, ParseErr> parse(u8* src, tok.LexTok* toks, u32 ntoks)
    {
        u32 consumed = 0;
        return self.parseFrom(src, toks, ntoks, 0, null, 0, &consumed);
    }
}