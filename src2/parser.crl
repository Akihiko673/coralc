    for (u32 i = 0; i < *n; i++) na[i] = (*arr)[i];
    if (*arr) mman.dealloc<ast.Expr*>(*arr);
    *arr = na;
    *cap = nc;
}

void growTypeArr(ast.TypeExpr*** arr, u32* n, u32* cap)
{
    if (*n < *cap) return;
    u32 nc = *cap ? *cap * 2 : 8;
    ast.TypeExpr** na = mman.alloc<ast.TypeExpr*>(nc);
    for (u32 i = 0; i < *n; i++) na[i] = (*arr)[i];
    if (*arr) mman.dealloc<ast.TypeExpr*>(*arr);
    *arr = na;
    *cap = nc;
}

void growParamArr(ast.Param** arr, u32* n, u32* cap)
{
    if (*n < *cap) return;
    u32 nc = *cap ? *cap * 2 : 8;
    ast.Param* na = mman.alloc<ast.Param>(nc);
    for (u32 i = 0; i < *n; i++) na[i] = (*arr)[i];
    if (*arr) mman.dealloc<ast.Param>(*arr);
    *arr = na;
    *cap = nc;
}

void growStrArr(str.strView** arr, u32* n, u32* cap)
{
    if (*n < *cap) return;
    u32 nc = *cap ? *cap * 2 : 8;
    str.strView* na = mman.alloc<str.strView>(nc);
    for (u32 i = 0; i < *n; i++) na[i] = (*arr)[i];
    if (*arr) mman.dealloc<str.strView>(*arr);
    *arr = na;
    *cap = nc;
}

void growCaseArr(ast.StmtCase*** arr, u32* n, u32* cap)
{
    if (*n < *cap) return;
    u32 nc = *cap ? *cap * 2 : 8;
    ast.StmtCase** na = mman.alloc<ast.StmtCase*>(nc);
    for (u32 i = 0; i < *n; i++) na[i] = (*arr)[i];
    if (*arr) mman.dealloc<ast.StmtCase*>(*arr);
    *arr = na;
    *cap = nc;
}

// node builders

ast.TypeExpr* typeBase(u32 kind, str.strView name, u32 line, u32 col)
{
    ast.TypeExpr* t = mman.alloc<ast.TypeExpr>(1);
    t->kind = kind;
    t->name = name;
    t->elem = null;
    t->count = null;
    t->args = null;
    t->nargs = 0;
    t->cargs = null;
    t->ncargs = 0;
    t->ret = null;
    t->isConst = false;
    t->line = line;
    t->col = col;
    return t;
}

ast.Expr* exprBase(u32 kind, u32 line, u32 col)
{
    ast.Expr* e = mman.alloc<ast.Expr>(1);
    e->kind = kind;
    e->text = str.strView::empty();
    e->a = null;
    e->b = null;
    e->c = null;
    e->args = null;
    e->nargs = 0;
    e->names = null;
    e->type = null;
    e->targs = null;
    e->ntargs = 0;
    e->post = false;
    e->line = line;
    e->col = col;
    return e;
}

ast.Stmt* stmtBase(u32 kind, u32 line, u32 col)
{
    ast.Stmt* s = mman.alloc<ast.Stmt>(1);
    s->kind = kind;
    s->text = str.strView::empty();
    s->type = null;
    s->a = null;
    s->b = null;
    s->c = null;
    s->body = null;
    s->body2 = null;
    s->init = null;
    s->stmts = null;
    s->nstmts = 0;
    s->cases = null;
    s->ncases = 0;
    s->defaultCase = null;
    s->line = line;
    s->col = col;
    return s;
}

ast.Decl* declBase(u32 kind, u32 line, u32 col)
{
    ast.Decl* d = mman.alloc<ast.Decl>(1);
    d->kind = kind;
    d->name = str.strView::empty();
    d->text = str.strView::empty();
    d->type = null;
    d->value = null;
    d->exported = false;
    d->isStatic = false;
    d->isInline = false;
    d->isExtern = false;
    d->noreturn = false;
    d->isVar = false;
    d->cc = str.strView::empty();
    d->structName = str.strView::empty();
    d->traitName = str.strView::empty();
    d->generics = null;
    d->ngenerics = 0;
    d->fields = null;
    d->nfields = 0;
    d->variants = null;
    d->nvariants = 0;
    d->params = null;
    d->nparams = 0;
    d->variadic = false;
    d->body = null;
    d->decls = null;
    d->ndecls = 0;
    d->cases = null;
    d->caseNames = null;
    d->caseLens = null;
    d->ncases = 0;
    d->defaultBody = null;
    d->ndeclDefault = 0;
    d->line = line;
    d->col = col;
    return d;
}

// declarations

void parseDecls()
{
    ast.Decl** arr = null;
    u32 n = 0;
    u32 cap = 0;
    while (!self.check(tok.TOK_EOF) && !self.check(T_RBRACE))
    {
        ast.Decl* outs[2];
        u32 cnt = self.parseDecl(outs);
        for (u32 i = 0; i < cnt; i++)
        {
            self.growDeclArr(&arr, &n, &cap);
            arr[n++] = outs[i];
        }
        self.skipSemicolons();
    }
    self.decls = arr;
    self.ndecls = n;
    self.declCap = cap;
}

// returns count written into outs (0..2)
u32 parseDecl(ast.Decl* outs[2])
{
    self.skipSemicolons();
    if (self.check(tok.TOK_EOF)) return 0;
    self.skipFileAttrs();
    self.parseAttachedAttrs();
    bool exported = false;
    if (self.check(T_PUB)) { self.advance(); exported = true; }
    self.skipFileAttrs();
    self.parseAttachedAttrs();
    return self.parseDeclExported(outs, exported);
}

u32 parseDeclExported(ast.Decl* outs[2], bool exported)
{
    if (self.check(T_MOD))
    {
        outs[0] = self.parseModuleDecl(outs[1]);
        return 2;
    }
    if (self.check(T_EXTERN))
    {
        outs[0] = self.parseExternDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_STATIC))
    {
        self.advance();
        outs[0] = self.parseTypeFirstDecl(exported, true, false);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_INLINE))
    {
        self.advance();
        outs[0] = self.parseTypeFirstDecl(exported, false, true);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_CONST))
    {
        outs[0] = self.parseConstDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_VAR))
    {
        outs[0] = self.parseVarDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_STRUCT))
    {
        outs[0] = self.parseStructDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_ENUM))
    {
        outs[0] = self.parseEnumDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_TRAIT))
    {
        outs[0] = self.parseTraitDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_TYPEDEF))
    {
        outs[0] = self.parseTypedefDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_DISTINCT))
    {
        outs[0] = self.parseDistinctDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_IDENT) && vEq(self.curText(), "compiler_fn"))
    {
        outs[0] = self.parseCompilerFnDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_FLAG))
    {
        outs[0] = self.parseFlagDecl(exported);
        return outs[0] ? 1 : 0;
    }
    if (self.isTypeTok(self.peekTok(0)) || self.check(T_IDENT))
    {
        outs[0] = self.parseTypeFirstDecl(exported, false, false);
        return outs[0] ? 1 : 0;
    }
    if (self.check(T_RBRACE)) return 0;

    str.String s = str.String::new();
    s.pushView(str.strView::fromCstr("unexpected token "));
    self.tokenDisplayStr(&s, self.peekTok(0));
    self.setErrAt(self.peekTok(0), &s);
    s.free();
    return 0;
}

ast.Decl* parseModuleDecl(ast.Decl* importOut)
{
    tok.LexTok* t = self.advance();
    str.strView alias = self.expectIdent();
    if (self.errored) return null;
    self.expect(T_ASSIGN);
    if (self.check(T_IMPORT)) self.advance();
    self.expect(T_LPAREN);
    str.strView path = self.expectString();
    self.expect(T_RPAREN);
    self.expect(T_SEMI);
    ast.Decl* d = self.declBase(ast.DT_MODULE, t->row, t->col);
    d->name = alias;
    d->text = path;
    ast.Decl* di = self.declBase(ast.DT_IMPORT, t->row, t->col);
    di->text = path;
    di->name = alias;
    importOut = di;
    return d;
}

ast.Decl* parseExternDecl(bool exported)
{
    tok.LexTok* t = self.advance(); // 'extern'
    str.strView cc = str.strView::empty();
    if (self.check(T_LPAREN))
    {
        self.advance();
        cc = self.expectString();
        self.expect(T_RPAREN);
    }
    self.skipFileAttrs();
    self.parseAttachedAttrs();
    ast.TypeExpr* ret = self.parseType();
    if (ret == null) self.errExpectTok(T_IDENT);
    str.strView name = self.expectIdent();
    if (self.errored) return null;
    ast.Param* params = null;
    u32 nparams = 0;
    u32 pcap = 0;
    bool variadic = false;
    bool isVar = false;
    if (self.check(T_LPAREN))
    {
        self.advance();
        self.parseParamList(&params, &nparams, &pcap, &variadic);
        self.expect(T_RPAREN);
        self.expect(T_SEMI);
        ast.Decl* d = self.declBase(ast.DT_EXTERN, self.peekTok(-1)->row, self.peekTok(-1)->col);
        d->name = name;
        d->type = ret;
        d->params = params;
        d->nparams = nparams;
        d->variadic = variadic;
        d->cc = cc;
        d->noreturn = self.hasAttr("noret");
        d->exported = exported;
        return d;
    }
    else
    {
        self.expect(T_SEMI);
        ast.Decl* d = self.declBase(ast.DT_EXTERN, self.peekTok(-1)->row, self.peekTok(-1)->col);
        d->name = name;
        d->type = ret;
        d->cc = cc;
        d->noreturn = self.hasAttr("noret");
        d->exported = exported;
        d->isVar = true;
        return d;
    }
}

ast.Decl* parseConstDecl(bool exported)
{
    tok.LexTok* t = self.advance();
    Mark saved = self.mark();
    bool nextIsIdent = self.check(T_IDENT);
    bool isArr = nextIsIdent && (self.peekTok(1)->id == T_ASSIGN || self.peekTok(1)->id == T_LBRACKET || self.peekTok(1)->id == T_SEMI);
    str.strView name = str.strView::empty();
    ast.TypeExpr* typeAnno = null;
    if (isArr)
    {
        name = self.advance()->id == 1 ? self.text(self.peekTok(-1)) : str.strView::empty();
        if (self.check(T_LBRACKET))
        {
            self.advance();
            ast.Expr* arraySize = null;
            if (!self.check(T_RBRACKET)) arraySize = self.parseExpr();
            self.expect(T_RBRACKET);
            typeAnno = self.typeBase(ast.TYP_ARRAY, str.strView::empty(), self.peekTok(-2)->row, self.peekTok(-2)->col);
            typeAnno->elem = self.typeBase(ast.TYP_IDENT, str.strView::fromCstr("void"), self.peekTok(-2)->row, self.peekTok(-2)->col);
            typeAnno->count = arraySize;
        }
    }
    else
    {
        typeAnno = self.parseType();
        if (self.errored) return null;
        if (typeAnno == null)
        {
            self.errorMsg("expected a type in const declaration");
            return null;
        }
        tok.LexTok* nameTok = self.peekTok(0);
        if (!(self.check(T_IDENT) || self.check(T_SELF) || self.isTypeTok(nameTok)))
        {
            self.errExpectTok(T_IDENT);
            return null;
        }
        name = self.text(self.peekTok(0));
        self.advance();
        if (self.check(T_LPAREN))
        {
            self.rewind(saved);
            ast.Decl* outs[2];
            outs[0] = self.parseTypeFirstDecl(exported, false, false);
            return outs[0];
        }
        if (self.check(T_LBRACKET))
        {
            self.advance();
            ast.Expr* arraySize = null;
            if (!self.check(T_RBRACKET)) arraySize = self.parseExpr();
            self.expect(T_RBRACKET);
            typeAnno = self.typeBase(ast.TYP_ARRAY, str.strView::empty(), typeAnno->line, typeAnno->col);
            typeAnno->elem = typeAnno;
            typeAnno->count = arraySize;
        }
    }
    self.expect(T_ASSIGN);
    ast.Expr* value = self.parseExpr();
    self.expect(T_SEMI);
    ast.Decl* d = self.declBase(ast.DT_CONST, self.peekTok(-1)->row, self.peekTok(-1)->col);
    d->name = name;
    d->type = typeAnno;
    d->value = value;
    d->exported = exported;
    return d;
}

ast.Decl* parseVarDecl(bool exported)
{
    tok.LexTok* t = self.advance();
    str.strView name = self.expectIdent();
    if (self.errored) return null;
    ast.TypeExpr* typeAnno = null;
    if (self.check(T_COLON))
    {
        self.advance();
        typeAnno = self.parseType();
    }
    ast.Expr* value = null;
    if (self.check(T_ASSIGN))
    {
        self.advance();
        value = self.parseExpr();
    }
    self.expect(T_SEMI);
    ast.Decl* d = self.declBase(ast.DT_VAR, self.peekTok(-1)->row, self.peekTok(-1)->col);
    d->name = name;
    d->type = typeAnno;
    d->value = value;
    d->exported = exported;
    return d;
}

ast.Decl* parseStructDecl(bool exported)
{
    self.advance(); // 'struct'
    str.strView name = self.expectIdent();
    if (self.errored) return null;
    self.ctxPush(CTX_STRUCT, name, str.strView::empty());
    ast.Decl* d = self.parseStructDeclRest(exported, name);
    self.ctxPop();
    return d;
}

ast.Decl* parseStructDeclRest(bool exported, str.strView name)
{
    ast.TypeExpr** genericParams = null;
    u32 ng = 0;
    u32 gcap = 0;
    if (self.check(T_LT))
    {
        self.advance();
        self.parseGenericParamList(&genericParams, &ng, &gcap);
        self.expect(T_GT);
    }
    self.skipFileAttrs();
    self.parseAttachedAttrs();
    self.expect(T_LBRACE);
    ast.StructField* fields = null;
    u32 nf = 0;
    u32 fcap = 0;
    ast.Decl** methods = null;
    u32 nm = 0;
    u32 mcap = 0;
    while (!self.check(T_RBRACE) && !self.check(tok.TOK_EOF))
    {
        if (self.check(T_SEMI)) { self.advance(); continue; }
        if (self.check(T_STATIC))
        {
            self.advance();
            ast.Decl* method = self.parseFuncDecl(false, false, name, str.strView::empty());
            if (method != null)
            {
                method->isStatic = true;
                self.growDeclArr(&methods, &nm, &mcap);
                methods[nm++] = method;
            }
            self.skipSemicolons();
            continue;
        }
        if (self.isTypeTok(self.peekTok(0)) || self.check(T_IDENT) || self.check(T_CONST))
        {
            Mark saved = self.mark();
            ast.TypeExpr* fieldType = self.parseTypeOrExprAsType();
            if (self.errored || fieldType == null)
            {
                self.rewind(saved);
                ast.Decl* method = self.parseFuncDecl(false, true, name, str.strView::empty());
                if (method != null)
                {
                    self.growDeclArr(&methods, &nm, &mcap);
                    methods[nm++] = method;
                }
                self.skipSemicolons();
                continue;
            }
            tok.LexTok* ft = self.peekTok(0);
            bool hasName = self.check(T_IDENT) || self.check(T_SELF) || self.isTypeTok(ft);
            if (hasName)
            {
                strView fname = self.text(self.peekTok(0));
                self.advance();
                if (self.check(T_LPAREN) || self.check(T_LT) || self.check(T_BANG_LT))
                {
                    self.rewind(saved);
                    ast.Decl* method = self.parseFuncDecl(false, true, name, str.strView::empty());
                    if (method != null)
                    {
                        self.growDeclArr(&methods, &nm, &mcap);
                        methods[nm++] = method;
                    }
                    self.skipSemicolons();
                    continue;
                }
                ast.Expr* arraySize = null;
                while (self.check(T_LBRACKET))
                {
                    self.advance();
                    ast.Expr* dim = self.parseExpr();
                    self.expect(T_RBRACKET);
                    ast.TypeExpr* t = self.typeBase(ast.TYP_ARRAY, str.strView::empty(), fieldType->line, fieldType->col);
                    t->elem = fieldType;
                    t->count = dim;
                    fieldType = t;
                }
                ast.StructField f;
                f.name = fname;
                f.type = fieldType;
                self.growParamArr(&fields, &nf, &fcap);
                fields[nf++] = f;
                self.expect(T_SEMI);
            }
            else
            {
                self.rewind(saved);
                ast.Decl* method = self.parseFuncDecl(false, true, name, str.strView::empty());
                if (method != null)
                {
                    self.growDeclArr(&methods, &nm, &mcap);
                    methods[nm++] = method;
                }
                self.skipSemicolons();
            }
        }
        else
        {
            ast.Decl* method = self.parseFuncDecl(false, true, name, str.strView::empty());
            if (method != null)
            {
                self.growDeclArr(&methods, &nm, &mcap);
                methods[nm++] = method;
            }
            self.skipSemicolons();
        }
    }
    self.expect(T_RBRACE);
    ast.Decl* d = self.declBase(ast.DT_STRUCT, self.peekTok(-1)->row, self.peekTok(-1)->col);
    d->name = name;
    d->generics = null;
    d->ngenerics = 0;
    // generic names discarded by parseGenericParamList(&strView) form; keep 0
    d->fields = fields;
    d->nfields = nf;
    d->decls = methods;
    d->ndecls = nm;
    d->exported = exported;
    return d;
}

ast.Decl* parseEnumDecl(bool exported)
{
    self.advance();
    str.strView name = self.expectIdent();
    if (self.errored) return null;
    self.ctxPush(CTX_ENUM, name, str.strView::empty());
    ast.Decl* d = self.parseEnumDeclRest(exported, name);
    self.ctxPop();
    return d;
}

ast.Decl* parseEnumDeclRest(bool exported, str.strView name)
{
    self.expect(T_LBRACE);
    ast.EnumVariant* variants = null;
    u32 nv = 0;
    u32 vcap = 0;
    while (!self.check(T_RBRACE) && !self.check(tok.TOK_EOF))
    {
        tok.LexTok* vt = self.peekTok(0);
        str.strView varName = self.expectIdent();
        if (self.errored) return null;
        if (self.check(T_LPAREN))
        {
            self.advance();
            while (!self.check(T_RPAREN) && !self.check(tok.TOK_EOF))
            {
                ast.TypeExpr* pt = self.parseType();
                if (self.check(T_COMMA)) self.advance();
            }
            self.expect(T_RPAREN);
        }
        ast.Expr* value = null;
        if (self.check(T_ASSIGN))
        {
            self.advance();
            value = self.parseExpr();
        }
        ast.EnumVariant v;
        v.name = varName;
        v.value = value;
        self.growParamArr(&variants, &nv, &vcap);
        variants[nv++] = v;
        if (self.check(T_COMMA)) self.advance();
    }
    self.expect(T_RBRACE);
    ast.Decl* d = self.declBase(ast.DT_ENUM, self.peekTok(-1)->row, self.peekTok(-1)->col);
    d->name = name;
    d->variants = variants;
    d->nvariants = nv;
    d->exported = exported;
    return d;
}

ast.Decl* parseTraitDecl(bool exported)
{
    self.advance();
    str.strView name = self.expectIdent();
    if (self.errored) return null;
    self.ctxPush(CTX_TRAIT, name, str.strView::empty());
    ast.Decl* d = self.parseTraitDeclRest(exported, name);
    self.ctxPop();
    return d;
}

ast.Decl* parseTraitDeclRest(bool exported, str.strView name)
{
    self.expect(T_LBRACE);
    ast.Decl** methods = null;
    u32 nm = 0;
    u32 mcap = 0;
    while (!self.check(T_RBRACE) && !self.check(tok.TOK_EOF))
    {
        if (self.check(T_SEMI)) { self.advance(); continue; }
        tok.LexTok* rt = self.peekTok(0);
        ast.TypeExpr* returnType = self.parseType();
        if (returnType == null) { self.errExpectTok(T_IDENT); return null; }
        str.strView methodName = self.expectIdent();
        ast.TypeExpr** generics = null;
        u32 ng = 0;
        u32 gcap = 0;
        if (self.check(T_BANG_LT))
        {
            self.advance();
            self.parseGenericParamList(&generics, &ng, &gcap);
            self.expect(T_GT);
        }
        self.expect(T_LPAREN);
        ast.Param* params = null;
        u32 nparams = 0;
        u32 pcap = 0;
        bool variadic = false;
        self.parseParamList(&params, &nparams, &pcap, &variadic);
        self.expect(T_RPAREN);
        self.expect(T_SEMI);
        ast.Decl* m = self.declBase(ast.DT_FUNC, rt->row, rt->col);
        m->name = methodName;
        m->type = returnType;
        m->params = params;
        m->nparams = nparams;
        m->isExtern = true;
        self.growDeclArr(&methods, &nm, &mcap);
        methods[nm++] = m;
    }
    self.expect(T_RBRACE);
    ast.Decl* d = self.declBase(ast.DT_TRAIT, self.peekTok(-1)->row, self.peekTok(-1)->col);
    d->name = name;
    d->decls = methods;
    d->ndecls = nm;
    d->exported = exported;
    return d;
}

ast.Decl* parseTypedefDecl(bool exported)
{
    self.advance();
    str.strView name = self.expectIdent();
    self.expect(T_ASSIGN);
    ast.TypeExpr* typeExpr = self.parseType();
    self.expect(T_SEMI);
    ast.Decl* d = self.declBase(ast.DT_TYPEDEF, self.peekTok(-1)->row, self.peekTok(-1)->col);
    d->name = name;
    d->type = typeExpr;
    d->exported = exported;
    return d;
}

ast.Decl* parseDistinctDecl(bool exported)
{
    self.advance();
    str.strView name = self.expectIdent();
    self.expect(T_ASSIGN);
    ast.TypeExpr* typeExpr = self.parseType();
    self.expect(T_SEMI);
    ast.Decl* d = self.declBase(ast.DT_DISTINCT, self.peekTok(-1)->row, self.peekTok(-1)->col);
    d->name = name;
    d->type = typeExpr;
    d->exported = exported;
    return d;
}

ast.Decl* parseCompilerFnDecl(bool exported)
{
    tok.LexTok* t = self.advance(); // 'compiler_fn'
    declBase:
    ast.TypeExpr* returnType = self.parseType();
    str.strView name = self.expectIdent();
    self.expect(T_LPAREN);
    ast.Param* params = null;
    u32 nparams = 0;
    u32 pcap = 0;
    bool variadic = false;
    self.parseParamList(&params, &nparams, &pcap, &variadic);
    self.expect(T_RPAREN);
    self.expect(T_SEMI);
    ast.Decl* d = self.declBase(ast.DT_FUNC, t->row, t->col);
    d->name = name;
    d->type = returnType;
    d->params = params;
    d->nparams = nparams;
    d->isExtern = true;
    d->exported = exported;
    return d;
}

ast.Decl* parseFlagDecl(bool exported)
{
    tok.LexTok* t = self.advance();
    self.expect(T_LPAREN);
    str.strView name = self.expectIdent();
    self.expect(T_RPAREN);
    self.ctxPush(CTX_FLAG, name, str.strView::empty());
    ast.Decl* d = self.parseFlagDeclRest(exported, name, t);
    self.ctxPop();
    return d;
}

ast.Decl* parseFlagDeclRest(bool exported, str.strView name, tok.LexTok* t)
{
    self.expect(T_LBRACE);
    ast.Decl** flat = null;
    u32 nflat = 0;
    u32 fcap = 0;
    str.strView* caseNames = null;
    u32 ncaseNames = 0;
    u32 ccap = 0;
    u32* caseLens = null;
    u32 ncaseLens = 0;
    u32 lcap = 0;
    ast.Decl** defaultBody = null;
    u32 ndefault = 0;
    u32 dcap = 0;
    while (!self.check(T_RBRACE) && !self.check(tok.TOK_EOF))
    {
        if (self.check(T_DEFAULT))
        {
            self.advance();
            self.expect(T_COLON);
            while (!self.check(T_RBRACE) && !self.check(tok.TOK_EOF))
            {
                ast.Decl* outs[2];
                u32 cnt = self.parseDecl(outs);
                if (cnt == 0) break;
                for (u32 i = 0; i < cnt; i++)
                {
                    self.growDeclArr(&defaultBody, &ndefault, &dcap);
                    defaultBody[ndefault++] = outs[i];
                }
            }
        }
        else if (self.check(T_IDENT))
        {
            str.strView cname = self.text(self.peekTok(0));
            self.advance();
            self.growStrArr(&caseNames, &ncaseNames, &ccap);
            caseNames[ncaseNames++] = cname;
            self.expect(T_COLON);
            u32 start = nflat;
            while (!self.check(T_RBRACE) && !self.check(tok.TOK_EOF))
            {
                ast.Decl* outs[2];
                u32 cnt = self.parseDecl(outs);
                if (cnt == 0) break;
                for (u32 i = 0; i < cnt; i++)
                {
                    self.growDeclArr(&flat, &nflat, &fcap);
                    flat[nflat++] = outs[i];
                }
            }
            self.growU32Arr(&caseLens, &ncaseLens, &lcap);
            caseLens[ncaseLens++] = nflat - start;
        }
        else
        {
            self.advance();
        }
    }
    self.expect(T_RBRACE);
    ast.Decl* d = self.declBase(ast.DT_FLAG, t->row, t->col);
    d->name = name;
    d->cases = flat;
    d->ncases = nflat;
    d->caseNames = caseNames;
    d->caseLens = caseLens;
    d->ncaseNames = ncaseNames;
    d->defaultBody = defaultBody;
    d->ndeclDefault = ndefault;
    d->exported = exported;
    return d;
}