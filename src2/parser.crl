// src2/parser.crl — port of py/parser.py. Recursive descent.
// Attributes: file-level @[[...]] are skipped, decl-level [[...]] are
// consumed and recorded (only "noret" has an effect today).

mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod tok = import("token.crl");
mod ast = import("ast/ast.crl");

// token ids (TOK_ANON_FIRST=6 + ANON_TERMS index; see token.crl)
const u32 T_MOD = 6;
const u32 T_IMPORT = 7;
const u32 T_PUB = 8;
const u32 T_STATIC = 9;
const u32 T_INLINE = 10;
const u32 T_STRUCT = 11;
const u32 T_ENUM = 12;
const u32 T_TRAIT = 13;
const u32 T_CONST = 14;
const u32 T_VAR = 15;
const u32 T_TYPEDEF = 17;
const u32 T_DISTINCT = 18;
const u32 T_EXTERN = 19;
const u32 T_IF = 20;
const u32 T_ELSE = 21;
const u32 T_WHILE = 22;
const u32 T_FOR = 23;
const u32 T_LOOP = 24;
const u32 T_SWITCH = 25;
const u32 T_CASE = 26;
const u32 T_DEFAULT = 27;
const u32 T_BREAK = 28;
const u32 T_CONTINUE = 29;
const u32 T_RETURN = 30;
const u32 T_DEFER = 31;
const u32 T_COMPTIME = 32;
const u32 T_FLAG = 33;
const u32 T_ASM = 34;
const u32 T_VOLATILE = 35;
const u32 T_SIZEOF = 36;
const u32 T_TRUE = 37;
const u32 T_FALSE = 38;
const u32 T_NULL = 39;
const u32 T_SELF = 40;
const u32 T_I8 = 41;
const u32 T_I16 = 42;
const u32 T_I32 = 43;
const u32 T_I64 = 44;
const u32 T_U8 = 45;
const u32 T_U16 = 46;
const u32 T_U32 = 47;
const u32 T_U64 = 48;
const u32 T_F32 = 49;
const u32 T_F64 = 50;
const u32 T_BOOL = 51;
const u32 T_CHAR = 52;
const u32 T_VOID = 53;
const u32 T_ISIZE = 54;
const u32 T_USIZE = 55;
const u32 T_SHL_EQ = 56;
const u32 T_SHR_EQ = 57;
const u32 T_ELLIPSIS = 58;
const u32 T_PLUS_EQ = 60;
const u32 T_MINUS_EQ = 61;
const u32 T_STAR_EQ = 62;
const u32 T_SLASH_EQ = 63;
const u32 T_PERCENT_EQ = 64;
const u32 T_AMP_EQ = 65;
const u32 T_PIPE_EQ = 66;
const u32 T_CARET_EQ = 67;
const u32 T_EQ = 68;
const u32 T_NE = 69;
const u32 T_BANG_LT = 70;
const u32 T_LE = 71;
const u32 T_GE = 72;
const u32 T_AND = 73;
const u32 T_OR = 74;
const u32 T_SHL = 75;
const u32 T_SHR = 76;
const u32 T_INC = 77;
const u32 T_DEC = 78;
const u32 T_ARROW = 79;
const u32 T_COLON_COLON = 80;
const u32 T_ASSIGN = 81;
const u32 T_LT = 82;
const u32 T_GT = 83;
const u32 T_BANG = 84;
const u32 T_TILDE = 85;
const u32 T_HASH = 86;
const u32 T_PLUS = 87;
const u32 T_MINUS = 88;
const u32 T_STAR = 89;
const u32 T_SLASH = 90;
const u32 T_PERCENT = 91;
const u32 T_AMP = 92;
const u32 T_PIPE = 93;
const u32 T_CARET = 94;
const u32 T_DOT = 95;
const u32 T_COMMA = 96;
const u32 T_COLON = 97;
const u32 T_SEMI = 98;
const u32 T_QUESTION = 99;
const u32 T_AT = 100;
const u32 T_LPAREN = 101;
const u32 T_RPAREN = 102;
const u32 T_LBRACE = 103;
const u32 T_RBRACE = 104;
const u32 T_LBRACKET = 105;
const u32 T_RBRACKET = 106;

// legacy single-token attributes (@[forced_unsafe_cast], @no_null, ...)
const u32 T_ATTR_MIN = 108;
const u32 T_ATTR_MAX = 115;

// operator precedence (higher binds tighter)
const u32 P_ASSIGN = 0;
const u32 P_TERNARY = 1;
const u32 P_OR = 2;
const u32 P_AND = 3;
const u32 P_BITOR = 4;
const u32 P_BITXOR = 5;
const u32 P_BITAND = 6;
const u32 P_EQ = 7;
const u32 P_CMP = 8;
const u32 P_SHIFT = 9;
const u32 P_ADD = 10;
const u32 P_MUL = 11;
const u32 P_UNARY = 12;
const u32 P_POSTFIX = 13;
const u32 P_PRIMARY = 14;
const u32 NO_PREC = 200;

struct CtxEntry
{
    u32 kind;
    str.strView name;
    str.strView name2;
};

const u32 CTX_STRUCT = 0;
const u32 CTX_ENUM = 1;
const u32 CTX_TRAIT = 2;
const u32 CTX_FLAG = 3;
const u32 CTX_FUNC = 4;
const u32 CTX_METHODS = 5;
const u32 CTX_TRAITIMPL = 6;
const u32 CTX_DECL = 7;

struct Mark
{
    u32 pos;
    u32 nctx;
    bool wasErr;
    u32 errLen;
    u32 ctxLen;
};

bool vEq(str.strView a, const char* b)
{
    u32 i = 0;
    while (b[i] != 0)
    {
        if (i >= a.len || a.ptr[i] != b[i]) return false;
        i++;
    }
    return i == a.len;
}

u32 assignOpPrec(u32 tid)
{
    if (tid == T_ASSIGN || tid == T_PLUS_EQ || tid == T_MINUS_EQ || tid == T_STAR_EQ
     || tid == T_SLASH_EQ || tid == T_PERCENT_EQ || tid == T_AMP_EQ || tid == T_PIPE_EQ
     || tid == T_CARET_EQ || tid == T_SHL_EQ || tid == T_SHR_EQ) return P_ASSIGN;
    return NO_PREC;
}

str.strView assignOpText(u32 tid)
{
    switch (tid)
    {
    case T_ASSIGN: return str.strView::fromCstr("=");
    case T_PLUS_EQ: return str.strView::fromCstr("+=");
    case T_MINUS_EQ: return str.strView::fromCstr("-=");
    case T_STAR_EQ: return str.strView::fromCstr("*=");
    case T_SLASH_EQ: return str.strView::fromCstr("/=");
    case T_PERCENT_EQ: return str.strView::fromCstr("%=");
    case T_AMP_EQ: return str.strView::fromCstr("&=");
    case T_PIPE_EQ: return str.strView::fromCstr("|=");
    case T_CARET_EQ: return str.strView::fromCstr("^=");
    case T_SHL_EQ: return str.strView::fromCstr("<<=");
    case T_SHR_EQ: return str.strView::fromCstr(">>=");
    }
    return str.strView::empty();
}

u32 binOpPrec(u32 tid)
{
    switch (tid)
    {
    case T_OR: return P_OR;
    case T_AND: return P_AND;
    case T_PIPE: return P_BITOR;
    case T_CARET: return P_BITXOR;
    case T_AMP: return P_BITAND;
    case T_EQ: return P_EQ;
    case T_NE: return P_EQ;
    case T_LT: return P_CMP;
    case T_LE: return P_CMP;
    case T_GT: return P_CMP;
    case T_GE: return P_CMP;
    case T_SHL: return P_SHIFT;
    case T_SHR: return P_SHIFT;
    case T_PLUS: return P_ADD;
    case T_MINUS: return P_ADD;
    case T_STAR: return P_MUL;
    case T_SLASH: return P_MUL;
    case T_PERCENT: return P_MUL;
    }
    return NO_PREC;
}

str.strView binOpText(u32 tid)
{
    switch (tid)
    {
    case T_OR: return str.strView::fromCstr("||");
    case T_AND: return str.strView::fromCstr("&&");
    case T_PIPE: return str.strView::fromCstr("|");
    case T_CARET: return str.strView::fromCstr("^");
    case T_AMP: return str.strView::fromCstr("&");
    case T_EQ: return str.strView::fromCstr("==");
    case T_NE: return str.strView::fromCstr("!=");
    case T_LT: return str.strView::fromCstr("<");
    case T_LE: return str.strView::fromCstr("<=");
    case T_GT: return str.strView::fromCstr(">");
    case T_GE: return str.strView::fromCstr(">=");
    case T_SHL: return str.strView::fromCstr("<<");
    case T_SHR: return str.strView::fromCstr(">>");
    case T_PLUS: return str.strView::fromCstr("+");
    case T_MINUS: return str.strView::fromCstr("-");
    case T_STAR: return str.strView::fromCstr("*");
    case T_SLASH: return str.strView::fromCstr("/");
    case T_PERCENT: return str.strView::fromCstr("%");
    }
    return str.strView::empty();
}

bool prefixOpText(u32 tid, str.strView* out)
{
    switch (tid)
    {
    case T_PLUS: *out = str.strView::fromCstr("+"); return true;
    case T_MINUS: *out = str.strView::fromCstr("-"); return true;
    case T_BANG: *out = str.strView::fromCstr("!"); return true;
    case T_TILDE: *out = str.strView::fromCstr("~"); return true;
    case T_STAR: *out = str.strView::fromCstr("*"); return true;
    case T_AMP: *out = str.strView::fromCstr("&"); return true;
    case T_INC: *out = str.strView::fromCstr("++"); return true;
    case T_DEC: *out = str.strView::fromCstr("--"); return true;
    }
    return false;
}

pub struct Parser
{
    tok.LexTok* toks;
    u32 n;
    u32 pos;
    str.strView filename;
    str.strView source;
    CtxEntry ctx[8];
    u32 nctx;
    bool errored;
    u32 errLine;
    u32 errCol;
    str.String errMsg;
    str.String errCtx;
    str.strView attrs[8];
    u32 nattrs;
    bool gtgtConsumed;
    ast.Decl** decls;
    u32 ndecls;
    u32 declCap;
}

// token access

tok.LexTok* peekTok(u32 off)
{
    u32 i = self.pos + off;
    if (i >= self.n) i = self.n - 1;
    return &self.toks[i];
}

bool check(u32 t)
{
    return self.peekTok(0)->id == t;
}

tok.LexTok* advance()
{
    tok.LexTok* t = &self.toks[self.pos];
    if (self.pos + 1 < self.n) self.pos++;
    return t;
}

str.strView text(tok.LexTok* t)
{
    return str.strView::fromParts(self.source.ptr + t->start, t->len);
}

str.strView curText()
{
    return self.text(self.peekTok(0));
}

bool isTypeTok(tok.LexTok* t)
{
    u32 id = t->id;
    return id >= T_I8 && id <= T_USIZE;
}

bool isNameTok(tok.LexTok* t)
{
    return t->id == T_IDENT || self.isTypeTok(t);
}

// span of source between token start at byte `s` and byte after token `e`
str.strView span(u32 s, u32 e)
{
    return str.strView::fromParts(self.source.ptr + s, e - s);
}

// context stack

void ctxPush(u32 kind, str.strView name, str.strView name2)
{
    if (self.nctx < 8)
    {
        self.ctx[self.nctx].kind = kind;
        self.ctx[self.nctx].name = name;
        self.ctx[self.nctx].name2 = name2;
        self.nctx++;
    }
}

void ctxPop()
{
    if (self.nctx > 0) self.nctx--;
}

void appendCtxLabel(str.String* out, CtxEntry* e)
{
    if (e->kind == CTX_STRUCT) out->pushView(str.strView::fromCstr("struct "));
    else if (e->kind == CTX_ENUM) out->pushView(str.strView::fromCstr("enum "));
    else if (e->kind == CTX_TRAIT) out->pushView(str.strView::fromCstr("trait "));
    else if (e->kind == CTX_FLAG) out->pushView(str.strView::fromCstr("flag "));
    else if (e->kind == CTX_FUNC) out->pushView(str.strView::fromCstr("function "));
    else if (e->kind == CTX_METHODS) out->pushView(str.strView::fromCstr("methods of "));
    else if (e->kind == CTX_TRAITIMPL) out->pushView(str.strView::fromCstr("trait impl "));
    else out->pushView(str.strView::fromCstr("declaration of "));
    out->pushView(e->name);
    if (e->name2.len > 0)
    {
        out->pushView(str.strView::fromCstr(" :: "));
        out->pushView(e->name2);
    }
}

// errors

void setErrAt(tok.LexTok* t, str.String* msg)
{
    if (self.errored) return;
    self.errored = true;
    self.errLine = t->row;
    self.errCol = t->col;
    self.errMsg.free();
    self.errMsg = str.String::new();
    if (msg->len > 0)
    {
        for (u64 i = 0; i < msg->len; i++) self.errMsg.pushChar(msg->ptr[i]);
    }
    self.errCtx.free();
    self.errCtx = str.String::new();
    if (self.nctx > 0)
    {
        u32 base = 0;
        if (self.nctx > 3) base = self.nctx - 3;
        for (u32 i = base; i < self.nctx; i++)
        {
            if (i > base) self.errCtx.pushView(str.strView::fromCstr(" \xe2\x86\x92 "));
            self.appendCtxLabel(&self.errCtx, &self.ctx[i]);
        }
    }
}

void errorMsg(const char* m)
{
    str.String s = str.String::new();
    s.pushView(str.strView::fromCstr(m));
    self.setErrAt(self.peekTok(0), &s);
    s.free();
}

void errorTok(tok.LexTok* t, const char* m)
{
    str.String s = str.String::new();
    s.pushView(str.strView::fromCstr(m));
    self.setErrAt(t, &s);
    s.free();
}

void tokenDisplayStr(str.String* s, tok.LexTok* t)
{
    if (t->id == tok.TOK_EOF)
    {
        s->pushView(str.strView::fromCstr("end of file"));
    }
    else
    {
        s->pushView(str.strView::fromCstr("'"));
        s->pushView(self.text(t));
        s->pushView(str.strView::fromCstr("'"));
    }
}

// expect a specific token; on mismatch emit error, do not advance
bool expect(u32 t)
{
    if (self.check(t)) { self.advance(); return true; }
    str.String s = str.String::new();
    s.pushView(str.strView::fromCstr("expected '"));
    s.pushView(self.text(self.peekTok(0)));
    s.pushView(str.strView::fromCstr("'..."));
    // placeholder replaced below
    s.free();
    self.errExpectTok(t);
    return false;
}

void errExpectTok(u32 want)
{
    str.String s = str.String::new();
    tok.LexTok* got = self.peekTok(0);
    if (want == T_GT) s.pushView(str.strView::fromCstr("expected '>'"));
    else if (want == T_SEMI) s.pushView(str.strView::fromCstr("expected ';'"));
    else if (want == T_RPAREN) s.pushView(str.strView::fromCstr("expected ')'"));
    else if (want == T_RBRACE) s.pushView(str.strView::fromCstr("expected '}'"));
    else if (want == T_LBRACE) s.pushView(str.strView::fromCstr("expected '{'"));
    else if (want == T_LPAREN) s.pushView(str.strView::fromCstr("expected '('"));
    else if (want == T_RBRACKET) s.pushView(str.strView::fromCstr("expected ']'"));
    else if (want == T_LBRACKET) s.pushView(str.strView::fromCstr("expected '['"));
    else if (want == T_COLON) s.pushView(str.strView::fromCstr("expected ':'"));
    else if (want == T_COMMA) s.pushView(str.strView::fromCstr("expected ','"));
    else if (want == T_ASSIGN) s.pushView(str.strView::fromCstr("expected '='"));
    else if (want == T_IDENT || want == T_SELF) s.pushView(str.strView::fromCstr("expected a name"));
    else
    {
        s.pushView(str.strView::fromCstr("expected token"));
    }
    s.pushView(str.strView::fromCstr(", found "));
    self.tokenDisplayStr(&s, got);
    self.setErrAt(got, &s);
    s.free();
}

// expect an identifier or a type keyword (used for names)
str.strView expectIdent()
{
    tok.LexTok* t = self.peekTok(0);
    if (self.isNameTok(t) || t->id == T_SELF)
    {
        self.advance();
        return self.text(t);
    }
    str.String s = str.String::new();
    s.pushView(str.strView::fromCstr("expected a name, found "));
    self.tokenDisplayStr(&s, t);
    self.setErrAt(t, &s);
    s.free();
    return str.strView::empty();
}

// expect a string literal, returns contents without quotes
str.strView expectString()
{
    tok.LexTok* t = self.peekTok(0);
    if (t->id == tok.TOK_STR)
    {
        self.advance();
        u64 start = t->start;
        u64 len = t->len;
        if (len >= 2) return str.strView::fromParts(self.source.ptr + start + 1, len - 2);
        return str.strView::fromParts(self.source.ptr + start, len);
    }
    str.String s = str.String::new();
    s.pushView(str.strView::fromCstr("expected a string literal, found "));
    self.tokenDisplayStr(&s, t);
    self.setErrAt(t, &s);
    s.free();
    return str.strView::empty();
}

void skipSemicolons()
{
    while (self.check(T_SEMI)) self.advance();
}

// mark / rewind

Mark mark()
{
    Mark m;
    m.pos = self.pos;
    m.nctx = self.nctx;
    m.wasErr = self.errored;
    m.errLen = self.errMsg.len;
    m.ctxLen = self.errCtx.len;
    return m;
}

void rewind(Mark m)
{
    self.pos = m.pos;
    self.nctx = m.nctx;
    if (m.wasErr) return;
    if (self.errored)
    {
        self.errored = false;
        self.errMsg.free();
        self.errMsg = str.String::new();
        self.errCtx.free();
        self.errCtx = str.String::new();
    }
}

void seekPos()
{
    // no-op: pos only restored via rewind(m)
}

// attributes

void skipAttrBrackets()
{
    while (!self.check(T_RBRACKET) && !self.check(tok.TOK_EOF)) self.advance();
    if (self.check(T_RBRACKET)) self.advance();
    if (self.check(T_RBRACKET)) self.advance();
}

// file-level attributes: @[[...]], @[...], legacy single-token @attrs.
// Never attached to the next decl.
void skipFileAttrs()
{
    while (true)
    {
        if (self.check(T_AT))
        {
            self.advance();
            if (self.check(T_LBRACKET) && self.peekTok(1)->id == T_LBRACKET)
            {
                self.advance();
                self.advance();
                self.skipAttrBrackets();
            }
            else if (self.check(T_LBRACKET))
            {
                self.advance();
                while (!self.check(T_RBRACKET) && !self.check(tok.TOK_EOF)) self.advance();
                if (self.check(T_RBRACKET)) self.advance();
            }
            continue;
        }
        u32 id = self.peekTok(0)->id;
        if (id >= T_ATTR_MIN && id <= T_ATTR_MAX)
        {
            self.advance();
            continue;
        }
        break;
    }
}

bool hasAttr(const char* name)
{
    for (u32 i = 0; i < self.nattrs; i++)
    {
        if (vEq(self.attrs[i], name)) return true;
    }
    return false;
}

// decl-level attributes: [[name, name]] attached to the next declaration.
void parseAttachedAttrs()
{
    self.nattrs = 0;
    while (self.check(T_LBRACKET) && self.peekTok(1)->id == T_LBRACKET)
    {
        self.advance();
        self.advance();
        while (!self.check(T_RBRACKET) && !self.check(tok.TOK_EOF))
        {
            if (self.check(T_COMMA)) { self.advance(); continue; }
            if (self.check(T_IDENT) || self.check(T_SELF))
            {
                if (self.nattrs < 8) self.attrs[self.nattrs++] = self.text(self.peekTok(0));
                self.advance();
            }
            else
            {
                self.advance();
            }
        }
        self.skipAttrBrackets();
    }
}

// array helpers

void growDeclArr(ast.Decl*** arr, u32* n, u32* cap)
{
    if (*n < *cap) return;
    u32 nc = *cap ? *cap * 2 : 8;
    ast.Decl** na = mman.alloc<ast.Decl*>(nc);
    for (u32 i = 0; i < *n; i++) na[i] = (*arr)[i];
    if (*arr) mman.dealloc<ast.Decl*>(*arr);
    *arr = na;
    *cap = nc;
}

void growStmtArr(ast.Stmt*** arr, u32* n, u32* cap)
{
    if (*n < *cap) return;
    u32 nc = *cap ? *cap * 2 : 8;
    ast.Stmt** na = mman.alloc<ast.Stmt*>(nc);
    for (u32 i = 0; i < *n; i++) na[i] = (*arr)[i];
    if (*arr) mman.dealloc<ast.Stmt*>(*arr);
    *arr = na;
    *cap = nc;
}

