// Package root for `mod godot = import(lib, "godot")`.
// Re-exports every submodule file under coral-godot/ (recursively).

pub mod classes = import(lib, "coral-godot/classes.crl");
pub mod entry = import(lib, "coral-godot/entry.crl");
pub mod interface = import(lib, "coral-godot/interface.crl");
pub mod types = import(lib, "coral-godot/types.crl");
