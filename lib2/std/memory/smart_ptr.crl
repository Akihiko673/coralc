mod std = import(lib, "std");

pub struct smart_ptr<T>
{
    T* ptr;

    void init(T value)
    {
        self.ptr = std.mman.alloc<T>(1);
        *self.ptr = value;
    }

    void dispose()
    {
        if (self.ptr != null)
        {
            std.mman.dealloc<T>(self.ptr);
            self.ptr = null;
        }
    }

    T get(const self*)
    {
        assert(self->ptr != null);
        return *self->ptr;
    }

    T* data()
    {
        return self.ptr;
    }

    const T* constData(const self*)
    {
        return self->ptr;
    }

    void set(T value)
    {
        assert(self.ptr != null);
        *self->ptr = value;
    }

    bool isValid(const self*)
    {
        return self->ptr != null;
    }

    T take()
    {
        assert(self.ptr != null);
        T value = *self->ptr;
        std.mman.dealloc<T>(self.ptr);
        self.ptr = null;
        return value;
    }
}