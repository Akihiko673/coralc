mod std = import(lib, "std");

pub struct iniSection
{
    std.hasmap.hashmap<std.string.String, std.string.String> entries;

    iniSection new()
    {
        iniSection s;
        s.entries = std.hasmap.hashmap<std.string.String, std.string.String>::new(hashString, eq);
        return s;
    }

    void dispose()
    {
        self.entries.eachEntry(freeEntry);
        self.entries.dispose();
    }

    std.string.String get(std.string.strView key)
    {
        std.string.String sk = std.string.String::fromView(key);
        option.option<std.string.String> v = self.entries.get(sk);
        sk.free();
        if (v.isNone()) return std.string.String::new();
        std.string.String stored = v.unwrap();
        return std.string.String::fromView(stored.asView());
    }

    void set(std.string.strView key, std.string.strView value)
    {
        std.string.String sk = std.string.String::fromView(key);
        option.option<std.hasmap.HashMapEntry<std.string.String, std.string.String>> old = self.entries.removeEntry(sk);
        if (old.isSome())
        {
            std.hasmap.HashMapEntry<std.string.String, std.string.String> e = old.unwrap();
            e.key.free();
            e.value.free();
        }
        std.string.String sv = std.string.String::fromView(value);
        self.entries.insert(sk, sv);
    }
}

pub struct iniFile
{
    std.vec.vec<iniSection> sections;
    std.vec.vec<std.string.String> names;

    iniFile new()
    {
        iniFile f;
        f.sections = std.vec.vec<iniSection>::new();
        f.names = std.vec.vec<std.string.String>::new();
        iniSection global = iniSection::new();
        f.sections.push(global);
        f.names.push(std.string.String::new());
        return f;
    }

    void dispose()
    {
        for (u64 i = 0; i < self.sections.count(); i++)
            self.sections.atPtr(i)->dispose();
        for (u64 i = 0; i < self.names.count(); i++)
            self.names.atPtr(i)->free();
        self.sections.dispose();
        self.names.dispose();
    }

    bool parse(std.string.strView input)
    {
        std.vec.vec<std.string.strView> lines = strutil.splitVec(input, '\n');
        u64 curSection = 0;
        for (u64 i = 0; i < lines.count(); i++)
        {
            std.string.strView line = strutil.trim(lines.at(i));
            if (line.len == 0 || line.ptr[0] == ';' || line.ptr[0] == '#') continue;
            if (line.ptr[0] == '[')
            {
                i64 closeIdx = strutil.indexOfChar(line, ']');
                if (closeIdx < 0) continue;
                std.string.strView name = strutil.trim(std.string.strView::fromParts(line.ptr + 1, (u64)closeIdx - 1));
                iniSection sec = iniSection::new();
                self.sections.push(sec);
                self.names.push(std.string.String::fromView(name));
                curSection = self.sections.count() - 1;
                continue;
            }
            i64 eq = strutil.indexOfChar(line, '=');
            if (eq < 0) continue;
            std.string.strView key = strutil.trim(std.string.strView::fromParts(line.ptr, (u64)eq));
            std.string.strView value = strutil.trim(std.string.strView::fromParts(line.ptr + (u64)eq + 1, line.len - (u64)eq - 1));
            i64 semi = strutil.indexOfChar(value, ';');
            if (semi >= 0)
                value = strutil.trim(std.string.strView::fromParts(value.ptr, (u64)semi));
            self.sections.atPtr(curSection)->set(key, value);
        }
        lines.dispose();
        return true;
    }

    iniSection* section(std.string.strView name)
    {
        for (u64 i = 0; i < self.names.count(); i++)
        {
            std.string.strView n = self.names.at(i).asView();
            if (n.len == name.len)
            {
                bool match = true;
                for (u64 j = 0; j < n.len; j++)
                    if (n.ptr[j] != name.ptr[j]) { match = false; break; }
                if (match) return self.sections.atPtr(i);
            }
        }
        return null;
    }

    std.string.String get(std.string.strView section, std.string.strView key)
    {
        for (u64 i = 0; i < self.names.count(); i++)
        {
            std.string.strView n = self.names.at(i).asView();
            if (n.len == section.len)
            {
                bool match = true;
                for (u64 j = 0; j < n.len; j++)
                    if (n.ptr[j] != section.ptr[j]) { match = false; break; }
                if (match)
                    return self.sections.at(i).get(key);
            }
        }
        return std.string.String::new();
    }
}

u64 hashString(std.string.String s)
{
    std.string.strView v = s.asView();
    u64 hash = 14695981039346656037u;
    for (u64 i = 0; i < v.len; i++)
    {
        hash ^= (u64)(u8)v.ptr[i];
        hash *= 1099511628211u;
    }
    return hash;
}

bool eq(std.string.String a, std.string.String b)
{
    return a.asView().equalsView(b.asView());
}

void freeEntry(std.hasmap.HashMapEntry<std.string.String, std.string.String>* e)
{
    e->key.free();
    e->value.free();
}
