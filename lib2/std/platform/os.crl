mod std = import("std");

flag (platform) {
LINUX:
    pub constexpr bool IS_LINUX = true;
    pub constexpr bool IS_MACOS = false;
    pub constexpr bool IS_WINDOWS = false;
    pub constexpr bool IS_FREEBSD = false;
    pub constexpr bool IS_OPENBSD = false;
    pub constexpr bool IS_WASM = false;
    pub constexpr bool IS_POSIX = true;
    pub constexpr char PATH_SEP = '/';
    pub constexpr bool USES_CRLF = false;
    pub constexpr std.string.strView EXE_EXT = std.string.strView::fromCstr("");
    pub constexpr std.string.strView DLL_EXT = std.string.strView::fromCstr(".so");
    pub constexpr std.string.strView NULL_DEV = std.string.strView::fromCstr("/dev/null");
MACOS:
    pub constexpr bool IS_LINUX = false;
    pub constexpr bool IS_MACOS = true;
    pub constexpr bool IS_WINDOWS = false;
    pub constexpr bool IS_FREEBSD = false;
    pub constexpr bool IS_OPENBSD = false;
    pub constexpr bool IS_WASM = false;
    pub constexpr bool IS_POSIX = true;
    pub constexpr char PATH_SEP = '/';
    pub constexpr bool USES_CRLF = false;
    pub constexpr std.string.strView EXE_EXT = std.string.strView::fromCstr("");
    pub constexpr std.string.strView DLL_EXT = std.string.strView::fromCstr(".dylib");
    pub constexpr std.string.strView NULL_DEV = std.string.strView::fromCstr("/dev/null");
WINDOWS:
    pub constexpr bool IS_LINUX = false;
    pub constexpr bool IS_MACOS = false;
    pub constexpr bool IS_WINDOWS = true;
    pub constexpr bool IS_FREEBSD = false;
    pub constexpr bool IS_OPENBSD = false;
    pub constexpr bool IS_WASM = false;
    pub constexpr bool IS_POSIX = false;
    pub constexpr char PATH_SEP = '\\';
    pub constexpr bool USES_CRLF = true;
    pub constexpr std.string.strView EXE_EXT = std.string.strView::fromCstr(".exe");
    pub constexpr std.string.strView DLL_EXT = std.string.strView::fromCstr(".dll");
    pub constexpr std.string.strView NULL_DEV = std.string.strView::fromCstr("NUL");
default:
    pub constexpr bool IS_LINUX = false;
    pub constexpr bool IS_MACOS = false;
    pub constexpr bool IS_WINDOWS = false;
    pub constexpr bool IS_FREEBSD = false;
    pub constexpr bool IS_OPENBSD = false;
    pub constexpr bool IS_WASM = false;
    pub constexpr bool IS_POSIX = true;
    pub constexpr char PATH_SEP = '/';
    pub constexpr bool USES_CRLF = false;
    pub constexpr std.string.strView EXE_EXT = std.string.strView::fromCstr("");
    pub constexpr std.string.strView DLL_EXT = std.string.strView::fromCstr(".so");
    pub constexpr std.string.strView NULL_DEV = std.string.strView::fromCstr("/dev/null");
}

pub constexpr u64 SYS_PAGE_SIZE = 4096;

pub constexpr i32 STDIN_FD = 0;
pub constexpr i32 STDOUT_FD = 1;
pub constexpr i32 STDERR_FD = 2;