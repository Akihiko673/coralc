mod std = import(lib, "std");

pub struct deque<T>
{
    T* data;
    u64 head;
    u64 tail;
    u64 cap;
    u64 mask;

    static deque<T> new()
    {
        deque<T> d;
        d.cap = 8;
        d.mask = 7;
        d.data = std.mman.alloc<T>(d.cap);
        d.head = 0;
        d.tail = 0;
        return d;
    }

    void dispose()
    {
        if (self.data != null)
        {
            std.mman.dealloc<T>(self.data);
            self.data = null;
        }
        self.cap = 0;
        self.head = 0;
        self.tail = 0;
    }

    u64 count()
    {
        return (self.tail - self.head) & self.mask;
    }

    bool isEmpty() { return self.head == self.tail; }
    u64 capacity() { return self.cap - 1; }

    void _grow()
    {
        u64 newCap = self.cap * 2;
        T* newData = std.mman.alloc<T>(newCap);
        u64 n = self.count();
        for (u64 i = 0; i < n; i++)
            newData[i] = self.data[(self.head + i) & self.mask];
        std.mman.dealloc<T>(self.data);
        self.data = newData;
        self.head = 0;
        self.tail = n;
        self.cap = newCap;
        self.mask = newCap - 1;
    }

    void pushFront(T val)
    {
        if (self.count() >= self.cap - 1) self._grow();
        self.head = (self.head - 1) & self.mask;
        self.data[self.head] = val;
    }

    void pushBack(T val)
    {
        if (self.count() >= self.cap - 1) self._grow();
        self.data[self.tail] = val;
        self.tail = (self.tail + 1) & self.mask;
    }

    T popFront()
    {
        assert(!self.isEmpty());
        T val = self.data[self.head];
        self.head = (self.head + 1) & self.mask;
        return val;
    }

    T popBack()
    {
        assert(!self.isEmpty());
        self.tail = (self.tail - 1) & self.mask;
        return self.data[self.tail];
    }

    T front()
    {
        assert(!self.isEmpty());
        return self.data[self.head];
    }

    T back()
    {
        assert(!self.isEmpty());
        return self.data[(self.tail - 1) & self.mask];
    }

    T at(u64 i)
    {
        assert(i < self.count());
        return self.data[(self.head + i) & self.mask];
    }

    void set(u64 i, T val)
    {
        assert(i < self.count());
        self.data[(self.head + i) & self.mask] = val;
    }

    void clear()
    {
        self.head = 0;
        self.tail = 0;
    }
}