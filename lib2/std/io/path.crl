mod std = import(lib, "std");

const char SEP = '/';
const char ALT_SEP = '\\';
std.string.strView CUR_DIR = std.string.strView::fromCstr(".");
std.string.strView PARENT_DIR = std.string.strView::fromCstr("..");
std.string.strView SEP_STR = std.string.strView::fromCstr("/");

pub u64 findLastSep(std.string.strView p)
{
    for (u64 i = p.len; i > 0; i--)
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) return i - 1;
    return p.len + 1;
}

pub bool isAbsolute(std.string.strView p)
{
    return p.len > 0 && p.ptr[0] == SEP;
}

pub bool hasExtension(std.string.strView p)
{
    u64 lastDot = p.len + 1;
    for (u64 i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    if (lastDot >= p.len) return false;
    u64 lastSep = findLastSep(p);
    return lastDot > lastSep;
}

pub std.string.strView extension(std.string.strView p)
{
    u64 lastDot = p.len + 1;
    for (u64 i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    if (lastDot >= p.len) return std.string.strView::empty();
    u64 lastSep = findLastSep(p);
    if (lastDot <= lastSep) return std.string.strView::empty();
    return std.string.strView::fromParts(p.ptr + lastDot, p.len - lastDot);
}

pub std.string.strView stem(std.string.strView p)
{
    u64 lastDot = p.len + 1;
    for (u64 i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    u64 lastSep = p.len + 1;
    for (u64 i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    u64 start = lastSep < p.len ? lastSep + 1 : 0;
    u64 end = lastDot < p.len ? lastDot : p.len;
    if (end <= start) return p.len > 0 ? std.string.strView::fromParts(p.ptr + start, p.len - start) : std.string.strView::empty();
    return std.string.strView::fromParts(p.ptr + start, end - start);
}

pub std.string.strView parent(std.string.strView p)
{
    u64 lastSep = p.len + 1;
    for (u64 i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    if (lastSep > p.len) return std.string.strView::empty();
    if (lastSep == 0) return std.string.strView::fromCstr("/");
    return std.string.strView::fromParts(p.ptr, lastSep);
}

pub std.string.strView filename(std.string.strView p)
{
    u64 lastSep = p.len + 1;
    for (u64 i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    if (lastSep > p.len) return p;
    return std.string.strView::fromParts(p.ptr + lastSep + 1, p.len - lastSep - 1);
}

pub std.string.String join(std.string.strView a, std.string.strView b)
{
    std.string.String out = std.string.String::new();
    out.appendView(a);
    if (a.len > 0 && a.ptr[a.len - 1] != SEP && a.ptr[a.len - 1] != ALT_SEP)
        out.pushChar(SEP);
    out.appendView(b);
    return out;
}

pub std.string.String normalize(std.string.strView p)
{
    std.string.String out = std.string.String::new();
    u64 i = 0;
    bool needSep = false;
    if (isAbsolute(p)) { out.pushChar(SEP); i++; }
    while (i < p.len)
    {
        if (p.ptr[i] == SEP || p.ptr[i] == ALT_SEP) { i++; continue; }
        u64 segStart = i;
        while (i < p.len && p.ptr[i] != SEP && p.ptr[i] != ALT_SEP) i++;
        std.string.strView seg = std.string.strView::fromParts(p.ptr + segStart, i - segStart);
        if (seg.len == 0);
        else if (seg.len == 1 && seg.ptr[0] == '.');
        else
        {
            if (needSep) out.pushChar(SEP);
            out.appendView(seg);
            needSep = true;
        }
    }
    if (out.isEmpty()) out.appendView(CUR_DIR);
    return out;
}

pub std.string.String absolute(std.string.strView base, std.string.strView rel)
{
    if (isAbsolute(rel)) return normalize(rel);
    std.string.String joined = join(base, rel);
    std.string.String norm = normalize(joined.asView());
    joined.free();
    return norm;
}

pub std.string.String changeExtension(std.string.strView p, std.string.strView newExt)
{
    std.string.strView ext = extension(p);
    std.string.String out = std.string.String::new();
    if (ext.len > 0)
        out.appendView(std.string.strView::fromParts(p.ptr, p.len - ext.len));
    else
        out.appendView(p);
    if (newExt.len > 0)
    {
        if (newExt.ptr[0] != '.') out.pushChar('.');
        out.appendView(newExt);
    }
    return out;
}