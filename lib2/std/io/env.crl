mod std = import(lib, "std");

pub string get(std.string.strview name)
{
    char* buf = (char*)std.mman.alloc<u8>(name.len + 1);
    std.mman.copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    char* val = std.libc.getenv(buf);
    if (val == null)
    {
        std.mman.dealloc<u8>((u8*)buf);
        return string::new();
    }
    string result = string.fromView(std.string.strview::fromCstr(val));
    std.mman.dealloc<u8>((u8*)buf);
    return result;
}

pub bool getInto(std.string.strview name, string* out)
{
    char* buf = (char*)std.mman.alloc<u8>(name.len + 1);
    std.mman.copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    char* val = std.libc.getenv(buf);
    std.mman.dealloc<u8>((u8*)buf);
    if (val == null) return false;
    out->free();
    *out = string.fromView(std.string.strview::fromCstr(val));
    return true;
}

pub bool set(std.string.strview name, std.string.strview value)
{
    char* nbuf = (char*)std.mman.alloc<u8>(name.len + 1);
    char* vbuf = (char*)std.mman.alloc<u8>(value.len + 1);
    std.mman.copy<u8>(nbuf, (const u8*)name.ptr, name.len);
    std.mman.copy<u8>(vbuf, (const u8*)value.ptr, value.len);
    nbuf[name.len] = 0; vbuf[value.len] = 0;
    i32 rc = std.libc.setenv(nbuf, vbuf, 1);
    std.mman.dealloc<u8>((u8*)nbuf);
    std.mman.dealloc<u8>((u8*)vbuf);
    return rc == 0;
}

pub bool unset(std.string.strview name)
{
    char* buf = (char*)std.mman.alloc<u8>(name.len + 1);
    std.mman.copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    i32 rc = std.libc.unsetenv(buf);
    std.mman.dealloc<u8>((u8*)buf);
    return rc == 0;
}

pub u64 all(vec<string>* out)
{
    char** env = std.libc.environ;
    u64 count = 0;
    while (env[count] != null) count++;
    for (u64 i = 0; i < count; i++)
        out->push(string.fromView(std.string.strview::fromCstr(env[i])));
    return count;
}