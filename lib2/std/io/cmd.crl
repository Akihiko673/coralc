mod std = import(lib, "std");

pub struct ArgParser
{
    std.vec.vec<std.string.String> positional;
    bool error;
    std.string.String errMsg;
    u64 pos;

    ArgParser new()
    {
        ArgParser p;
        p.positional = std.vec.vec<std.string.String>::new();
        p.error = false;
        p.errMsg = std.string.String::new();
        p.pos = 0;
        return p;
    }

    void dispose()
    {
        for (u64 i = 0; i < self.positional.count(); i++)
            self.positional.atPtr(i)->free();
        self.positional.dispose();
        self.errMsg.free();
    }

    void parse(i32 argc, char** argv)
    {
        for (i32 i = 1; i < argc; i++)
        {
            char* arg = argv[i];
            if (arg[0] == '-' && arg[1] != 0)
            {
                if (arg[1] == '-' && arg[2] == 0) break;
                continue;
            }
            self.positional.push(std.string.String.fromView(std.string.strview::fromCstr(arg)));
        }
    }

    bool _afterDoubleDash(i32 argc, char** argv, i32 idx)
    {
        for (i32 i = 1; i < idx; i++)
        {
            char* arg = argv[i];
            if (arg[0] == '-' && arg[1] == '-' && arg[2] == 0) return true;
        }
        return false;
    }

    bool hasFlag(i32 argc, char** argv, std.string.strview shortFlag, std.string.strview longFlag)
    {
        for (i32 i = 1; i < argc; i++)
        {
            char* arg = argv[i];
            if (arg[0] == '-' && arg[1] == '-' && arg[2] == 0) break;
            if (self._afterDoubleDash(argc, argv, i)) continue;
            if (shortFlag.len == 1 && arg[0] == '-' && arg[1] == shortFlag.ptr[0] && arg[2] == 0) return true;
            if (longFlag.len > 0 && arg[0] == '-' && arg[1] == '-')
            {
                bool match = true;
                for (u64 j = 0; j < longFlag.len; j++)
                    if (arg[2 + j] != longFlag.ptr[j]) { match = false; break; }
                if (match && arg[2 + longFlag.len] == 0) return true;
            }
        }
        return false;
    }

    bool getOption(i32 argc, char** argv, std.string.strview shortFlag, std.string.strview longFlag, std.string.String* out)
    {
        for (i32 i = 1; i < argc - 1; i++)
        {
            char* arg = argv[i];
            if (arg[0] == '-' && arg[1] == '-' && arg[2] == 0) break;
            if (self._afterDoubleDash(argc, argv, i)) continue;
            if (shortFlag.len == 1 && arg[0] == '-' && arg[1] == shortFlag.ptr[0] && arg[2] == 0)
            {
                out->free();
                *out = std.string.String.fromView(std.string.strview::fromCstr(argv[i + 1]));
                return true;
            }
            if (longFlag.len > 0 && arg[0] == '-' && arg[1] == '-')
            {
                bool match = true;
                for (u64 j = 0; j < longFlag.len; j++)
                    if (arg[2 + j] != longFlag.ptr[j]) { match = false; break; }
                if (match && arg[2 + longFlag.len] == 0)
                {
                    out->free();
                    *out = std.string.String.fromView(std.string.strview::fromCstr(argv[i + 1]));
                    return true;
                }
            }
        }
        return false;
    }

    u64 count() { return self.positional.count(); }
    std.string.strview get(u64 idx) { return self.positional.at(idx).asView(); }
}