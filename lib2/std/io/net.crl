mod libc = import(lib, "std/platform/std.libc.crl");
mod string = import(lib, "std/text/std.string.crl");

const i32 AF_INET = 2;
const i32 SOCK_STREAM = 1;
const i32 SOCK_DGRAM = 2;
const i32 IPPROTO_TCP = 6;
const i32 IPPROTO_UDP = 17;
const i32 SOL_SOCKET = 1;
const i32 SO_REUSEADDR = 2;

pub struct sockaddr_in
{
    u16 sinFamily;
    u16 sinPort;
    u32 sinAddr;
    u8 sinZero[8];
}

bool _parseIp(std.string.strView ip, u32* out)
{
    u32 octet = 0;
    u32 addrVal = 0;
    u32 shift = 24;
    u32 octets = 0;
    bool octetHasDigit = false;
    for (u64 i = 0; i <= ip.len; i++)
    {
        if (i == ip.len || ip.ptr[i] == '.')
        {
            if (!octetHasDigit || octet > 255) return false;
            addrVal |= (octet << shift);
            octet = 0;
            octetHasDigit = false;
            octets++;
            if (shift > 0) shift -= 8;
        }
        else
        {
            if (ip.ptr[i] < '0' || ip.ptr[i] > '9') return false;
            octet = octet * 10 + (u32)(ip.ptr[i] - '0');
            if (octet > 255) return false;
            octetHasDigit = true;
        }
    }
    if (octets != 4) return false;
    *out = std.libc.htonl(addrVal);
    return true;
}

void _zeroSockaddr(sockaddr_in* a)
{
    for (u64 i = 0; i < 8; i++) a->sinZero[i] = 0;
}

pub distinct TcpSocket = i32;

pub TcpSocket tcpConnect(std.string.strView ip, u16 port)
{
    i32 fd = std.libc.socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (fd < 0) return (TcpSocket)(-1);

    u32 ipAddr;
    if (!_parseIp(ip, &ipAddr)) { std.libc.close(fd); return (TcpSocket)(-1); }

    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = ipAddr;

    if (std.libc.connect(fd, &addr, 16) < 0)
    {
        std.libc.close(fd);
        return (TcpSocket)(-1);
    }
    return (TcpSocket)fd;
}

pub TcpSocket tcpListen(u16 port)
{
    i32 fd = std.libc.socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (fd < 0) return (TcpSocket)(-1);

    i32 optval = 1;
    std.libc.sendto(fd, SOL_SOCKET, SO_REUSEADDR, &optval, 4);

    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = std.libc.htonl(0u);
    if (std.libc.bind(fd, &addr, 16) < 0) { std.libc.close(fd); return (TcpSocket)(-1); }
    if (std.libc.listen(fd, 128) < 0) { std.libc.close(fd); return (TcpSocket)(-1); }
    return (TcpSocket)fd;
}

pub TcpSocket tcpAccept(TcpSocket server)
{
    sockaddr_in addr;
    i32 addrLen = 16;
    i32 fd = std.libc.accept((i32)server, &addr, &addrLen);
    return (TcpSocket)fd;
}

pub i64 tcpSend(TcpSocket sock, const u8* buf, u64 len)
{
    u64 sent = 0;
    while (sent < len)
    {
        i64 n = std.libc.send((i32)sock, buf + sent, len - sent, 0);
        if (n <= 0) return n < 0 ? n : (i64)sent;
        sent += (u64)n;
    }
    return (i64)sent;
}

pub i64 tcpRecv(TcpSocket sock, u8* buf, u64 len)
{
    u64 got = 0;
    while (got < len)
    {
        i64 n = std.libc.recv((i32)sock, buf + got, len - got, 0);
        if (n <= 0) return n < 0 ? n : (i64)got;
        got += (u64)n;
    }
    return (i64)got;
}

pub void tcpClose(TcpSocket sock)
{
    std.libc.close((i32)sock);
}

pub struct UdpSocket
{
    i32 fd;
}

pub UdpSocket udpSocket()
{
    UdpSocket s;
    s.fd = std.libc.socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
    return s;
}

pub bool udpBind(UdpSocket* s, u16 port)
{
    if (s->fd < 0) return false;
    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = std.libc.htonl(0u);
    return std.libc.bind(s->fd, &addr, 16) == 0;
}

pub i64 udpSendTo(UdpSocket* s, const u8* buf, u64 len, std.string.strView ip, u16 port)
{
    if (s->fd < 0) return -1;
    u32 ipAddr;
    if (!_parseIp(ip, &ipAddr)) return -1;
    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = ipAddr;
    return std.libc.sendto(s->fd, buf, len, 0, &addr, 16);
}

pub i64 udpRecvFrom(UdpSocket* s, u8* buf, u64 len)
{
    if (s->fd < 0) return -1;
    return std.libc.recvfrom(s->fd, buf, len, 0, null, null);
}

pub void udpClose(UdpSocket* s)
{
    if (s->fd >= 0) std.libc.close(s->fd);
    s->fd = -1;
}