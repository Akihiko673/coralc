mod libc = import(lib, "std");

pub struct mutex
{
    void* impl[6];

    void init()
    {
        std.libc.pthread_mutex_init(self.impl, null);
    }

    void initRecursive()
    {
        u8 attr[8];
        std.libc.pthread_mutexattr_init(attr);
        std.libc.pthread_mutexattr_settype(attr, 1);
        std.libc.pthread_mutex_init(self.impl, attr);
        std.libc.pthread_mutexattr_destroy(attr);
    }

    void destroy()
    {
        std.libc.pthread_mutex_destroy(self.impl);
    }

    void lock()
    {
        std.libc.pthread_mutex_lock(self.impl);
    }

    void unlock()
    {
        std.libc.pthread_mutex_unlock(self.impl);
    }

    bool tryLock()
    {
        return std.libc.pthread_mutex_trylock(self.impl) == 0;
    }
}