mod std = import(lib, "std");

pub struct semaphore
{
    void* impl[8];

    bool init(u32 value)
    {
        return std.libc.sem_init(self.impl, 0, value) == 0;
    }

    void destroy()
    {
        std.libc.sem_destroy(self.impl);
    }

    void wait()
    {
        std.libc.sem_wait(self.impl);
    }

    bool tryWait()
    {
        return std.libc.sem_trywait(self.impl) == 0;
    }

    void post()
    {
        std.libc.sem_post(self.impl);
    }

    i32 value()
    {
        i32 v;
        std.libc.sem_getvalue(self.impl, &v);
        return v;
    }
}