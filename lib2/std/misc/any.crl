@[[no_warn_unsafe]]
@[[no_drop]]
@[[forced_pointer]]
@[[forced_unsafe_cast]]
@[[forced_null_deref]]
pub struct any
{
    void* p;

    void* ptr()
    {
        return self.p;
    }

    bool isNull()
    {
        return self.p == null;
    }

    T* as<T>()
    {
        return (T*)self.p;
    }
}

pub any wrap(void* value)
{
    any a;
    a.p = value;
    return a;
}