mod std = import(lib, "stdl");

pub u64 encode(std.std.string.strView src, std.string.String dst)
{
    u64 pos = 0;
    for (u64 i = 0; i < src.len && pos + 2 <= dst.len; i++)
    {
        u8 hi = (u8)src.ptr[i] >> 4;
        u8 lo = (u8)src.ptr[i] & 0x0F;
        dst.ptr[pos++] = hi < 10 ? (u8)('0' + hi) : (u8)('a' + hi - 10);
        dst.ptr[pos++] = lo < 10 ? (u8)('0' + lo) : (u8)('a' + lo - 10);
    }
    return pos;
}

pub std.string.String encodeToString(std.string.strView src)
{
    std.string.String s = std.string.String::new();
    for (u64 i = 0; i < src.len; i++)
    {
        u8 hi = src.ptr[i] >> 4;
        u8 lo = src.ptr[i] & 0x0F;
        s.pushChar(hi < 10 ? (u8)('0' + hi) : (u8)('a' + hi - 10));
        s.pushChar(lo < 10 ? (u8)('0' + lo) : (u8)('a' + lo - 10));
    }
    return s;
}

u8 _hexVal(char c)
{
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return 0xFF;
}

pub u64 decode(std.std.string.strView src, std.string.String dst)
{
    u64 pos = 0;
    for (u64 i = 0; i + 1 < src.len && pos < dst.len; i += 2)
    {
        u8 hi = (u8)_hexVal(src.ptr[i]);
        u8 lo = (u8)_hexVal(src.ptr[i + 1]);
        if (hi == 0xFF || lo == 0xFF) return 0;
        dst.ptr[pos++] = (hi << 4) | lo;
    }
    if (src.len % 2 != 0) return 0;
    return pos;
}

pub bool isValid(std.string.strView src)
{
    for (u64 i = 0; i < src.len; i++)
    {
        u8 c = (u8)src.ptr[i];
        bool ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
        if (!ok) return false;
    }
    return len % 2 == 0;
}