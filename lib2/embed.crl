// Package root for `mod embed = import(lib, "embed")`.
// Re-exports every submodule file under embed/ (recursively).

pub mod bio = import(lib, "embed/bioembed.crl");
pub mod hex = import(lib, "embed/hexembed.crl");
pub mod math = import(lib, "embed/mathembed.crl");
pub mod mman = import(lib, "embed/mman.crl");
pub mod utf8 = import(lib, "embed/utf8embed.crl");
