// Package root for `mod std = import(lib, "std")`.
// Re-exports every submodule file under std/ (recursively).


// collections
pub mod arr = import(lib, "std/collections/arr.crl");
pub mod bitset = import(lib, "std/collections/bitset.crl");
pub mod cache = import(lib, "std/collections/cache.crl");
