pub struct CallError
{
    CallErrorType error;
    i32 argument;
    i32 expected;
}

pub struct PropertyInfo
{
    VariantType type;
    StringNamePtr name;
    StringNamePtr className;
    u32 hint;
    StringPtr hintString;
    u32 usage;
}

pub struct MethodInfo
{
    StringNamePtr name;
    PropertyInfo returnValue;
    u32 flags;
    i32 id;
    u32 argumentCount;
    PropertyInfo* arguments;
    u32 defaultArgumentCount;
    VariantPtr* defaultArguments;
}

pub struct ClassMethodInfo
{
    StringNamePtr name;
    void* methodUserdata;
    ClassMethodCall call;
    ClassMethodPtrCall ptrcall;
    u32 methodFlags;
    GBool hasReturnValue;
    PropertyInfo* returnValueInfo;
    ArgumentMetadata returnValueMetadata;
    u32 argumentCount;
    PropertyInfo* argumentsInfo;
    ArgumentMetadata* argumentsMetadata;
    u32 defaultArgumentCount;
    VariantPtr* defaultArguments;
}

pub struct VirtualMethodInfo
{
    StringNamePtr name;
    u32 methodFlags;
    PropertyInfo returnValue;
    ArgumentMetadata returnValueMetadata;
    u32 argumentCount;
    PropertyInfo* arguments;
    ArgumentMetadata* argumentsMetadata;
}

