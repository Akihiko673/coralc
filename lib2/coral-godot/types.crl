// Godot GDExtension C API types, translated to Coral.
// Field order matches gdextension_interface.h exactly. ABI-compatible.
// Opaque handles are distinct: same void* underneath, explicit cast to cross.

pub i64 GInt;          // GDExtensionInt (int64_t)
pub u8 GBool;          // GDExtensionBool (uint8_t)
pub u64 ObjectId;      // GDObjectInstanceID (uint64_t)

pub distinct VariantPtr = void*;
pub distinct ConstVariantPtr = const void*;
pub distinct UninitVariantPtr = void*;

pub distinct StringNamePtr = void*;
pub distinct ConstStringNamePtr = const void*;
pub distinct UninitStringNamePtr = void*;

pub distinct StringPtr = void*;
pub distinct ConstStringPtr = const void*;
pub distinct UninitStringPtr = void*;

pub distinct ObjectPtr = void*;
pub distinct ConstObjectPtr = const void*;
pub distinct UninitObjectPtr = void*;

pub distinct TypePtr = void*;
pub distinct ConstTypePtr = const void*;
pub distinct UninitTypePtr = void*;

pub distinct RefPtr = void*;
pub distinct ConstRefPtr = const void*;

pub distinct MethodBind = const void*;
pub distinct ClassInstance = void*;
pub distinct Library = void*;
pub distinct ScriptData = void*;
pub distinct ScriptLanguage = void*;
pub distinct ScriptInstance = void*;

pub enum VariantType
{
    Nil = 0,
    Bool = 1,
    Int = 2,
    Float = 3,
    String = 4,
    Vector2 = 5,
    Vector2i = 6,
    Rect2 = 7,
    Rect2i = 8,
    Vector3 = 9,
    Vector3i = 10,
    Transform2D = 11,
    Vector4 = 12,
    Vector4i = 13,
    Plane = 14,
    Quaternion = 15,
    Aabb = 16,
    Basis = 17,
    Transform3D = 18,
    Projection = 19,
    Color = 20,
    StringName = 21,
    NodePath = 22,
    Rid = 23,
    Object = 24,
    Callable = 25,
    Signal = 26,
    Dictionary = 27,
    Array = 28,
    PackedByteArray = 29,
    PackedInt32Array = 30,
    PackedInt64Array = 31,
    PackedFloat32Array = 32,
    PackedFloat64Array = 33,
    PackedStringArray = 34,
    PackedVector2Array = 35,
    PackedVector3Array = 36,
    PackedColorArray = 37,
    PackedVector4Array = 38,
    VariantMax = 39,
}

pub enum VariantOperator
{
    Equal = 0,
    NotEqual = 1,
    Less = 2,
    LessEqual = 3,
    Greater = 4,
    GreaterEqual = 5,
    Add = 6,
    Subtract = 7,
    Multiply = 8,
    Divide = 9,
    Negate = 10,
    Positive = 11,
    Module = 12,
    Power = 13,
    ShiftLeft = 14,
    ShiftRight = 15,
    BitAnd = 16,
    BitOr = 17,
    BitXor = 18,
    BitNegate = 19,
    And = 20,
    Or = 21,
    Xor = 22,
    Not = 23,
    In = 24,
    Max = 25,
}

pub enum CallErrorType
{
    Ok = 0,
    InvalidMethod = 1,
    InvalidArgument = 2,
    TooManyArguments = 3,
    TooFewArguments = 4,
    InstanceIsNull = 5,
    MethodNotConst = 6,
}

pub enum InitLevel
{
    Core = 0,
    Servers = 1,
    Scene = 2,
    Editor = 3,
    MaxLevel = 4,
}

pub enum ArgumentMetadata
{
    None = 0,
    IntIsInt8 = 1,
    IntIsInt16 = 2,
    IntIsInt32 = 3,
    IntIsInt64 = 4,
    IntIsUint8 = 5,
    IntIsUint16 = 6,
    IntIsUint32 = 7,
    IntIsUint64 = 8,
    RealIsFloat = 9,
    RealIsDouble = 10,
    IntIsChar16 = 11,
    IntIsChar32 = 12,
    ObjectIsRequired = 13,
}

pub const u32 METHOD_FLAG_NORMAL = 1;
pub const u32 METHOD_FLAG_EDITOR = 2;
pub const u32 METHOD_FLAG_CONST = 4;
pub const u32 METHOD_FLAG_VIRTUAL = 8;
pub const u32 METHOD_FLAG_VARARG = 16;
pub const u32 METHOD_FLAG_STATIC = 32;
pub const u32 METHOD_FLAG_VIRTUAL_REQUIRED = 128;
pub const u32 METHOD_FLAGS_DEFAULT = 1;

