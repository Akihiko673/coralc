pub struct Initialization
{
    InitLevel minimumLevel;
    void* userdata;
    InitializeCallback initialize;
    DeinitializeCallback deinitialize;
}

pub struct GodotVersion
{
    u32 major;
    u32 minor;
    u32 patch;
    const char* string;
}

pub struct GodotVersion2
{
    u32 major;
    u32 minor;
    u32 patch;
    u32 hex;
    const char* status;
    const char* build;
    const char* hash;
    u64 timestamp;
    const char* string;
}

