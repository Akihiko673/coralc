// register_class.crl — register your own class with the engine.
//
// A user-defined class is an ObjectPtr the engine knows about. The contract
// lives in the ABI structs (godot/types.crl, field order = header order):
// ClassInfo6 carries the callbacks the engine calls back into your code.

mod godot = import(lib, "coral-godot");

godot.interface.Interface g_interface;

u8 snBuf[64];

godot.types.StringNamePtr makeName(const char* text)
{
    godot.interface.Interface* api = &g_interface;
    godot.types.UninitStringNamePtr dst = (godot.types.UninitStringNamePtr)snBuf;
    api->stringNameNewWithUtf8Chars(dst, text);
    return (godot.types.StringNamePtr)dst;
}

// our class's engine-side lifecycle 

godot.types.GBool mySet(godot.types.ClassInstance self, godot.types.ConstStringNamePtr name, godot.types.ConstVariantPtr val)
{
    return 1;
}

godot.types.GBool myGet(godot.types.ClassInstance self, godot.types.ConstStringNamePtr name, godot.types.VariantPtr ret)
{
    return 1;
}

godot.types.ObjectPtr myCreate(void* userdata)
{
    // real body: claim a GDExtensionClassInstancePtr and return it
    return null;
}

void myFree(void* userdata, godot.types.ClassInstance instance)
{
    // release the instance memory
}

// fill the ABI struct and register

bool registerMyClass(godot.types.Library library)
{
    godot.interface.Interface* api = &g_interface;

    godot.types.ClassInfo6 info;
    info.isVirtual = 0;
    info.isAbstract = 0;
    info.set = mySet;
    info.get = myGet;
    info.createInstance = myCreate;
    info.freeInstance = myFree;
    // (fields = header order: isVirtual, isAbstract, isExposed, isRuntime,
    //  iconPath, set, get, getPropertyList, freePropertyList, ... )

    godot.types.ConstStringNamePtr cn = makeName("MyNode");
    godot.types.ConstStringNamePtr parent = makeName("Node");
    api->classdbRegisterExtensionClass6(library, cn, parent, &info);
    return true;
}

// Field-by-field the struct matches gdextension_interface.h, so the engine
// reads offsets we wrote. The enums (godot.types.InitLevel, godot.classes.NodeProcessMode, ...)
// and constants (godot.classes.NodeNotificationReady, ...) come from the same source:
// types.crl mirrors the header, classes.crl mirrors extension_api.json.