// singleton.crl — grab an engine singleton and call one of its methods.
//
// Singletons (Engine, OS, DisplayServer, Input, ...) are objects the engine
// creates itself. Their typed slots plus hashes are in godot/classes.crl, so
// you only need global_get_singleton(name) and the usual bind resolution.

mod typ = import(lib, "coral-godot/types");
mod inf = import(lib, "coral-godot/interface");
mod cls = import(lib, "coral-godot/classes");

inf.Interface g_interface;

u8 snBuf[64];

typ.StringNamePtr makeName(const char* text)  // (see method_call.crl)
{
    inf.Interface* api = &g_interface;
    typ.UninitStringNamePtr dst = (typ.UninitStringNamePtr)snBuf;
    api->stringNameNewWithUtf8Chars(dst, text);
    return (typ.StringNamePtr)dst;
}

// Engine is a singleton; grab its pointer once.
typ.ObjectPtr engine()
{
    inf.Interface* api = &g_interface;
    return api->globalGetSingleton(makeName("Engine"));
}

// Calling Engine.get_frames_per_second() -> f32.
f32 engineFps()
{
    inf.Interface* api = &g_interface;
    typ.ConstStringNamePtr en = makeName("Engine");
    typ.ConstStringNamePtr mn = makeName("get_frames_per_second");
    typ.MethodBind bind = api->classdbGetMethodBind(en, mn, cls.EngineGetFramesPerSecondHash);
    if (bind == null) return -1.0;

    typ.TypePtr ret;
    api->objectMethodBindPtrcall(bind, engine(), null, ret);
    return *(f32*)ret;
}

// Same shape works for every singleton: OS.get_name(),
// DisplayServer.screen_get_size(), Input.is_key_pressed(...), ...
// The generated `pub typ.ObjectPtr EngineInstance;` slots mirror these
// singletons 1:1, one entry per item in the JSON's "singletons" section.