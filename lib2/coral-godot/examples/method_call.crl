// method_call.crl — call a Godot method through the interface.
//
// Every Godot method is reached through one method bind per (class, method).
// Resolve it once at load time with classdb_get_method_bind using the
// generated hash, keep it, and call it on any object of that class.

mod godot.types = import(lib, "coral-godot");


godot.interface.Interface g_interface;

// A StringName is an engine-internal object, NOT a C string. Build it on a
// stack buffer; the buffer's layout is the engine's own StringName storage.
u8 snBuf[64];

godot.types.StringNamePtr makeName(const char* text)
{
    godot.interface.Interface* api = &g_interface;
    godot.types.UninitStringNamePtr dst = (godot.types.UninitStringNamePtr)snBuf;
    api->stringNameNewWithUtf8Chars(dst, text);
    return (godot.types.StringNamePtr)dst;
}

// Resolve Node.get_name to its bind. The hash is the generated constant.
godot.types.MethodBind resolveBind()
{
    godot.interface.Interface* api = &g_interface;
    godot.types.ConstStringNamePtr cn = makeName("Node");
    godot.types.ConstStringNamePtr mn = makeName("get_name");
    if (cn == null || mn == null) return null;
    return api->classdbGetMethodBind(cn, mn, godot.classes.NodeGetNameHash);
}

// Calling it: raw arg call through the bind.
void callGetName(godot.types.ObjectPtr node, godot.types.MethodBind bind)
{
    godot.interface.Interface* api = &g_interface;
    godot.types.CallError err;
    godot.types.UninitVariantPtr ret;
    api->objectMethodBindCall(bind, node, null, 0, ret, &err);
    // (ret now holds the StringName; cast/destroy it as needed.)
    api->variantDestroy(ret);
}

// Ptr-call variant — faster when every argument maps to a typed C pointer:
void callGetNamePtr(godot.types.ObjectPtr node, godot.types.MethodBind bind)
{
    godot.interface.Interface* api = &g_interface;
    godot.types.TypePtr ret;
    api->objectMethodBindPtrcall(bind, node, null, ret);
}

// The generated slot (godot.classes.NodeGetName) is where the resolved bind address is
// stored; the generated <Class><Method>Hash pairs go straight into
// classdb_get_method_bind, so the JSON->Coral->engine chain is hash-exact.