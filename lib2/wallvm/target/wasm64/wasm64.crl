mod wasm32 = import(lib, "wallvm");
mod std = import(lib, "std");

pub bool irCodegenWasm64(wallvm.ir_types.IrModule* mod_, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !mod_) return false;
    wallvm.target.wasm32.Wasm32Codegen cg = wallvm.target.wasm32.Wasm32Codegen::new(ctx, true);
    cg.emitModule(mod_);
    if (cg.outLen == 0) return false;
    std.mman.dealloc<char>(cg.out);
    return true;
}