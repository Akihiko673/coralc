mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

pub struct Mips64Codegen
{
    wallvm.ir_types.IrContext* ctx;
    wallvm.asm_rules.ABIRules abi;
    char* out; u32 outLen; u32 outCap;
    wallvm.ir_types.IrFunc* func; u32 frameSize;
    u32* stackSlots; u32 stackSlotsLen; u32 stackSlotsCap;
    u32* blockLabels; u32 blockLabelsCap;
    bool fp64;

    Mips64Codegen new(wallvm.ir_types.IrContext* ctx)
    {
        Mips64Codegen c;
        c.ctx = ctx; c.abi = wallvm.asm_rules.mips64Abi();
        c.out = null; c.outLen = 0; c.outCap = 0;
        c.func = null; c.frameSize = 0;
        c.stackSlots = null; c.stackSlotsLen = 0; c.stackSlotsCap = 0;
        c.blockLabels = null; c.blockLabelsCap = 0;
        c.fp64 = true;
        return c;
    }

    void grow(u32 n)
    {
        if (self.outCap >= self.outLen + n) return;
        u32 nc = self.outCap ? self.outCap * 2 : 4096;
        while (nc < self.outLen + n) nc *= 2;
        char* nb = std.mman.alloc<char>(nc);
        if (self.out) { for (u32 i = 0; i < self.outLen; i++) nb[i] = self.out[i]; std.mman.dealloc<char>(self.out); }
        self.out = nb; self.outCap = nc;
    }
    void c(char ch) { self.grow(1); self.out[self.outLen++] = ch; }
    void s(const char* p) { if (!p) return; u32 l = 0; while (p[l]) l++; if (!l) return; self.grow(l); for (u32 i = 0; i < l; i++) self.out[self.outLen++] = p[i]; }
    void u(u64 v) { if (v == 0) { self.c('0'); return; } char b[24]; u32 p = 24; while (v) { b[--p] = (char)('0' + (v % 10)); v /= 10; } while (p < 24) self.c(b[p++]); }
    void pad() { self.c(' '); self.c(' '); self.c(' '); self.c(' '); }
    void inst0(const char* m) { self.pad(); self.s(m); self.c('\n'); }
    void inst1(const char* m, const char* a) { self.pad(); self.s(m); self.c(' '); self.s(a); self.c('\n'); }
    void inst2(const char* m, const char* a, const char* b) { self.pad(); self.s(m); self.c(' '); self.s(a); self.s(", "); self.s(b); self.c('\n'); }
    void inst3(const char* m, const char* a, const char* b, const char* c) { self.pad(); self.s(m); self.c(' '); self.s(a); self.s(", "); self.s(b); self.s(", "); self.s(c); self.c('\n'); }
    void emitLabel(const char* n) { self.s(n); self.s(":\n"); }

    void ensureSlots(u32 id)
    {
        if (id < self.stackSlotsCap) return;
        u32 nc = self.stackSlotsCap ? self.stackSlotsCap * 2 : 64;
        while (nc <= id) nc *= 2;
        u32* ns = std.mman.alloc<u32>(nc);
        for (u32 i = 0; i < self.stackSlotsCap; i++) ns[i] = self.stackSlots[i];
        for (u32 i = self.stackSlotsCap; i < nc; i++) ns[i] = 0;
        if (self.stackSlots) std.mman.dealloc<u32>(self.stackSlots);
        self.stackSlots = ns; self.stackSlotsCap = nc;
        if (id >= self.stackSlotsLen) self.stackSlotsLen = id + 1;
    }
    u32 slot(wallvm.ir_types.IrValue* v) { if (!v) return 0; u32 id = v->id; if (id >= self.stackSlotsCap) self.ensureSlots(id); if (self.stackSlots[id] == 0) { self.frameSize += 8; self.stackSlots[id] = self.frameSize; } return self.stackSlots[id]; }
    bool isConst(wallvm.ir_types.IrValue* v) { if (!v) return true; wallvm.ir_types.IrValueKind k = v->kind; return k == wallvm.ir_types.IrValueKind::ConstInt || k == wallvm.ir_types.IrValueKind::ConstFloat; }
    void emitSlot(wallvm.ir_types.IrValue* v) { self.u((u64)self.slot(v)); self.s("($sp)"); }
    void emitImm(wallvm.ir_types.IrValue* v) { self.u(v->valData); }

    void load(wallvm.ir_types.IrValue* v, const char* r)
    {
        if (!v) { self.inst2("daddiu", r, "$zero, 0"); return; }
        if (self.isConst(v)) { self.pad(); self.s("li "); self.s(r); self.s(", "); self.emitImm(v); self.c('\n'); return; }
        self.pad(); self.s("ld "); self.s(r); self.s(", "); self.emitSlot(v); self.c('\n');
    }
    void loadArith(wallvm.ir_types.IrValue* v, const char* r) { if (!v) { self.inst2("daddiu", r, "$zero, 0"); return; } if (self.isConst(v)) { self.load(v, r); return; } self.load(v, r); }
    void store(wallvm.ir_types.IrValue* v, const char* r) { if (!v) return; self.pad(); self.s("sd "); self.s(r); self.s(", "); self.emitSlot(v); self.c('\n'); }
    u32 resolveBlock(wallvm.ir_types.IrValue* bv) { for (u32 i = 0; i < self.func.nblocks; i++) if (&self.func.blocks[i].base == bv) return i; return ~0u; }

    void emitArith(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(lhs, "$t0");
        if (rhs && self.isConst(rhs)) { self.pad(); self.s("daddiu $t0, $t0, "); self.emitImm(rhs); self.c('\n'); }
        else { self.loadArith(rhs, "$t1"); self.inst3(mne, "$t0", "$t0", "$t1"); }
        self.store(res, "$t0");
    }

    void emitDivRem(wallvm.ir_types.IrInst* inst, const char* divMne, const char* remMne, bool rem)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(lhs, "$t0");
        self.loadArith(rhs, "$t1");
        self.inst2("teq", "$t1", "$zero");
        if (rem) { self.inst3(remMne, "$t0", "$t0", "$t1"); }
        else { self.inst3(divMne, "$t0", "$t0", "$t1"); }
        self.store(res, "$t0");
    }
    void emitUnary(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(src, "$t0");
        self.inst2(mne, "$t0", "$t0");
        self.store(res, "$t0");
    }
    void emitShift(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* cnt = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(val, "$t0");
        if (cnt && self.isConst(cnt)) { self.pad(); self.s(mne); self.s(" $t0, $t0, "); self.emitImm(cnt); self.c('\n'); }
        else { self.loadArith(cnt, "$t1"); self.inst3(mne, "$t0", "$t0", "$t1"); }
        self.store(res, "$t0");
    }

    void emitICmp(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        wallvm.irOps.IrICmpPred p = inst->icmpPred;
        self.loadArith(lhs, "$t0"); self.loadArith(rhs, "$t1");
        switch (p)
        {
        case wallvm.irOps.IrICmpPred::Eq: self.inst3("xor", "$t0", "$t0", "$t1"); self.inst3("sltiu", "$t0", "$t0", "1"); break;
        case wallvm.irOps.IrICmpPred::Ne: self.inst3("xor", "$t0", "$t0", "$t1"); self.inst3("sltu", "$t0", "$zero", "$t0"); break;
        case wallvm.irOps.IrICmpPred::Slt: self.inst3("slt", "$t0", "$t0", "$t1"); break;
        case wallvm.irOps.IrICmpPred::Sle: self.inst3("slt", "$t0", "$t1", "$t0"); self.inst3("xori", "$t0", "$t0", "1"); break;
        case wallvm.irOps.IrICmpPred::Ult: self.inst3("sltu", "$t0", "$t0", "$t1"); break;
        case wallvm.irOps.IrICmpPred::Ule: self.inst3("sltu", "$t0", "$t1", "$t0"); self.inst3("xori", "$t0", "$t0", "1"); break;
        default: self.inst2("li", "$t0", "0"); break;
        }
        self.store(res, "$t0");
    }

    void emitFCmp(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.pad(); self.s("l.d $f0, "); self.emitSlot(lhs); self.c('\n');
        self.pad(); self.s("l.d $f2, "); self.emitSlot(rhs); self.c('\n');
        self.inst2("c.eq.d", "$f0", "$f2"); self.inst0("li $t0, 0");
        self.inst0("bc1t 1f"); self.inst0("li $t0, 1");
        self.inst2("sw", "$t0", "0(%1)");
        self.inst0("nop");
        self.store(res, "$t0");
    }

    void emitCall(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* callee = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 nArgs = inst->nops > 0 ? inst->nops - 1 : 0;
        for (u32 i = 0; i < nArgs && i < self.abi.numArgRegs; i++)
            self.load(inst->ops[i + 1], self.abi.argRegs[i]);
        if (callee && callee->kind == wallvm.ir_types.IrValueKind::Func && callee->name && callee->name[0])
            self.inst1("jal", callee->name);
        else { self.load(callee, "$t9"); self.inst1("jalr", "$t9"); }
        if (res->type && res->type->kind != wallvm.ir_types.IrTypeKind::Void)
            self.store(res, "$v0");
    }

    void emitLoad(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* ptr = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.load(ptr, "$t0"); self.inst1("ld", "$t0, 0($t0)");
        self.store(res, "$t0");
    }
    void emitStore(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* ptr = inst->nops > 1 ? inst->ops[1] : null;
        self.load(ptr, "$t1"); self.load(val, "$t0");
        self.inst1("sd", "$t0, 0($t1)");
    }
    void emitAlloca(wallvm.ir_types.IrInst* inst)
    {
        u32 sz = 16; self.pad(); self.s("daddiu $sp, $sp, -"); self.u((u64)sz); self.c('\n');
        self.inst2("move", "$t0", "$sp"); self.store(&inst->base, "$t0");
    }
    void emitGep(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* ptr = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 nidxs = inst->nops > 1 ? inst->nops - 1 : 0;
        self.load(ptr, "$t0");
        for (u32 i = 0; i < nidxs; i++)
        {
            wallvm.ir_types.IrValue* idx = inst->ops[i + 1];
            if (self.isConst(idx)) { u64 off = idx->valData * 8; if (off > 0) { self.pad(); self.s("daddiu $t0, $t0, "); self.u(off); self.c('\n'); } }
            else { self.loadArith(idx, "$t1"); self.inst2("dsll", "$t1", "3"); self.inst3("daddu", "$t0", "$t0", "$t1"); }
        }
        self.store(res, "$t0");
    }

    void emitCast(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        switch (inst->opcode)
        {
        case wallvm.irOps.IrOpcode::Trunc: case wallvm.irOps.IrOpcode::Zext: case wallvm.irOps.IrOpcode::Sext: case wallvm.irOps.IrOpcode::Bitcast:
            self.load(src, "$t0"); self.store(res, "$t0"); break;
        case wallvm.irOps.IrOpcode::FpTrunc:
            self.pad(); self.s("l.d $f0, "); self.emitSlot(src); self.c('\n');
            self.inst0("cvt.s.d $f0, $f0"); self.pad(); self.s("s.s $f0, "); self.emitSlot(res); self.c('\n'); break;
        case wallvm.irOps.IrOpcode::FpExt:
            self.pad(); self.s("l.s $f0, "); self.emitSlot(src); self.c('\n');
            self.inst0("cvt.d.s $f0, $f0"); self.pad(); self.s("s.d $f0, "); self.emitSlot(res); self.c('\n'); break;
        case wallvm.irOps.IrOpcode::FpToSi:
            self.pad(); self.s("l.d $f0, "); self.emitSlot(src); self.c('\n');
            self.inst0("trunc.w.d $f0, $f0"); self.pad(); self.s("mfc1 $t0, $f0"); self.c('\n'); self.store(res, "$t0"); break;
        case wallvm.irOps.IrOpcode::FpToUi:
            self.pad(); self.s("l.d $f0, "); self.emitSlot(src); self.c('\n');
            self.inst0("trunc.l.d $f0, $f0"); self.pad(); self.s("dmfc1 $t0, $f0"); self.c('\n'); self.store(res, "$t0"); break;
        case wallvm.irOps.IrOpcode::SiToFp:
            self.load(src, "$t0"); self.inst0("dmtc1 $t0, $f0");
            self.inst0("cvt.d.l $f0, $f0"); self.pad(); self.s("s.d $f0, "); self.emitSlot(res); self.c('\n'); break;
        case wallvm.irOps.IrOpcode::UiToFp:
            self.load(src, "$t0"); self.inst0("dmtc1 $t0, $f0");
            self.inst0("cvt.d.l $f0, $f0"); self.pad(); self.s("s.d $f0, "); self.emitSlot(res); self.c('\n'); break;
        default: break;
        }
    }

    void emitSelect(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* cond = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* tval = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* fval = inst->nops > 2 ? inst->ops[2] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(fval, "$t0"); self.loadArith(tval, "$t1"); self.loadArith(cond, "$t2");
        self.inst2("beqz", "$t2", ".Lsel"); self.inst2("move", "$t0", "$t1"); self.emitLabel(".Lsel");
        self.store(res, "$t0");
    }
    void emitPhi(wallvm.ir_types.IrInst* inst)
    {
        // Phi results are materialized on incoming edges (emitPhiEdges).
    }

    void emitPhiEdges(wallvm.ir_types.IrBlock* pred, wallvm.ir_types.IrValue* tgt)
    {
        if (!pred || !tgt) return;
        u32 tbi = self.resolveBlock(tgt);
        if (tbi == ~0u) return;
        wallvm.ir_types.IrBlock* tb = self.func.blocks[tbi];
        for (u32 i = 0; i < tb->ninsts; i++)
        {
            wallvm.ir_types.IrInst* phi = tb->insts[i];
            if (phi->opcode != wallvm.irOps.IrOpcode::Phi) break;
            for (u32 j = 0; j + 1 < phi->nops; j += 2)
            {
                if (phi->ops[j + 1] == &pred->base)
                {
                    self.loadArith(phi->ops[j], "$t0");
                    self.store(&phi->base, "$t0");
                    break;
                }
            }
        }
    }

    bool genFunc(wallvm.ir_types.IrFunc* func)
    {
        if (!func) return false;
        if (func->isExtern) { if (func->base.name && func->base.name[0]) { self.pad(); self.s(".globl "); self.s(func->base.name); self.c('\n'); } return true; }
        self.func = func; self.frameSize = 0;
        for (u32 i = 0; i < self.blockLabelsCap; i++) self.blockLabels[i] = ~0u;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* blk = func->blocks[bi];
            for (u32 ii = 0; ii < blk->ninsts; ii++)
            {
                wallvm.ir_types.IrInst* inst = blk->insts[ii];
                wallvm.ir_types.IrValue* res = &inst->base;
                if (res->type && res->type->kind != wallvm.ir_types.IrTypeKind::Void) self.slot(res);
                for (u32 oi = 0; oi < inst->nops; oi++)
                { wallvm.ir_types.IrValue* op = inst->ops[oi]; if (op && !self.isConst(op) && op->kind != wallvm.ir_types.IrValueKind::Block) self.slot(op); }
            }
        }
        u32 frame = ((self.frameSize + 15) / 16) * 16 + 16;
        if (func->base.name && func->base.name[0]) self.emitLabel(func->base.name);
        else self.emitLabel(".Lanon");
        self.inst0("move $t0, $sp");
        self.pad(); self.s("daddiu $sp, $sp, -"); self.u((u64)frame); self.c('\n');
        self.inst1("sd", "$t0, 0($sp)");
        self.inst1("sd", "$ra, 8($sp)");
        if (func->nblocks > self.blockLabelsCap)
        {
            u32 nc = self.blockLabelsCap ? self.blockLabelsCap * 2 : 16;
            while (nc < func->nblocks) nc *= 2;
            u32* nm = std.mman.alloc<u32>(nc);
            for (u32 i = 0; i < self.blockLabelsCap; i++) nm[i] = self.blockLabels[i];
            for (u32 i = self.blockLabelsCap; i < nc; i++) nm[i] = ~0u;
            if (self.blockLabels) std.mman.dealloc<u32>(self.blockLabels);
            self.blockLabels = nm; self.blockLabelsCap = nc;
        }
        u32 nl = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++) if (self.blockLabels[bi] == ~0u) self.blockLabels[bi] = nl++;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* blk = func->blocks[bi];
            if (bi > 0) self.c('\n');
            self.s(".LBB"); self.u((u64)self.blockLabels[bi]); self.s(":\n");
            for (u32 ii = 0; ii < blk->ninsts; ii++)
            {
                wallvm.ir_types.IrInst* inst = blk->insts[ii];
                switch (inst->opcode)
                {
                case wallvm.irOps.IrOpcode::Br:
                { wallvm.ir_types.IrValue* tgt = inst->nops > 0 ? inst->ops[0] : null; if (tgt) { self.emitPhiEdges(blk, tgt); u32 tbi = self.resolveBlock(tgt); if (tbi != ~0u && self.blockLabels[tbi] != ~0u) { self.s("    b .LBB"); self.u((u64)self.blockLabels[tbi]); self.c('\n'); } } break; }
                case wallvm.irOps.IrOpcode::CondBr:
                {
                    wallvm.ir_types.IrValue* cond = inst->nops > 0 ? inst->ops[0] : null;
                    wallvm.ir_types.IrValue* tv = inst->nops > 1 ? inst->ops[1] : null;
                    wallvm.ir_types.IrValue* ev = inst->nops > 2 ? inst->ops[2] : null;
                    u32 tbi = tv ? self.resolveBlock(tv) : ~0u;
                    u32 ebi = ev ? self.resolveBlock(ev) : ~0u;
                    self.emitPhiEdges(blk, tv);
                    self.emitPhiEdges(blk, ev);
                    self.loadArith(cond, "$t0");
                    if (ebi != ~0u && self.blockLabels[ebi] != ~0u)
                    { self.s("    beqz $t0, .LBB"); self.u((u64)self.blockLabels[ebi]); self.c('\n'); }
                    if (tbi != ~0u && self.blockLabels[tbi] != ~0u)
                    { self.s("    b .LBB"); self.u((u64)self.blockLabels[tbi]); self.c('\n'); }
                    break;
                }
                case wallvm.irOps.IrOpcode::Ret:
                {
                    wallvm.ir_types.IrValue* rv = inst->nops > 0 ? inst->ops[0] : null;
                    if (rv && func->retType && func->retType->kind != wallvm.ir_types.IrTypeKind::Void)
                        self.load(rv, "$v0");
                    self.inst1("ld", "$ra, 0($sp)");
                    self.pad(); self.s("daddiu $sp, $sp, "); self.u((u64)frame); self.c('\n');
                    self.inst1("jr", "$ra"); break;
                }
                case wallvm.irOps.IrOpcode::Unreachable: self.inst0("break"); break;
                case wallvm.irOps.IrOpcode::Noret:
                {
                    const char* tmpl = wallvm.asm_rules.noretTemplate(&self.abi);
                    for (u32 i = 0; tmpl[i]; i++)
                    { if (tmpl[i] == '$' && tmpl[i+1] == 'e' && tmpl[i+2] == 'x' && tmpl[i+3] == 'i' && tmpl[i+4] == 't' && tmpl[i+5] == '_' && tmpl[i+6] == 'c' && tmpl[i+7] == 'o' && tmpl[i+8] == 'd' && tmpl[i+9] == 'e') { self.s("0"); i += 9; } else self.c(tmpl[i]); }
                    self.c('\n'); break;
                }
                case wallvm.irOps.IrOpcode::Neg: self.loadArith(inst->ops[0], "$t0"); self.inst3("subu", "$t0", "$zero", "$t0"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::Not: self.loadArith(inst->ops[0], "$t0"); self.inst3("nor", "$t0", "$t0", "$zero"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::Add: self.emitArith(inst, "daddu"); break;
                case wallvm.irOps.IrOpcode::Sub: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->ops[1], "$t1"); self.inst3("dsubu", "$t0", "$t0", "$t1"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::Mul: self.emitArith(inst, "dmul"); break;
                case wallvm.irOps.IrOpcode::SDiv: self.emitDivRem(inst, "div", "mod", false); break;
                case wallvm.irOps.IrOpcode::UDiv: self.emitDivRem(inst, "divu", "modu", false); break;
                case wallvm.irOps.IrOpcode::SRem: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->ops[1], "$t1"); self.inst2("div", "$t0", "$t1"); self.inst0("mfhi $t0"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::URem: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->ops[1], "$t1"); self.inst2("divu", "$t0", "$t1"); self.inst0("mfhi $t0"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::And: self.emitArith(inst, "and"); break;
                case wallvm.irOps.IrOpcode::Or: self.emitArith(inst, "or"); break;
                case wallvm.irOps.IrOpcode::Xor: self.emitArith(inst, "xor"); break;
                case wallvm.irOps.IrOpcode::Shl: self.emitShift(inst, "dsllv"); break;
                case wallvm.irOps.IrOpcode::Ashr: self.emitShift(inst, "dsrav"); break;
                case wallvm.irOps.IrOpcode::Lshr: self.emitShift(inst, "dsrlv"); break;
                case wallvm.irOps.IrOpcode::Load: self.emitLoad(inst); break;
                case wallvm.irOps.IrOpcode::Store: self.emitStore(inst); break;
                case wallvm.irOps.IrOpcode::Alloca: self.emitAlloca(inst); break;
                case wallvm.irOps.IrOpcode::Gep: self.emitGep(inst); break;
                case wallvm.irOps.IrOpcode::Trunc: case wallvm.irOps.IrOpcode::Zext: case wallvm.irOps.IrOpcode::Sext:
                case wallvm.irOps.IrOpcode::FpTrunc: case wallvm.irOps.IrOpcode::FpExt:
                case wallvm.irOps.IrOpcode::FpToSi: case wallvm.irOps.IrOpcode::SiToFp:
                case wallvm.irOps.IrOpcode::FpToUi: case wallvm.irOps.IrOpcode::UiToFp: case wallvm.irOps.IrOpcode::Bitcast:
                    self.emitCast(inst); break;
                case wallvm.irOps.IrOpcode::ICmp: self.emitICmp(inst); break;
                case wallvm.irOps.IrOpcode::FCmp: self.emitFCmp(inst); break;
                case wallvm.irOps.IrOpcode::Call: self.emitCall(inst); break;
                case wallvm.irOps.IrOpcode::Phi: self.emitPhi(inst); break;
                case wallvm.irOps.IrOpcode::Select: self.emitSelect(inst); break;
                case wallvm.irOps.IrOpcode::Abs: self.loadArith(inst->ops[0], "$t0"); self.inst3("sra", "$t1", "$t0", "63"); self.inst3("xor", "$t0", "$t0", "$t1"); self.inst3("dsubu", "$t0", "$t0", "$t1"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::Bswap: self.loadArith(inst->ops[0], "$t0"); self.inst0("dsbh $t0, $t0"); self.inst0("dshd $t0, $t0"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::CtLz: self.loadArith(inst->ops[0], "$t0"); self.inst2("dclz", "$t0", "$t0"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::CtPop: self.loadArith(inst->ops[0], "$t0"); self.inst0("dpop $t0, $t0"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::CtTz: self.loadArith(inst->ops[0], "$t0"); self.inst2("dbitrev", "$t0", "$t0"); self.inst2("dclz", "$t0", "$t0"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::FAbs: self.pad(); self.s("l.d $f0, "); self.emitSlot(inst->ops[0]); self.c('\n'); self.inst0("abs.d $f0, $f0"); self.pad(); self.s("s.d $f0, "); self.emitSlot(&inst->base); self.c('\n'); break;
                case wallvm.irOps.IrOpcode::Fma: self.pad(); self.s("l.d $f0, "); self.emitSlot(inst->ops[0]); self.c('\n'); self.pad(); self.s("l.d $f2, "); self.emitSlot(inst->ops[1]); self.c('\n'); self.pad(); self.s("l.d $f4, "); self.emitSlot(inst->ops[2]); self.c('\n'); self.inst0("madd.d $f0, $f0, $f2, $f4"); self.pad(); self.s("s.d $f0, "); self.emitSlot(&inst->base); self.c('\n'); break;
                case wallvm.irOps.IrOpcode::FSqrt: self.pad(); self.s("l.d $f0, "); self.emitSlot(inst->ops[0]); self.c('\n'); self.inst0("sqrt.d $f0, $f0"); self.pad(); self.s("s.d $f0, "); self.emitSlot(&inst->base); self.c('\n'); break;
                case wallvm.irOps.IrOpcode::Rotl: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->nops > 1 ? inst->ops[1] : null, "$t1"); self.inst0("drol $t0, $t0, $t1"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::Rotr: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->nops > 1 ? inst->ops[1] : null, "$t1"); self.inst0("dror $t0, $t0, $t1"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::SMax: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->ops[1], "$t1"); self.inst3("slt", "$t2", "$t0", "$t1"); self.inst3("movn", "$t0", "$t1", "$t2"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::SMin: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->ops[1], "$t1"); self.inst3("slt", "$t2", "$t0", "$t1"); self.inst3("movz", "$t0", "$t1", "$t2"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::UMax: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->ops[1], "$t1"); self.inst3("sltu", "$t2", "$t0", "$t1"); self.inst3("movn", "$t0", "$t1", "$t2"); self.store(&inst->base, "$t0"); break;
                case wallvm.irOps.IrOpcode::UMin: self.loadArith(inst->ops[0], "$t0"); self.loadArith(inst->ops[1], "$t1"); self.inst3("sltu", "$t2", "$t0", "$t1"); self.inst3("movz", "$t0", "$t1", "$t2"); self.store(&inst->base, "$t0"); break;
                default: break;
                }
            }
        }
        self.inst1("ld", "$ra, 8($sp)");
        self.pad(); self.s("daddiu $sp, $sp, "); self.u((u64)frame); self.c('\n');
        self.inst1("jr", "$ra");
        return true;
    }

    bool generate(wallvm.ir_types.IrModule* mod_)
    {
        if (!mod_) return false;
        self.s(".text\n");
        for (u32 i = 0; i < mod_->nfuncs; i++) { if (!self.genFunc(mod_->funcs[i])) return false; self.c('\n'); }
        return true;
    }
}

pub bool irCodegenMips64(wallvm.ir_types.IrModule* mod_, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !mod_) return false;
    Mips64Codegen cg = Mips64Codegen::new(ctx);
    return cg.generate(mod_);
}
