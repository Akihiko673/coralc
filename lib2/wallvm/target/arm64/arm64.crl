mod wallvm = import("wallvm");
mod std = import(lib, "std");

pub struct Arm64Codegen
{
    wallvm.ir_types.IrContext* ctx;
    wallvm.asm_rules.ABIRules abi;
    char* out;
    u32 outLen;
    u32 outCap;
    wallvm.ir_types.IrFunc* func;
    u32 frameSize;
    u32* stackSlots;
    u32 stackSlotsLen;
    u32 stackSlotsCap;
    u32* blockLabels;
    u32 blockLabelsCap;

    Arm64Codegen new(wallvm.ir_types.IrContext* ctx)
    {
        Arm64Codegen c;
        c.ctx = ctx;
        c.abi = wallvm.asm_rules.aapcs64Abi();
        c.out = null;
        c.outLen = 0;
        c.outCap = 0;
        c.func = null;
        c.frameSize = 0;
        c.stackSlots = null;
        c.stackSlotsLen = 0;
        c.stackSlotsCap = 0;
        c.blockLabels = null;
        c.blockLabelsCap = 0;
        return c;
    }

    void grow(u32 n)
    {
        if (self.outCap >= self.outLen + n) return;
        u32 nc = self.outCap ? self.outCap * 2 : 4096;
        while (nc < self.outLen + n) nc *= 2;
        char* nb = std.mman.alloc<char>(nc);
        if (self.out)
        {
            for (u32 i = 0; i < self.outLen; i++) nb[i] = self.out[i];
            std.mman.dealloc<char>(self.out);
        }
        self.out = nb;
        self.outCap = nc;
    }

    void c(char ch) { self.grow(1); self.out[self.outLen++] = ch; }

    void s(const char* p)
    {
        if (!p) return;
        u32 l = 0; while (p[l]) l++;
        if (!l) return;
        self.grow(l);
        for (u32 i = 0; i < l; i++) self.out[self.outLen++] = p[i];
    }

    void u(u64 v)
    {
        if (v == 0) { self.c('0'); return; }
        char b[24]; u32 p = 24;
        while (v) { b[--p] = (char)('0' + (v % 10)); v /= 10; }
        while (p < 24) self.c(b[p++]);
    }

    void pad() { self.c(' '); self.c(' '); self.c(' '); self.c(' '); }

    void inst0(const char* m)
    {
        self.pad(); self.s(m); self.c('\n');
    }

    void inst1(const char* m, const char* a)
    {
        self.pad(); self.s(m); self.c(' '); self.s(a); self.c('\n');
    }

    void inst2(const char* m, const char* a, const char* b)
    {
        self.pad(); self.s(m); self.c(' '); self.s(a); self.s(", "); self.s(b); self.c('\n');
    }

    void inst3(const char* m, const char* a, const char* b, const char* c)
    {
        self.pad(); self.s(m); self.c(' '); self.s(a); self.s(", "); self.s(b); self.s(", "); self.s(c); self.c('\n');
    }

    void emitLabel(const char* n)
    {
        self.s(n); self.s(":\n");
    }

    void emitWReg(const char* r)
    {
        if (r[0] == 'x') { self.c('w'); self.s(r + 1); }
        else self.s(r);
    }

    void emitReg(const char* r, u32 w)
    {
        if (w <= 32) self.emitWReg(r);
        else self.s(r);
    }

    void emitFpReg(const char* r, u32 w)
    {
        if (w == 32) { self.c('s'); self.s(r + 1); }
        else if (w == 64) { self.c('d'); self.s(r + 1); }
        else self.s(r);
    }

    void emitMovImm(const char* reg, u64 val, bool is64)
    {
        u32 maxShift = is64 ? 64u : 32u;
        bool first = true;
        for (u32 shift = 0; shift < maxShift; shift += 16)
        {
            u32 part = (u32)((val >> shift) & 0xFFFF);
            if (part == 0 && !first) continue;
            if (first)
            {
                self.pad(); self.s("movz "); self.s(reg); self.s(", #"); self.u((u64)part);
                if (shift > 0) { self.s(", lsl #"); self.u((u64)shift); }
                self.c('\n');
                first = false;
            }
            else
            {
                self.pad(); self.s("movk "); self.s(reg); self.s(", #"); self.u((u64)part);
                if (shift > 0) { self.s(", lsl #"); self.u((u64)shift); }
                self.c('\n');
            }
        }
        if (first) { self.pad(); self.s("mov "); self.s(reg); self.s(", #0\n"); }
    }

    void ensureSlots(u32 id)
    {
        if (id < self.stackSlotsCap) return;
        u32 nc = self.stackSlotsCap ? self.stackSlotsCap * 2 : 64;
        while (nc <= id) nc *= 2;
        u32* ns = std.mman.alloc<u32>(nc);
        for (u32 i = 0; i < self.stackSlotsCap; i++) ns[i] = self.stackSlots[i];
        for (u32 i = self.stackSlotsCap; i < nc; i++) ns[i] = 0;
        if (self.stackSlots) std.mman.dealloc<u32>(self.stackSlots);
        self.stackSlots = ns;
        self.stackSlotsCap = nc;
        if (id >= self.stackSlotsLen) self.stackSlotsLen = id + 1;
    }

    u32 slot(wallvm.ir_types.IrValue* v)
    {
        if (!v) return 0;
        u32 id = v->id;
        if (id >= self.stackSlotsCap) self.ensureSlots(id);
        if (self.stackSlots[id] == 0)
        {
            self.frameSize += 8;
            self.stackSlots[id] = self.frameSize;
        }
        return self.stackSlots[id];
    }

    bool isConst(wallvm.ir_types.IrValue* v)
    {
        if (!v) return true;
        wallvm.ir_types.IrValueKind k = v->kind;
        return k == wallvm.ir_types.IrValueKind::ConstInt || k == wallvm.ir_types.IrValueKind::ConstFloat;
    }

    void emitSlot(wallvm.ir_types.IrValue* v)
    {
        self.c('['); self.s("x29, #-"); self.u((u64)self.slot(v)); self.c(']');
    }

    void emitImm(wallvm.ir_types.IrValue* v)
    {
        if (!v) { self.s("0"); return; }
        self.c('#'); self.u(v->valData);
    }

    void load(wallvm.ir_types.IrValue* v, const char* r)
    {
        if (!v) { self.inst2("mov", r, "#0"); return; }
        if (self.isConst(v))
        {
            u64 n = v->valData;
            u32 w = v->type ? v->type->width : 64;
            bool is64 = w > 32;
            self.emitMovImm(r, n, is64);
            return;
        }
        wallvm.ir_types.IrType* ty = v->type;
        u32 w = ty ? ty->width : 64;
        if (w == 0) w = 64;
        self.pad(); self.s("ldr "); self.emitReg(r, w); self.s(", "); self.emitSlot(v); self.c('\n');
    }

    void loadFp(wallvm.ir_types.IrValue* v, const char* r)
    {
        if (!v) { self.inst2("fmov", r, "#0.0"); return; }
        if (self.isConst(v))
        {
            u64 raw = v->valData;
            u32 w = v->type ? v->type->width : 64;
            self.emitMovImm("x9", raw, w > 32);
            self.pad(); self.s("fmov "); self.emitFpReg(r, w); self.s(", x9\n");
            return;
        }
        u32 w = v->type ? v->type->width : 64;
        self.pad(); self.s("ldr "); self.emitFpReg(r, w); self.s(", "); self.emitSlot(v); self.c('\n');
    }

    void store(wallvm.ir_types.IrValue* v, const char* r)
    {
        if (!v) return;
        wallvm.ir_types.IrType* ty = v->type;
        u32 w = ty ? ty->width : 64;
        if (w == 0) w = 64;
        self.pad(); self.s("str "); self.emitReg(r, w); self.s(", "); self.emitSlot(v); self.c('\n');
    }

    void storeFp(wallvm.ir_types.IrValue* v, const char* r)
    {
        if (!v) return;
        u32 w = v->type ? v->type->width : 64;
        if (w == 0) w = 64;
        self.pad(); self.s("str "); self.emitFpReg(r, w); self.s(", "); self.emitSlot(v); self.c('\n');
    }

    u32 resolveBlock(wallvm.ir_types.IrValue* bv)
    {
        for (u32 i = 0; i < self.func.nblocks; i++)
            if (&self.func.blocks[i].base == bv) return i;
        return ~0u;
    }

    void emitBlockRef(u32 bi)
    {
        self.s(".LBB"); self.u((u64)bi);
    }

    void emitBinary(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        self.load(lhs, "x9");
        if (rhs)
        {
            if (self.isConst(rhs))
            {
                self.pad(); self.s(mne); self.c(' ');
                self.emitReg("x9", w); self.s(", "); self.emitReg("x9", w); self.s(", "); self.emitImm(rhs); self.c('\n');
            }
            else
            {
                self.load(rhs, "x10");
                self.pad(); self.s(mne); self.c(' ');
                self.emitReg("x9", w); self.s(", "); self.emitReg("x9", w); self.s(", "); self.emitReg("x10", w); self.c('\n');
            }
        }
        self.store(res, "x9");
    }

    void emitUnary(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        self.load(src, "x9");
        self.pad(); self.s(mne); self.c(' ');
        self.emitReg("x9", w); self.s(", "); self.emitReg("x9", w); self.c('\n');
        self.store(res, "x9");
    }

    void emitDivRem(wallvm.ir_types.IrInst* inst, bool sig, bool rem)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        const char* divOp = (const char*)(sig ? "sdiv" : "udiv");
        self.load(lhs, "x9");
        self.load(rhs, "x10");
        self.pad(); self.s(divOp); self.c(' ');
        self.emitReg("x11", w); self.s(", "); self.emitReg("x9", w); self.s(", "); self.emitReg("x10", w); self.c('\n');
        if (rem)
        {
            self.pad(); self.s("msub "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x11", w);
            self.s(", "); self.emitReg("x10", w);
            self.s(", "); self.emitReg("x9", w); self.c('\n');
        }
        else
        {
            self.pad(); self.s("mov "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x11", w); self.c('\n');
        }
        self.store(res, "x9");
    }

    void emitShift(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* cnt = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        self.load(val, "x9");
        if (cnt && self.isConst(cnt))
        {
            self.pad(); self.s(mne); self.c(' ');
            self.emitReg("x9", w); self.s(", "); self.emitReg("x9", w); self.s(", "); self.emitImm(cnt); self.c('\n');
        }
        else
        {
            if (cnt) self.load(cnt, "x10");
            self.pad(); self.s(mne); self.c(' ');
            self.emitReg("x9", w); self.s(", "); self.emitReg("x9", w); self.s(", "); self.emitReg("x10", w); self.c('\n');
        }
        self.store(res, "x9");
    }

    void emitICmp(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        wallvm.irOps.IrICmpPred p = inst->icmpPred;
        self.load(lhs, "x9");
        self.load(rhs, "x10");
        self.inst2("cmp", "x9", "x10");
        const char* cc;
        switch (p)
        {
        case wallvm.irOps.IrICmpPred::Eq: cc = "eq"; break;
        case wallvm.irOps.IrICmpPred::Ne: cc = "ne"; break;
        case wallvm.irOps.IrICmpPred::Slt: cc = "lt"; break;
        case wallvm.irOps.IrICmpPred::Sle: cc = "le"; break;
        case wallvm.irOps.IrICmpPred::Sgt: cc = "gt"; break;
        case wallvm.irOps.IrICmpPred::Sge: cc = "ge"; break;
        case wallvm.irOps.IrICmpPred::Ult: cc = "lo"; break;
        case wallvm.irOps.IrICmpPred::Ule: cc = "ls"; break;
        case wallvm.irOps.IrICmpPred::Ugt: cc = "hi"; break;
        case wallvm.irOps.IrICmpPred::Uge: cc = "hs"; break;
        default: cc = "eq"; break;
        }
        self.pad(); self.s("cset x9, "); self.s(cc); self.c('\n');
        self.store(res, "x9");
    }

    void emitFCmp(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        wallvm.irOps.IrFCmpPred p = inst->fcmpPred;
        self.loadFp(lhs, "v0");
        self.loadFp(rhs, "v1");
        self.inst0("fcmp d0, d1");
        const char* cc;
        switch (p)
        {
        case wallvm.irOps.IrFCmpPred::Oeq: cc = "eq"; break;
        case wallvm.irOps.IrFCmpPred::One: cc = "ne"; break;
        case wallvm.irOps.IrFCmpPred::Olt: cc = "lt"; break;
        case wallvm.irOps.IrFCmpPred::Ole: cc = "le"; break;
        case wallvm.irOps.IrFCmpPred::Ogt: cc = "gt"; break;
        case wallvm.irOps.IrFCmpPred::Oge: cc = "ge"; break;
        case wallvm.irOps.IrFCmpPred::Ueq: cc = "eq"; break;
        case wallvm.irOps.IrFCmpPred::Une: cc = "ne"; break;
        case wallvm.irOps.IrFCmpPred::Ult: cc = "lt"; break;
        case wallvm.irOps.IrFCmpPred::Ule: cc = "le"; break;
        case wallvm.irOps.IrFCmpPred::Ugt: cc = "gt"; break;
        case wallvm.irOps.IrFCmpPred::Uge: cc = "ge"; break;
        default: cc = "eq"; break;
        }
        self.pad(); self.s("cset x9, "); self.s(cc); self.c('\n');
        self.store(res, "x9");
    }

    void emitCall(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* callee = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 nArgs = inst->nops > 0 ? inst->nops - 1 : 0;

        for (u32 i = 0; i < nArgs; i++)
        {
            wallvm.ir_types.IrValue* arg = inst->ops[i + 1];
            bool isFloat = arg && arg->type && arg->type->kind == wallvm.ir_types.IrTypeKind::Float;
            if (i < self.abi.numFloatArgRegs && isFloat)
                self.loadFp(arg, self.abi.floatArgRegs[i]);
            else if (i < self.abi.numArgRegs)
                self.load(arg, self.abi.argRegs[i]);
            else
            {
                self.load(arg, "x9");
                self.inst1("str", "x9, [sp, #-16]!");
            }
        }

        if (callee)
        {
            if (callee->kind == wallvm.ir_types.IrValueKind::Func && callee->name && callee->name[0])
                self.inst1("bl", callee->name);
            else
            {
                self.load(callee, "x9");
                self.inst0("blr x9");
            }
        }
        else
            self.inst0("blr x9");

        if (res->type && res->type->kind != wallvm.ir_types.IrTypeKind::Void)
        {
            if (res->type->kind == wallvm.ir_types.IrTypeKind::Float)
                self.storeFp(res, "v0");
            else
                self.store(res, "x0");
        }

        u32 extra = 0;
        for (u32 i = 0; i < nArgs; i++)
        {
            wallvm.ir_types.IrValue* arg = inst->ops[i + 1];
            if (!arg) continue;
            bool isFloat = arg->type && arg->type->kind == wallvm.ir_types.IrTypeKind::Float;
            bool isIntReg = !isFloat && i >= self.abi.numArgRegs;
            bool isFpReg = isFloat && i >= self.abi.numFloatArgRegs;
            if (isIntReg || isFpReg) extra++;
        }
        if (extra > 0)
        {
            self.pad(); self.s("add sp, sp, #"); self.u((u64)(extra * 16)); self.c('\n');
        }
    }

    void emitLoad(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* ptr = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        wallvm.ir_types.IrType* ty = res->type;
        u32 w = ty ? ty->width : 64;
        self.load(ptr, "x9");
        self.pad(); self.s("ldr "); self.emitReg("x9", w); self.s(", [x9]\n");
        self.store(res, "x9");
    }

    void emitStore(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* ptr = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrType* ty = val ? val->type : null;
        u32 w = ty ? ty->width : 64;
        if (w == 0) w = 64;
        self.load(ptr, "x10");
        self.load(val, "x9");
        self.pad(); self.s("str "); self.emitReg("x9", w); self.s(", [x10]\n");
    }

    void emitAlloca(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 sz = 8;
        if (res->type && res->type->kind == wallvm.ir_types.IrTypeKind::Ptr && res->type->elem)
        {
            u32 ew = res->type->elem->width;
            if (ew == 0) ew = 8;
            if (ew <= 8) sz = 8;
            else sz = ((ew + 7) / 8) * 8;
        }
        self.pad(); self.s("sub sp, sp, #"); self.u((u64)sz); self.c('\n');
        self.inst2("add", "x9", "sp, #0");
        self.store(res, "x9");
    }

    void emitGep(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* ptr = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 nidxs = inst->nops > 1 ? inst->nops - 1 : 0;
        self.load(ptr, "x9");
        for (u32 i = 0; i < nidxs; i++)
        {
            wallvm.ir_types.IrValue* idx = inst->ops[i + 1];
            if (self.isConst(idx))
            {
                u64 off = idx->valData * 8;
                if (off > 0)
                {
                    self.pad(); self.s("add x9, x9, #"); self.u(off); self.c('\n');
                }
            }
            else
            {
                self.load(idx, "x10");
                self.inst3("add", "x9", "x9", "x10, lsl #3");
            }
        }
        self.store(res, "x9");
    }

    void emitCast(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        wallvm.ir_types.IrType* st = src ? src->type : null;
        wallvm.ir_types.IrType* dt = res->type;
        u32 sw = st ? st->width : 64;
        u32 dw = dt ? dt->width : 64;

        switch (inst->opcode)
        {
        case wallvm.irOps.IrOpcode::Trunc:
            self.load(src, "x9"); self.store(res, "x9"); break;
        case wallvm.irOps.IrOpcode::Zext:
            self.load(src, "x9");
            if (dw > sw && sw <= 16)
            {
                if (sw <= 8) self.inst2("uxtb", "w9", "w9");
                else self.inst2("uxth", "w9", "w9");
            }
            self.store(res, "x9");
            break;
        case wallvm.irOps.IrOpcode::Sext:
            self.load(src, "x9");
            if (dw > sw)
            {
                if (sw <= 8) self.inst2("sxtb", "x9", "w9");
                else if (sw <= 16) self.inst2("sxth", "x9", "w9");
                else if (sw <= 32) self.inst2("sxtw", "x9", "w9");
            }
            self.store(res, "x9");
            break;
        case wallvm.irOps.IrOpcode::FpTrunc:
            self.loadFp(src, "v0");
            self.inst0("fcvt s0, d0");
            self.storeFp(res, "v0");
            break;
        case wallvm.irOps.IrOpcode::FpExt:
            self.loadFp(src, "v0");
            self.inst0("fcvt d0, s0");
            self.storeFp(res, "v0");
            break;
        case wallvm.irOps.IrOpcode::FpToSi:
            self.loadFp(src, "v0");
            if (dw <= 32)
                self.inst0("fcvtzs w9, d0");
            else
                self.inst0("fcvtzs x9, d0");
            self.store(res, "x9");
            break;
        case wallvm.irOps.IrOpcode::FpToUi:
            self.loadFp(src, "v0");
            if (dw <= 32)
                self.inst0("fcvtzu w9, d0");
            else
                self.inst0("fcvtzu x9, d0");
            self.store(res, "x9");
            break;
        case wallvm.irOps.IrOpcode::SiToFp:
            self.load(src, "x9");
            if (sw <= 32)
                self.inst0("scvtf d0, w9");
            else
                self.inst0("scvtf d0, x9");
            self.storeFp(res, "v0");
            break;
        case wallvm.irOps.IrOpcode::UiToFp:
            self.load(src, "x9");
            if (sw <= 32)
                self.inst0("ucvtf d0, w9");
            else
                self.inst0("ucvtf d0, x9");
            self.storeFp(res, "v0");
            break;
        case wallvm.irOps.IrOpcode::Bitcast:
        {
            bool isFloat = src && src->type && src->type->kind == wallvm.ir_types.IrTypeKind::Float;
            if (isFloat)
            {
                self.loadFp(src, "v0");
                u32 w = src->type->width;
                if (w <= 32)
                    self.inst0("fmov w9, s0");
                else
                    self.inst0("fmov x9, d0");
            }
            else
            {
                self.load(src, "x9");
                self.inst0("fmov d0, x9");
                self.storeFp(res, "v0");
                break;
            }
            self.store(res, "x9");
            break;
        }
        default: break;
        }
    }

    void emitSelect(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* cond = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* tval = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* fval = inst->nops > 2 ? inst->ops[2] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        bool isFloat = res->type && res->type->kind == wallvm.ir_types.IrTypeKind::Float;
        if (isFloat)
        {
            self.loadFp(tval, "d9");
            self.loadFp(fval, "d10");
            self.load(cond, "x11");
            self.inst2("cmp", "x11", "#0");
            self.inst0("fcsel d9, d9, d10, ne");
            self.storeFp(res, "d9");
        }
        else
        {
            self.load(tval, "x9");
            self.load(fval, "x10");
            self.load(cond, "x11");
            self.inst2("cmp", "x11", "#0");
            self.pad(); self.s("csel "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x10", w);
            self.s(", ne\n");
            self.store(res, "x9");
        }
    }

    void emitPhi(wallvm.ir_types.IrInst* inst)
    {
        // Phi results are materialized on incoming edges (emitPhiEdges).
    }

    void emitPhiEdges(wallvm.ir_types.IrBlock* pred, wallvm.ir_types.IrValue* tgt)
    {
        if (!pred || !tgt) return;
        u32 tbi = self.resolveBlock(tgt);
        if (tbi == ~0u) return;
        wallvm.ir_types.IrBlock* tb = self.func.blocks[tbi];
        for (u32 i = 0; i < tb->ninsts; i++)
        {
            wallvm.ir_types.IrInst* phi = tb->insts[i];
            if (phi->opcode != wallvm.irOps.IrOpcode::Phi) break;
            for (u32 j = 0; j + 1 < phi->nops; j += 2)
            {
                if (phi->ops[j + 1] == &pred->base)
                {
                    self.load(phi->ops[j], "x9");
                    self.store(&phi->base, "x9");
                    break;
                }
            }
        }
    }

    void emitCtPop(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.load(src, "x9");
        self.inst0("fmov d0, x9");
        self.inst0("cnt v0.8b, v0.8b");
        self.inst0("addv b0, v0.8b");
        self.inst0("fmov w9, s0");
        self.store(res, "x9");
    }

    void emitCtLz(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        self.load(src, "x9");
        self.pad(); self.s("clz "); self.emitReg("x9", w);
        self.s(", "); self.emitReg("x9", w); self.c('\n');
        self.store(res, "x9");
    }

    void emitCtTz(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        self.load(src, "x9");
        self.pad(); self.s("rbit "); self.emitReg("x9", w);
        self.s(", "); self.emitReg("x9", w); self.c('\n');
        self.pad(); self.s("clz "); self.emitReg("x9", w);
        self.s(", "); self.emitReg("x9", w); self.c('\n');
        self.store(res, "x9");
    }

    void emitBswap(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        self.load(src, "x9");
        self.pad(); self.s("rev "); self.emitReg("x9", w);
        self.s(", "); self.emitReg("x9", w); self.c('\n');
        self.store(res, "x9");
    }

    void emitRotl(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* cnt = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        self.load(val, "x9");
        if (cnt && self.isConst(cnt))
        {
            u64 shift = cnt->valData;
            u32 width = w;
            u32 rot = width - (shift % width);
            self.pad(); self.s("extr "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", #"); self.u((u64)rot); self.c('\n');
        }
        else
        {
            self.load(cnt, "x10");
            self.pad(); self.s("lsl "); self.emitReg("x11", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x10", w); self.c('\n');
            self.pad(); self.s("neg "); self.emitReg("x10", w);
            self.s(", "); self.emitReg("x10", w); self.c('\n');
            self.pad(); self.s("lsr "); self.emitReg("x12", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x10", w); self.c('\n');
            self.pad(); self.s("orr "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x11", w);
            self.s(", "); self.emitReg("x12", w); self.c('\n');
        }
        self.store(res, "x9");
    }

    void emitRotr(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* cnt = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        self.load(val, "x9");
        if (cnt && self.isConst(cnt))
        {
            u64 shift = cnt->valData % w;
            self.pad(); self.s("extr "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", #"); self.u(shift); self.c('\n');
        }
        else
        {
            self.load(cnt, "x10");
            self.pad(); self.s("lsr "); self.emitReg("x11", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x10", w); self.c('\n');
            self.pad(); self.s("neg "); self.emitReg("x10", w);
            self.s(", "); self.emitReg("x10", w); self.c('\n');
            self.pad(); self.s("lsl "); self.emitReg("x12", w);
            self.s(", "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x10", w); self.c('\n');
            self.pad(); self.s("orr "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x11", w);
            self.s(", "); self.emitReg("x12", w); self.c('\n');
        }
        self.store(res, "x9");
    }

    void emitMinMax(wallvm.ir_types.IrInst* inst, bool sig, bool max)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        const char* op;
        if (sig && max) op = "smax";
        else if (sig && !max) op = "smin";
        else if (!sig && max) op = "umax";
        else op = "umin";
        self.load(lhs, "x9");
        self.load(rhs, "x10");
        self.pad(); self.s(op); self.c(' ');
        self.emitReg("x9", w); self.s(", "); self.emitReg("x9", w);
        self.s(", "); self.emitReg("x10", w); self.c('\n');
        self.store(res, "x9");
    }

    void emitAbs(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 w = res->type ? res->type->width : 64;
        if (w == 0) w = 64;
        bool isFloat = res->type && res->type->kind == wallvm.ir_types.IrTypeKind::Float;
        if (isFloat)
        {
            self.loadFp(src, "d0");
            self.inst0("fabs d0, d0");
            self.storeFp(res, "d0");
        }
        else
        {
            self.load(src, "x9");
            self.pad(); self.s("abs "); self.emitReg("x9", w);
            self.s(", "); self.emitReg("x9", w); self.c('\n');
            self.store(res, "x9");
        }
    }

    void emitFma(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* a = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* b = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* c = inst->nops > 2 ? inst->ops[2] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadFp(c, "d0");
        self.loadFp(a, "d1");
        self.loadFp(b, "d2");
        self.inst0("fmadd d0, d1, d2, d0");
        self.storeFp(res, "d0");
    }

    void emitFAbs(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadFp(src, "d0");
        self.inst0("fabs d0, d0");
        self.storeFp(res, "d0");
    }

    void emitFSqrt(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadFp(src, "d0");
        self.inst0("fsqrt d0, d0");
        self.storeFp(res, "d0");
    }

    bool genFunc(wallvm.ir_types.IrFunc* func)
    {
        if (!func) return false;
        if (func->isExtern) { if (func->base.name && func->base.name[0]) { self.pad(); self.s(".globl "); self.s(func->base.name); self.c('\n'); } return true; }
        self.func = func;
        self.frameSize = 0;

        for (u32 i = 0; i < self.blockLabelsCap; i++)
            self.blockLabels[i] = ~0u;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* blk = func->blocks[bi];
            for (u32 ii = 0; ii < blk->ninsts; ii++)
            {
                wallvm.ir_types.IrInst* inst = blk->insts[ii];
                wallvm.ir_types.IrValue* res = &inst->base;
                if (res->type && res->type->kind != wallvm.ir_types.IrTypeKind::Void)
                    self.slot(res);
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    wallvm.ir_types.IrValue* op = inst->ops[oi];
                    if (op && !self.isConst(op) && op->kind != wallvm.ir_types.IrValueKind::Block)
                        self.slot(op);
                }
            }
        }

        if (func->base.name && func->base.name[0])
        {
            self.s(".globl "); self.s(func->base.name); self.c('\n');
            self.emitLabel(func->base.name);
        }
        else
            self.emitLabel(".Lanon");

        self.inst0("stp x29, x30, [sp, #-16]!");
        self.inst0("mov x29, sp");
        if (self.frameSize > 0)
        {
            self.pad(); self.s("sub sp, sp, #"); self.u((u64)self.frameSize); self.c('\n');
        }

        if (func->nblocks > self.blockLabelsCap)
        {
            u32 nc = self.blockLabelsCap ? self.blockLabelsCap * 2 : 16;
            while (nc < func->nblocks) nc *= 2;
            u32* nm = std.mman.alloc<u32>(nc);
            for (u32 i = 0; i < self.blockLabelsCap; i++) nm[i] = self.blockLabels[i];
            for (u32 i = self.blockLabelsCap; i < nc; i++) nm[i] = ~0u;
            if (self.blockLabels) std.mman.dealloc<u32>(self.blockLabels);
            self.blockLabels = nm;
            self.blockLabelsCap = nc;
        }
        u32 nextLabel = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
            if (self.blockLabels[bi] == ~0u)
                self.blockLabels[bi] = nextLabel++;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* blk = func->blocks[bi];
            if (bi > 0) self.c('\n');
            self.s(".LBB"); self.u((u64)self.blockLabels[bi]); self.s(":\n");

            for (u32 ii = 0; ii < blk->ninsts; ii++)
            {
                wallvm.ir_types.IrInst* inst = blk->insts[ii];

                switch (inst->opcode)
                {
                case wallvm.irOps.IrOpcode::Br:
                {
                    wallvm.ir_types.IrValue* tgt = inst->nops > 0 ? inst->ops[0] : null;
                    if (tgt)
                    {
                        self.emitPhiEdges(blk, tgt);
                        u32 tbi = self.resolveBlock(tgt);
                        if (tbi != ~0u && self.blockLabels[tbi] != ~0u)
                        { self.s("    b .LBB"); self.u((u64)self.blockLabels[tbi]); self.c('\n'); }
                    }
                    break;
                }
                case wallvm.irOps.IrOpcode::CondBr:
                {
                    wallvm.ir_types.IrValue* cond = inst->nops > 0 ? inst->ops[0] : null;
                    wallvm.ir_types.IrValue* tv = inst->nops > 1 ? inst->ops[1] : null;
                    wallvm.ir_types.IrValue* ev = inst->nops > 2 ? inst->ops[2] : null;
                    u32 tbi = tv ? self.resolveBlock(tv) : ~0u;
                    u32 ebi = ev ? self.resolveBlock(ev) : ~0u;
                    self.emitPhiEdges(blk, tv);
                    self.emitPhiEdges(blk, ev);
                    self.load(cond, "x9");
                    self.inst2("cmp", "x9", "#0");
                    if (tbi != ~0u && self.blockLabels[tbi] != ~0u)
                    { self.s("    b.ne .LBB"); self.u((u64)self.blockLabels[tbi]); self.c('\n'); }
                    if (ebi != ~0u && self.blockLabels[ebi] != ~0u)
                    { self.s("    b .LBB"); self.u((u64)self.blockLabels[ebi]); self.c('\n'); }
                    break;
                }
                case wallvm.irOps.IrOpcode::Ret:
                {
                    wallvm.ir_types.IrValue* rv = inst->nops > 0 ? inst->ops[0] : null;
                    wallvm.ir_types.IrType* rt = func->retType;
                    if (rv && rt && rt->kind != wallvm.ir_types.IrTypeKind::Void)
                    {
                        if (rt->kind == wallvm.ir_types.IrTypeKind::Float)
                            self.loadFp(rv, "d0");
                        else
                            self.load(rv, "x0");
                    }
                    self.inst0("mov sp, x29");
                    self.inst0("ldp x29, x30, [sp], #16");
                    self.inst0("ret");
                    break;
                }
                case wallvm.irOps.IrOpcode::Unreachable:
                    self.inst0("brk #0"); break;
                case wallvm.irOps.IrOpcode::Noret:
                {
                    const char* tmpl = wallvm.asm_rules.noretTemplate(&self.abi);
                    for (u32 i = 0; tmpl[i]; i++)
                    {
                        if (tmpl[i] == '$' && tmpl[i+1] == 'e' && tmpl[i+2] == 'x' && tmpl[i+3] == 'i' && tmpl[i+4] == 't' && tmpl[i+5] == '_' && tmpl[i+6] == 'c' && tmpl[i+7] == 'o' && tmpl[i+8] == 'd' && tmpl[i+9] == 'e')
                        {
                            self.s("0");
                            i += 9;
                        }
                        else
                            self.c(tmpl[i]);
                    }
                    self.c('\n');
                    break;
                }

                case wallvm.irOps.IrOpcode::Neg: self.emitUnary(inst, "neg"); break;
                case wallvm.irOps.IrOpcode::Not: self.emitUnary(inst, "mvn"); break;

                case wallvm.irOps.IrOpcode::Add: self.emitBinary(inst, "add"); break;
                case wallvm.irOps.IrOpcode::Sub: self.emitBinary(inst, "sub"); break;
                case wallvm.irOps.IrOpcode::Mul: self.emitBinary(inst, "mul"); break;
                case wallvm.irOps.IrOpcode::SDiv: self.emitDivRem(inst, true, false); break;
                case wallvm.irOps.IrOpcode::UDiv: self.emitDivRem(inst, false, false); break;
                case wallvm.irOps.IrOpcode::SRem: self.emitDivRem(inst, true, true); break;
                case wallvm.irOps.IrOpcode::URem: self.emitDivRem(inst, false, true); break;

                case wallvm.irOps.IrOpcode::And: self.emitBinary(inst, "and"); break;
                case wallvm.irOps.IrOpcode::Or: self.emitBinary(inst, "orr"); break;
                case wallvm.irOps.IrOpcode::Xor: self.emitBinary(inst, "eor"); break;
                case wallvm.irOps.IrOpcode::Shl: self.emitShift(inst, "lsl"); break;
                case wallvm.irOps.IrOpcode::Ashr: self.emitShift(inst, "asr"); break;
                case wallvm.irOps.IrOpcode::Lshr: self.emitShift(inst, "lsr"); break;

                case wallvm.irOps.IrOpcode::CtPop: self.emitCtPop(inst); break;
                case wallvm.irOps.IrOpcode::CtLz: self.emitCtLz(inst); break;
                case wallvm.irOps.IrOpcode::CtTz: self.emitCtTz(inst); break;
                case wallvm.irOps.IrOpcode::Rotl: self.emitRotl(inst); break;
                case wallvm.irOps.IrOpcode::Rotr: self.emitRotr(inst); break;
                case wallvm.irOps.IrOpcode::Bswap: self.emitBswap(inst); break;

                case wallvm.irOps.IrOpcode::SMin: self.emitMinMax(inst, true, false); break;
                case wallvm.irOps.IrOpcode::SMax: self.emitMinMax(inst, true, true); break;
                case wallvm.irOps.IrOpcode::UMin: self.emitMinMax(inst, false, false); break;
                case wallvm.irOps.IrOpcode::UMax: self.emitMinMax(inst, false, true); break;
                case wallvm.irOps.IrOpcode::Abs: self.emitAbs(inst); break;

                case wallvm.irOps.IrOpcode::Fma: self.emitFma(inst); break;
                case wallvm.irOps.IrOpcode::FAbs: self.emitFAbs(inst); break;
                case wallvm.irOps.IrOpcode::FSqrt: self.emitFSqrt(inst); break;

                case wallvm.irOps.IrOpcode::Alloca: self.emitAlloca(inst); break;
                case wallvm.irOps.IrOpcode::Load: self.emitLoad(inst); break;
                case wallvm.irOps.IrOpcode::Store: self.emitStore(inst); break;
                case wallvm.irOps.IrOpcode::Gep: self.emitGep(inst); break;

                case wallvm.irOps.IrOpcode::Trunc:
                case wallvm.irOps.IrOpcode::Zext:
                case wallvm.irOps.IrOpcode::Sext:
                case wallvm.irOps.IrOpcode::FpTrunc:
                case wallvm.irOps.IrOpcode::FpExt:
                case wallvm.irOps.IrOpcode::FpToSi:
                case wallvm.irOps.IrOpcode::SiToFp:
                case wallvm.irOps.IrOpcode::FpToUi:
                case wallvm.irOps.IrOpcode::UiToFp:
                case wallvm.irOps.IrOpcode::Bitcast:
                    self.emitCast(inst); break;

                case wallvm.irOps.IrOpcode::ICmp: self.emitICmp(inst); break;
                case wallvm.irOps.IrOpcode::FCmp: self.emitFCmp(inst); break;

                case wallvm.irOps.IrOpcode::Call: self.emitCall(inst); break;
                case wallvm.irOps.IrOpcode::Phi: self.emitPhi(inst); break;
                case wallvm.irOps.IrOpcode::Select: self.emitSelect(inst); break;
                }
            }
        }

        self.inst0("mov sp, x29");
        self.inst0("ldp x29, x30, [sp], #16");
        self.inst0("ret");
        return true;
    }

    bool generate(wallvm.ir_types.IrModule* mod_)
    {
        if (!mod_) return false;
        self.s(".text\n");
        for (u32 i = 0; i < mod_->nfuncs; i++)
        {
            if (!self.genFunc(mod_->funcs[i]))
                return false;
            self.c('\n');
        }
        return true;
    }
}

pub bool irCodegenArm64(wallvm.ir_types.IrModule* mod_, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !mod_) return false;
    Arm64Codegen cg = Arm64Codegen::new(ctx);
    return cg.generate(mod_);
}
