mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

pub struct PpcCodegen
{
    wallvm.ir_types.IrContext* ctx;
    wallvm.asm_rules.ABIRules abi;
    char* out; u32 outLen; u32 outCap;
    wallvm.ir_types.IrFunc* func; u32 frameSize;
    u32* stackSlots; u32 stackSlotsLen; u32 stackSlotsCap;
    u32* blockLabels; u32 blockLabelsCap;

    PpcCodegen new(wallvm.ir_types.IrContext* ctx)
    {
        PpcCodegen c;
        c.ctx = ctx; c.abi = wallvm.asm_rules.ppcAbi();
        c.out = null; c.outLen = 0; c.outCap = 0;
        c.func = null; c.frameSize = 0;
        c.stackSlots = null; c.stackSlotsLen = 0; c.stackSlotsCap = 0;
        c.blockLabels = null; c.blockLabelsCap = 0;
        return c;
    }

    void grow(u32 n)
    {
        if (self.outCap >= self.outLen + n) return;
        u32 nc = self.outCap ? self.outCap * 2 : 4096;
        while (nc < self.outLen + n) nc *= 2;
        char* nb = std.mman.alloc<char>(nc);
        if (self.out) { for (u32 i = 0; i < self.outLen; i++) nb[i] = self.out[i]; std.mman.dealloc<char>(self.out); }
        self.out = nb; self.outCap = nc;
    }
    
    void c(char ch) { self.grow(1); self.out[self.outLen++] = ch; }
    
    void s(const char* p)
    {
        if (!p) return;
        u32 l = 0;
        while (p[l]) l++;
        if (!l) return;
        self.grow(l);
        for (u32 i = 0; i < l; i++) self.out[self.outLen++] = p[i];
    }
    
    void u(u64 v)
    {
        if (v == 0) { self.c('0'); return; }
        char b[24];
        u32 p = 24;
        while (v) { b[--p] = (char)('0' + (v % 10)); v /= 10; }
        while (p < 24) self.c(b[p++]);
    }
    void pad() { self.c(' '); self.c(' '); self.c(' '); self.c(' '); }
    
    void inst0(const char* m) { self.pad(); self.s(m); self.c('\n'); }
    
    void inst1(const char* m, const char* a) { self.pad(); self.s(m); self.c(' '); self.s(a); self.c('\n'); }
    
    void inst2(const char* m, const char* a, const char* b)
        { self.pad(); self.s(m); self.c(' '); self.s(a); self.s(", "); self.s(b); self.c('\n'); }
    
    void inst3(const char* m, const char* a,
               const char* b, const char* c)
    {
        self.pad();
        self.s(m);
        self.c(' ');
        self.s(a);
        self.s(", ");
        self.s(b);
        self.s(", ");
        self.s(c);
        self.c('\n');
    }
    void emitLabel(const char* n) { self.s(n); self.s(":\n"); }

    void ensureSlots(u32 id)
    {
        if (id < self.stackSlotsCap) return;
        u32 nc = self.stackSlotsCap ? self.stackSlotsCap * 2 : 64;
        while (nc <= id) nc *= 2;
        u32* ns = std.mman.alloc<u32>(nc);
        for (u32 i = 0; i < self.stackSlotsCap; i++) ns[i] = self.stackSlots[i];
        for (u32 i = self.stackSlotsCap; i < nc; i++) ns[i] = 0;
        if (self.stackSlots) std.mman.dealloc<u32>(self.stackSlots);
        self.stackSlots = ns; self.stackSlotsCap = nc;
        if (id >= self.stackSlotsLen) self.stackSlotsLen = id + 1;
    }
    u32 slot(wallvm.ir_types.IrValue* v)
    {
        if (!v) return 0;
        u32 id = v->id;
        if (id >= self.stackSlotsCap) self.ensureSlots(id);
        if (self.stackSlots[id] == 0)
        {
            self.frameSize += 4;
            self.stackSlots[id] = self.frameSize;
        }
        return self.stackSlots[id];
    }
    bool isConst(wallvm.ir_types.IrValue* v) { if (!v) return true; wallvm.ir_types.IrValueKind k = v->kind; return k == wallvm.ir_types.IrValueKind::ConstInt || k == wallvm.ir_types.IrValueKind::ConstFloat; }
    void emitSlot(wallvm.ir_types.IrValue* v) { self.u((u64)self.slot(v)); self.s("(r1)"); }
    void emitImm(wallvm.ir_types.IrValue* v) { self.u(v->valData); }

    void load(wallvm.ir_types.IrValue* v, const char* r)
    {
        if (!v) { self.inst2("li", r, "0"); return; }
        if (self.isConst(v)) { self.pad(); self.s("li "); self.s(r); self.s(", "); self.emitImm(v); self.c('\n'); return; }
        self.pad(); self.s("lwz "); self.s(r); self.s(", "); self.emitSlot(v); self.c('\n');
    }
    void loadArith(wallvm.ir_types.IrValue* v, const char* r) { if (!v) { self.inst2("li", r, "0"); return; } if (self.isConst(v)) { self.load(v, r); return; } self.load(v, r); }
    void store(wallvm.ir_types.IrValue* v, const char* r) { if (!v) return; self.pad(); self.s("stw "); self.s(r); self.s(", "); self.emitSlot(v); self.c('\n'); }
    u32 resolveBlock(wallvm.ir_types.IrValue* bv) { for (u32 i = 0; i < self.func.nblocks; i++) if (&self.func.blocks[i].base == bv) return i; return ~0u; }

    void emitArith(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(lhs, "r3");
        if (rhs && self.isConst(rhs)) { self.pad(); self.s(mne); self.s("i r3, r3, "); self.emitImm(rhs); self.c('\n'); }
        else if (rhs) { self.loadArith(rhs, "r4"); self.inst3(mne, "r3", "r3", "r4"); }
        self.store(res, "r3");
    }
    void emitUnary(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(src, "r3");
        if (mne[0] == 'n' && mne[1] == 'o') self.inst3("nor", "r3", "r3", "r3");
        else self.inst2(mne, "r3", "r3");
        self.store(res, "r3");
    }
    void emitDivRem(wallvm.ir_types.IrInst* inst, const char* divMne, bool rem)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(lhs, "r3");
        if (rhs && self.isConst(rhs)) { self.pad(); self.s("li r4, "); self.emitImm(rhs); self.c('\n'); }
        else if (rhs) self.loadArith(rhs, "r4");
        else self.inst2("li", "r4", "1");
        self.inst3(divMne, "r3", "r3", "r4");
        if (rem) { self.inst3("mulld", "r4", "r3", "r4"); self.inst3("subf", "r3", "r4", "r3"); }
        self.store(res, "r3");
    }
    void emitShift(wallvm.ir_types.IrInst* inst, const char* mne)
    {
        wallvm.ir_types.IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* cnt = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(val, "r3");
        if (cnt && self.isConst(cnt)) { self.pad(); self.s(mne); self.s("i r3, r3, "); self.emitImm(cnt); self.c('\n'); }
        else { if (cnt) self.loadArith(cnt, "r4"); else self.inst2("li", "r4", "0"); self.inst3(mne, "r3", "r3", "r4"); }
        self.store(res, "r3");
    }

    void emitICmp(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        wallvm.irOps.IrICmpPred p = inst->icmpPred;
        self.loadArith(lhs, "r3");
        if (rhs && self.isConst(rhs)) { self.pad(); self.s("li r4, "); self.emitImm(rhs); self.c('\n'); }
        else if (rhs) self.loadArith(rhs, "r4");
        else self.inst2("li", "r4", "0");
        self.inst2("cmpw", "r3", "r4");
        self.inst0("mfcr r3");
        self.inst3("rlwinm", "r3", "r3", "2, 31, 31"); self.inst3("rlwinm", "r4", "r3", "1, 31, 31"); self.inst3("or", "r3", "r3", "r4");
        switch (p)
        {
        case wallvm.irOps.IrICmpPred::Eq: self.inst3("andi.", "r3", "r5", "0x2"); break;
        case wallvm.irOps.IrICmpPred::Ne: self.inst3("andi.", "r3", "r5", "0x2"); self.inst3("xori", "r3", "r3", "1"); break;
        case wallvm.irOps.IrICmpPred::Slt: self.inst3("andi.", "r3", "r5", "0x1"); break;
        case wallvm.irOps.IrICmpPred::Sle: self.inst3("andi.", "r3", "r5", "0x1"); self.inst3("xori", "r3", "r3", "1"); break;
        default: self.inst2("li", "r3", "0"); break;
        }
        self.store(res, "r3");
    }

    void emitFCmp(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* lhs = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* rhs = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        if (lhs) { self.pad(); self.s("lfd f1, "); self.emitSlot(lhs); self.c('\n'); }
        else self.inst0("fmr f1, f0");
        if (rhs) { self.pad(); self.s("lfd f2, "); self.emitSlot(rhs); self.c('\n'); }
        else self.inst0("fmr f2, f0");
        self.inst0("fcmpo cr0, f1, f2");
        self.inst0("mfcr r3");
        self.inst3("rlwinm", "r3", "r3", "4, 31, 31");
        self.inst3("rlwinm", "r4", "r3", "2, 31, 31");
        self.inst3("or", "r3", "r3", "r4");
        self.store(res, "r3");
    }

    void emitCall(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* callee = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 nArgs = inst->nops > 0 ? inst->nops - 1 : 0;
        for (u32 i = 0; i < nArgs && i < self.abi.numArgRegs; i++)
            self.load(inst->ops[i + 1], self.abi.argRegs[i]);
        if (callee && callee->kind == wallvm.ir_types.IrValueKind::Func && callee->name && callee->name[0])
            self.inst1("bl", callee->name);
        else { self.load(callee, "r12"); self.inst0("mtctr r12"); self.inst0("bctrl"); }
        if (res->type && res->type->kind != wallvm.ir_types.IrTypeKind::Void)
            self.store(res, "r3");
    }

    void emitLoad(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* ptr = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.load(ptr, "r3");
        self.inst1("lwz", "r3, 0(r3)");
        self.store(res, "r3");
    }
    void emitStore(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* ptr = inst->nops > 1 ? inst->ops[1] : null;
        self.load(ptr, "r4"); self.load(val, "r3");
        self.inst1("stw", "r3, 0(r4)");
    }
    void emitAlloca(wallvm.ir_types.IrInst* inst)
    {
        u32 sz = 16; self.pad(); self.s("addi r1, r1, -"); self.u((u64)sz); self.c('\n');
        self.inst3("addi", "r3", "r1", "0");
        self.store(&inst->base, "r3");
    }
    void emitGep(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* ptr = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        u32 nidxs = inst->nops > 1 ? inst->nops - 1 : 0;
        self.load(ptr, "r3");
        for (u32 i = 0; i < nidxs; i++)
        {
            wallvm.ir_types.IrValue* idx = inst->ops[i + 1];
            if (self.isConst(idx)) { u64 off = idx->valData * 4; if (off > 0) { self.pad(); self.s("addi r3, r3, "); self.u(off); self.c('\n'); } }
            else { self.loadArith(idx, "r4"); self.inst3("slwi", "r4", "r4", "2"); self.inst3("add", "r3", "r3", "r4"); }
        }
        self.store(res, "r3");
    }

    void emitCast(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* src = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        switch (inst->opcode)
        {
        case wallvm.irOps.IrOpcode::Trunc: self.load(src, "r3"); self.store(res, "r3"); break;
        case wallvm.irOps.IrOpcode::Zext: self.load(src, "r3"); self.store(res, "r3"); break;
        case wallvm.irOps.IrOpcode::Sext: self.load(src, "r3"); self.store(res, "r3"); break;
        case wallvm.irOps.IrOpcode::FpTrunc: case wallvm.irOps.IrOpcode::FpExt:
            self.pad(); self.s("lfd f1, "); self.emitSlot(src); self.c('\n');
            if (inst->opcode == wallvm.irOps.IrOpcode::FpTrunc) self.inst0("frsp f1, f1");
            self.pad(); self.s("stfd f1, "); self.emitSlot(res); self.c('\n'); break;
        case wallvm.irOps.IrOpcode::FpToSi: case wallvm.irOps.IrOpcode::FpToUi:
            self.pad(); self.s("lfd f1, "); self.emitSlot(src); self.c('\n');
            self.inst0("fctiwz f1, f1"); self.pad(); self.s("stfd f1, "); self.emitSlot(res); self.c('\n');
            self.pad(); self.s("lwz r3, 4("); self.emitSlot(res); self.s(")\n"); self.store(res, "r3"); break;
        case wallvm.irOps.IrOpcode::SiToFp: case wallvm.irOps.IrOpcode::UiToFp:
            self.load(src, "r3"); self.inst1("xoris", "r3, r3, 0x8000");
            self.inst0("stw r3, -8(r1)"); self.inst0("lfd f1, -8(r1)");
            self.inst0("fadd f1, f1, f1"); self.inst0("fadd f1, f1, f0");
            self.pad(); self.s("stfd f1, "); self.emitSlot(res); self.c('\n'); break;
        case wallvm.irOps.IrOpcode::Bitcast: self.load(src, "r3"); self.store(res, "r3"); break;
        default: break;
        }
    }

    void emitSelect(wallvm.ir_types.IrInst* inst)
    {
        wallvm.ir_types.IrValue* cond = inst->nops > 0 ? inst->ops[0] : null;
        wallvm.ir_types.IrValue* tval = inst->nops > 1 ? inst->ops[1] : null;
        wallvm.ir_types.IrValue* fval = inst->nops > 2 ? inst->ops[2] : null;
        wallvm.ir_types.IrValue* res = &inst->base;
        self.loadArith(fval, "r3"); self.loadArith(tval, "r4"); self.loadArith(cond, "r5");
        self.inst2("cmpwi", "r5", "0"); self.inst1("beq", "cr0, .Lsel");
        self.inst2("mr", "r3", "r4"); self.emitLabel(".Lsel");
        self.store(res, "r3");
    }
    void emitPhi(wallvm.ir_types.IrInst* inst)
    {
        // Phi results are materialized on incoming edges (emitPhiEdges).
    }

    void emitPhiEdges(wallvm.ir_types.IrBlock* pred, wallvm.ir_types.IrValue* tgt)
    {
        if (!pred || !tgt) return;
        u32 tbi = self.resolveBlock(tgt);
        if (tbi == ~0u) return;
        wallvm.ir_types.IrBlock* tb = self.func.blocks[tbi];
        for (u32 i = 0; i < tb->ninsts; i++)
        {
            wallvm.ir_types.IrInst* phi = tb->insts[i];
            if (phi->opcode != wallvm.irOps.IrOpcode::Phi) break;
            for (u32 j = 0; j + 1 < phi->nops; j += 2)
            {
                if (phi->ops[j + 1] == &pred->base)
                {
                    self.loadArith(phi->ops[j], "r3");
                    self.store(&phi->base, "r3");
                    break;
                }
            }
        }
    }

    bool genFunc(wallvm.ir_types.IrFunc* func)
    {
        if (!func) return false;
        if (func->isExtern) { if (func->base.name && func->base.name[0]) { self.pad(); self.s(".globl "); self.s(func->base.name); self.c('\n'); } return true; }
        self.func = func; self.frameSize = 0;
        for (u32 i = 0; i < self.blockLabelsCap; i++) self.blockLabels[i] = ~0u;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* blk = func->blocks[bi];
            for (u32 ii = 0; ii < blk->ninsts; ii++)
            {
                wallvm.ir_types.IrInst* inst = blk->insts[ii];
                wallvm.ir_types.IrValue* res = &inst->base;
                if (res->type && res->type->kind != wallvm.ir_types.IrTypeKind::Void) self.slot(res);
                for (u32 oi = 0; oi < inst->nops; oi++)
                { wallvm.ir_types.IrValue* op = inst->ops[oi]; if (op && !self.isConst(op) && op->kind != wallvm.ir_types.IrValueKind::Block) self.slot(op); }
            }
        }
        if (func->base.name && func->base.name[0]) self.emitLabel(func->base.name);
        else self.emitLabel(".Lanon");
        u32 frame = ((self.frameSize + 15) / 16) * 16 + 8;
        self.inst0("mflr r0"); self.pad(); self.s("stw r0, "); self.u((u64)(frame - 4)); self.s("(r1)\n");
        self.pad(); self.s("stwu r1, -"); self.u((u64)frame); self.s("(r1)\n");
        if (func->nblocks > self.blockLabelsCap)
        {
            u32 nc = self.blockLabelsCap ? self.blockLabelsCap * 2 : 16;
            while (nc < func->nblocks) nc *= 2;
            u32* nm = std.mman.alloc<u32>(nc);
            for (u32 i = 0; i < self.blockLabelsCap; i++) nm[i] = self.blockLabels[i];
            for (u32 i = self.blockLabelsCap; i < nc; i++) nm[i] = ~0u;
            if (self.blockLabels) std.mman.dealloc<u32>(self.blockLabels);
            self.blockLabels = nm; self.blockLabelsCap = nc;
        }
        u32 nl = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++) if (self.blockLabels[bi] == ~0u) self.blockLabels[bi] = nl++;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* blk = func->blocks[bi];
            if (bi > 0) self.c('\n');
            self.s(".LBB"); self.u((u64)self.blockLabels[bi]); self.s(":\n");
            for (u32 ii = 0; ii < blk->ninsts; ii++)
            {
                wallvm.ir_types.IrInst* inst = blk->insts[ii];
                switch (inst->opcode)
                {
                case wallvm.irOps.IrOpcode::Br:
                { wallvm.ir_types.IrValue* tgt = inst->nops > 0 ? inst->ops[0] : null; if (tgt) { self.emitPhiEdges(blk, tgt); u32 tbi = self.resolveBlock(tgt); if (tbi != ~0u && self.blockLabels[tbi] != ~0u) { self.s("    b .LBB"); self.u((u64)self.blockLabels[tbi]); self.c('\n'); } } break; }
                case wallvm.irOps.IrOpcode::CondBr:
                {
                    wallvm.ir_types.IrValue* cond = inst->nops > 0 ? inst->ops[0] : null;
                    wallvm.ir_types.IrValue* tv = inst->nops > 1 ? inst->ops[1] : null;
                    wallvm.ir_types.IrValue* ev = inst->nops > 2 ? inst->ops[2] : null;
                    u32 tbi = tv ? self.resolveBlock(tv) : ~0u;
                    u32 ebi = ev ? self.resolveBlock(ev) : ~0u;
                    self.emitPhiEdges(blk, tv);
                    self.emitPhiEdges(blk, ev);
                    self.loadArith(cond, "r3"); self.inst2("cmpwi", "r3", "0");
                    if (ebi != ~0u && self.blockLabels[ebi] != ~0u)
                    { self.s("    beq .LBB"); self.u((u64)self.blockLabels[ebi]); self.c('\n'); }
                    if (tbi != ~0u && self.blockLabels[tbi] != ~0u)
                    { self.s("    b .LBB"); self.u((u64)self.blockLabels[tbi]); self.c('\n'); }
                    break;
                }
                case wallvm.irOps.IrOpcode::Ret:
                {
                    wallvm.ir_types.IrValue* rv = inst->nops > 0 ? inst->ops[0] : null;
                    if (rv && func->retType && func->retType->kind != wallvm.ir_types.IrTypeKind::Void)
                        self.load(rv, "r3");
                    self.pad(); self.s("addi r1, r1, "); self.u((u64)frame); self.c('\n');
                    self.pad(); self.s("lwz r0, "); self.u((u64)(frame - 4)); self.s("(r1)\n");
                    self.inst0("mtlr r0"); self.inst0("blr");
                    break;
                }
                case wallvm.irOps.IrOpcode::Unreachable: self.inst0("trap"); break;
                case wallvm.irOps.IrOpcode::Noret:
                {
                    const char* tmpl = wallvm.asm_rules.noretTemplate(&self.abi);
                    for (u32 i = 0; tmpl[i]; i++)
                    { if (tmpl[i] == '$' && tmpl[i+1] == 'e' && tmpl[i+2] == 'x' && tmpl[i+3] == 'i' && tmpl[i+4] == 't' && tmpl[i+5] == '_' && tmpl[i+6] == 'c' && tmpl[i+7] == 'o' && tmpl[i+8] == 'd' && tmpl[i+9] == 'e') { self.s("0"); i += 9; } else self.c(tmpl[i]); }
                    self.c('\n');
                    break;
                }
                case wallvm.irOps.IrOpcode::Neg: self.emitUnary(inst, "neg"); break;
                case wallvm.irOps.IrOpcode::Not: self.emitUnary(inst, "nor"); break;
                case wallvm.irOps.IrOpcode::Add: self.emitArith(inst, "add"); break;
                case wallvm.irOps.IrOpcode::Sub: self.loadArith(inst->ops[0], "r3"); self.loadArith(inst->ops[1], "r4"); self.inst3("subf", "r3", "r4", "r3"); self.store(&inst->base, "r3"); break;
                case wallvm.irOps.IrOpcode::Mul: self.emitArith(inst, "mullw"); break;
                case wallvm.irOps.IrOpcode::SDiv: self.emitDivRem(inst, "divw", false); break;
                case wallvm.irOps.IrOpcode::UDiv: self.emitDivRem(inst, "divwu", false); break;
                case wallvm.irOps.IrOpcode::SRem: self.emitDivRem(inst, "divw", true); break;
                case wallvm.irOps.IrOpcode::URem: self.emitDivRem(inst, "divwu", true); break;
                case wallvm.irOps.IrOpcode::And: self.emitArith(inst, "and"); break;
                case wallvm.irOps.IrOpcode::Or: self.emitArith(inst, "or"); break;
                case wallvm.irOps.IrOpcode::Xor: self.emitArith(inst, "xor"); break;
                case wallvm.irOps.IrOpcode::Shl: self.emitShift(inst, "slw"); break;
                case wallvm.irOps.IrOpcode::Ashr: self.emitShift(inst, "sraw"); break;
                case wallvm.irOps.IrOpcode::Lshr: self.emitShift(inst, "srw"); break;
                case wallvm.irOps.IrOpcode::Load: self.emitLoad(inst); break;
                case wallvm.irOps.IrOpcode::Store: self.emitStore(inst); break;
                case wallvm.irOps.IrOpcode::Alloca: self.emitAlloca(inst); break;
                case wallvm.irOps.IrOpcode::Gep: self.emitGep(inst); break;
                case wallvm.irOps.IrOpcode::Trunc: case wallvm.irOps.IrOpcode::Zext: case wallvm.irOps.IrOpcode::Sext:
                case wallvm.irOps.IrOpcode::FpTrunc: case wallvm.irOps.IrOpcode::FpExt:
                case wallvm.irOps.IrOpcode::FpToSi: case wallvm.irOps.IrOpcode::SiToFp:
                case wallvm.irOps.IrOpcode::FpToUi: case wallvm.irOps.IrOpcode::UiToFp: case wallvm.irOps.IrOpcode::Bitcast:
                    self.emitCast(inst); break;
                case wallvm.irOps.IrOpcode::ICmp: self.emitICmp(inst); break;
                case wallvm.irOps.IrOpcode::FCmp: self.emitFCmp(inst); break;
                case wallvm.irOps.IrOpcode::Call: self.emitCall(inst); break;
                case wallvm.irOps.IrOpcode::Phi: self.emitPhi(inst); break;
                case wallvm.irOps.IrOpcode::Select: self.emitSelect(inst); break;
                case wallvm.irOps.IrOpcode::Abs: self.emitUnary(inst, "abs"); break;
                case wallvm.irOps.IrOpcode::Bswap: self.load(inst->ops[0], "r3"); self.inst0("stwbrx r3, 0, r3"); self.store(&inst->base, "r3"); break;
                case wallvm.irOps.IrOpcode::CtLz: self.emitUnary(inst, "cntlzw"); break;
                case wallvm.irOps.IrOpcode::CtPop: self.emitUnary(inst, "popcntw"); break;
                case wallvm.irOps.IrOpcode::CtTz: self.load(inst->ops[0], "r3"); self.inst3("addi", "r4", "r3", "-1"); self.inst3("andc", "r3", "r4", "r3"); self.inst2("cntlzw", "r3", "r3"); self.inst3("subfic", "r3", "r3", "32"); self.store(&inst->base, "r3"); break;
                case wallvm.irOps.IrOpcode::FAbs: self.load(inst->ops[0], "r3"); self.inst3("clrlwi", "r3", "r3", "1"); self.inst0("stfd f1, 0(r3)"); self.pad(); self.s("lfd f1, "); self.emitSlot(&inst->base); self.c('\n'); break;
                case wallvm.irOps.IrOpcode::Fma: self.load(inst->ops[0], "r3"); self.inst0("lfd f1, 0(r3)"); self.load(inst->ops[1], "r3"); self.inst0("lfd f2, 0(r3)"); self.load(inst->ops[2], "r3"); self.inst0("lfd f3, 0(r3)"); self.inst0("fmadd f1, f1, f2, f3"); self.pad(); self.s("stfd f1, "); self.emitSlot(&inst->base); self.c('\n'); break;
                case wallvm.irOps.IrOpcode::FSqrt: self.load(inst->ops[0], "r3"); self.inst0("lfd f1, 0(r3)"); self.inst0("fsqrt f1, f1"); self.pad(); self.s("stfd f1, "); self.emitSlot(&inst->base); self.c('\n'); break;
                case wallvm.irOps.IrOpcode::Rotl: self.emitShift(inst, "rotlw"); break;
                case wallvm.irOps.IrOpcode::Rotr: { wallvm.ir_types.IrValue* res = &inst->base; self.loadArith(inst->ops[0], "r3"); wallvm.ir_types.IrValue* cnt = inst->nops > 1 ? inst->ops[1] : null; if (cnt && cnt->kind == wallvm.ir_types.IrValueKind::ConstInt) { self.pad(); self.s("rotlwi r3, r3, "); self.u(32 - cnt->valData); self.c('\n'); } else { self.loadArith(cnt, "r4"); self.inst3("subfic", "r4", "r4", "32"); self.inst3("rotlw", "r3", "r3", "r4"); } self.store(res, "r3"); break; }
                case wallvm.irOps.IrOpcode::SMax: self.loadArith(inst->ops[0], "r3"); self.loadArith(inst->ops[1], "r4"); self.inst2("cmpw", "r3", "r4"); self.inst1("bge", "cr0, .Lmx"); self.inst2("mr", "r3", "r4"); self.emitLabel(".Lmx"); self.store(&inst->base, "r3"); break;
                case wallvm.irOps.IrOpcode::SMin: self.loadArith(inst->ops[0], "r3"); self.loadArith(inst->ops[1], "r4"); self.inst2("cmpw", "r3", "r4"); self.inst1("ble", "cr0, .Lmn"); self.inst2("mr", "r3", "r4"); self.emitLabel(".Lmn"); self.store(&inst->base, "r3"); break;
                case wallvm.irOps.IrOpcode::UMax: self.loadArith(inst->ops[0], "r3"); self.loadArith(inst->ops[1], "r4"); self.inst2("cmplw", "r3", "r4"); self.inst1("bge", "cr0, .Lux"); self.inst2("mr", "r3", "r4"); self.emitLabel(".Lux"); self.store(&inst->base, "r3"); break;
                case wallvm.irOps.IrOpcode::UMin: self.loadArith(inst->ops[0], "r3"); self.loadArith(inst->ops[1], "r4"); self.inst2("cmplw", "r3", "r4"); self.inst1("ble", "cr0, .Lun"); self.inst2("mr", "r3", "r4"); self.emitLabel(".Lun"); self.store(&inst->base, "r3"); break;
                default: break;
                }
            }
        }
        self.pad(); self.s("addi r1, r1, "); self.u((u64)frame); self.c('\n');
        self.pad(); self.s("lwz r0, "); self.u((u64)(frame - 4)); self.s("(r1)\n");
        self.inst0("mtlr r0"); self.inst0("blr");
        return true;
    }

    bool generate(wallvm.ir_types.IrModule* mod_)
    {
        if (!mod_) return false;
        self.s(".text\n");
        for (u32 i = 0; i < mod_->nfuncs; i++) { if (!self.genFunc(mod_->funcs[i])) return false; self.c('\n'); }
        return true;
    }
}

pub bool irCodegenPpc(wallvm.ir_types.IrModule* mod_, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !mod_) return false;
    PpcCodegen cg = PpcCodegen::new(ctx);
    return cg.generate(mod_);
}
