mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

pub struct IrBuilder
{
    wallvm.ir_types.IrContext* ctx;
    wallvm.ir_types.IrBlock* block;
    wallvm.ir_types.IrInst* insertBefore;

    IrBuilder new(wallvm.ir_types.IrContext* ctx)
    {
        IrBuilder b;
        b.ctx = ctx;
        b.block = null;
        b.insertBefore = null;
        return b;
    }

    // Set insertion position
    void pos(wallvm.ir_types.IrBlock* block, wallvm.ir_types.IrInst* before)
    {
        self.block = block;
        self.insertBefore = before;
    }

    wallvm.ir_types.IrInst* retVoid()
    {
        return self.createInst(wallvm.irOps.IrOpcode::Ret, self.ctx.tyVoid(), null, 0, 0, 0);
    }

    wallvm.ir_types.IrInst* ret(wallvm.ir_types.IrValue* val)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(1);
        ops[0] = val;
        return self.createInst(wallvm.irOps.IrOpcode::Ret, val.type, ops, 1, 0, 0);
    }

    wallvm.ir_types.IrInst* br(wallvm.ir_types.IrBlock* dest)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(1);
        ops[0] = &dest.base;
        wallvm.ir_types.IrInst* inst = self.createInst(wallvm.irOps.IrOpcode::Br, self.ctx.tyVoid(), ops, 1, 0, 0);
        // sdd successor edge
        if (self.block) self.block.addSucc(dest);
        return inst;
    }

    wallvm.ir_types.IrInst* condBr(wallvm.ir_types.IrValue* cond, wallvm.ir_types.IrBlock* thenBb, wallvm.ir_types.IrBlock* elseBb)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(3);
        ops[0] = cond;
        ops[1] = &thenBb.base;
        ops[2] = &elseBb.base;
        wallvm.ir_types.IrInst* inst = self.createInst(wallvm.irOps.IrOpcode::CondBr, self.ctx.tyVoid(), ops, 3, 0, 0);
        if (self.block)
        {
            self.block.addSucc(thenBb);
            self.block.addSucc(elseBb);
        }
        return inst;
    }

    wallvm.ir_types.IrInst* unreachable()
    {
        return self.createInst(wallvm.irOps.IrOpcode::Unreachable, self.ctx.tyVoid(), null, 0, 0, 0);
    }

    wallvm.ir_types.IrInst* noret()
    {
        return self.createInst(wallvm.irOps.IrOpcode::Noret, self.ctx.tyVoid(), null, 0, 0, 0);
    }

    wallvm.ir_types.IrInst* add(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Add, l, r);
    }

    wallvm.ir_types.IrInst* sub(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Sub, l, r);
    }

    wallvm.ir_types.IrInst* mul(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Mul, l, r);
    }

    wallvm.ir_types.IrInst* sdiv(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::SDiv, l, r);
    }

    wallvm.ir_types.IrInst* udiv(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::UDiv, l, r);
    }

    wallvm.ir_types.IrInst* srem(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::SRem, l, r);
    }

    wallvm.ir_types.IrInst* fadd(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::FAdd, l, r);
    }

    wallvm.ir_types.IrInst* fsub(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::FSub, l, r);
    }

    wallvm.ir_types.IrInst* fmul(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::FMul, l, r);
    }

    wallvm.ir_types.IrInst* fdiv(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::FDiv, l, r);
    }

    wallvm.ir_types.IrInst* urem(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::URem, l, r);
    }

    wallvm.ir_types.IrInst* andOp(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::And, l, r);
    }

    wallvm.ir_types.IrInst* orOp(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Or, l, r);
    }

    wallvm.ir_types.IrInst* xorOp(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Xor, l, r);
    }

    wallvm.ir_types.IrInst* shl(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Shl, l, r);
    }

    wallvm.ir_types.IrInst* ashr(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Ashr, l, r);
    }

    wallvm.ir_types.IrInst* lshr(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Lshr, l, r);
    }

    wallvm.ir_types.IrInst* neg(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::Neg, v);
    }

    wallvm.ir_types.IrInst* notOp(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::Not, v);
    }

    //   Memory
    wallvm.ir_types.IrInst* alloca(wallvm.ir_types.IrType* ty)
    {
        wallvm.ir_types.IrType* ptrTy = self.ctx.tyPtr(ty);
        return self.createInst(wallvm.irOps.IrOpcode::Alloca, ptrTy, null, 0, 0, 0);
    }

    wallvm.ir_types.IrInst* load(wallvm.ir_types.IrType* ty, wallvm.ir_types.IrValue* ptr)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(wallvm.irOps.IrOpcode::Load, ty, ops, 1, 0, 0);
    }

    wallvm.ir_types.IrInst* store(wallvm.ir_types.IrValue* val, wallvm.ir_types.IrValue* ptr)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = val;
        ops[1] = ptr;
        return self.createInst(wallvm.irOps.IrOpcode::Store, self.ctx.tyVoid(), ops, 2, 0, 0);
    }

    wallvm.ir_types.IrInst* gep(wallvm.ir_types.IrValue* ptr, wallvm.ir_types.IrValue** idxs, u32 nidxs)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(nidxs + 1);
        ops[0] = ptr;
        for (u32 i = 0; i < nidxs; i++)
            ops[i + 1] = idxs[i];
        wallvm.ir_types.IrType* elemTy = ptr.type;
        if (elemTy && elemTy.kind == wallvm.ir_types.IrTypeKind::Ptr && elemTy.elem)
            elemTy = elemTy.elem;
        return self.createInst(wallvm.irOps.IrOpcode::Gep, self.ctx.tyPtr(elemTy), ops, nidxs + 1, 0, 0);
    }

    //   Cast
    wallvm.ir_types.IrInst* trunc(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::Trunc, v, dt);
    }

    wallvm.ir_types.IrInst* zext(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::Zext, v, dt);
    }

    wallvm.ir_types.IrInst* sext(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::Sext, v, dt);
    }

    wallvm.ir_types.IrInst* fpTrunc(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::FpTrunc, v, dt);
    }

    wallvm.ir_types.IrInst* fpExt(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::FpExt, v, dt);
    }

    wallvm.ir_types.IrInst* fpToSi(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::FpToSi, v, dt);
    }

    wallvm.ir_types.IrInst* fpToUi(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::FpToUi, v, dt);
    }

    wallvm.ir_types.IrInst* siToFp(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::SiToFp, v, dt);
    }

    wallvm.ir_types.IrInst* uiToFp(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::UiToFp, v, dt);
    }

    wallvm.ir_types.IrInst* bitcast(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        return self.createUnary3(wallvm.irOps.IrOpcode::Bitcast, v, dt);
    }

    //   Compare
    wallvm.ir_types.IrInst* icmp(wallvm.irOps.IrICmpPred p, wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        wallvm.ir_types.IrType* i1Ty = self.ctx.tyInt(1);
        return self.createInst(wallvm.irOps.IrOpcode::ICmp, i1Ty, ops, 2, (u64)p, 0);
    }

    wallvm.ir_types.IrInst* fcmp(wallvm.irOps.IrFCmpPred p, wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        wallvm.ir_types.IrType* i1Ty = self.ctx.tyInt(1);
        return self.createInst(wallvm.irOps.IrOpcode::FCmp, i1Ty, ops, 2, 0, (u64)p);
    }

    //   bit man
    wallvm.ir_types.IrInst* ctPop(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::CtPop, v);
    }

    wallvm.ir_types.IrInst* ctLz(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::CtLz, v);
    }

    wallvm.ir_types.IrInst* ctTz(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::CtTz, v);
    }

    wallvm.ir_types.IrInst* rotl(wallvm.ir_types.IrValue* x, wallvm.ir_types.IrValue* y)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Rotl, x, y);
    }

    wallvm.ir_types.IrInst* rotr(wallvm.ir_types.IrValue* x, wallvm.ir_types.IrValue* y)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::Rotr, x, y);
    }

    wallvm.ir_types.IrInst* bswap(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::Bswap, v);
    }

    // maths shit
    wallvm.ir_types.IrInst* smin(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::SMin, l, r);
    }

    wallvm.ir_types.IrInst* smax(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::SMax, l, r);
    }

    wallvm.ir_types.IrInst* umin(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::UMin, l, r);
    }

    wallvm.ir_types.IrInst* umax(wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        return self.createBinary(wallvm.irOps.IrOpcode::UMax, l, r);
    }

    wallvm.ir_types.IrInst* abs(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::Abs, v);
    }

    //   Floating-point

    wallvm.ir_types.IrInst* fma(wallvm.ir_types.IrValue* a, wallvm.ir_types.IrValue* b, wallvm.ir_types.IrValue* c)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(3);
        ops[0] = a;
        ops[1] = b;
        ops[2] = c;
        return self.createInst(wallvm.irOps.IrOpcode::Fma, a.type, ops, 3, 0, 0);
    }

    wallvm.ir_types.IrInst* fabs(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::FAbs, v);
    }

    wallvm.ir_types.IrInst* fsqrt(wallvm.ir_types.IrValue* v)
    {
        return self.createUnary2(wallvm.irOps.IrOpcode::FSqrt, v);
    }

    wallvm.ir_types.IrInst* shuffleVector(wallvm.ir_types.IrValue* v1, wallvm.ir_types.IrValue* v2, wallvm.ir_types.IrValue** mask, u32 nmask)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(nmask + 2);
        ops[0] = v1;
        ops[1] = v2;
        for (u32 i = 0; i < nmask; i++) ops[i + 2] = mask[i];
        return self.createInst(wallvm.irOps.IrOpcode::ShuffleVector, v1.type, ops, nmask + 2, 0, 0);
    }

    wallvm.ir_types.IrInst* extractElement(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrValue* idx)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = v;
        ops[1] = idx;
        wallvm.ir_types.IrType* elemTy = v.type && v.type.kind == wallvm.ir_types.IrTypeKind::Vector ? v.type.elem : v.type;
        return self.createInst(wallvm.irOps.IrOpcode::ExtractElement, elemTy, ops, 2, 0, 0);
    }

    wallvm.ir_types.IrInst* insertElement(wallvm.ir_types.IrValue* v, wallvm.ir_types.IrValue* val, wallvm.ir_types.IrValue* idx)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(3);
        ops[0] = v;
        ops[1] = val;
        ops[2] = idx;
        return self.createInst(wallvm.irOps.IrOpcode::InsertElement, v.type, ops, 3, 0, 0);
    }

    wallvm.ir_types.IrInst* inlineAsm(const char* asmStr, wallvm.ir_types.IrValue** args, u32 nargs, wallvm.ir_types.IrType* retTy)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(nargs + 1);
        wallvm.ir_types.IrType* asmType = self.ctx.tyPtr(self.ctx.tyInt(8));
        wallvm.ir_types.IrValue* asmStrVal = self.ctx.constInt(asmType, (u64)asmStr);
        ops[0] = asmStrVal;
        for (u32 i = 0; i < nargs; i++)
            ops[i + 1] = args[i];
        return self.createInst(wallvm.irOps.IrOpcode::InlineAsm, retTy ? retTy : self.ctx.tyVoid(), ops, nargs + 1, 0, 0);
    }

    //   atomics
    wallvm.ir_types.IrInst* atomicLoad(wallvm.ir_types.IrType* ty, wallvm.ir_types.IrValue* ptr, wallvm.irOps.IrAtomicOrdering order)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(wallvm.irOps.IrOpcode::AtomicLoad, ty, ops, 1, (u64)order, 0);
    }

    wallvm.ir_types.IrInst* atomicStore(wallvm.ir_types.IrValue* val, wallvm.ir_types.IrValue* ptr, wallvm.irOps.IrAtomicOrdering order)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = val;
        ops[1] = ptr;
        return self.createInst(wallvm.irOps.IrOpcode::AtomicStore, self.ctx.tyVoid(), ops, 2, (u64)order, 0);
    }

    wallvm.ir_types.IrInst* atomicRmw(wallvm.ir_types.IrType* ty,
                               wallvm.irOps.IrAtomicRmwOp op,
                               wallvm.ir_types.IrValue* ptr,
                               wallvm.ir_types.IrValue* val,
                               wallvm.irOps.IrAtomicOrdering order)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = ptr;
        ops[1] = val;
        return self.createInst(wallvm.irOps.IrOpcode::AtomicRmw, ty, ops, 2, (u64)op, (u64)order);
    }

    wallvm.ir_types.IrInst* atomicCmpXchg(wallvm.ir_types.IrType* ty,
                                  wallvm.ir_types.IrValue* ptr,
                                  wallvm.ir_types.IrValue* cmp,
                                  wallvm.ir_types.IrValue* val,
                                  wallvm.irOps.IrAtomicOrdering succ,
                                  wallvm.irOps.IrAtomicOrdering fail)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(3);
        ops[0] = ptr;
        ops[1] = cmp;
        ops[2] = val;
        return self.createInst(wallvm.irOps.IrOpcode::AtomicCmpXchg, ty, ops, 3, (u64)succ, (u64)fail);
    }

    wallvm.ir_types.IrInst* fence(wallvm.irOps.IrAtomicOrdering order)
    {
        return self.createInst(wallvm.irOps.IrOpcode::Fence, self.ctx.tyVoid(), null, 0, (u64)order, 0);
    }

    //   exception handling
    wallvm.ir_types.IrInst* landingPad(wallvm.ir_types.IrType* ty, wallvm.ir_types.IrValue* personalityFn, u32 numClauses)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(numClauses + 1);
        ops[0] = personalityFn;
        for (u32 i = 0; i < numClauses; i++)
            ops[i + 1] = null; // placeholder for filter/catch clauses
        return self.createInst(wallvm.irOps.IrOpcode::LandingPad, ty, ops, numClauses + 1, 0, 0);
    }

    wallvm.ir_types.IrInst* extractValue(wallvm.ir_types.IrValue* agg, u32 idx)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = agg;
        wallvm.ir_types.IrType* i32Ty = self.ctx.tyInt(32);
        ops[1] = self.ctx.constInt(i32Ty, (u64)idx);
        wallvm.ir_types.IrType* elemTy = agg.type;
        if (elemTy && elemTy.kind == wallvm.ir_types.IrTypeKind::Array && elemTy.elem)
            elemTy = elemTy.elem;
        return self.createInst(wallvm.irOps.IrOpcode::ExtractValue, elemTy, ops, 2, 0, 0);
    }

    //   gc support
    wallvm.ir_types.IrInst* gcRoot(wallvm.ir_types.IrValue* ptr)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(wallvm.irOps.IrOpcode::GcRoot, ptr.type, ops, 1, 0, 0);
    }

    wallvm.ir_types.IrInst* gcWriteBarrier(wallvm.ir_types.IrValue* ptr, wallvm.ir_types.IrValue* val)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = ptr;
        ops[1] = val;
        return self.createInst(wallvm.irOps.IrOpcode::GcWriteBarrier, self.ctx.tyVoid(), ops, 2, 0, 0);
    }

    wallvm.ir_types.IrInst* gcSafepoint()
    {
        return self.createInst(wallvm.irOps.IrOpcode::GcSafepoint, self.ctx.tyVoid(), null, 0, 0, 0);
    }

    wallvm.ir_types.IrInst* call(wallvm.ir_types.IrValue* callee, wallvm.ir_types.IrValue** args, u32 nargs)
    {
        wallvm.ir_types.IrType* retTy = callee.type;
        if (retTy && retTy.kind == wallvm.ir_types.IrTypeKind::Func && retTy.ret)
            retTy = retTy.ret;
        else
            retTy = self.ctx.tyVoid();
        wallvm.ir_types.IrValue** ops = self.allocOps(nargs + 1);
        ops[0] = callee;
        for (u32 i = 0; i < nargs; i++)
            ops[i + 1] = args[i];
        return self.createInst(wallvm.irOps.IrOpcode::Call, retTy, ops, nargs + 1, 0, 0);
    }

    wallvm.ir_types.IrInst* phi(wallvm.ir_types.IrType* ty, wallvm.ir_types.IrValue** vals, wallvm.ir_types.IrBlock** blocks, u32 nincoming)
    {
        // interleave, val, block, val, block, ...
        u32 nops = nincoming * 2;
        wallvm.ir_types.IrValue** ops = self.allocOps(nops);
        for (u32 i = 0; i < nincoming; i++)
        {
            ops[i * 2] = vals[i];
            ops[i * 2 + 1] = &blocks[i].base;
        }
        return self.createInst(wallvm.irOps.IrOpcode::Phi, ty, ops, nops, 0, 0);
    }

    wallvm.ir_types.IrInst* select(wallvm.ir_types.IrValue* cond, wallvm.ir_types.IrValue* t, wallvm.ir_types.IrValue* f)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(3);
        ops[0] = cond;
        ops[1] = t;
        ops[2] = f;
        return self.createInst(wallvm.irOps.IrOpcode::Select, t.type, ops, 3, 0, 0);
    }

    wallvm.ir_types.IrValue** allocOps(u32 count)
    {
        return (wallvm.ir_types.IrValue**)std.mman.alloc<wallvm.ir_types.IrValue*>(count);
    }

    wallvm.ir_types.IrInst* createBinary(wallvm.irOps.IrOpcode op, wallvm.ir_types.IrValue* l, wallvm.ir_types.IrValue* r)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        return self.createInst(op, l.type, ops, 2, 0, 0);
    }

    wallvm.ir_types.IrInst* createUnary2(wallvm.irOps.IrOpcode op, wallvm.ir_types.IrValue* v)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(1);
        ops[0] = v;
        return self.createInst(op, v.type, ops, 1, 0, 0);
    }

    wallvm.ir_types.IrInst* createUnary3(wallvm.irOps.IrOpcode op, wallvm.ir_types.IrValue* v, wallvm.ir_types.IrType* dt)
    {
        wallvm.ir_types.IrValue** ops = self.allocOps(1);
        ops[0] = v;
        return self.createInst(op, dt, ops, 1, 0, 0);
    }

    wallvm.ir_types.IrInst* createInst(wallvm.irOps.IrOpcode op, wallvm.ir_types.IrType* ty, wallvm.ir_types.IrValue** ops, u32 nops, u64 icmpP, u64 fcmpP)
    {
        wallvm.ir_types.IrInst* inst = self.ctx.createInst(op, ty, ops, nops, icmpP, fcmpP);
        if (inst != null)
        {
            // Insert into current block
            if (self.block)
                self.block.addInst(inst);

            // Track users for each operand (before freeing ops)
            for (u32 i = 0; i < nops; i++)
                if (ops[i] != null)
                    ops[i].addUser(inst);
        }
        // Free the temp ops array now that createInst copied it
        if (ops) std.mman.dealloc<wallvm.ir_types.IrValue*>(ops);
        return inst;
    }
}