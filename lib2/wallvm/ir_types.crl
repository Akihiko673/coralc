mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

pub enum IrTypeKind
{
    Void,
    Int,
    Float,
    Ptr,
    Array,
    Func,
    Vector
}

pub enum IrValueKind
{
    Inst,
    ConstInt,
    ConstFloat,
    Block,
    Func
}

pub struct IrType
{
    IrTypeKind kind;
    u32 width;
    IrType* elem;
    u32 count;
    IrType* ret;
    IrType** params;
    u32 nparams;
    bool isVararg;

    IrTypeKind kind() { return self->kind; }
    u32 width() { return self->width; }
    bool isEqual(IrType* other) { return irTypeEqual(self, other); }
}

pub struct IrValue
{
    IrValueKind kind;
    IrType* type;
    u32 id;
    u64 valData;
    char* name;
    IrInst** users;
    u32 nusers;
    u32 capUsers;

    void addUser(IrInst* inst)
    {
        if (self.nusers >= self.capUsers)
        {
            u32 newCap = self.capUsers ? self.capUsers * 2 : 4;
            IrInst** newUsers = std.mman.alloc<IrInst*>(newCap);
            if (self.users)
            {
                std.mman.copy<IrInst*>(newUsers, self.users, self.nusers);
                std.mman.dealloc<IrInst*>(self.users);
            }
            self.users = newUsers;
            self.capUsers = newCap;
        }
        self.users[self.nusers++] = inst;
    }

    void removeUser(IrInst* inst)
    {
        for (u32 i = 0; i < self.nusers; i++)
        {
            if (self.users[i] == inst)
            {
                self.users[i] = self.users[--self.nusers];
                return;
            }
        }
    }

    // Rewrite every instruction that uses this value to use newVal instead.
    // Keeps both user lists consistent. The caller is responsible for erasing
    // the producer instruction afterwards.
    void replaceAllUses(IrValue* newVal)
    {
        if (self == newVal) return;
        for (u32 ui = 0; ui < self.nusers; ui++)
        {
            IrInst* user = self.users[ui];
            for (u32 j = 0; j < user.nops; j++)
                if (user.ops[j] == self)
                    user.ops[j] = newVal;
            newVal.addUser(user);
        }
        self.nusers = 0;
    }

    IrValueKind valueKind() { return self->kind; }
    IrType* valueType() { return self->type; }
}

pub struct IrDebugLoc
{
    char* file;
    u32 line;
    u32 col;
}

pub struct IrVarDebugInfo
{
    char* varName;
    IrType* varType;
    u32 line;
    u32 col;
    u32 argIndex; // ~0u if not an argument
}

pub struct IrInst
{
    IrValue base;
    IrOpcode opcode;
    IrBlock* parent;
    IrInst* prev;
    IrInst* next;
    IrValue** ops;
    u32 nops;
    u32 capOps;
    IrICmpPred icmpPred;
    IrFCmpPred fcmpPred;
    IrDebugLoc debugLoc;
    IrVarDebugInfo* varDbg;
    u32 nvarDbg;
    u32 capVarDbg;

    IrInst* prevInst() { return self->prev; }
    IrInst* nextInst() { return self->next; }
    IrBlock* instParent() { return self->parent; }

    void setDebugLoc(const char* file, u32 line, u32 col)
    {
        if (!file) return;
        u32 len = 0; while (file[len]) len++;
        char* copy = std.mman.alloc<char>(len + 1);
        for (u32 i = 0; i < len; i++) copy[i] = file[i];
        copy[len] = 0;
        self.debugLoc.file = copy;
        self.debugLoc.line = line;
        self.debugLoc.col = col;
    }

    void addVarDebug(const char* name, IrType* ty, u32 line, u32 col, u32 argIdx)
    {
        if (self.nvarDbg >= self.capVarDbg)
        {
            u32 nc = self.capVarDbg ? self.capVarDbg * 2 : 4;
            IrVarDebugInfo* nd = std.mman.alloc<IrVarDebugInfo>(nc);
            if (self.varDbg)
            {
                std.mman.copy<IrVarDebugInfo>(nd, self.varDbg, self.nvarDbg);
                std.mman.dealloc<IrVarDebugInfo>(self.varDbg);
            }
            self.varDbg = nd;
            self.capVarDbg = nc;
        }
        u32 nl = 0; while (name[nl]) nl++;
        char* nc = std.mman.alloc<char>(nl + 1);
        for (u32 i = 0; i < nl; i++) nc[i] = name[i];
        nc[nl] = 0;
        self.varDbg[self.nvarDbg++] = (IrVarDebugInfo){ nc, ty, line, col, argIdx };
    }

    void erase()
    {
        // Remove from parent block
        if (self.parent)
        {
            for (u32 i = 0; i < self.parent.ninsts; i++)
            {
                if (self.parent.insts[i] == self)
                {
                    for (u32 j = i; j < self.parent.ninsts - 1; j++)
                        self.parent.insts[j] = self.parent.insts[j + 1];
                    self.parent.ninsts--;
                    break;
                }
            }
        }

        // Remove from use lists
        for (u32 i = 0; i < self.nops; i++)
        {
            if (self.ops[i])
                self.ops[i].removeUser(self);
        }

        // Free operands
        if (self.capOps > 0)
            std.mman.dealloc<IrValue*>(self.ops);

        // Free users
        if (self.base.capUsers > 0)
            std.mman.dealloc<IrInst*>(self.base.users);

        // Free debug info
        if (self.debugLoc.file)
            std.mman.dealloc<char>(self.debugLoc.file);
        if (self.varDbg)
        {
            for (u32 i = 0; i < self.nvarDbg; i++)
                if (self.varDbg[i].varName)
                    std.mman.dealloc<char>(self.varDbg[i].varName);
            std.mman.dealloc<IrVarDebugInfo>(self.varDbg);
        }

        std.mman.dealloc<IrInst>(self);
    }

    IrOpcode instOpcode() { return self->opcode; }
    u32 numOps() { return self->nops; }
    IrValue* operand(u32 i) { if (i < self.nops) return self.ops[i]; return null; }
}

pub struct IrBlock
{
    IrValue base;
    IrFunc* parent;
    IrInst** insts;
    u32 ninsts;
    u32 capInsts;
    IrBlock** preds;
    u32 npreds;
    u32 capPreds;
    IrBlock** succs;
    u32 nsuccs;
    u32 capSuccs;

    void addInst(IrInst* inst)
    {
        if (self.ninsts >= self.capInsts)
        {
            u32 newCap = self.capInsts ? self.capInsts * 2 : 8;
            IrInst** newInsts = std.mman.alloc<IrInst*>(newCap);
            if (self.insts)
            {
                std.mman.copy<IrInst*>(newInsts, self.insts, self.ninsts);
                std.mman.dealloc<IrInst*>(self.insts);
            }
            self.insts = newInsts;
            self.capInsts = newCap;
        }
        inst.parent = self;
        self.insts[self.ninsts++] = inst;
    }

    // Insert an instruction directly before an anchor instruction in this
    // block, keeping SSA dominance intact. If the anchor is not found, the
    // instruction is appended (matching addInst).
    void insertBefore(IrInst* inst, IrInst* anchor)
    {
        if (self.ninsts >= self.capInsts)
        {
            u32 newCap = self.capInsts ? self.capInsts * 2 : 8;
            IrInst** newInsts = std.mman.alloc<IrInst*>(newCap);
            if (self.insts)
            {
                std.mman.copy<IrInst*>(newInsts, self.insts, self.ninsts);
                std.mman.dealloc<IrInst*>(self.insts);
            }
            self.insts = newInsts;
            self.capInsts = newCap;
        }
        u32 idx = self.ninsts;
        for (u32 i = 0; i < self.ninsts; i++)
            if (self.insts[i] == anchor) { idx = i; break; }
        for (u32 j = self.ninsts; j > idx; j--)
            self.insts[j] = self.insts[j - 1];
        inst.parent = self;
        self.insts[idx] = inst;
        self.ninsts++;
    }

    void addPred(IrBlock* pred)
    {
        if (self.npreds >= self.capPreds)
        {
            u32 newCap = self.capPreds ? self.capPreds * 2 : 4;
            IrBlock** newPreds = std.mman.alloc<IrBlock*>(newCap);
            if (self.preds)
            {
                std.mman.copy<IrBlock*>(newPreds, self.preds, self.npreds);
                std.mman.dealloc<IrBlock*>(self.preds);
            }
            self.preds = newPreds;
            self.capPreds = newCap;
        }
        self.preds[self.npreds++] = pred;
    }

    void addSucc(IrBlock* succ)
    {
        if (self.nsuccs >= self.capSuccs)
        {
            u32 newCap = self.capSuccs ? self.capSuccs * 2 : 4;
            IrBlock** newSuccs = std.mman.alloc<IrBlock*>(newCap);
            if (self.succs)
            {
                std.mman.copy<IrBlock*>(newSuccs, self.succs, self.nsuccs);
                std.mman.dealloc<IrBlock*>(self.succs);
            }
            self.succs = newSuccs;
            self.capSuccs = newCap;
        }
        self.succs[self.nsuccs++] = succ;
        succ.addPred(self);
    }

    void removePred(IrBlock* pred)
    {
        for (u32 i = 0; i < self.npreds; i++)
            if (self.preds[i] == pred) { self.preds[i] = self.preds[--self.npreds]; return; }
    }

    void removeSucc(IrBlock* succ)
    {
        for (u32 i = 0; i < self.nsuccs; i++)
            if (self.succs[i] == succ) { self.succs[i] = self.succs[--self.nsuccs]; return; }
    }

    bool hasPred(IrBlock* pred)
    {
        for (u32 i = 0; i < self.npreds; i++)
            if (self.preds[i] == pred) return true;
        return false;
    }

    IrInst* terminator()
    {
        for (u32 i = 0; i < self.ninsts; i++)
        {
            IrOpcode op = self.insts[i].opcode;
            if (op == IrOpcode::Br || op == IrOpcode::CondBr || op == IrOpcode::Ret ||
                op == IrOpcode::Unreachable || op == IrOpcode::Noret)
                return self.insts[i];
        }
        return null;
    }
}

pub struct IrFunc
{
    IrValue base;
    IrModule* parent;
    IrBlock** blocks;
    u32 nblocks;
    u32 capBlocks;
    IrType* retType;
    IrType** paramTypes;
    u32 nparams;
    bool isExtern;
    char* externLib;
    char* externSym;

    void addBlock(IrBlock* bb)
    {
        if (self.nblocks >= self.capBlocks)
        {
            u32 newCap = self.capBlocks ? self.capBlocks * 2 : 4;
            IrBlock** newBlocks = std.mman.alloc<IrBlock*>(newCap);
            if (self.blocks)
            {
                std.mman.copy<IrBlock*>(newBlocks, self.blocks, self.nblocks);
                std.mman.dealloc<IrBlock*>(self.blocks);
            }
            self.blocks = newBlocks;
            self.capBlocks = newCap;
        }
        bb.parent = self;
        self.blocks[self.nblocks++] = bb;
    }

    void removeBlock(IrBlock* bb)
    {
        for (u32 i = 0; i < self.nblocks; i++)
        {
            if (self.blocks[i] == bb)
            {
                for (u32 j = i; j < self.nblocks - 1; j++)
                    self.blocks[j] = self.blocks[j + 1];
                self.nblocks--;
                return;
            }
        }
    }
}

pub struct IrGlobal
{
    IrValue base;
    IrModule* parent;
    bool isConst;
    bool isExtern;
    IrValue* initVal;
    u32 alignment;
}

pub struct IrStringConst
{
    IrValue base;
    char* str;
    u32 length;
}

pub struct IrStructType
{
    IrType* irType;
    char* name;
    IrType** fieldTypes;
    char** fieldNames;
    u32 nfields;
    u32 capFields;
    u32 size;
    u32* offsets;
}

pub struct IrModule
{
    IrContext* ctx;
    char* name;
    IrFunc** funcs;
    u32 nfuncs;
    u32 capFuncs;
    IrGlobal** globals;
    u32 nglobals;
    u32 capGlobals;
    IrStringConst** constStrings;
    u32 nconstStrings;
    u32 capConstStrings;
    IrStructType** structs;
    u32 nstructs;
    u32 capStructs;

    void addFunc(IrFunc* f)
    {
        if (self.nfuncs >= self.capFuncs)
        {
            u32 newCap = self.capFuncs ? self.capFuncs * 2 : 4;
            IrFunc** newFuncs = std.mman.alloc<IrFunc*>(newCap);
            if (self.funcs)
            {
                std.mman.copy<IrFunc*>(newFuncs, self.funcs, self.nfuncs);
                std.mman.dealloc<IrFunc*>(self.funcs);
            }
            self.funcs = newFuncs;
            self.capFuncs = newCap;
        }
        f.parent = self;
        self.funcs[self.nfuncs++] = f;
    }

    IrFunc* getFunc(const char* name)
    {
        for (u32 i = 0; i < self.nfuncs; i++)
        {
            bool match = true;
            const char* a = self.funcs[i].base.name;
            const char* b = name;
            while (*a && *b) { if (*a++ != *b++) { match = false; break; } }
            if (match && *a == *b) return self.funcs[i];
        }
        return null;
    }

    void addGlobal(IrGlobal* g)
    {
        if (self.nglobals >= self.capGlobals)
        {
            u32 nc = self.capGlobals ? self.capGlobals * 2 : 4;
            IrGlobal** ng = std.mman.alloc<IrGlobal*>(nc);
            if (self.globals)
            {
                std.mman.copy<IrGlobal*>(ng, self.globals, self.nglobals);
                std.mman.dealloc<IrGlobal*>(self.globals);
            }
            self.globals = ng;
            self.capGlobals = nc;
        }
        g.parent = self;
        self.globals[self.nglobals++] = g;
    }

    void addConstString(IrStringConst* sc)
    {
        if (self.nconstStrings >= self.capConstStrings)
        {
            u32 nc = self.capConstStrings ? self.capConstStrings * 2 : 4;
            IrStringConst** ns = std.mman.alloc<IrStringConst*>(nc);
            if (self.constStrings)
            {
                std.mman.copy<IrStringConst*>(ns, self.constStrings, self.nconstStrings);
                std.mman.dealloc<IrStringConst*>(self.constStrings);
            }
            self.constStrings = ns;
            self.capConstStrings = nc;
        }
        self.constStrings[self.nconstStrings++] = sc;
    }

    void addStruct(IrStructType* st)
    {
        if (self.nstructs >= self.capStructs)
        {
            u32 nc = self.capStructs ? self.capStructs * 2 : 4;
            IrStructType** ns = std.mman.alloc<IrStructType*>(nc);
            if (self.structs)
            {
                std.mman.copy<IrStructType*>(ns, self.structs, self.nstructs);
                std.mman.dealloc<IrStructType*>(self.structs);
            }
            self.structs = ns;
            self.capStructs = nc;
        }
        self.structs[self.nstructs++] = st;
    }
}

pub struct IrContext
{
    IrType** types;
    u32 ntypes;
    u32 capTypes;
    u32 nextId;
    IrValue** constInts;
    u32 nconstInts;
    u32 capConstInts;
    IrValue** constFloats;
    u32 nconstFloats;
    u32 capConstFloats;

    //   Methods on IrContext

    u32 nextValueId()
    {
        return self.nextId++;
    }

    IrType* tyVoid()
    {
        return self.tyGetOrCreate(IrTypeKind::Void, 0, null, 0, null, null, 0, false);
    }

    IrType* tyInt(u32 bits)
    {
        return self.tyGetOrCreate(IrTypeKind::Int, bits, null, 0, null, null, 0, false);
    }

    IrType* tyFloat()
    {
        return self.tyGetOrCreate(IrTypeKind::Float, 32, null, 0, null, null, 0, false);
    }

    IrType* tyDouble()
    {
        return self.tyGetOrCreate(IrTypeKind::Float, 64, null, 0, null, null, 0, false);
    }

    IrType* tyPtr(IrType* elem)
    {
        return self.tyGetOrCreate(IrTypeKind::Ptr, 64, elem, 0, null, null, 0, false);
    }

    IrType* tyArray(IrType* elem, u32 count)
    {
        return self.tyGetOrCreate(IrTypeKind::Array, 0, elem, count, null, null, 0, false);
    }

    IrType* tyFunc(IrType* ret, IrType** params, u32 nparams, bool isVararg)
    {
        return self.tyGetOrCreate(IrTypeKind::Func, 0, null, 0, ret, params, nparams, isVararg);
    }

    IrType* tyVector(IrType* elem, u32 count)
    {
        return self.tyGetOrCreate(IrTypeKind::Vector, 0, elem, count, null, null, 0, false);
    }

    IrGlobal* createGlobal(const char* name, IrType* ty, bool isConst, bool isExtern, IrValue* init, u32 alignment)
    {
        IrGlobal* g = std.mman.alloc<IrGlobal>(1);
        u32 nl = 0; if (name) { while (name[nl]) nl++; }
        char* nc = std.mman.alloc<char>(nl + 1);
        for (u32 i = 0; i < nl; i++) nc[i] = name[i];
        nc[nl] = 0;
        *g = (IrGlobal){
            { IrValueKind::Func, ty, self.nextValueId(), 0, nc, null, 0, 0 },
            null, isConst, isExtern, init, alignment
        };
        return g;
    }

    IrStringConst* createStringConst(const char* str, u32 length)
    {
        IrStringConst* sc = std.mman.alloc<IrStringConst>(1);
        IrType* charTy = self.tyInt(8);
        IrType* arrTy = self.tyArray(charTy, length + 1);
        char* copy = std.mman.alloc<char>(length + 1);
        for (u32 i = 0; i < length; i++) copy[i] = str[i];
        copy[length] = 0;
        *sc = (IrStringConst){
            { IrValueKind::ConstInt, arrTy, self.nextValueId(), 0, null, null, 0, 0 },
            copy, length
        };
        // We don't store in ctx — module owns them
        return sc;
    }

    // Alignment in bytes of a type. Scalars round their width up to a byte,
    // pointers use the backend's 8-byte addressing unit, and aggregates take
    // the alignment of their element type.
    u32 irTypeAlignOf(IrType* t)
    {
        if (!t) return 1;
        switch (t->kind)
        {
        case IrTypeKind::Int:
        case IrTypeKind::Float:
        {
            u32 a = (t->width + 7) / 8;
            if (a == 0) a = 1;
            return a;
        }
        case IrTypeKind::Ptr:
        case IrTypeKind::Func:
            return 8;
        case IrTypeKind::Array:
        case IrTypeKind::Vector:
            return irTypeAlignOf(t->elem);
        default:
            return 1;
        }
    }

    // Size in bytes of a type, rounded up for scalars and multiplied out for
    // arrays and vectors.
    u32 irTypeSizeOf(IrType* t)
    {
        if (!t) return 0;
        switch (t->kind)
        {
        case IrTypeKind::Int:
        case IrTypeKind::Float:
        {
            u32 s = (t->width + 7) / 8;
            if (s == 0) s = 1;
            return s;
        }
        case IrTypeKind::Ptr:
        case IrTypeKind::Func:
            return 8;
        case IrTypeKind::Array:
        case IrTypeKind::Vector:
            return irTypeSizeOf(t->elem) * (t->count > 0 ? t->count : 1);
        default:
            return 0;
        }
    }

    static u32 alignUpTo(u32 v, u32 a)
    {
        if (a <= 1) return v;
        return (v + a - 1) / a * a;
    }

    IrStructType* createStructType(const char* name, IrType** fields, char** fieldNames, u32 nfields)
    {
        IrStructType* st = std.mman.alloc<IrStructType>(1);
        u32 nl = 0; if (name) { while (name[nl]) nl++; }
        char* nc = std.mman.alloc<char>(nl + 1);
        for (u32 i = 0; i < nl; i++) nc[i] = name[i];
        nc[nl] = 0;

        // Alignment-aware layout, every field starts at its natural
        // alignment, and the struct size is padded to the maximum field
        // alignment so an array of structs keeps every element aligned.
        u32* offs = std.mman.alloc<u32>(nfields > 0 ? nfields : 1);
        u32 off = 0;
        u32 maxAlign = 1;
        for (u32 i = 0; i < nfields; i++)
        {
            u32 al = irTypeAlignOf(fields[i]);
            off = alignUpTo(off, al);
            offs[i] = off;
            off += irTypeSizeOf(fields[i]);
            if (al > maxAlign) maxAlign = al;
        }
        u32 sz = alignUpTo(off, maxAlign);

        *st = (IrStructType){ null, nc, fields, fieldNames, nfields, nfields, sz, offs };
        return st;
    }

    IrType* tyGetOrCreate(IrTypeKind kind, u32 width, IrType* elem, u32 count,
        IrType* ret, IrType** params, u32 nparams, bool isVararg)
    {
        for (u32 i = 0; i < self.ntypes; i++)
        {
            IrType* t = self.types[i];
            if (t->kind != kind || t->width != width) continue;
            if (t->count != count || t->nparams != nparams || t->isVararg != isVararg) continue;
            if (kind == IrTypeKind::Ptr || kind == IrTypeKind::Array || kind == IrTypeKind::Vector)
                { if (t->count == count && irTypeEqual(t->elem, elem)) return t; }
            else if (kind == IrTypeKind::Func)
            {
                if (!irTypeEqual(t->ret, ret)) continue;
                bool match = true;
                for (u32 j = 0; j < nparams; j++)
                    if (!irTypeEqual(t->params[j], params[j])) { match = false; break; }
                if (match) return t;
            }
            else return t;
        }

        IrType* t = std.mman.alloc<IrType>(1);
        *t = (IrType){ kind, width, elem, count, ret, params, nparams, isVararg };

        u32 idx = self.ntypes;
        if (idx >= self.capTypes)
        {
            u32 newCap = self.capTypes ? self.capTypes * 2 : 16;
            IrType** newTypes = std.mman.alloc<IrType*>(newCap);
            if (self.types) { std.mman.copy<IrType*>(newTypes, self.types, self.ntypes); std.mman.dealloc<IrType*>(self.types); }
            self.types = newTypes; self.capTypes = newCap;
        }
        self.types[idx] = t;
        self.ntypes = idx + 1;
        return t;
    }

    IrValue* constInt(IrType* ty, u64 val)
    {
        for (u32 i = 0; i < self.nconstInts; i++)
            if (self.constInts[i]->type == ty && self.constInts[i]->valData == val)
                return self.constInts[i];

        IrValue* v = std.mman.alloc<IrValue>(1);
        *v = (IrValue){ IrValueKind::ConstInt, ty, self.nextValueId(), val, null, null, 0, 0 };
        u32 idx = self.nconstInts;
        if (idx >= self.capConstInts)
        {
            u32 newCap = self.capConstInts ? self.capConstInts * 2 : 16;
            IrValue** newC = std.mman.alloc<IrValue*>(newCap);
            if (self.constInts) { std.mman.copy<IrValue*>(newC, self.constInts, self.nconstInts); std.mman.dealloc<IrValue*>(self.constInts); }
            self.constInts = newC; self.capConstInts = newCap;
        }
        self.constInts[idx] = v;
        self.nconstInts = idx + 1;
        return v;
    }

    IrValue* constFloat(IrType* ty, f64 val)
    {
        u64 raw;
        std.mman.copy<u8>((u8*)&raw, (u8*)&val, 8);
        // Coral has no f32 scalar type, so consts always carry the f64 bit
        // pattern; width-32 float types are only a codegen-level hint.
        for (u32 i = 0; i < self.nconstFloats; i++)
            if (self.constFloats[i]->valData == raw) return self.constFloats[i];

        IrValue* v = std.mman.alloc<IrValue>(1);
        *v = (IrValue){ IrValueKind::ConstFloat, ty, self.nextValueId(), raw, null, null, 0, 0 };
        u32 idx = self.nconstFloats;
        if (idx >= self.capConstFloats)
        {
            u32 newCap = self.capConstFloats ? self.capConstFloats * 2 : 8;
            IrValue** newC = std.mman.alloc<IrValue*>(newCap);
            if (self.constFloats) { std.mman.copy<IrValue*>(newC, self.constFloats, self.nconstFloats); std.mman.dealloc<IrValue*>(self.constFloats); }
            self.constFloats = newC; self.capConstFloats = newCap;
        }
        self.constFloats[idx] = v;
        self.nconstFloats = idx + 1;
        return v;
    }

    IrInst* createInst(IrOpcode op, IrType* ty, IrValue** ops, u32 nops, u64 icmpP, u64 fcmpP)
    {
        IrInst* inst = std.mman.alloc<IrInst>(1);
        IrValue** opsCopy = std.mman.alloc<IrValue*>(nops > 0 ? nops : 1);
        for (u32 i = 0; i < nops; i++) opsCopy[i] = ops ? ops[i] : null;

        *inst = (IrInst){
            { IrValueKind::Inst, ty, self.nextValueId(), 0, null, null, 0, 0 },
            op, null, null, null, opsCopy, nops, nops,
            0, 0, { null, 0, 0 }, null, 0, 0
        };
        if (op == IrOpcode::ICmp) inst.icmpPred = (IrICmpPred)icmpP;
        if (op == IrOpcode::FCmp) inst.fcmpPred = (IrFCmpPred)fcmpP;
        return inst;
    }

    IrBlock* createBlock(const char* name)
    {
        IrBlock* bb = std.mman.alloc<IrBlock>(1);
        u32 nameLen = 0;
        if (name) { while (name[nameLen]) nameLen++; }
        char* nameCopy = std.mman.alloc<char>(nameLen + 1);
        for (u32 i = 0; i < nameLen; i++) nameCopy[i] = name[i];
        nameCopy[nameLen] = 0;

        *bb = (IrBlock){
            { IrValueKind::Block, null, self.nextValueId(), 0, nameCopy, null, 0, 0 },
            null, null, 0, 0, null, 0, 0, null, 0, 0
        };
        return bb;
    }

    IrFunc* createFunc(const char* name, IrType* ret, IrType** params, u32 nparams)
    {
        IrFunc* f = std.mman.alloc<IrFunc>(1);
        u32 nameLen = 0;
        if (name) { while (name[nameLen]) nameLen++; }
        char* nameCopy = std.mman.alloc<char>(nameLen + 1);
        for (u32 i = 0; i < nameLen; i++) nameCopy[i] = name[i];
        nameCopy[nameLen] = 0;

        *f = (IrFunc){
            { IrValueKind::Func, self.tyFunc(ret, params, nparams, false), self.nextValueId(), 0, nameCopy, null, 0, 0 },
            null, null, 0, 0, ret, params, nparams,
            false, null, null
        };
        return f;
    }

    IrModule* createModule(const char* name)
    {
        IrModule* m = std.mman.alloc<IrModule>(1);
        u32 nameLen = 0;
        if (name) { while (name[nameLen]) nameLen++; }
        char* nameCopy = std.mman.alloc<char>(nameLen + 1);
        for (u32 i = 0; i < nameLen; i++) nameCopy[i] = name[i];
        nameCopy[nameLen] = 0;

        *m = (IrModule){ self, nameCopy, null, 0, 0 };
        return m;
    }
}

//   Free functions (non-method, standalone)

pub IrContext* irCtxCreate()
{
    IrContext* ctx = std.mman.alloc<IrContext>(1);
    *ctx = (IrContext){ null, 0, 0, 1, null, 0, 0, null, 0, 0 };
    return ctx;
}

pub void irCtxDestroy(IrContext* ctx)
{
    if (!ctx) return;
    if (ctx->constInts) std.mman.dealloc<IrValue*>(ctx->constInts);
    if (ctx->constFloats) std.mman.dealloc<IrValue*>(ctx->constFloats);
    if (ctx->types) std.mman.dealloc<IrType*>(ctx->types);
    std.mman.dealloc<IrContext>(ctx);
}

pub void irGlobalDestroy(IrGlobal* g)
{
    if (!g) return;
    if (g->base.name) std.mman.dealloc<char>(g->base.name);
    std.mman.dealloc<IrGlobal>(g);
}

pub void irStringConstDestroy(IrStringConst* sc)
{
    if (!sc) return;
    if (sc->str) std.mman.dealloc<char>(sc->str);
    std.mman.dealloc<IrStringConst>(sc);
}

pub void irStructTypeDestroy(IrStructType* st)
{
    if (!st) return;
    if (st->name) std.mman.dealloc<char>(st->name);
    if (st->offsets) std.mman.dealloc<u32>(st->offsets);
    std.mman.dealloc<IrStructType>(st);
}

static bool irTypeEqual(IrType* a, IrType* b)
{
    if (!a || !b) return false;
    if (a->kind != b->kind) return false;
    switch (a->kind)
    {
    case IrTypeKind::Void: return true;
    case IrTypeKind::Int: case IrTypeKind::Float: return a->width == b->width;
    case IrTypeKind::Ptr: return irTypeEqual(a->elem, b->elem);
    case IrTypeKind::Array: return a->count == b->count && irTypeEqual(a->elem, b->elem);
    case IrTypeKind::Vector: return a->count == b->count && irTypeEqual(a->elem, b->elem);
    case IrTypeKind::Func:
        if (!irTypeEqual(a->ret, b->ret) || a->isVararg != b->isVararg || a->nparams != b->nparams) return false;
        for (u32 i = 0; i < a->nparams; i++)
            if (!irTypeEqual(a->params[i], b->params[i])) return false;
        return true;
    }
    return false;
}

pub const char* irTypeStr(IrType* t)
{
    if (!t) return "void";
    switch (t->kind)
    {
    case IrTypeKind::Void: return "void";
    case IrTypeKind::Int:
        if (t->width == 1) return "i1";
        if (t->width == 8) return "i8";
        if (t->width == 16) return "i16";
        if (t->width == 32) return "i32";
        if (t->width == 64) return "i64";
        return "iN";
    case IrTypeKind::Float: return t->width == 64 ? "f64" : "float";
    case IrTypeKind::Ptr: return "ptr";
    case IrTypeKind::Array: return "array";
    case IrTypeKind::Vector: return "vector";
    case IrTypeKind::Func: return "func";
    }
    return "unknown";
}
