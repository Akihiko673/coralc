mod std = import(lib, "std");

pub const char* KNOWN_ARCHS[] = {
    "x86_64", "x86", "x86_32",
    "arm64", "arm",
    "riscv64",
    "ppc64", "ppc",
    "mips64", "mips",
    "sparcv9",
    "wasm32", "wasm64",
    null
};

static bool archMatch(const char* arch, const char* known)
{
    if (!arch || !known) return false;
    u32 i = 0;
    while (arch[i] && known[i])
    {
        char a = arch[i];
        char k = known[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
        i++;
    }
    return arch[i] == 0 && known[i] == 0;
}

pub bool hasNoretSupport(const char* arch)
{
    if (!arch) return false;
    for (u32 i = 0; KNOWN_ARCHS[i]; i++)
        if (archMatch(arch, KNOWN_ARCHS[i])) return true;
    return false;
}

pub bool isNoret(IrInst* inst)
{
    if (!inst) return false;
    return inst->opcode == wallvm.irOps.IrOpcode::Noret;
}

struct ArchCcEntry { const char* name; wallvm.asm_rules.CallingConvention cc; } // i'm still having import issues,
                                                                         // so std isn't used, and map isn't even in the std yet

static ArchCcEntry ARCH_CC_MAP[] = {
    { "x86_64", wallvm.asm_rules.CallingConvention::SystemV },
    { "x86_32", wallvm.asm_rules.CallingConvention::Cdecl },
    { "x86", wallvm.asm_rules.CallingConvention::Cdecl },
    { "arm64", wallvm.asm_rules.CallingConvention::Aapcs64 },
    { "arm", wallvm.asm_rules.CallingConvention::Aapcs },
    { "riscv64", wallvm.asm_rules.CallingConvention::Riscv64 },
    { "ppc64", wallvm.asm_rules.CallingConvention::Ppc64 },
    { "ppc", wallvm.asm_rules.CallingConvention::Ppc },
    { "mips64", wallvm.asm_rules.CallingConvention::Mips64 },
    { "mips", wallvm.asm_rules.CallingConvention::Mips },
    { "sparcv9", wallvm.asm_rules.CallingConvention::SparcV9 },
    { "wasm32", wallvm.asm_rules.CallingConvention::Wasm32 },
    { "wasm64", wallvm.asm_rules.CallingConvention::Wasm64 },
    { null, wallvm.asm_rules.CallingConvention::SystemV }
};

static wallvm.asm_rules.CallingConvention archToCallingConvention(const char* arch)
{
    if (!arch) return wallvm.asm_rules.CallingConvention::SystemV;
    for (u32 i = 0; ARCH_CC_MAP[i].name; i++)
        if (archMatch(arch, ARCH_CC_MAP[i].name))
            return ARCH_CC_MAP[i].cc;
    return wallvm.asm_rules.CallingConvention::SystemV;
}

static wallvm.asm_rules.ABIRules abiForArch(const char* arch)
{
    wallvm.asm_rules.CallingConvention cc = archToCallingConvention(arch);
    switch (cc)
    {
    case wallvm.asm_rules.CallingConvention::SystemV:
        return wallvm.asm_rules.sysvAbi();
    case wallvm.asm_rules.CallingConvention::Win64:
        return wallvm.asm_rules.win64Abi();
    case wallvm.asm_rules.CallingConvention::Aapcs64:
        return wallvm.asm_rules.aapcs64Abi();
    case wallvm.asm_rules.CallingConvention::Aapcs64MacOs:
        return wallvm.asm_rules.aapcs64MacOsAbi();
    case wallvm.asm_rules.CallingConvention::Aapcs:
        return wallvm.asm_rules.aapcsAbi();
    case wallvm.asm_rules.CallingConvention::Cdecl:
        return wallvm.asm_rules.cdeclAbi();
    case wallvm.asm_rules.CallingConvention::Riscv64:
        return wallvm.asm_rules.riscv64Abi();
    case wallvm.asm_rules.CallingConvention::Ppc64:
        return wallvm.asm_rules.ppc64Abi(); // thinking about it, sounds like 'pipis'
    case wallvm.asm_rules.CallingConvention::Ppc:
        return wallvm.asm_rules.ppcAbi();
    case wallvm.asm_rules.CallingConvention::Mips64:
        return wallvm.asm_rules.mips64Abi();
    case wallvm.asm_rules.CallingConvention::Mips:
        return wallvm.asm_rules.mipsAbi();
    case wallvm.asm_rules.CallingConvention::SparcV9:
        return wallvm.asm_rules.sparcV9Abi();
    case wallvm.asm_rules.CallingConvention::WinX86_32:
        return wallvm.asm_rules.winX86_32Abi();
    case wallvm.asm_rules.CallingConvention::SyscallX86_64:
        return wallvm.asm_rules.x86_64SyscallAbi();
    case wallvm.asm_rules.CallingConvention::SyscallX86:
        return wallvm.asm_rules.x86SyscallAbi();
    case wallvm.asm_rules.CallingConvention::SyscallArm64:
        return wallvm.asm_rules.arm64SyscallAbi();
    case wallvm.asm_rules.CallingConvention::SyscallArm:
        return wallvm.asm_rules.armSyscallAbi();
    case wallvm.asm_rules.CallingConvention::SyscallRiscv64:
        return wallvm.asm_rules.riscv64SyscallAbi();
    case wallvm.asm_rules.CallingConvention::Wasm32:
        return wallvm.asm_rules.wasm32Abi();
    case wallvm.asm_rules.CallingConvention::Wasm64:
        return wallvm.asm_rules.wasm64Abi();
    default: return wallvm.asm_rules.sysvAbi();
    }
}

// Emit(ejaculate) noreturn sequence for a given architecture
// Returns a dynamically allocated string. Caller(slave master) must free with std.mman.dealloc.
pub const char* emitNoret(const char* arch, i32 exitCode)
{
    wallvm.asm_rules.ABIRules abi = abiForArch(arch);
    const char* tmpl = wallvm.asm_rules.noretTemplate(&abi);

    u32 len = 0;
    for (u32 i = 0; tmpl[i]; i++)
    {
        if (tmpl[i] == '$' && tmpl[i+1] == 'e' && tmpl[i+2] == 'x' && tmpl[i+3] == 'i' &&
            tmpl[i+4] == 't' && tmpl[i+5] == '_' && tmpl[i+6] == 'c' && tmpl[i+7] == 'o' &&
            tmpl[i+8] == 'd' && tmpl[i+9] == 'e')
        {
            u32 code = (u32)(exitCode >= 0 ? exitCode : -exitCode);
            len++; // at least one digit // this part been giving me issues. FAAAAAAAAAAAAH!!!
            while (code >= 10) { code /= 10; len++; }
            if (exitCode < 0) len++;
            i += 9;
        }
        else if (tmpl[i] == '\\' && tmpl[i+1] == 'n')
        {
            len++;
            i++;
        }
        else {
            len++;
        }
    }

    char* result = std.mman.alloc<char>(len + 1);
    u32 pos = 0;
    for (u32 i = 0; tmpl[i]; i++)
    {
        if (tmpl[i] == '$' && tmpl[i+1] == 'e' && tmpl[i+2] == 'x' && tmpl[i+3] == 'i' &&
            tmpl[i+4] == 't' && tmpl[i+5] == '_' && tmpl[i+6] == 'c' && tmpl[i+7] == 'o' &&
            tmpl[i+8] == 'd' && tmpl[i+9] == 'e')
        {
            i += 9;
            i32 code = exitCode;
            if (code < 0) { result[pos++] = '-'; code = -code; }
            u32 c = (u32)code;
            u32 digits[16];
            u32 nd = 0;
            if (c == 0) digits[nd++] = 0;
            else while (c) { digits[nd++] = c % 10; c /= 10; }
            for (i32 d = (i32)nd - 1; d >= 0; d--)
                result[pos++] = (char)('0' + digits[d]);
        }
        else if (tmpl[i] == '\\' && tmpl[i+1] == 'n')
        {
            result[pos++] = '\n';
            i++;
        }
        else {
            result[pos++] = tmpl[i];
        }
    }
    result[pos] = 0;
    return result;
}