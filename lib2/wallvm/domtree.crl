@[[no_warn_unsafe]]
@[[no_drop]]
@[[forced_pointer]]
@[[forced_unsafe_cast]]
@[[forced_null_deref]]

mod mman = import("std/memory/mman.crl");
mod ir_types = import("wallvm/ir_types.crl");

pub struct IrDomTree
{
    ir_types.IrBlock** blocks;
    u32 nblocks;
    ir_types.IrBlock** idoms;
}

// Helper: EVAL operation from Lengauer-Tarjan with path compression.
// Returns the ancestor of v (or v itself) with the minimal semi-dominator.
// The chain is walked up first, then compressed top-down so each label
// comparison uses ancestors whose labels are already final.
u32 _domEval(u32 v, u32 n, u32* ancestor, u32* label, u32* semi, u32* dfn, u32* work)
{
    if (ancestor[v] >= n) return v;
    u32 top = 0;
    u32 x = v;
    while (ancestor[x] < n)
    {
        work[top++] = x;
        x = ancestor[x];
    }
    while (top > 0)
    {
        u32 w = work[--top];
        if (dfn[semi[label[ancestor[w]]]] < dfn[semi[label[w]]])
            label[w] = label[ancestor[w]];
    }
    return label[v];
}

// Lengauer-Tarjan algorithm for computing immediate dominators.
// O(N * alpha(N)) two-pass algorithm.
//
// Phase 1: DFS numbering, build parent/child relationship in DFS tree.
// Phase 2: Process vertices in reverse DFS order.
//   - Compute semi-dominator (semi) from predecessors.
//   - Use union-find (ancestor/label) to answer EVAL queries.
//   - Link vertex into forest, process bucket of its parent.
// Phase 3: Final pass to set immediate dominators.

pub IrDomTree* irDomtreeNew(ir_types.IrFunc* func)
{
    if (!func || func.nblocks == 0) return null;

    u32 n = func.nblocks;

    IrDomTree* dt = mman.alloc<IrDomTree>(1);
    dt->blocks = mman.alloc<ir_types.IrBlock*>(n);
    dt->idoms = mman.alloc<ir_types.IrBlock*>(n);
    dt->nblocks = n;

    // Copy block pointers
    for (u32 i = 0; i < n; i++)
        dt->blocks[i] = func.blocks[i];

    // Arrays indexed by block index
    u32* parent = mman.alloc<u32>(n); // DFS parent
    u32* dfn = mman.alloc<u32>(n); // DFS number (block->index)
    u32* vertex = mman.alloc<u32>(n); // index->block (reverse mapping)
    u32* semi = mman.alloc<u32>(n); // semi-dominator (store block index)
    u32* idom = mman.alloc<u32>(n); // immediate dominator (block index)
    u32* ancestor = mman.alloc<u32>(n); // union-find parent
    u32* label = mman.alloc<u32>(n); // label for EVAL
    u32* bucket = mman.alloc<u32>(n); // bucket head (singly linked list)
    u32* next = mman.alloc<u32>(n); // bucket next pointer

    for (u32 i = 0; i < n; i++)
    {
        parent[i] = n;
        dfn[i] = n;
        vertex[i] = n;
        semi[i] = i;
        idom[i] = n;
        ancestor[i] = n;
        label[i] = i;
        bucket[i] = n;
        next[i] = n;
    }

    // Build block index maps — dt->blocks[i] == func.blocks[i] by construction
    u32* blockIdx = mman.alloc<u32>(n);
    for (u32 i = 0; i < n; i++)
        blockIdx[i] = i;

    // Reverse map, ir_types.IrBlock* → index in func.blocks
    // Store block pointer → index into func.blocks by scanning once
    u32* revIdx = mman.alloc<u32>(n);
    for (u32 i = 0; i < n; i++) revIdx[i] = n;

    // Iterative DFS from entry (assumes entry is func.blocks[0])
    u32* stack = mman.alloc<u32>(n);
    u32* state = mman.alloc<u32>(n); // 0=unvisited, 1=in-stack, 2=processed
    for (u32 i = 0; i < n; i++) state[i] = 0;

    u32 time = 0;
    u32 sp = 0;
    stack[sp++] = 0;
    state[0] = 1;

    while (sp > 0)
    {
        u32 cur = stack[sp - 1];

        if (state[cur] == 1)
        {
            // First visit, assign DFS number
            state[cur] = 2;
            dfn[cur] = time;
            vertex[time] = cur;
            // Record reverse index for this block
            revIdx[cur] = cur;
            time++;

            ir_types.IrBlock* curBlock = func.blocks[cur];
            for (u32 j = 0; j < curBlock.nsuccs; j++)
            {
                ir_types.IrBlock* succBlock = curBlock.succs[j];
                u32 succ = n;
                // Find succ index in func.blocks
                for (u32 k = 0; k < n; k++)
                    if (func.blocks[k] == succBlock) { succ = k; break; }

                if (succ < n && state[succ] == 0)
                {
                    parent[succ] = cur;
                    state[succ] = 1;
                    stack[sp++] = succ;
                }
            }
        }
        else
        {
            sp--;
        }
    }

    // Helper, compress the ancestor chain (union-find path compression)
    // and return the vertex with the minimal semi-dominator on the path to root.
    // This is the EVAL operation from the paper.
    //
    // The compress function updates labels as it walks up the ancestor chain.
    // label[v] = v if ancestor[v] == n
    // label[v] = vertex with minimal semi[label] else

    // Iterate vertices in reverse DFS order
    for (u32 wIdx = time - 1; wIdx > 0; wIdx--)
    {
        u32 w = vertex[wIdx]; // block index

        // Step 1: Compute semi-dominator of w
        ir_types.IrBlock* wBlock = func.blocks[blockIdx[w]];
        semi[w] = parent[w]; // default semi = parent in DFS tree

        for (u32 j = 0; j < wBlock.npreds; j++)
        {
            ir_types.IrBlock* vBlock = wBlock.preds[j];
            u32 v = n;
            for (u32 k = 0; k < n; k++)
                if (func.blocks[k] == vBlock) { v = k; break; }
            if (v >= n) continue;

            u32 u;
            if (dfn[v] <= dfn[w])
            {
                u = v; // v is an ancestor of w
            }
            else
            {
                // EVAL(v), find ancestor of v with minimal semi
                u = _domEval(v, n, ancestor, label, semi, dfn, stack);
            }

            if (dfn[semi[u]] < dfn[semi[w]])
                semi[w] = semi[u];
        }

        // Step 2: Add w to bucket of semi(w)
        next[w] = bucket[semi[w]];
        bucket[semi[w]] = w;

        // Step 3: LINK(parent[w], w) — w becomes child of parent[w]
        ancestor[w] = parent[w];
        label[w] = w;

        // Step 4: Process bucket of parent[w]
        u32 v = bucket[parent[w]];
        while (v < n)
        {
            // EVAL(v) with COMPRESS
            u32 uEval = _domEval(v, n, ancestor, label, semi, dfn, stack);

            if (dfn[semi[uEval]] < dfn[semi[v]])
                idom[v] = uEval;
            else
                idom[v] = parent[w];

            u32 tmp = next[v];
            v = tmp;
        }
        bucket[parent[w]] = n;
    }

    // Phase 3: Final pass — set idom
    for (u32 wIdx = 1; wIdx < time; wIdx++)
    {
        u32 w = vertex[wIdx];
        if (idom[w] != semi[w])
            idom[w] = idom[idom[w]];
    }
    idom[0] = 0; // entry dominates itself

    // Convert block indices to ir_types.IrBlock* pointers
    for (u32 i = 0; i < n; i++)
    {
        if (i == 0)
            dt->idoms[i] = func.blocks[blockIdx[0]];
        else if (idom[i] < n)
            dt->idoms[i] = func.blocks[blockIdx[idom[i]]];
        else
            dt->idoms[i] = null;
    }

    // Cleanup
    mman.dealloc<u32>(stack);
    mman.dealloc<u32>(state);
    mman.dealloc<u32>(blockIdx);
    mman.dealloc<u32>(parent);
    mman.dealloc<u32>(dfn);
    mman.dealloc<u32>(vertex);
    mman.dealloc<u32>(semi);
    mman.dealloc<u32>(idom);
    mman.dealloc<u32>(ancestor);
    mman.dealloc<u32>(label);
    mman.dealloc<u32>(bucket);
    mman.dealloc<u32>(next);

    return dt;
}

pub void irDomtreeFree(IrDomTree* dt)
{
    if (!dt) return;
    if (dt->blocks) mman.dealloc<ir_types.IrBlock*>(dt->blocks);
    if (dt->idoms) mman.dealloc<ir_types.IrBlock*>(dt->idoms);
    mman.dealloc<IrDomTree>(dt);
}

pub ir_types.IrBlock* irDomtreeIdom(IrDomTree* dt, ir_types.IrBlock* bb)
{
    if (!dt || !bb) return null;
    for (u32 i = 0; i < dt->nblocks; i++)
    {
        if (dt->blocks[i] == bb)
            return dt->idoms[i];
    }
    return null;
}

pub bool irDomtreeDominates(IrDomTree* dt, ir_types.IrBlock* a, ir_types.IrBlock* b)
{
    if (!dt || !a || !b) return false;
    if (a == b) return true;
    // The idom chain of the root is the root itself, so walks from a
    // self-dominated block must be bounded or they would never terminate.
    u32 guard = 0;
    ir_types.IrBlock* current = irDomtreeIdom(dt, b);
    while (current && guard <= dt->nblocks)
    {
        if (current == a) return true;
        current = irDomtreeIdom(dt, current);
        guard++;
    }
    return false;
}

pub u32 irDomtreeLevel(IrDomTree* dt, ir_types.IrBlock* bb)
{
    u32 level = 0;
    ir_types.IrBlock* current = irDomtreeIdom(dt, bb);
    while (current)
    {
        level++;
        current = irDomtreeIdom(dt, current);
    }
    return level;
}
