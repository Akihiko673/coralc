mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

struct ExprTable
{
    wallvm.ir_types.IrInst** insts;
    u32 count;
    u32 cap;

    void init()
    {
        self.insts = null;
        self.count = 0;
        self.cap = 0;
    }

    void cloneFrom(ExprTable* other)
    {
        self.count = other->count;
        self.cap = other->count;
        if (self.cap == 0)
        {
            self.insts = null;
            return;
        }
        self.insts = std.mman.alloc<wallvm.ir_types.IrInst*>(self.cap);
        for (u32 i = 0; i < self.count; i++)
            self.insts[i] = other->insts[i];
    }

    void add(wallvm.ir_types.IrInst* inst)
    {
        if (self.count >= self.cap)
        {
            u32 nc = self.cap ? self.cap * 2 : 32;
            wallvm.ir_types.IrInst** ni = std.mman.alloc<wallvm.ir_types.IrInst*>(nc);
            for (u32 i = 0; i < self.count; i++)
                ni[i] = self.insts[i];
            if (self.insts) std.mman.dealloc<wallvm.ir_types.IrInst*>(self.insts);
            self.insts = ni;
            self.cap = nc;
        }
        self.insts[self.count++] = inst;
    }

    void free()
    {
        if (self.insts) std.mman.dealloc<wallvm.ir_types.IrInst*>(self.insts);
        self.insts = null;
        self.count = 0;
        self.cap = 0;
    }
}

static bool isCandidate(wallvm.ir_types.IrInst* inst)
{
    switch (inst.opcode)
    {
    case wallvm.irOps.IrOpcode::Add:
    case wallvm.irOps.IrOpcode::Sub:
    case wallvm.irOps.IrOpcode::Mul:
    case wallvm.irOps.IrOpcode::And:
    case wallvm.irOps.IrOpcode::Or:
    case wallvm.irOps.IrOpcode::Xor:
    case wallvm.irOps.IrOpcode::Shl:
    case wallvm.irOps.IrOpcode::Lshr:
    case wallvm.irOps.IrOpcode::Ashr:
    case wallvm.irOps.IrOpcode::SMin:
    case wallvm.irOps.IrOpcode::SMax:
    case wallvm.irOps.IrOpcode::UMin:
    case wallvm.irOps.IrOpcode::UMax:
    case wallvm.irOps.IrOpcode::ICmp:
    case wallvm.irOps.IrOpcode::FAdd:
    case wallvm.irOps.IrOpcode::FSub:
    case wallvm.irOps.IrOpcode::FMul:
    case wallvm.irOps.IrOpcode::FDiv:
    case wallvm.irOps.IrOpcode::FCmp:
    case wallvm.irOps.IrOpcode::Trunc:
    case wallvm.irOps.IrOpcode::Zext:
    case wallvm.irOps.IrOpcode::Sext:
    case wallvm.irOps.IrOpcode::FpTrunc:
    case wallvm.irOps.IrOpcode::FpExt:
    case wallvm.irOps.IrOpcode::FpToSi:
    case wallvm.irOps.IrOpcode::SiToFp:
    case wallvm.irOps.IrOpcode::FpToUi:
    case wallvm.irOps.IrOpcode::UiToFp:
    case wallvm.irOps.IrOpcode::Bitcast:
    case wallvm.irOps.IrOpcode::Neg:
    case wallvm.irOps.IrOpcode::Not:
    case wallvm.irOps.IrOpcode::Abs:
    case wallvm.irOps.IrOpcode::FAbs:
    case wallvm.irOps.IrOpcode::FSqrt:
    case wallvm.irOps.IrOpcode::CtPop:
    case wallvm.irOps.IrOpcode::CtLz:
    case wallvm.irOps.IrOpcode::CtTz:
    case wallvm.irOps.IrOpcode::Rotl:
    case wallvm.irOps.IrOpcode::Rotr:
    case wallvm.irOps.IrOpcode::Bswap:
    case wallvm.irOps.IrOpcode::Select:
        return true;
    default:
        return false;
    }
}

static bool sameOperands(wallvm.ir_types.IrInst* a, wallvm.ir_types.IrInst* b)
{
    if (a->nops != b->nops) return false;
    for (u32 i = 0; i < a->nops; i++)
        if (a->ops[i] != b->ops[i]) return false;
    return true;
}

static bool areEquivalent(wallvm.ir_types.IrInst* a, wallvm.ir_types.IrInst* b)
{
    if (a->opcode != b->opcode) return false;
    if (a->base.type != b->base.type) return false;
    if (a->nops != b->nops) return false;
    if (a->opcode == wallvm.irOps.IrOpcode::ICmp && a->icmpPred != b->icmpPred) return false;
    if (a->opcode == wallvm.irOps.IrOpcode::FCmp && a->fcmpPred != b->fcmpPred) return false;

    if (sameOperands(a, b)) return true;

    if (a->nops == 2 && wallvm.irOps.irOpcodeIsCommutative(a->opcode))
    {
        if (a->ops[0] == b->ops[1] && a->ops[1] == b->ops[0])
            return true;
    }

    return false;
}

static wallvm.ir_types.IrInst* findEquivalent(ExprTable* table, wallvm.ir_types.IrInst* inst)
{
    for (u32 i = 0; i < table->count; i++)
        if (areEquivalent(table->insts[i], inst))
            return table->insts[i];
    return null;
}

static bool processBlock(wallvm.ir_types.IrBlock* bb, ExprTable* table)
{
    bool changed = false;
    u32 ii = 0;
    while (ii < bb.ninsts)
    {
        wallvm.ir_types.IrInst* inst = bb.insts[ii];
        if (!isCandidate(inst))
        {
            ii++;
            continue;
        }

        wallvm.ir_types.IrInst* existing = findEquivalent(table, inst);
        if (existing)
        {
            inst.base.replaceAllUses(&existing.base);
            inst.erase();
            changed = true;
            continue;
        }

        table->add(inst);
        ii++;
    }
    return changed;
}

static bool processDomSubtree(wallvm.ir_types.IrFunc* func, wallvm.domtree.IrDomTree* dt, wallvm.ir_types.IrBlock* bb, ExprTable* incoming)
{
    ExprTable local;
    local.init();
    local.cloneFrom(incoming);

    bool changed = processBlock(bb, &local);

    for (u32 i = 0; i < dt->nblocks; i++)
    {
        if (dt->blocks[i] == bb) continue;
        if (dt->idoms[i] == bb)
        {
            if (processDomSubtree(func, dt, dt->blocks[i], &local))
                changed = true;
        }
    }

    local.free();
    return changed;
}

pub bool irPassGvn(wallvm.ir_types.IrFunc* func, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !func || func.nblocks == 0) return false;

    wallvm.domtree.IrDomTree* dt = wallvm.domtree.irDomtreeNew(func);
    if (!dt) return false;

    ExprTable root;
    root.init();
    bool changed = processDomSubtree(func, dt, func.blocks[0], &root);
    root.free();

    wallvm.domtree.irDomtreeFree(dt);
    return changed;
}
