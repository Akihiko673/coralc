mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

// Simple key-value mapping table for value remapping during cloning
struct ValMap
{
    wallvm.ir_types.IrValue** keys;
    wallvm.ir_types.IrValue** vals;
    u32 count;
    u32 cap;

    void init()
    {
        self.keys = null;
        self.vals = null;
        self.count = 0;
        self.cap = 0;
    }

    void put(wallvm.ir_types.IrValue* k, wallvm.ir_types.IrValue* v)
    {
        if (self.count >= self.cap)
        {
            u32 nc = self.cap ? self.cap * 2 : 32;
            wallvm.ir_types.IrValue** nk = std.mman.alloc<wallvm.ir_types.IrValue*>(nc);
            wallvm.ir_types.IrValue** nv = std.mman.alloc<wallvm.ir_types.IrValue*>(nc);
            for (u32 i = 0; i < self.count; i++)
            {
                nk[i] = self.keys[i];
                nv[i] = self.vals[i];
            }
            if (self.keys) std.mman.dealloc<wallvm.ir_types.IrValue*>(self.keys);
            if (self.vals) std.mman.dealloc<wallvm.ir_types.IrValue*>(self.vals);
            self.keys = nk;
            self.vals = nv;
            self.cap = nc;
        }
        self.keys[self.count] = k;
        self.vals[self.count] = v;
        self.count++;
    }

    wallvm.ir_types.IrValue* get(wallvm.ir_types.IrValue* k)
    {
        for (u32 i = 0; i < self.count; i++)
            if (self.keys[i] == k)
                return self.vals[i];
        return null;
    }

    void free()
    {
        if (self.keys) std.mman.dealloc<wallvm.ir_types.IrValue*>(self.keys);
        if (self.vals) std.mman.dealloc<wallvm.ir_types.IrValue*>(self.vals);
        self.keys = null;
        self.vals = null;
        self.count = 0;
        self.cap = 0;
    }
};

static u32 countBodyInsts(wallvm.ir_types.IrFunc* f)
{
    u32 n = 0;
    u32 skip = f.nparams;
    for (u32 bi = 0; bi < f.nblocks; bi++)
    {
        wallvm.ir_types.IrBlock* bb = f.blocks[bi];
        u32 start = (bi == 0) ? skip : 0;
        if (start > bb.ninsts) start = bb.ninsts;
        n += bb.ninsts - start;
    }
    return n;
}

static wallvm.ir_types.IrInst* cloneInst(wallvm.ir_types.IrInst* old, wallvm.ir_types.IrBlock* newBlock, ValMap* valMap, ValMap* blkMap, wallvm.ir_types.IrContext* ctx)
{
    wallvm.ir_types.IrValue** newOps = std.mman.alloc<wallvm.ir_types.IrValue*>(old.nops > 0 ? old.nops : 1);

    for (u32 i = 0; i < old.nops; i++)
    {
        wallvm.ir_types.IrValue* op = old.ops[i];
        if (!op) { newOps[i] = null; continue; }

        if (op.kind == wallvm.ir_types.IrValueKind::Inst)
        {
            wallvm.ir_types.IrValue* m = valMap.get(op);
            if (m) { newOps[i] = m; continue; }
        }
        else if (op.kind == wallvm.ir_types.IrValueKind::Block)
        {
            wallvm.ir_types.IrValue* m = blkMap.get(op);
            if (m) { newOps[i] = m; continue; }
        }

        newOps[i] = op;
    }

    wallvm.ir_types.IrInst* ni = ctx.createInst(old.opcode, old.base.type, newOps, old.nops,
                                (u64)old.icmpPred, (u64)old.fcmpPred);

    newBlock.addInst(ni);

    valMap.put(&old.base, &ni.base);

    for (u32 i = 0; i < old.nops; i++)
        if (newOps[i])
            newOps[i].addUser(ni);

    return ni;
}

static void eraseInstAt(wallvm.ir_types.IrBlock* bb, u32 ii)
{
    for (u32 j = ii; j < bb.ninsts - 1; j++)
        bb.insts[j] = bb.insts[j + 1];
    bb.ninsts--;
}

static void transferSuccs(wallvm.ir_types.IrBlock* src, wallvm.ir_types.IrBlock* dst)
{
    for (u32 i = 0; i < src.nsuccs; i++)
    {
        wallvm.ir_types.IrBlock* succ = src.succs[i];
        succ.removePred(src);
        dst.addSucc(succ);
        for (u32 pi = 0; pi < succ.ninsts; pi++)
        {
            wallvm.ir_types.IrInst* phi = succ.insts[pi];
            if (phi.opcode == wallvm.irOps.IrOpcode::Phi)
            {
                for (u32 oi = 1; oi < phi.nops; oi += 2)
                    if (phi.ops[oi] == &src.base)
                        phi.ops[oi] = &dst.base;
            }
        }
    }
    src.nsuccs = 0;
    if (src.succs)
    {
        std.mman.dealloc<wallvm.ir_types.IrBlock*>(src.succs);
        src.succs = null;
    }
    src.capSuccs = 0;
}

static void moveInstsAfter(wallvm.ir_types.IrBlock* src, u32 startIdx, wallvm.ir_types.IrBlock* dst)
{
    u32 nToMove = src.ninsts - startIdx;
    for (u32 i = 0; i < nToMove; i++)
    {
        wallvm.ir_types.IrInst* inst = src.insts[startIdx];
        eraseInstAt(src, startIdx);
        inst.parent = dst;
        dst.addInst(inst);
    }
}

static bool inlineCall(wallvm.ir_types.IrFunc* caller, wallvm.ir_types.IrBlock* callBlock, wallvm.ir_types.IrInst* callInst,
                        u32 instIdx, wallvm.ir_types.IrFunc* callee, wallvm.ir_types.IrContext* ctx)
{
    u32 nCallArgs = (callInst.nops > 0) ? callInst.nops - 1 : 0;
    wallvm.ir_types.IrValue** callArgs = (callInst.nops > 1) ? &callInst.ops[1] : null;

    wallvm.ir_types.IrBlock* afterBlock = ctx.createBlock("after_inline");
    caller.addBlock(afterBlock);

    transferSuccs(callBlock, afterBlock);

    moveInstsAfter(callBlock, instIdx + 1, afterBlock);

    for (u32 i = 0; i < callInst.nops; i++)
        if (callInst.ops[i])
            callInst.ops[i].removeUser(callInst);
    eraseInstAt(callBlock, instIdx);

    ValMap blkMap;
    blkMap.init();

    wallvm.ir_types.IrBlock** newBlocks = std.mman.alloc<wallvm.ir_types.IrBlock*>(callee.nblocks);
    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm.ir_types.IrBlock* ob = callee.blocks[bi];
        wallvm.ir_types.IrBlock* nb = ctx.createBlock(ob.base.name);
        caller.addBlock(nb);
        newBlocks[bi] = nb;
        blkMap.put(&ob.base, &nb.base);
    }
    wallvm.ir_types.IrBlock* calleeEntry = newBlocks[0];

    ValMap valMap;
    valMap.init();

    u32 nparams = callee.nparams;
    wallvm.ir_types.IrBlock* oldEntry = callee.blocks[0];
    for (u32 i = 0; i < nparams && i < nCallArgs; i++)
    {
        if (i < oldEntry.ninsts)
        {
            wallvm.ir_types.IrInst* paramInst = oldEntry.insts[i];
            valMap.put(&paramInst.base, callArgs[i]);
        }
    }

    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm.ir_types.IrBlock* ob = callee.blocks[bi];
        wallvm.ir_types.IrBlock* nb = newBlocks[bi];
        u32 start = (bi == 0) ? nparams : 0;

        for (u32 ii = start; ii < ob.ninsts; ii++)
            cloneInst(ob.insts[ii], nb, &valMap, &blkMap, ctx);
    }

    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm.ir_types.IrBlock* nb = newBlocks[bi];
        for (u32 ii = 0; ii < nb.ninsts; ii++)
        {
            wallvm.ir_types.IrInst* ni = nb.insts[ii];
            for (u32 j = 0; j < ni.nops; j++)
            {
                wallvm.ir_types.IrValue* op = ni.ops[j];
                if (!op || op.kind != wallvm.ir_types.IrValueKind::Inst) continue;
                wallvm.ir_types.IrValue* m = valMap.get(op);
                if (!m || m == op) continue;
                op.removeUser(ni);
                ni.ops[j] = m;
                m.addUser(ni);
            }
        }
    }

    // Step 5, Wire up control flow
    // Add br from callBlock to callee entry
    {
        wallvm.ir_types.IrValue** brOps = std.mman.alloc<wallvm.ir_types.IrValue*>(1);
        wallvm.ir_types.IrValue* entryVal = &calleeEntry.base;
        brOps[0] = entryVal;
        wallvm.ir_types.IrInst* brInst = ctx.createInst(wallvm.irOps.IrOpcode::Br, ctx.tyVoid(), brOps, 1, 0, 0);
        std.mman.dealloc<wallvm.ir_types.IrValue*>(brOps);
        callBlock.addInst(brInst);
        entryVal.addUser(brInst);
        callBlock.addSucc(calleeEntry);
    }

    // Step 6, Handle return values
    // Collect all ret instructions in the cloned callee blocks
    u32 retCount = 0;
    wallvm.ir_types.IrInst** retInsts = std.mman.alloc<wallvm.ir_types.IrInst*>(callee.nblocks);
    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm.ir_types.IrBlock* nb = newBlocks[bi];
        for (u32 ii = 0; ii < nb.ninsts; ii++)
        {
            if (nb.insts[ii].opcode == wallvm.irOps.IrOpcode::Ret)
                retInsts[retCount++] = nb.insts[ii];
        }
    }

    // Create continuation block
    wallvm.ir_types.IrBlock* contBlock = ctx.createBlock("cont_inline");
    caller.addBlock(contBlock);

    bool hasRetVal = callInst.base.type && callInst.base.type.kind != wallvm.ir_types.IrTypeKind::Void;

    for (u32 ri = 0; ri < retCount; ri++)
    {
        wallvm.ir_types.IrInst* ret = retInsts[ri];
        wallvm.ir_types.IrBlock* retBlock = ret.parent;

        // Remove ret from user lists
        for (u32 oi = 0; oi < ret.nops; oi++)
            if (ret.ops[oi])
                ret.ops[oi].removeUser(ret);

        // Replace ret with br to contBlock
        // first, remove ret from retBlock's inst list
        for (u32 ii = 0; ii < retBlock.ninsts; ii++)
        {
            if (retBlock.insts[ii] == ret)
            {
                eraseInstAt(retBlock, ii);
                break;
            }
        }

        // Add successor edge(goon) from retBlock to contBlock
        retBlock.addSucc(contBlock);

        // Create br to contBlock
        wallvm.ir_types.IrValue** brOps = std.mman.alloc<wallvm.ir_types.IrValue*>(1);
        wallvm.ir_types.IrValue* contVal = &contBlock.base;
        brOps[0] = contVal;
        wallvm.ir_types.IrInst* brInst = ctx.createInst(wallvm.irOps.IrOpcode::Br, ctx.tyVoid(), brOps, 1, 0, 0);
        std.mman.dealloc<wallvm.ir_types.IrValue*>(brOps);
        retBlock.addInst(brInst);
        contVal.addUser(brInst);
    }

    // Create phi at continuation if multiple return sites and non-void
    wallvm.ir_types.IrValue* mergedRetVal = null;

    if (hasRetVal && retCount > 1)
    {
        wallvm.ir_types.IrType* retTy = callInst.base.type;
        wallvm.ir_types.IrValue** phiVals = std.mman.alloc<wallvm.ir_types.IrValue*>(retCount);
        wallvm.ir_types.IrValue** phiBlks = std.mman.alloc<wallvm.ir_types.IrValue*>(retCount);
        u32 phiCount = 0;

        for (u32 ri = 0; ri < retCount; ri++)
        {
            wallvm.ir_types.IrInst* ret = retInsts[ri];
            if (ret.nops > 0 && ret.ops[0])
            {
                wallvm.ir_types.IrBlock* retBlock = ret.parent;
                phiVals[phiCount] = ret.ops[0];
                phiBlks[phiCount] = &retBlock.base;
                phiCount++;
            }
        }

        if (phiCount > 1)
        {
            wallvm.ir_types.IrValue** phiOps = std.mman.alloc<wallvm.ir_types.IrValue*>(phiCount * 2);
            for (u32 i = 0; i < phiCount; i++)
            {
                phiOps[i * 2] = phiVals[i];
                phiOps[i * 2 + 1] = phiBlks[i];
            }
            wallvm.ir_types.IrInst* phiInst = ctx.createInst(wallvm.irOps.IrOpcode::Phi, retTy, phiOps, phiCount * 2, 0, 0);
            contBlock.addInst(phiInst);
            for (u32 i = 0; i < phiCount * 2; i++)
                if (phiOps[i])
                    phiOps[i].addUser(phiInst);
            std.mman.dealloc<wallvm.ir_types.IrValue*>(phiOps);
            mergedRetVal = &phiInst.base;
        }
        else if (phiCount == 1)
        {
            mergedRetVal = phiVals[0];
        }

        if (phiVals) std.mman.dealloc<wallvm.ir_types.IrValue*>(phiVals);
        if (phiBlks) std.mman.dealloc<wallvm.ir_types.IrValue*>(phiBlks);
    }
    else if (hasRetVal && retCount == 1)
    {
        wallvm.ir_types.IrInst* ret = retInsts[0];
        if (ret.nops > 0 && ret.ops[0])
            mergedRetVal = ret.ops[0];
    }

    // Free cloned ret instructions (no longer needed)
    for (u32 ri = 0; ri < retCount; ri++)
        retInsts[ri].erase();

    // Add br from contBlock to afterBlock
    {
        wallvm.ir_types.IrValue** brOps = std.mman.alloc<wallvm.ir_types.IrValue*>(1);
        wallvm.ir_types.IrValue* afterVal = &afterBlock.base;
        brOps[0] = afterVal;
        wallvm.ir_types.IrInst* brInst = ctx.createInst(wallvm.irOps.IrOpcode::Br, ctx.tyVoid(), brOps, 1, 0, 0);
        std.mman.dealloc<wallvm.ir_types.IrValue*>(brOps);
        contBlock.addInst(brInst);
        afterVal.addUser(brInst);
        contBlock.addSucc(afterBlock);
    }

    // Step 7, Replace uses of call result with the merged return value
    if (hasRetVal && mergedRetVal)
    {
        wallvm.ir_types.IrValue* callVal = &callInst.base;
        callVal.replaceAllUses(mergedRetVal);
    }

    // Cleanup dat biiiiiih
    // Fully erase the call instruction (frees ops, users, and the struct)
    callInst.erase();

    std.mman.dealloc<wallvm.ir_types.IrBlock*>(newBlocks);
    std.mman.dealloc<wallvm.ir_types.IrInst*>(retInsts);

    valMap.free();
    blkMap.free();

    return true;
}

pub bool irPassInline(wallvm.ir_types.IrFunc* func, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !func) return false;
    if (func.nblocks == 0) return false;

    const u32 MAX_INLINE_SIZE = 20;
    bool changed = false;

    // Iterate looking for inlineable calls. After each successful inline
    // the CFG changes, so we restart scanning from the beginning
    bool progress = true;
    while (progress)
    {
        progress = false;

        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = func.blocks[bi];

            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm.ir_types.IrInst* inst = bb.insts[ii];
                if (inst.opcode != wallvm.irOps.IrOpcode::Call) continue;

                // Callee must be at ops[0] (convention used by all backends)
                if (inst.nops < 1) continue;
                wallvm.ir_types.IrValue* calleeVal = inst.ops[0];
                if (!calleeVal || calleeVal.kind != wallvm.ir_types.IrValueKind::Func) continue;

                wallvm.ir_types.IrFunc* callee = (wallvm.ir_types.IrFunc*)calleeVal;

                // Do not inline extern functions or recursive calls
                if (callee.isExtern || callee == func) continue;

                // Cost model, only inline small functions
                if (countBodyInsts(callee) >= MAX_INLINE_SIZE) continue;

                // Inline the call
                if (inlineCall(func, bb, inst, ii, callee, ctx))
                {
                    changed = true;
                    progress = true;
                    break; // restart scanning
                }
            }

            if (progress) break;
        }
    }
    return changed;
}
