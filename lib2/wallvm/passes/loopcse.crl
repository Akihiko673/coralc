mod domtree = import(lib, "wallvm");
mod std = import(lib, "std");

// Cross-loop CSE. LICM skips memory operations, so hoisting loop-invariant
// loads out of loops that cannot write memory, then sweeping the preheader for
// redundant computations, closes that gap.
pub struct LoopCsePass
{
    wallvm.ir_types.IrContext* ctx;
    u64 hoisted;
    u64 eliminated;

    LoopCsePass new(wallvm.ir_types.IrContext* ctx)
    {
        LoopCsePass p;
        p.ctx = ctx;
        p.hoisted = 0;
        p.eliminated = 0;
        return p;
    }

    bool run(wallvm.ir_types.IrFunc* func)
    {
        wallvm.passes.loop_detectIrLoop** loops = wallvm.passes.loop_detectirLoopDetectNatural(func);
        if (!loops) return false;

        bool changed = false;
        for (u32 li = 0; loops[li]; li++)
        {
            wallvm.passes.loop_detectIrLoop* lp = loops[li];
            if (self.hoistLoopLoads(func, lp)) changed = true;
            if (lp->preheader && self.dedupeBlock(lp->preheader)) changed = true;
        }

        std.mman.dealloc<wallvm.passes.loop_detectIrLoop*>(loops);
        return changed;
    }

    // Any opcode that can conditionally or through a callee write memory
    // invalidates cross-iteration load hoisting.
    bool isWriter(wallvm.irOps.IrOpcode op)
    {
        switch (op)
        {
        case wallvm.irOps.IrOpcode::Store:
        case wallvm.irOps.IrOpcode::AtomicLoad:
        case wallvm.irOps.IrOpcode::AtomicStore:
        case wallvm.irOps.IrOpcode::AtomicRmw:
        case wallvm.irOps.IrOpcode::AtomicCmpXchg:
        case wallvm.irOps.IrOpcode::Fence:
        case wallvm.irOps.IrOpcode::Call:
        case wallvm.irOps.IrOpcode::InlineAsm:
        case wallvm.irOps.IrOpcode::LandingPad:
        case wallvm.irOps.IrOpcode::GcRoot:
        case wallvm.irOps.IrOpcode::GcWriteBarrier:
        case wallvm.irOps.IrOpcode::GcSafepoint:
            return true;
        default:
            return false;
        }
    }

    bool loopHasWriter(wallvm.passes.loop_detectIrLoop* lp)
    {
        for (u32 bi = 0; bi < lp->nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = lp->blocks[bi];
            for (u32 ii = 0; ii < bb.ninsts; ii++)
                if (self.isWriter(bb.insts[ii].opcode)) return true;
        }
        return false;
    }

    bool isHoistableLoad(wallvm.ir_types.IrInst* inst, wallvm.passes.loop_detectIrLoop* lp)
    {
        if (inst.opcode != wallvm.irOps.IrOpcode::Load) return false;
        return wallvm.passes.licm.isLoopInvariant(inst, lp);
    }

    bool hoistLoopLoads(wallvm.ir_types.IrFunc* func, wallvm.passes.loop_detectIrLoop* lp)
    {
        if (self.loopHasWriter(lp)) return false;

        wallvm.ir_types.IrBlock* pre = lp->preheader;
        bool changed = false;

        bool hasCandidate = false;
        for (u32 bi = 0; bi < lp->nblocks && !hasCandidate; bi++)
        {
            wallvm.ir_types.IrBlock* bb = lp->blocks[bi];
            for (u32 ii = 0; ii < bb.ninsts; ii++)
                if (self.isHoistableLoad(bb.insts[ii], lp))
                {
                    hasCandidate = true;
                    break;
                }
        }
        if (!hasCandidate) return false;

        if (!pre)
        {
            pre = wallvm.passes.licm.createPreheader(self.ctx, lp, func);
            if (!pre) return false;
        }

        wallvm.domtree.IrDomTree* dt = wallvm.domtree.irDomtreeNew(func);
        if (!dt) return false;

        for (u32 bi = 0; bi < lp->nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = lp->blocks[bi];

            // Only loads in blocks that run on every path are hoisted, the
            // block must dominate the latch (every path to the back edge).
            if (!wallvm.domtree.irDomtreeDominates(dt, bb, lp->latch)) continue;

            u32 ii = 0;
            while (ii < bb.ninsts)
            {
                wallvm.ir_types.IrInst* inst = bb.insts[ii];
                if (self.isHoistableLoad(inst, lp))
                {
                    wallvm.passes.licm.hoistToPreheader(inst, pre);
                    self.hoisted++;
                    changed = true;
                }
                else
                {
                    ii++;
                }
            }
        }

        wallvm.domtree.irDomtreeFree(dt);
        return changed;
    }

    bool isPureCandidate(wallvm.irOps.IrOpcode op)
    {
        switch (op)
        {
        case wallvm.irOps.IrOpcode::Add:
        case wallvm.irOps.IrOpcode::Sub:
        case wallvm.irOps.IrOpcode::Mul:
        case wallvm.irOps.IrOpcode::And:
        case wallvm.irOps.IrOpcode::Or:
        case wallvm.irOps.IrOpcode::Xor:
        case wallvm.irOps.IrOpcode::Shl:
        case wallvm.irOps.IrOpcode::Lshr:
        case wallvm.irOps.IrOpcode::Ashr:
        case wallvm.irOps.IrOpcode::SMin:
        case wallvm.irOps.IrOpcode::SMax:
        case wallvm.irOps.IrOpcode::UMin:
        case wallvm.irOps.IrOpcode::UMax:
        case wallvm.irOps.IrOpcode::ICmp:
        case wallvm.irOps.IrOpcode::FAdd:
        case wallvm.irOps.IrOpcode::FSub:
        case wallvm.irOps.IrOpcode::FMul:
        case wallvm.irOps.IrOpcode::FDiv:
        case wallvm.irOps.IrOpcode::FCmp:
        case wallvm.irOps.IrOpcode::Trunc:
        case wallvm.irOps.IrOpcode::Zext:
        case wallvm.irOps.IrOpcode::Sext:
        case wallvm.irOps.IrOpcode::FpTrunc:
        case wallvm.irOps.IrOpcode::FpExt:
        case wallvm.irOps.IrOpcode::FpToSi:
        case wallvm.irOps.IrOpcode::SiToFp:
        case wallvm.irOps.IrOpcode::FpToUi:
        case wallvm.irOps.IrOpcode::UiToFp:
        case wallvm.irOps.IrOpcode::Bitcast:
        case wallvm.irOps.IrOpcode::Neg:
        case wallvm.irOps.IrOpcode::Not:
        case wallvm.irOps.IrOpcode::Abs:
        case wallvm.irOps.IrOpcode::FAbs:
        case wallvm.irOps.IrOpcode::FSqrt:
        case wallvm.irOps.IrOpcode::CtPop:
        case wallvm.irOps.IrOpcode::CtLz:
        case wallvm.irOps.IrOpcode::CtTz:
        case wallvm.irOps.IrOpcode::Rotl:
        case wallvm.irOps.IrOpcode::Rotr:
        case wallvm.irOps.IrOpcode::Bswap:
        case wallvm.irOps.IrOpcode::Select:
            return true;
        default:
            return false;
        }
    }

    bool isDedupeCandidate(wallvm.irOps.IrOpcode op)
    {
        if (op == wallvm.irOps.IrOpcode::Load) return true;
        return self.isPureCandidate(op);
    }

    bool sameOperands(wallvm.ir_types.IrInst* a, wallvm.ir_types.IrInst* b)
    {
        if (a->nops != b->nops) return false;
        for (u32 i = 0; i < a->nops; i++)
            if (a->ops[i] != b->ops[i]) return false;
        return true;
    }

    bool areEquivalent(wallvm.ir_types.IrInst* a, wallvm.ir_types.IrInst* b)
    {
        if (a->opcode != b->opcode) return false;
        if (a->base.type != b->base.type) return false;
        if (a->nops != b->nops) return false;
        if (a->opcode == wallvm.irOps.IrOpcode::ICmp && a->icmpPred != b->icmpPred) return false;
        if (a->opcode == wallvm.irOps.IrOpcode::FCmp && a->fcmpPred != b->fcmpPred) return false;

        if (sameOperands(a, b)) return true;

        if (a->nops == 2 && wallvm.irOps.irOpcodeIsCommutative(a->opcode))
        {
            if (a->ops[0] == b->ops[1] && a->ops[1] == b->ops[0])
                return true;
        }

        return false;
    }

    void fold(wallvm.ir_types.IrInst* inst, wallvm.ir_types.IrInst* prev)
    {
        inst.base.replaceAllUses(&prev.base);
        inst.erase();
        self.eliminated++;
    }

    // Sweep the preheader for redundant computations. Pure instructions fold
    // against any earlier equivalent (SSA values are immutable, a store between
    // them cannot change a result). Loads only fold where no writer lies
    // between the copies.
    bool dedupeBlock(wallvm.ir_types.IrBlock* pre)
    {
        bool changed = false;
        u32 i = 0;
        while (i < pre.ninsts)
        {
            wallvm.ir_types.IrInst* inst = pre.insts[i];
            if (!self.isDedupeCandidate(inst.opcode))
            {
                i++;
                continue;
            }

            bool folded = false;
            if (inst.opcode == wallvm.irOps.IrOpcode::Load)
            {
                u32 j = i;
                while (j > 0)
                {
                    j--;
                    wallvm.ir_types.IrInst* prev = pre.insts[j];
                    if (self.isWriter(prev.opcode)) break;
                    if (self.areEquivalent(inst, prev))
                    {
                        self.fold(inst, prev);
                        changed = true;
                        folded = true;
                        break;
                    }
                }
            }
            else
            {
                for (u32 j = 0; j < i; j++)
                {
                    wallvm.ir_types.IrInst* prev = pre.insts[j];
                    if (self.areEquivalent(inst, prev))
                    {
                        self.fold(inst, prev);
                        changed = true;
                        folded = true;
                        break;
                    }
                }
            }

            if (!folded) i++;
        }
        return changed;
    }
}

pub bool irPassLoopCse(wallvm.ir_types.IrFunc* func, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !func) return false;
    LoopCsePass pass = LoopCsePass::new(ctx);
    return pass.run(func);
}
