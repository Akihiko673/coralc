mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

pub struct DCEPass
{
    wallvm.ir_types.IrContext* ctx;
    u64 removed;

    DCEPass new(wallvm.ir_types.IrContext* ctx)
    {
        DCEPass p;
        p.ctx = ctx;
        p.removed = 0;
        return p;
    }

    bool run(wallvm.ir_types.IrFunc* func)
    {
        self.removed = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = func.blocks[bi];
            u32 ii = 0;
            while (ii < bb.ninsts)
            {
                wallvm.ir_types.IrInst* inst = bb.insts[ii];
                if (self.isDead(inst))
                {
                    inst.erase();
                    self.removed++;
                    changed = true;
                }
                else
                {
                    ii++;
                }
            }
        }

        return changed;
    }

    u64 removedCount()
    {
        return self.removed;
    }

    bool isDead(wallvm.ir_types.IrInst* inst)
    {
        if (wallvm.irOps.irOpcodeIsTerminator(inst.opcode)) return false;

        // side-effecting ops are never dead
        switch (inst.opcode)
        {
        case wallvm.irOps.IrOpcode::Store:
        case wallvm.irOps.IrOpcode::Call:
        case wallvm.irOps.IrOpcode::Noret:
        case wallvm.irOps.IrOpcode::AtomicStore:
        case wallvm.irOps.IrOpcode::AtomicRmw:
        case wallvm.irOps.IrOpcode::AtomicCmpXchg:
        case wallvm.irOps.IrOpcode::Fence:
        case wallvm.irOps.IrOpcode::InlineAsm:
        case wallvm.irOps.IrOpcode::GcWriteBarrier:
        case wallvm.irOps.IrOpcode::GcSafepoint:
        case wallvm.irOps.IrOpcode::LandingPad:
            return false;
        default:
            break;
        }

        if (inst.opcode == wallvm.irOps.IrOpcode::Alloca)
            return inst.base.nusers == 0;

        return inst.base.nusers == 0;
    }
}

pub bool irPassDce(wallvm.ir_types.IrFunc* func, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !func) return false;
    DCEPass pass = DCEPass::new(ctx);
    return pass.run(func);
}

pub struct ADCEPass
{
    wallvm.ir_types.IrContext* ctx;
    u64 removed;

    ADCEPass new(wallvm.ir_types.IrContext* ctx)
    {
        ADCEPass p;
        p.ctx = ctx;
        p.removed = 0;
        return p;
    }

    bool isCritical(wallvm.ir_types.IrInst* inst)
    {
        switch (inst.opcode)
        {
        case wallvm.irOps.IrOpcode::Br:
        case wallvm.irOps.IrOpcode::CondBr:
        case wallvm.irOps.IrOpcode::Ret:
        case wallvm.irOps.IrOpcode::Unreachable:
        case wallvm.irOps.IrOpcode::Noret:
        case wallvm.irOps.IrOpcode::Store:
        case wallvm.irOps.IrOpcode::Call:
        case wallvm.irOps.IrOpcode::AtomicStore:
        case wallvm.irOps.IrOpcode::AtomicRmw:
        case wallvm.irOps.IrOpcode::AtomicCmpXchg:
        case wallvm.irOps.IrOpcode::Fence:
        case wallvm.irOps.IrOpcode::InlineAsm:
        case wallvm.irOps.IrOpcode::GcWriteBarrier:
        case wallvm.irOps.IrOpcode::GcSafepoint:
        case wallvm.irOps.IrOpcode::LandingPad:
            return true;
        default:
            return false;
        }
    }

    bool run(wallvm.ir_types.IrFunc* func)
    {
        self.removed = 0;

        u32 totalInsts = 0;
        for (u32 bi = 0; bi < func.nblocks; bi++)
            totalInsts += func.blocks[bi].ninsts;

        if (totalInsts == 0) return false;

        wallvm.ir_types.IrInst** allInsts = std.mman.alloc<wallvm.ir_types.IrInst*>(totalInsts);
        u32 idx = 0;
        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = func.blocks[bi];
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                allInsts[idx] = bb.insts[ii];
                bb.insts[ii].base.valData = idx;
                idx++;
            }
        }

        u8* live = std.mman.alloc<u8>(totalInsts);
        for (u32 i = 0; i < totalInsts; i++) live[i] = 0;

        for (u32 i = 0; i < totalInsts; i++)
        {
            if (self.isCritical(allInsts[i]))
                live[i] = 1;
        }

        bool changed = true;
        while (changed)
        {
            changed = false;
            for (u32 i = 0; i < totalInsts; i++)
            {
                if (!live[i]) continue;
                wallvm.ir_types.IrInst* inst = allInsts[i];
                for (u32 j = 0; j < inst.nops; j++)
                {
                    wallvm.ir_types.IrValue* op = inst.ops[j];
                    if (!op || op.kind != wallvm.ir_types.IrValueKind::Inst) continue;
                    u32 opIdx = (u32)op.valData;
                    if (!live[opIdx])
                    {
                        live[opIdx] = 1;
                        changed = true;
                    }
                }
            }
        }

        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = func.blocks[bi];
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm.ir_types.IrInst* inst = bb.insts[ii];
                u32 instIdx = (u32)inst.base.valData;
                if (live[instIdx]) continue;
                for (u32 ui = 0; ui < inst.base.nusers; ui++)
                {
                    wallvm.ir_types.IrInst* user = inst.base.users[ui];
                    for (u32 j = 0; j < user.nops; j++)
                        if (user.ops[j] == &inst.base)
                            user.ops[j] = null;
                }
            }
        }

        bool anyRemoved = false;
        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = func.blocks[bi];
            u32 ii = 0;
            while (ii < bb.ninsts)
            {
                wallvm.ir_types.IrInst* inst = bb.insts[ii];
                u32 instIdx = (u32)inst.base.valData;
                if (!live[instIdx])
                {
                    inst.erase();
                    self.removed++;
                    anyRemoved = true;
                }
                else
                {
                    ii++;
                }
            }
        }

        std.mman.dealloc<wallvm.ir_types.IrInst*>(allInsts);
        std.mman.dealloc<u8>(live);

        return anyRemoved;
    }
}

pub bool irPassAdce(wallvm.ir_types.IrFunc* func, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !func) return false;
    ADCEPass pass = ADCEPass::new(ctx);
    return pass.run(func);
}