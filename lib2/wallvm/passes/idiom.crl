mod wallvm = import(lib, "wallvm");

pub struct IdiomRecognizePass
{
    wallvm.ir_types.IrContext* ctx;
    u64 recognized;

    IdiomRecognizePass new(wallvm.ir_types.IrContext* ctx)
    {
        IdiomRecognizePass p;
        p.ctx = ctx;
        p.recognized = 0;
        return p;
    }

    bool run(wallvm.ir_types.IrFunc* func)
    {
        self.recognized = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = func.blocks[bi];
            u32 ii = 0;
            while (ii < bb.ninsts)
            {
                wallvm.ir_types.IrInst* inst = bb.insts[ii];
                if (self.recognizeIdiom(inst))
                {
                    self.recognized++;
                    changed = true;
                }
                else
                {
                    ii++;
                }
            }
        }

        return changed;
    }

    // Recognize common code idioms and replace with single instructions
    bool recognizeIdiom(wallvm.ir_types.IrInst* inst)
    {
        if (inst.nops < 2) return false;

        wallvm.ir_types.IrValue* a = inst.ops[0];
        wallvm.ir_types.IrValue* b = inst.ops[1];
        if (!a || !b) return false;

        if (self.matchRotate(inst, a, b))
            return true;

        if (self.matchBswap(inst))
            return true;

        if (self.matchMinMax(inst, a, b))
            return true;

        if (self.matchAbs(inst, a, b))
            return true;

        if (self.matchFma(inst, a, b))
            return true;

        return false;
    }

    // Match rotate idiom, or(shl(x, N), lshr(x, M-N)) -> rotl(x, N)
    bool matchRotate(wallvm.ir_types.IrInst* inst, wallvm.ir_types.IrValue* a, wallvm.ir_types.IrValue* b)
    {
        if (inst.opcode != wallvm.irOps.IrOpcode::Or) return false;
        if (a.kind != wallvm.ir_types.IrValueKind::Inst || b.kind != wallvm.ir_types.IrValueKind::Inst) return false;

        wallvm.ir_types.IrInst* aInst = (wallvm.ir_types.IrInst*)a;
        wallvm.ir_types.IrInst* bInst = (wallvm.ir_types.IrInst*)b;

        if (aInst->opcode == wallvm.irOps.IrOpcode::Shl &&
            bInst->opcode == wallvm.irOps.IrOpcode::Lshr &&
            aInst->nops == 2 && bInst->nops == 2)
        {
            wallvm.ir_types.IrValue* x1 = aInst->ops[0];
            wallvm.ir_types.IrValue* x2 = bInst->ops[0];
            wallvm.ir_types.IrValue* n1 = aInst->ops[1];
            wallvm.ir_types.IrValue* n2 = bInst->ops[1];

            if (x1 == x2 && n1.kind == wallvm.ir_types.IrValueKind::ConstInt &&
                n2.kind == wallvm.ir_types.IrValueKind::ConstInt)
            {
                u32 bits = x1.type ? x1.type.width : 64;
                u64 shift = n1.valData;
                u64 complement = n2.valData;

                if (complement == bits - shift || complement == (64 - shift))
                {
                    wallvm.ir_types.IrType* ty = x1.type;
                    wallvm.ir_types.IrValue* rotlOps[2] = { x1, self.ctx.constInt(ty, shift) };
                    wallvm.ir_types.IrInst* rotlInst = self.ctx.createInst(wallvm.irOps.IrOpcode::Rotl, ty, rotlOps, 2, 0, 0);
                    rotlOps[0].addUser(rotlInst);
                    rotlOps[1].addUser(rotlInst);
                    inst.parent.insertBefore(rotlInst, inst);
                    inst.base.replaceAllUses(&rotlInst.base);
                    inst.erase();
                    return true;
                }
            }
        }

        if (aInst->opcode == wallvm.irOps.IrOpcode::Lshr &&
            bInst->opcode == wallvm.irOps.IrOpcode::Shl &&
            aInst->nops == 2 && bInst->nops == 2)
        {
            wallvm.ir_types.IrValue* x1 = aInst->ops[0];
            wallvm.ir_types.IrValue* x2 = bInst->ops[0];
            wallvm.ir_types.IrValue* n1 = aInst->ops[1];
            wallvm.ir_types.IrValue* n2 = bInst->ops[1];

            if (x1 == x2 && n1.kind == wallvm.ir_types.IrValueKind::ConstInt &&
                n2.kind == wallvm.ir_types.IrValueKind::ConstInt)
            {
                u32 bits = x1.type ? x1.type.width : 64;
                u64 shift = n1.valData;
                u64 complement = n2.valData;

                if (complement == bits - shift || complement == (64 - shift))
                {
                    wallvm.ir_types.IrType* ty = x1.type;
                    wallvm.ir_types.IrValue* rotrOps[2] = { x1, self.ctx.constInt(ty, shift) };
                    wallvm.ir_types.IrInst* rotrInst = self.ctx.createInst(wallvm.irOps.IrOpcode::Rotr, ty, rotrOps, 2, 0, 0);
                    rotrOps[0].addUser(rotrInst);
                    rotrOps[1].addUser(rotrInst);
                    inst.parent.insertBefore(rotrInst, inst);
                    inst.base.replaceAllUses(&rotrInst.base);
                    inst.erase();
                    return true;
                }
            }
        }

        return false;
    }

    bool matchFma(wallvm.ir_types.IrInst* inst, wallvm.ir_types.IrValue* a, wallvm.ir_types.IrValue* b)
    {
        if (inst.opcode != wallvm.irOps.IrOpcode::FAdd) return false;
        if (!inst.base.type || inst.base.type.kind != wallvm.ir_types.IrTypeKind::Float) return false;

        wallvm.ir_types.IrInst* mulInst = null;
        wallvm.ir_types.IrValue* other = null;

        if (a.kind == wallvm.ir_types.IrValueKind::Inst && ((wallvm.ir_types.IrInst*)a)->opcode == wallvm.irOps.IrOpcode::FMul)
        {
            mulInst = (wallvm.ir_types.IrInst*)a;
            other = b;
        }
        else if (b.kind == wallvm.ir_types.IrValueKind::Inst && ((wallvm.ir_types.IrInst*)b)->opcode == wallvm.irOps.IrOpcode::FMul)
        {
            mulInst = (wallvm.ir_types.IrInst*)b;
            other = a;
        }
        else
        {
            return false;
        }

        if (!mulInst || mulInst->nops != 2 || !other) return false;
        if (!mulInst->base.type || mulInst->base.type != inst.base.type) return false;

        wallvm.ir_types.IrValue* x = mulInst->ops[0];
        wallvm.ir_types.IrValue* y = mulInst->ops[1];
        if (!x || !y) return false;

        wallvm.ir_types.IrValue* fmaOps[3] = { x, y, other };
        wallvm.ir_types.IrInst* fmaInst = self.ctx.createInst(wallvm.irOps.IrOpcode::Fma, inst.base.type, fmaOps, 3, 0, 0);
        fmaOps[0].addUser(fmaInst);
        fmaOps[1].addUser(fmaInst);
        fmaOps[2].addUser(fmaInst);
        inst.parent.insertBefore(fmaInst, inst);
        inst.base.replaceAllUses(&fmaInst.base);
        inst.erase();
        return true;
    }

    // Match byte-swap idiom, an or-chain of masked byte shifts that places each
    // source byte at its byte-reversed destination.
    bool matchBswap(wallvm.ir_types.IrInst* inst)
    {
        if (inst.opcode != wallvm.irOps.IrOpcode::Or) return false;
        if (!inst.base.type || inst.base.type.kind != wallvm.ir_types.IrTypeKind::Int) return false;
        u32 width = inst.base.type.width;
        if (width < 16 || width > 64 || width % 16 != 0) return false;
        u32 nBytes = width / 8;
        if (nBytes > 8) return false;

        wallvm.ir_types.IrInst* leaves[8];
        wallvm.ir_types.IrInst* cur = inst;
        u32 n = 0;
        while (true)
        {
            if (cur.opcode != wallvm.irOps.IrOpcode::Or)
            {
                leaves[n++] = cur;
                break;
            }
            if (cur.nops != 2) return false;
            if (cur.ops[1].kind != wallvm.ir_types.IrValueKind::Inst) return false;
            leaves[n++] = (wallvm.ir_types.IrInst*)cur.ops[1];
            if (n > nBytes) return false;
            if (cur.ops[0].kind != wallvm.ir_types.IrValueKind::Inst) return false;
            cur = (wallvm.ir_types.IrInst*)cur.ops[0];
        }
        if (n != nBytes) return false;

        wallvm.ir_types.IrValue* x = null;
        u32 ms[8];
        u32 ds[8];
        for (u32 i = 0; i < n; i++)
        {
            if (!self.bswapTerm(leaves[i], nBytes, &x, &ms[i], &ds[i])) return false;
        }

        // Every byte moves to its mirrored destination, no two share one.
        for (u32 i = 0; i < n; i++)
        {
            if (ds[i] != nBytes - 1 - ms[i]) return false;
            for (u32 j = i + 1; j < n; j++)
                if (ds[i] == ds[j]) return false;
        }

        wallvm.ir_types.IrValue* bops[1] = { x };
        wallvm.ir_types.IrInst* bs = self.ctx.createInst(wallvm.irOps.IrOpcode::Bswap, inst.base.type, bops, 1, 0, 0);
        bops[0].addUser(bs);
        inst.parent.insertBefore(bs, inst);
        inst.base.replaceAllUses(&bs.base);
        inst.erase();
        return true;
    }

    // Match one byte-swap term; returns its source byte m and destination byte
    // d, and binds the shared value x on the first call.
    bool bswapTerm(wallvm.ir_types.IrInst* leaf, u32 nBytes, wallvm.ir_types.IrValue** x, u32* m, u32* d)
    {
        wallvm.ir_types.IrInst* shiftInst = leaf;
        u64 mask = 0;
        bool isAnd = false;
        if (leaf.opcode == wallvm.irOps.IrOpcode::And && leaf.nops == 2)
        {
            if (leaf.ops[1].kind != wallvm.ir_types.IrValueKind::ConstInt) return false;
            if (leaf.ops[0].kind != wallvm.ir_types.IrValueKind::Inst) return false;
            mask = leaf.ops[1].valData;
            shiftInst = (wallvm.ir_types.IrInst*)leaf.ops[0];
            isAnd = true;
        }
        if (shiftInst->opcode != wallvm.irOps.IrOpcode::Shl &&
            shiftInst->opcode != wallvm.irOps.IrOpcode::Lshr) return false;
        if (shiftInst->nops != 2) return false;
        wallvm.ir_types.IrValue* sx = shiftInst->ops[0];
        wallvm.ir_types.IrValue* s = shiftInst->ops[1];
        if (s.kind != wallvm.ir_types.IrValueKind::ConstInt) return false;
        u64 shift = s.valData;
        if (shift == 0 || shift % 8 != 0) return false;
        u32 sBytes = (u32)(shift / 8);
        bool isShl = shiftInst->opcode == wallvm.irOps.IrOpcode::Shl;

        if (!(*x)) *x = sx;
        else if (*x != sx) return false;

        if (isAnd)
        {
            // The mask must isolate exactly one byte, 0xFF << (d * 8).
            if (mask == 0) return false;
            u32 dpos = 0;
            bool found = false;
            for (u32 k = 0; k < 8; k++)
            {
                if (((mask >> (k * 8)) & 0xFF) != 0)
                {
                    if (found) return false;
                    found = true;
                    dpos = k;
                }
            }
            if (!found || (mask >> (dpos * 8)) != 0xFF) return false;
            if (dpos >= nBytes) return false;

            u32 spos;
            if (isShl)
            {
                if (sBytes > dpos) return false;
                spos = dpos - sBytes;
            }
            else
            {
                spos = dpos + sBytes;
            }
            if (spos >= nBytes) return false;
            *m = spos;
            *d = dpos;
            return true;
        }

        // Maskless term, a shift of nBytes-1 bytes isolates the far byte.
        if (isShl)
        {
            if (sBytes != nBytes - 1) return false;
            *m = 0;
            *d = sBytes;
        }
        else
        {
            if (sBytes != nBytes - 1) return false;
            *m = sBytes;
            *d = 0;
        }
        return true;
    }

    // Match min/max idiom, select(icmp_XX(a, b), a, b) -> smin/smax/umin/umax
    bool matchMinMax(wallvm.ir_types.IrInst* inst, wallvm.ir_types.IrValue* a, wallvm.ir_types.IrValue* b)
    {
        if (inst.opcode != wallvm.irOps.IrOpcode::Select) return false;
        if (a.kind != wallvm.ir_types.IrValueKind::Inst) return false;
        if (inst.nops < 3) return false;

        wallvm.ir_types.IrInst* condInst = (wallvm.ir_types.IrInst*)a;
        if (condInst->opcode != wallvm.irOps.IrOpcode::ICmp) return false;
        if (condInst->nops != 2) return false;

        wallvm.ir_types.IrValue* cmpA = condInst->ops[0];
        wallvm.ir_types.IrValue* cmpB = condInst->ops[1];
        wallvm.ir_types.IrValue* trueVal = b;
        wallvm.ir_types.IrValue* falseVal = inst.ops[2];

        wallvm.irOps.IrICmpPred pred = condInst->icmpPred;
        wallvm.irOps.IrOpcode minMaxOp;

        if (trueVal == cmpA && falseVal == cmpB)
        {
            switch (pred)
            {
            case wallvm.irOps.IrICmpPred::Slt: case wallvm.irOps.IrICmpPred::Sle: minMaxOp = wallvm.irOps.IrOpcode::SMin; break;
            case wallvm.irOps.IrICmpPred::Sgt: case wallvm.irOps.IrICmpPred::Sge: minMaxOp = wallvm.irOps.IrOpcode::SMax; break;
            case wallvm.irOps.IrICmpPred::Ult: case wallvm.irOps.IrICmpPred::Ule: minMaxOp = wallvm.irOps.IrOpcode::UMin; break;
            case wallvm.irOps.IrICmpPred::Ugt: case wallvm.irOps.IrICmpPred::Uge: minMaxOp = wallvm.irOps.IrOpcode::UMax; break;
            default: return false;
            }
        }
        else if (trueVal == cmpB && falseVal == cmpA)
        {
            switch (pred)
            {
            case wallvm.irOps.IrICmpPred::Slt: case wallvm.irOps.IrICmpPred::Sle: minMaxOp = wallvm.irOps.IrOpcode::SMax; break;
            case wallvm.irOps.IrICmpPred::Sgt: case wallvm.irOps.IrICmpPred::Sge: minMaxOp = wallvm.irOps.IrOpcode::SMin; break;
            case wallvm.irOps.IrICmpPred::Ult: case wallvm.irOps.IrICmpPred::Ule: minMaxOp = wallvm.irOps.IrOpcode::UMax; break;
            case wallvm.irOps.IrICmpPred::Ugt: case wallvm.irOps.IrICmpPred::Uge: minMaxOp = wallvm.irOps.IrOpcode::UMin; break;
            default: return false;
            }
        }
        else
        {
            return false;
        }

        wallvm.ir_types.IrType* ty = cmpA.type;
        wallvm.ir_types.IrValue* mmOps[2] = { cmpA, cmpB };
        wallvm.ir_types.IrInst* mmInst = self.ctx.createInst(minMaxOp, ty, mmOps, 2, 0, 0);
        mmOps[0].addUser(mmInst);
        mmOps[1].addUser(mmInst);
        inst.parent.insertBefore(mmInst, inst);
        inst.base.replaceAllUses(&mmInst.base);
        inst.erase();
        return true;
    }

    // Match abs idiom, select(icmp_slt(x, 0), neg(x), x) -> abs(x)
    bool matchAbs(wallvm.ir_types.IrInst* inst, wallvm.ir_types.IrValue* a, wallvm.ir_types.IrValue* b)
    {
        if (inst.opcode != wallvm.irOps.IrOpcode::Select) return false;
        if (a.kind != wallvm.ir_types.IrValueKind::Inst) return false;
        if (inst.nops < 3) return false;

        wallvm.ir_types.IrInst* condInst = (wallvm.ir_types.IrInst*)a;
        if (condInst->opcode != wallvm.irOps.IrOpcode::ICmp) return false;
        if (condInst->nops != 2) return false;

        wallvm.ir_types.IrValue* cmpA = condInst->ops[0];
        wallvm.ir_types.IrValue* cmpB = condInst->ops[1];

        if (cmpB.kind != wallvm.ir_types.IrValueKind::ConstInt || cmpB.valData != 0)
            return false;

        wallvm.ir_types.IrValue* trueVal = b;
        wallvm.ir_types.IrValue* falseVal = inst.ops[2];
        wallvm.irOps.IrICmpPred pred = condInst->icmpPred;

        wallvm.ir_types.IrValue* absOperand = null;

        if (trueVal.kind == wallvm.ir_types.IrValueKind::Inst)
        {
            wallvm.ir_types.IrInst* negInst = (wallvm.ir_types.IrInst*)trueVal;
            if (negInst->opcode == wallvm.irOps.IrOpcode::Neg && negInst->nops == 1 &&
                negInst->ops[0] == falseVal &&
                (pred == wallvm.irOps.IrICmpPred::Slt || pred == wallvm.irOps.IrICmpPred::Sle))
            {
                absOperand = falseVal;
            }
        }

        if (!absOperand && falseVal.kind == wallvm.ir_types.IrValueKind::Inst)
        {
            wallvm.ir_types.IrInst* negInst = (wallvm.ir_types.IrInst*)falseVal;
            if (negInst->opcode == wallvm.irOps.IrOpcode::Neg && negInst->nops == 1 &&
                negInst->ops[0] == trueVal &&
                (pred == wallvm.irOps.IrICmpPred::Sgt || pred == wallvm.irOps.IrICmpPred::Sge))
            {
                absOperand = trueVal;
            }
        }

        if (!absOperand) return false;

        wallvm.ir_types.IrType* ty = absOperand.type;
        wallvm.ir_types.IrValue* absOps[1] = { absOperand };
        wallvm.ir_types.IrInst* absInst = self.ctx.createInst(wallvm.irOps.IrOpcode::Abs, ty, absOps, 1, 0, 0);
        absOps[0].addUser(absInst);
        inst.parent.insertBefore(absInst, inst);
        inst.base.replaceAllUses(&absInst.base);
        inst.erase();
        return true;
    }
}

pub bool irPassIdiom(wallvm.ir_types.IrFunc* func, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !func) return false;
    IdiomRecognizePass pass = IdiomRecognizePass::new(ctx);
    return pass.run(func);
}
