mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

pub struct IrLoop
{
    wallvm.ir_types.IrBlock* header;
    wallvm.ir_types.IrBlock** blocks;
    u32 nblocks;
    wallvm.ir_types.IrBlock* preheader;
    wallvm.ir_types.IrBlock* latch;
}

pub IrLoop** irDetectLoops(wallvm.ir_types.IrFunc* func, wallvm.domtree.IrDomTree* dt)
{
    bool ownDt = false;
    if (!dt)
    {
        dt = wallvm.domtree.irDomtreeNew(func);
        ownDt = true;
    }
    if (!dt) return null;

    u32 n = func.nblocks;
    IrLoop** loops = std.mman.alloc<IrLoop*>(n + 1);
    u32 nloops = 0;

    for (u32 ai = 1; ai < n; ai++)
    {
        wallvm.ir_types.IrBlock* latch = func.blocks[ai];
        for (u32 sj = 0; sj < latch.nsuccs; sj++)
        {
            wallvm.ir_types.IrBlock* header = latch.succs[sj];
            if (header == latch) continue;
            if (!wallvm.domtree.irDomtreeDominates(dt, header, latch)) continue;

            bool dup = false;
            for (u32 li = 0; li < nloops; li++)
            {
                if (loops[li]->header == header && loops[li]->latch == latch)
                { dup = true; break; }
            }
            if (dup) continue;

            u32 headerIdx = n;
            u32 latchIdx = n;
            for (u32 i = 0; i < n; i++)
            {
                if (func.blocks[i] == header) headerIdx = i;
                if (func.blocks[i] == latch) latchIdx = i;
            }

            bool* inLoop = std.mman.alloc<bool>(n);
            for (u32 i = 0; i < n; i++) inLoop[i] = false;
            inLoop[headerIdx] = true;
            u32 count = 1;

            u32* stack = std.mman.alloc<u32>(n);
            u32 sp = 0;
            if (latchIdx != headerIdx)
            {
                stack[sp++] = latchIdx;
                inLoop[latchIdx] = true;
                count++;
            }

            while (sp > 0)
            {
                u32 curIdx = stack[--sp];
                wallvm.ir_types.IrBlock* curBlock = func.blocks[curIdx];
                for (u32 pj = 0; pj < curBlock.npreds; pj++)
                {
                    wallvm.ir_types.IrBlock* pred = curBlock.preds[pj];
                    u32 predIdx = n;
                    for (u32 i = 0; i < n; i++)
                        if (func.blocks[i] == pred) { predIdx = i; break; }
                    if (predIdx >= n || predIdx == headerIdx || inLoop[predIdx])
                        continue;
                    inLoop[predIdx] = true;
                    count++;
                    stack[sp++] = predIdx;
                }
            }

            wallvm.ir_types.IrBlock** blocks = std.mman.alloc<wallvm.ir_types.IrBlock*>(count);
            u32 bi = 0;
            for (u32 i = 0; i < n; i++)
                if (inLoop[i])
                    blocks[bi++] = func.blocks[i];

            IrLoop* lp = std.mman.alloc<IrLoop>(1);
            lp->header = header;
            lp->blocks = blocks;
            lp->nblocks = count;
            lp->preheader = null;
            lp->latch = latch;
            loops[nloops++] = lp;

            std.mman.dealloc<bool>(inLoop);
            std.mman.dealloc<u32>(stack);
        }
    }

    loops[nloops] = null;

    if (ownDt) wallvm.domtree.irDomtreeFree(dt);
    return loops;
}

pub IrLoop** irLoopDetectNatural(wallvm.ir_types.IrFunc* func)
{
    wallvm.domtree.IrDomTree* dt = wallvm.domtree.irDomtreeNew(func);
    IrLoop** loops = irDetectLoops(func, dt);
    wallvm.domtree.irDomtreeFree(dt);
    return loops;
}