; WallVM IR
func @_mmap -> ptr {
  block %entry:
    %3 = alloca ptr
    %5 = store void [%4(addr), %3]
    %6 = alloca ptr
    %8 = store void [%7(length), %6]
    %9 = alloca ptr
    %11 = store void [%10(prot), %9]
    %12 = alloca ptr
    %14 = store void [%13(flags), %12]
    %15 = alloca ptr
    %17 = store void [%16(fd), %15]
    %18 = alloca ptr
    %20 = store void [%19(offset), %18]
    %21 = alloca ptr
    %25 = inlineasm i64 ["movq %2, %%rdi
	movq %3, %%rsi
	movq %4, %%rdx
	movq %5, %%r10
	movq %6, %%r8
	movq %7, %%r9
	syscall
	movq %%rax, %0
	# clobber:rcx ,  r8 ,  r9 ,  r10 ,  r11 ,  memory 
            ", %21, 9, 0]
    %26 = store void [%25, %21]
    %27 = load i64 [%21]
    %28 = icmp i1 [%27, 0]
    %29 = load i64 [%21]
    %31 = neg i64 [4095]
    %32 = icmp i1 [%29, %31]
    %34 = icmp i1 [%28, 0]
    %35 = icmp i1 [%32, 0]
    %36 = and i1 [%34, %35]
    %39 = cond_br void [%36, %37(if.then), %38(if.join)]
  block %if.then:
    %41 = ret ptr [0]
  block %if.join:
    %42 = load i64 [%21]
    %43 = bitcast ptr [%42]
    %44 = ret ptr [%43]
}
func @main -> i32 {
  block %entry:
    %47 = alloca ptr
    %48 = store void [0, %47]
    %49 = alloca ptr
    %51 = store void [7, %49]
    %52 = alloca ptr
    %54 = store void [3, %52]
    %55 = alloca ptr
    %57 = store void [34, %55]
    %58 = alloca ptr
    %60 = neg i64 [1]
    %61 = store void [%60, %58]
    %62 = load ptr [%47]
    %63 = load i64 [%49]
    %64 = load i32 [%52]
    %65 = load i32 [%55]
    %66 = load i32 [%58]
    %67 = call ptr [%1(_mmap), %62, %63, %64, %65, %66, 0]
    %68 = ret i64 [0]
}
