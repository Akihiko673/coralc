@[no_warn_unsafe]

mod libc = import("std/platform/libc.crl");
mod string = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");

pub string get(strView name)
{
    char* buf = (char*)mman.alloc<u8>(name.len + 1);
    mman.copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    char* val = libc.getenv(buf);
    if (val == null)
    {
        mman.dealloc<u8>((u8*)buf);
        return string.new();
    }
    string result = string.fromView(strView::fromCstr(val));
    mman.dealloc<u8>((u8*)buf);
    return result;
}

pub bool getInto(strView name, string* out)
{
    char* buf = (char*)mman.alloc<u8>(name.len + 1);
    mman.copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    char* val = libc.getenv(buf);
    mman.dealloc<u8>((u8*)buf);
    if (val == null) return false;
    out->free();
    *out = string.fromView(strView::fromCstr(val));
    return true;
}

pub bool set(strView name, strView value)
{
    char* nbuf = (char*)mman.alloc<u8>(name.len + 1);
    char* vbuf = (char*)mman.alloc<u8>(value.len + 1);
    mman.copy<u8>(nbuf, (const u8*)name.ptr, name.len);
    mman.copy<u8>(vbuf, (const u8*)value.ptr, value.len);
    nbuf[name.len] = 0; vbuf[value.len] = 0;
    i32 rc = libc.setenv(nbuf, vbuf, 1);
    mman.dealloc<u8>((u8*)nbuf);
    mman.dealloc<u8>((u8*)vbuf);
    return rc == 0;
}

pub bool unset(strView name)
{
    char* buf = (char*)mman.alloc<u8>(name.len + 1);
    mman.copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    i32 rc = libc.unsetenv(buf);
    mman.dealloc<u8>((u8*)buf);
    return rc == 0;
}

pub u64 all(vec<string>* out)
{
    char** env = libc.environ;
    u64 count = 0;
    while (env[count] != null) count++;
    for (u64 i = 0; i < count; i++)
        out->push(out, string.fromView(strView::fromCstr(env[i])));
    return count;
}