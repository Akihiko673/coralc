const u8 RCON[11] = { 0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36 };

u8 _mul2(u8 x)
{
    u8 r = (u8)((u16)x << 1);
    if (x & 0x80) r ^= 0x1B;
    return r;
}

u8 _mul3(u8 x) { return _mul2(x) ^ x; }
u8 _mul9(u8 x) { return _mul2(_mul2(_mul2(x))) ^ x; }
u8 _mulB(u8 x) { return _mul2(_mul2(_mul2(x))) ^ _mul2(x) ^ x; }
u8 _mulD(u8 x) { return _mul2(_mul2(_mul2(x))) ^ _mul2(_mul2(x)) ^ x; }
u8 _mulE(u8 x) { return _mul2(_mul2(_mul2(x))) ^ _mul2(_mul2(x)) ^ _mul2(x); }

void _subBytes(u8* state)
{
    for (u64 i = 0; i < 16; i++) state[i] = SBOX[state[i]];
}

void _invSubBytes(u8* state)
{
    for (u64 i = 0; i < 16; i++) state[i] = RSBOX[state[i]];
}

void _shiftRows(u8* state)
{
    u8 tmp;
    tmp = state[1];
    state[1] = state[5];
    state[5] = state[9];
    state[9] = state[13];
    state[13] = tmp;
    tmp = state[2];
    state[2] = state[10];
    state[10] = tmp;
    tmp = state[6];
    state[6] = state[14];
    state[14] = tmp;
    tmp = state[3];
    state[3] = state[15];
    state[15] = state[11];
    state[11] = state[7];
    state[7] = tmp;
}

void _invShiftRows(u8* state)
{
    u8 tmp;
    tmp = state[13];
    state[13] = state[9];
    state[9] = state[5];
    state[5] = state[1];
    state[1] = tmp;
    tmp = state[2];
    state[2] = state[10];
    state[10] = tmp;
    tmp = state[6];
    state[6] = state[14];
    state[14] = tmp;
    tmp = state[3];
    state[3] = state[7];
    state[7] = state[11];
    state[11] = state[15];
    state[15] = tmp;
}

void _mixColumns(u8* state)
{
    for (u64 i = 0; i < 4; i++)
    {
        u64 idx = i * 4;
        u8 a0 = state[idx]; u8 a1 = state[idx + 1];
        u8 a2 = state[idx + 2]; u8 a3 = state[idx + 3];
        state[idx] = _mul2(a0) ^ _mul3(a1) ^ a2 ^ a3;
        state[idx + 1] = a0 ^ _mul2(a1) ^ _mul3(a2) ^ a3;
        state[idx + 2] = a0 ^ a1 ^ _mul2(a2) ^ _mul3(a3);
        state[idx + 3] = _mul3(a0) ^ a1 ^ a2 ^ _mul2(a3);
    }
}

void _invMixColumns(u8* state)
{
    for (u64 i = 0; i < 4; i++)
    {
        u64 idx = i * 4;
        u8 a0 = state[idx]; u8 a1 = state[idx + 1];
        u8 a2 = state[idx + 2]; u8 a3 = state[idx + 3];
        state[idx] = _mulE(a0) ^ _mulB(a1) ^ _mulD(a2) ^ _mul9(a3);
        state[idx + 1] = _mul9(a0) ^ _mulE(a1) ^ _mulB(a2) ^ _mulD(a3);
        state[idx + 2] = _mulD(a0) ^ _mul9(a1) ^ _mulE(a2) ^ _mulB(a3);
        state[idx + 3] = _mulB(a0) ^ _mulD(a1) ^ _mul9(a2) ^ _mulE(a3);
    }
}

void _xorBlock(u8* dst, const u8* src)
{
    for (u64 i = 0; i < 16; i++) dst[i] ^= src[i];
}

void _keyExpansion(const u8* key, u8* roundKeys, u32 nRounds)
{
    u32 nk = nRounds == 10 ? 4 : (nRounds == 12 ? 6 : 8);
    u32 totalWords = 4 * (nRounds + 1);
    for (u32 i = 0; i < nk; i++)
    {
        roundKeys[i * 4] = key[i * 4];
        roundKeys[i * 4 + 1] = key[i * 4 + 1];
        roundKeys[i * 4 + 2] = key[i * 4 + 2];
        roundKeys[i * 4 + 3] = key[i * 4 + 3];
    }
    for (u32 i = nk; i < totalWords; i++)
    {
        u32 prev = (i - 1) * 4;
        u32 cur = i * 4;
        u8 temp[4];
        temp[0] = roundKeys[prev]; temp[1] = roundKeys[prev + 1];
        temp[2] = roundKeys[prev + 2]; temp[3] = roundKeys[prev + 3];
        if (i % nk == 0)
        {
            u8 t = temp[0]; temp[0] = SBOX[temp[1]]; temp[1] = SBOX[temp[2]];
            temp[2] = SBOX[temp[3]]; temp[3] = SBOX[t];
            temp[0] ^= RCON[i / nk];
        }
        else if (nk > 6 && i % nk == 4)
        {
            temp[0] = SBOX[temp[0]]; temp[1] = SBOX[temp[1]];
            temp[2] = SBOX[temp[2]]; temp[3] = SBOX[temp[3]];
        }
        u32 prevNk = (i - nk) * 4;
        roundKeys[cur] = roundKeys[prevNk] ^ temp[0];
        roundKeys[cur + 1] = roundKeys[prevNk + 1] ^ temp[1];
        roundKeys[cur + 2] = roundKeys[prevNk + 2] ^ temp[2];
        roundKeys[cur + 3] = roundKeys[prevNk + 3] ^ temp[3];
    }
}

void _encryptBlock(const u8* roundKeys, u32 nRounds, u8* block)
{
    _xorBlock(block, roundKeys);
    for (u32 r = 1; r <= nRounds; r++)
    {
        _subBytes(block);
        _shiftRows(block);
        if (r < nRounds) _mixColumns(block);
        _xorBlock(block, roundKeys + r * 16);
    }
}

void _decryptBlock(const u8* roundKeys, u32 nRounds, u8* block)
{
    _xorBlock(block, roundKeys + nRounds * 16);
    for (u32 r = nRounds; r > 0; r--)
    {
        _invShiftRows(block);
        _invSubBytes(block);
        _xorBlock(block, roundKeys + (r - 1) * 16);
        if (r > 1) _invMixColumns(block);
    }
}

pub struct Aes256
{
    u8 roundKeys[240];
    u32 nRounds;

    void init(const u8* key)
    {
        self.nRounds = 14;
        _keyExpansion(key, self.roundKeys, self.nRounds);
    }

    void encryptBlock(u8* block)
    {
        _encryptBlock(self.roundKeys, self.nRounds, block);
    }

    void decryptBlock(u8* block)
    {
        _decryptBlock(self.roundKeys, self.nRounds, block);
    }

    bool encryptCbc(const u8* iv, u8* data, u64 len)
    {
        if (len % 16 != 0 || len == 0) return false;
        u8 prev[16];
        mman.copy<u8>(prev, iv, 16);
        for (u64 i = 0; i < len; i += 16)
        {
            _xorBlock(data + i, prev);
            _encryptBlock(self.roundKeys, self.nRounds, data + i);
            mman.copy<u8>(prev, data + i, 16);
        }
        return true;
    }

    bool decryptCbc(const u8* iv, u8* data, u64 len)
    {
        if (len % 16 != 0 || len == 0) return false;
        u8 prev[16];
        mman.copy<u8>(prev, iv, 16);
        for (u64 i = 0; i < len; i += 16)
        {
            u8 next[16];
            mman.copy<u8>(next, data + i, 16);
            _decryptBlock(self.roundKeys, self.nRounds, data + i);
            _xorBlock(data + i, prev);
            mman.copy<u8>(prev, next, 16);
        }
        return true;
    }
}

pub struct Aes128
{
    u8 roundKeys[176];
    u32 nRounds;

    void init(const u8* key)
    {
        self.nRounds = 10;
        _keyExpansion(key, self.roundKeys, self.nRounds);
    }

    void encryptBlock(u8* block)
    {
        _encryptBlock(self.roundKeys, self.nRounds, block);
    }

    void decryptBlock(u8* block)
    {
        _decryptBlock(self.roundKeys, self.nRounds, block);
    }

    bool encryptCbc(const u8* iv, u8* data, u64 len)
    {
        if (len % 16 != 0 || len == 0) return false;
        u8 prev[16];
        mman.copy<u8>(prev, iv, 16);
        for (u64 i = 0; i < len; i += 16)
        {
            _xorBlock(data + i, prev);
            _encryptBlock(self.roundKeys, self.nRounds, data + i);
            mman.copy<u8>(prev, data + i, 16);
        }
        return true;
    }

    bool decryptCbc(const u8* iv, u8* data, u64 len)
    {
        if (len % 16 != 0 || len == 0) return false;
        u8 prev[16];
        mman.copy<u8>(prev, iv, 16);
        for (u64 i = 0; i < len; i += 16)
        {
            u8 next[16];
            mman.copy<u8>(next, data + i, 16);
            _decryptBlock(self.roundKeys, self.nRounds, data + i);
            _xorBlock(data + i, prev);
            mman.copy<u8>(prev, next, 16);
        }
        return true;
    }
}
