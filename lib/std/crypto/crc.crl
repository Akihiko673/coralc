pub u32 crc32(const u8* data, u64 len)
{
    u32 crc = 0xFFFFFFFF;
    for (u64 i = 0; i < len; i++)
        crc = CRC32_TABLE[(crc ^ (u32)data[i]) & 0xFF] ^ (crc >> 8);
    return crc ^ 0xFFFFFFFF;
}

