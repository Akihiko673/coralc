pub u64 crc64(const u8* data, u64 len)
{
    u64 crc = 0xFFFFFFFFFFFFFFFF;
    for (u64 i = 0; i < len; i++)
        crc = CRC64_TABLE[(crc ^ (u64)data[i]) & 0xFF] ^ (crc >> 8);
    return crc ^ 0xFFFFFFFFFFFFFFFF;
}