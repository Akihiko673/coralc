@[no_warn_unsafe]
mod string.String = import("std/text/string.crl");

pub u8 encodeCodepoint(u32 cp, u8* out)
{
    if (cp >= 0xD800 && cp <= 0xDFFF) return 0;
    if (cp > 0x10FFFF) return 0;
    if (cp < 0x80)
    {
        out[0] = (u8)cp;
        return 1;
    }
    if (cp < 0x800)
    {
        out[0] = (u8)(0xC0 | (cp >> 6));
        out[1] = (u8)(0x80 | (cp & 0x3F));
        return 2;
    }
    if (cp < 0x10000)
    {
        out[0] = (u8)(0xE0 | (cp >> 12));
        out[1] = (u8)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (u8)(0x80 | (cp & 0x3F));
        return 3;
    }
    out[0] = (u8)(0xF0 | (cp >> 18));
    out[1] = (u8)(0x80 | ((cp >> 12) & 0x3F));
    out[2] = (u8)(0x80 | ((cp >> 6) & 0x3F));
    out[3] = (u8)(0x80 | (cp & 0x3F));
    return 4;
}

pub u32 decodeCodepoint(const u8* s, u64 len, u64* consumed)
{
    if (len == 0) { *consumed = 0; return 0; }
    u8 b0 = s[0];
    if (b0 < 0x80) { *consumed = 1; return (u32)b0; }
    if (b0 < 0xC0) { *consumed = 1; return 0xFFFD; }
    if (b0 < 0xE0 && len >= 2)
    {
        if ((s[1] & 0xC0) != 0x80) { *consumed = 1; return 0xFFFD; }
        *consumed = 2;
        u32 cp = ((u32)(b0 & 0x1F) << 6) | (u32)(s[1] & 0x3F);
        if (cp < 0x80) { *consumed = 1; return 0xFFFD; }
        return cp;
    }
    if (b0 < 0xF0 && len >= 3)
    {
        if ((s[1] & 0xC0) != 0x80 || (s[2] & 0xC0) != 0x80) { *consumed = 1; return 0xFFFD; }
        *consumed = 3;
        u32 cp = ((u32)(b0 & 0x0F) << 12) | ((u32)(s[1] & 0x3F) << 6) | (u32)(s[2] & 0x3F);
        if (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF)) { *consumed = 1; return 0xFFFD; }
        return cp;
    }
    if (b0 < 0xF8 && len >= 4)
    {
        if ((s[1] & 0xC0) != 0x80 || (s[2] & 0xC0) != 0x80 || (s[3] & 0xC0) != 0x80)
        {
            *consumed = 1;
            return 0xFFFD;
        }
        *consumed = 4;
        u32 cp = ((u32)(b0 & 0x07) << 18) | ((u32)(s[1] & 0x3F) << 12) | ((u32)(s[2] & 0x3F) << 6) | (u32)(s[3] & 0x3F);
        if (cp < 0x10000 || cp > 0x10FFFF) { *consumed = 1; return 0xFFFD; }
        return cp;
    }
    *consumed = 1;
    return 0xFFFD;
}

pub u64 codepointLen(const u8* s, u64 len)
{
    u64 clen;
    decodeCodepoint(s, len, &clen);
    return clen;
}

pub u64 countCodepoints(const u8* s, u64 len)
{
    u64 count = 0;
    u64 i = 0;
    while (i < len)
    {
        u64 advance;
        decodeCodepoint(s + i, len - i, &advance);
        if (advance == 0) break;
        i += advance;
        count++;
    }
    return count;
}

pub bool isValid(const u8* s, u64 len)
{
    u64 i = 0;
    while (i < len)
    {
        u8 b = s[i];
        if (b < 0x80) { i++; continue; }
        u64 seqLen;
        if (b < 0xC0) return false;
        else if (b < 0xE0) seqLen = 2;
        else if (b < 0xF0) seqLen = 3;
        else if (b < 0xF8) seqLen = 4;
        else return false;
        if (i + seqLen > len) return false;
        for (u64 j = 1; j < seqLen; j++)
            if ((s[i + j] & 0xC0) != 0x80) return false;
        u32 cp;
        if (seqLen == 2)
            cp = ((u32)(b & 0x1F) << 6) | (u32)(s[i + 1] & 0x3F);
        else if (seqLen == 3)
            cp = ((u32)(b & 0x0F) << 12) | ((u32)(s[i + 1] & 0x3F) << 6) | (u32)(s[i + 2] & 0x3F);
        else
            cp = ((u32)(b & 0x07) << 18) | ((u32)(s[i + 1] & 0x3F) << 12) | ((u32)(s[i + 2] & 0x3F) << 6) | (u32)(s[i + 3] & 0x3F);
        if (seqLen == 2 && cp < 0x80) return false;
        if (seqLen == 3 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) return false;
        if (seqLen == 4 && (cp < 0x10000 || cp > 0x10FFFF)) return false;
        i += seqLen;
    }
    return true;
}

pub string.String toLower(const u8* s, u64 len)
{
    string.String out = string.String::new();
    u64 i = 0;
    while (i < len)
    {
        u64 adv;
        u32 cp = decodeCodepoint(s + i, len - i, &adv);
        if (adv == 0) break;
        if (cp >= 0x41 && cp <= 0x5A) cp += 0x20;
        u8 buf[4];
        u8 n = encodeCodepoint(cp, buf);
        for (u8 j = 0; j < n; j++) out.pushByte(&out, buf[j]);
        i += adv;
    }
    return out;
}

pub string.String toUpper(const u8* s, u64 len)
{
    string.String out = string.String::new();
    u64 i = 0;
    while (i < len)
    {
        u64 adv;
        u32 cp = decodeCodepoint(s + i, len - i, &adv);
        if (adv == 0) break;
        if (cp >= 0x61 && cp <= 0x7A) cp -= 0x20;
        u8 buf[4];
        u8 n = encodeCodepoint(cp, buf);
        for (u8 j = 0; j < n; j++) out.pushByte(&out, buf[j]);
        i += adv;
    }
    return out;
}