@[no_warn_unsafe]
mod libc = import("std/platform/libc.crl");

pub const i32 SIGABRT = 6;
pub const i32 SIGALRM = 14;
pub const i32 SIGBUS = 7;
pub const i32 SIGCHLD = 17;
pub const i32 SIGCONT = 18;
pub const i32 SIGFPE = 8;
pub const i32 SIGHUP = 1;
pub const i32 SIGILL = 4;
pub const i32 SIGINT = 2;
pub const i32 SIGKILL = 9;
pub const i32 SIGPIPE = 13;
pub const i32 SIGQUIT = 3;
pub const i32 SIGSEGV = 11;
pub const i32 SIGSTOP = 19;
pub const i32 SIGTERM = 15;
pub const i32 SIGTSTP = 20;
pub const i32 SIGTTIN = 21;
pub const i32 SIGTTOU = 22;
pub const i32 SIGUSR1 = 10;
pub const i32 SIGUSR2 = 12;
pub const i32 SIGSYS = 31;
pub const i32 SIGTRAP = 5;
pub const i32 SIGURG = 23;
pub const i32 SIGXCPU = 24;
pub const i32 SIGXFSZ = 25;

// SIG_DFL/SIG_IGN are special pointer values, not integers.
// On posix, SIG_DFL = (void (*)(int))0, SIG_IGN = (void (*)(int))1.
// these are passed as raw u64 and cast to function pointer.
pub const u64 SIG_DFL = 0;
pub const u64 SIG_IGN = 1;

pub typedef SigHandler = void(i32);

pub void(i32) handle(i32 sig, SigHandler* handler)
{
    return libc.signal(sig, handler);
}

pub void ignore(i32 sig)
{
    libc.signal(sig, (SigHandler*)(u64)SIG_IGN);
}

pub void defaultHandler(i32 sig)
{
    libc.signal(sig, (SigHandler*)(u64)SIG_DFL);
}

pub i32 send(i32 pid, i32 sig)
{
    return libc.kill(pid, sig);
}

pub i32 raiseSig(i32 sig)
{
    return libc.raise(sig);
}