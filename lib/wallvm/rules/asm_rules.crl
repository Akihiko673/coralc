// Pick the ABI rules for a calling convention. Mirrors the irCodegen
// dispatch in wallvm.crl so targets and register classes stay in sync.
pub AsmFormat formatForCc(CallingConvention cc)
{
    switch (cc)
    {
    case CallingConvention::SystemV:
    case CallingConvention::Win64:
    case CallingConvention::SyscallX86_64:
    case CallingConvention::SyscallMacOS:
    case CallingConvention::SyscallWin64:
        return x86_64LinuxRules().format;
    case CallingConvention::Cdecl:
    case CallingConvention::Stdcall:
    case CallingConvention::Fastcall:
    case CallingConvention::SyscallX86:
    case CallingConvention::WinX86_32:
        return x86LinuxRules().format;
    default:
        return x86_64LinuxRules().format;
    }
}

pub ABIRules abiForCc(CallingConvention cc)
{
    switch (cc)
    {
    case CallingConvention::SystemV: return sysvAbi();
    case CallingConvention::Win64: return win64Abi();
    case CallingConvention::Aapcs: return aapcsAbi();
    case CallingConvention::Aapcs64: return aapcs64Abi();
    case CallingConvention::Cdecl: return cdeclAbi();
    case CallingConvention::Stdcall: return stdcallAbi();
    case CallingConvention::Fastcall: return fastcallAbi();
    case CallingConvention::Riscv64: return riscv64Abi();
    case CallingConvention::SyscallX86_64: return x86_64SyscallAbi();
    case CallingConvention::SyscallX86: return x86SyscallAbi();
    case CallingConvention::SyscallArm64: return arm64SyscallAbi();
    case CallingConvention::SyscallArm: return armSyscallAbi();
    case CallingConvention::SyscallRiscv64: return riscv64SyscallAbi();
    case CallingConvention::SyscallMacOS: return x86_64MacOSSyscallAbi();
    case CallingConvention::SyscallWin64: return win64Abi();
    case CallingConvention::Ppc64: return ppc64Abi();
    case CallingConvention::Ppc: return ppcAbi();
    case CallingConvention::Mips64: return mips64Abi();
    case CallingConvention::Mips: return mipsAbi();
    case CallingConvention::SparcV9: return sparcV9Abi();
    case CallingConvention::Aapcs64MacOs: return aapcs64MacOsAbi();
    case CallingConvention::Aapcs64Ios: return aapcs64IosAbi();
    case CallingConvention::WinX86_32: return winX86_32Abi();
    case CallingConvention::SyscallPpc64: return ppc64SyscallAbi();
    case CallingConvention::SyscallPpc: return ppcSyscallAbi();
    case CallingConvention::SyscallMips64: return mips64SyscallAbi();
    case CallingConvention::SyscallMips: return mipsSyscallAbi();
    case CallingConvention::SyscallSparc64: return sparc64SyscallAbi();
    case CallingConvention::Wasm32: return wasm32Abi();
    case CallingConvention::Wasm64: return wasm64Abi();
    }
    return sysvAbi();
}

// Noreturn termination rules per platform

pub const char* noretTemplate(ABIRules* abi)
{
    switch (abi.cc)
    {
    case CallingConvention::SystemV:
        return "mov $60, %rax\\nmov $exit_code, %rdi\\nsyscall";
    case CallingConvention::Win64:
    case CallingConvention::SyscallWin64:
        return "mov $exit_code, %ecx\\ncall ExitProcess";
    case CallingConvention::WinX86_32:
        return "push $exit_code\\ncall ExitProcess";
    case CallingConvention::Aapcs64:
    case CallingConvention::SyscallArm64:
        return "mov x0, $exit_code\\nmov x8, #93\\nsvc #0";
    case CallingConvention::Aapcs64MacOs:
        return "mov x0, $exit_code\\nmov x16, #1\\nsvc 0x80";
    case CallingConvention::Aapcs64Ios:
        return "mov x0, $exit_code\\nmov x16, #1\\nsvc 0x80";
    case CallingConvention::Aapcs:
    case CallingConvention::SyscallArm:
        return "mov r0, $exit_code\\nmov r7, #1\\nsvc #0";
    case CallingConvention::Cdecl:
    case CallingConvention::Stdcall:
    case CallingConvention::Fastcall:
    case CallingConvention::SyscallX86:
        return "mov eax, 1\\nmov ebx, $exit_code\\nint 0x80";
    case CallingConvention::Riscv64:
    case CallingConvention::SyscallRiscv64:
        return "li a7, 93\\nmv a0, $exit_code\\necall";
    case CallingConvention::SyscallMacOS:
        return "mov $0x2000001, %rax\\nmov $exit_code, %rdi\\nsyscall";
    case CallingConvention::Ppc64:
    case CallingConvention::SyscallPpc64:
        return "li 0, 1\\nmr 3, $exit_code\\nsc";
    case CallingConvention::Ppc:
    case CallingConvention::SyscallPpc:
        return "li 0, 1\\nmr 3, $exit_code\\nsc";
    case CallingConvention::Mips64:
    case CallingConvention::SyscallMips64:
        return "li $a0, $exit_code\\nli $v0, 5058\\nsyscall";
    case CallingConvention::Mips:
    case CallingConvention::SyscallMips:
        return "li $a0, $exit_code\\nli $v0, 4001\\nsyscall";
    case CallingConvention::SparcV9:
    case CallingConvention::SyscallSparc64:
        return "mov $exit_code, %o0\\nmov 1, %g1\\nta 0x6d";
    case CallingConvention::Wasm32:
        return "unreachable";
    case CallingConvention::Wasm64:
        return "unreachable";
    }
    return "cli\\n.halt:\\nhlt\\njmp .halt";
}

// Platform rule tables

pub AsmRuleTable x86_64LinuxRules()
{
    u32 cap = 32;
    AsmRule* rules = mman.alloc<AsmRule>(cap);
    u32 n = 0;

    rules[n++] = (AsmRule){ IrOpcode::Add, "add", "add $op0, $op1", 2, false, false, "op0:reg,op1:reg/mem", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Sub, "sub", "sub $op0, $op1", 2, false, false, "op0:reg,op1:reg/mem", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Mul, "imul", "imul $op0, $op1", 2, false, false, "op0:reg,op1:reg", "3" };
    rules[n++] = (AsmRule){ IrOpcode::SDiv, "idiv", "idiv $op0", 1, false, false, "op0:reg", "12" };
    rules[n++] = (AsmRule){ IrOpcode::And, "and", "and $op0, $op1", 2, false, false, "op0:reg,op1:reg/mem", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Or, "or", "or $op0, $op1", 2, false, false, "op0:reg,op1:reg/mem", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Xor, "xor", "xor $op0, $op1", 2, false, false, "op0:reg,op1:reg/mem", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Neg, "neg", "neg $op0", 1, false, false, "op0:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Not, "not", "not $op0", 1, false, false, "op0:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Shl, "shl", "shl $op0, $op1", 2, false, false, "op0:reg,op1:cl/imm", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Ashr,"sar", "sar $op0, $op1", 2, false, false, "op0:reg,op1:cl/imm", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Lshr,"shr", "shr $op0, $op1", 2, false, false, "op0:reg,op1:cl/imm", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Br, "jmp", "jmp $op0", 1, false, true, "op0:label", "1" };
    rules[n++] = (AsmRule){ IrOpcode::CondBr, "jcc", "je $op0", 1, false, true, "op0:label", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Ret, "ret", "ret", 0, false, true, "", "2" };
    rules[n++] = (AsmRule){ IrOpcode::Noret, "", "mov $60, %rax; syscall",0, true, true, "exit_code:rdi", "100" };
    rules[n++] = (AsmRule){ IrOpcode::Call, "call", "call $op0", 1, true, false, "op0:label/reg", "1-10" };
    rules[n++] = (AsmRule){ IrOpcode::Alloca, "", "sub $op0, %rsp", 1, false, false, "op0:imm", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Load, "mov", "mov ($op0), $op1", 2, false, false, "op0:mem,op1:reg", "1-4" };
    rules[n++] = (AsmRule){ IrOpcode::Store, "mov", "mov $op0, ($op1)", 2, true, false, "op0:reg,op1:mem", "1-2" };
    rules[n++] = (AsmRule){ IrOpcode::Zext, "movzx", "movzx $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Sext, "movsx", "movsx $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::ICmp, "cmp", "cmp $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Select, "cmov", "cmov $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };

    AsmRuleTable table;
    table.rules = rules;
    table.numRules = n;
    table.abi = sysvAbi();
    table.format = AsmFormat::Att;
    table.platform = "x86_64";
    return table;
}

pub AsmRuleTable arm64LinuxRules()
{
    u32 cap = 32;
    AsmRule* rules = mman.alloc<AsmRule>(cap);
    u32 n = 0;

    rules[n++] = (AsmRule){ IrOpcode::Add, "add", "add $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Sub, "sub", "sub $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Mul, "mul", "mul $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "3" };
    rules[n++] = (AsmRule){ IrOpcode::SDiv,"sdiv", "sdiv $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "4" };
    rules[n++] = (AsmRule){ IrOpcode::UDiv,"udiv", "udiv $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "4" };
    rules[n++] = (AsmRule){ IrOpcode::And, "and", "and $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Or, "orr", "orr $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Xor, "eor", "eor $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Neg, "neg", "neg $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Not, "mvn", "mvn $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Shl, "lsl", "lsl $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Ashr,"asr", "asr $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Lshr,"lsr", "lsr $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Br, "b", "b $op0", 1, false, true, "op0:label", "1" };
    rules[n++] = (AsmRule){ IrOpcode::CondBr,"b.eq","b.eq $op0", 1, false, true, "op0:label", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Ret, "ret", "ret", 0, false, true, "", "2" };
    rules[n++] = (AsmRule){ IrOpcode::Noret,"","mov x0, #0; mov x8, #93; svc #0",0,true,true,"exit_code:x0", "100" };
    rules[n++] = (AsmRule){ IrOpcode::Call,"blr", "blr $op0", 1, true, false, "op0:reg", "1-5" };
    rules[n++] = (AsmRule){ IrOpcode::SRem,"sdiv","sdiv $tmp,$a,$b; msub $dst,$tmp,$b,$a",4,false,false,"op0:reg,op1:reg,op2:reg", "8" };
    rules[n++] = (AsmRule){ IrOpcode::URem,"udiv","udiv $tmp,$a,$b; msub $dst,$tmp,$b,$a",4,false,false,"op0:reg,op1:reg,op2:reg", "8" };
    rules[n++] = (AsmRule){ IrOpcode::Alloca,"sub","sub sp, sp, $op0",1,false,false,"op0:imm", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Load,"ldr","ldr $op0, [$op1]",2,false,false,"op0:reg,op1:mem", "1-4" };
    rules[n++] = (AsmRule){ IrOpcode::Store,"str","str $op0, [$op1]",2,true,false,"op0:reg,op1:mem", "1-2" };
    rules[n++] = (AsmRule){ IrOpcode::Zext,"uxtb","uxtb $op0, $op1",2,false,false,"op0:reg,op1:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Sext,"sxtb","sxtb $op0, $op1",2,false,false,"op0:reg,op1:reg", "1" };
    rules[n++] = (AsmRule){ IrOpcode::ICmp,"cmp","cmp $op0, $op1",2,false,false,"op0:reg,op1:reg", "1" };
