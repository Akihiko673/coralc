// Platform-specific rule tables

pub struct AsmRuleTable
{
    AsmRule* rules;
    u32 numRules;
    ABIRules abi;
    AsmFormat format;
    const char* platform; // "x86_64", "arm64", etc.

    AsmRule* findRule(IrOpcode op)
    {
        for (u32 i = 0; i < self.numRules; i++)
            if (self.rules[i].irOpcode == op) return &self.rules[i];
        return null;
    }

    void deinit()
    {
        mman.free(self.rules);
        self.rules = null;
        self.numRules = 0;
    }
}

// Predefined ABI configurations

pub ABIRules sysvAbi()
{
    ABIRules a;
    a.cc = CallingConvention::SystemV;
    a.name = "sysv";
    a.argRegs = SYSV_ARG_REGS;
    a.numArgRegs = 6;
    a.floatArgRegs = SYSV_FLOAT_ARG_REGS;
    a.numFloatArgRegs = 8;
    a.returnReg = "rax";
    a.floatReturnReg = "xmm0";
    a.stackArgReg = "rsp";
    a.calleeSaveRegs = SYSV_CALLEE_SAVE;
    a.numCalleeSaveRegs = 6;
    a.callerSaveRegs = SYSV_CALLER_SAVE;
    a.numCallerSaveRegs = 9;
    a.frameReg = "rbp";
    a.stackAlignment = 16;
    a.hasRedZone = true;
    a.calleeCleanupStack = false;
    a.shadowSpaceBytes = 0;
    a.syscallInst = "syscall";
    a.syscallNumberReg = "rax";
    a.syscallArgRegs = SYSV_SYSCALL_ARG_REGS;
    a.numSyscallArgRegs = 6;
    a.syscallNumberShift = 0;
    return a;
}

