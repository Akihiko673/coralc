    rules[n++] = (AsmRule){ IrOpcode::CondBr,"beq","beq $op0, $op1, $op2", 1, false, true, "op0:label", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Ret, "jr", "jr $ra", 0, false, true, "", "4" };
    rules[n++] = (AsmRule){ IrOpcode::Noret,"","li $a0, 0; li $v0, 5058; syscall",0,true,true,"exit_code:a0", "100" };
    rules[n++] = (AsmRule){ IrOpcode::Call,"jal","jal $op0", 1, true, false, "op0:label", "1-5" };
    rules[n++] = (AsmRule){ IrOpcode::Alloca,"daddiu","daddiu sp, sp, -$op0",1,false,false,"op0:imm", "1" };
    rules[n++] = (AsmRule){ IrOpcode::Load,"ld","ld $op0, 0($op1)",2,false,false,"op0:reg,op1:mem", "1-4" };
    rules[n++] = (AsmRule){ IrOpcode::Store,"sd","sd $op0, 0($op1)",2,true,false,"op0:reg,op1:mem", "1-2" };
    rules[n++] = (AsmRule){ IrOpcode::ICmp,"slt","slt $op0, $op1, $op2",3,false,false,"op0:reg,op1:reg,op2:reg", "1" };

    AsmRuleTable table;
    table.rules = rules;
    table.numRules = n;
    table.abi = mips64Abi();
    table.format = AsmFormat::Att;
    table.platform = "mips64";
    return table;
}

