@[no_warn_unsafe]


mod ir_types = import("wallvm/ir_types.crl");
mod ir_opcodes = import("wallvm/ir_opcodes.crl");

pub struct CSEPass
{
    ir_types.IrContext* ctx;
    u64 eliminated;

    CSEPass new(ir_types.IrContext* ctx)
    {
        CSEPass p;
        p.ctx = ctx;
        p.eliminated = 0;
        return p;
    }
    // Local CSE within each basic block
    // This pass only removes redundant pure instructions already available
    // earlier in the same block.
    bool run(ir_types.IrFunc* func)
    {
        self.eliminated = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            ir_types.IrBlock* bb = func.blocks[bi];
            if (self.processBlock(bb)) changed = true;
        }

        return changed;
    }

    bool processBlock(ir_types.IrBlock* bb)
    {
        bool changed = false;
        u32 i = 0;
        while (i < bb.ninsts)
        {
            ir_types.IrInst* inst = bb.insts[i];
            if (!self.isCseCandidate(inst))
            {
                i++;
                continue;
            }

            bool removed = false;
            for (u32 j = 0; j < i; j++)
            {
                ir_types.IrInst* prev = bb.insts[j];
                if (self.areEquivalent(inst, prev))
                {
                    inst.base.replaceAllUses(&prev.base);
                    inst.erase();
                    self.eliminated++;
                    changed = true;
                    removed = true;
                    break;
                }
            }

            if (!removed) i++;
        }
        return changed;
    }

    bool isCseCandidate(ir_types.IrInst* inst)
    {
        switch (inst.opcode)
        {
        case ir_opcodes.IrOpcode::Add:
        case ir_opcodes.IrOpcode::Sub:
        case ir_opcodes.IrOpcode::Mul:
        case ir_opcodes.IrOpcode::And:
        case ir_opcodes.IrOpcode::Or:
        case ir_opcodes.IrOpcode::Xor:
        case ir_opcodes.IrOpcode::Shl:
        case ir_opcodes.IrOpcode::Lshr:
        case ir_opcodes.IrOpcode::Ashr:
        case ir_opcodes.IrOpcode::SMin:
        case ir_opcodes.IrOpcode::SMax:
        case ir_opcodes.IrOpcode::UMin:
        case ir_opcodes.IrOpcode::UMax:
        case ir_opcodes.IrOpcode::ICmp:
        case ir_opcodes.IrOpcode::FAdd:
        case ir_opcodes.IrOpcode::FSub:
        case ir_opcodes.IrOpcode::FMul:
        case ir_opcodes.IrOpcode::FDiv:
        case ir_opcodes.IrOpcode::FCmp:
        case ir_opcodes.IrOpcode::Trunc:
        case ir_opcodes.IrOpcode::Zext:
        case ir_opcodes.IrOpcode::Sext:
        case ir_opcodes.IrOpcode::FpTrunc:
        case ir_opcodes.IrOpcode::FpExt:
        case ir_opcodes.IrOpcode::FpToSi:
        case ir_opcodes.IrOpcode::SiToFp:
        case ir_opcodes.IrOpcode::FpToUi:
        case ir_opcodes.IrOpcode::UiToFp:
        case ir_opcodes.IrOpcode::Bitcast:
        case ir_opcodes.IrOpcode::Neg:
        case ir_opcodes.IrOpcode::Not:
        case ir_opcodes.IrOpcode::Abs:
        case ir_opcodes.IrOpcode::FAbs:
        case ir_opcodes.IrOpcode::FSqrt:
        case ir_opcodes.IrOpcode::CtPop:
        case ir_opcodes.IrOpcode::CtLz:
        case ir_opcodes.IrOpcode::CtTz:
        case ir_opcodes.IrOpcode::Rotl:
        case ir_opcodes.IrOpcode::Rotr:
        case ir_opcodes.IrOpcode::Bswap:
        case ir_opcodes.IrOpcode::Select:
            return true;
        default:
            return false;
        }
    }

    bool sameOperands(ir_types.IrInst* a, ir_types.IrInst* b)
    {
        if (a->nops != b->nops) return false;
        for (u32 i = 0; i < a->nops; i++)
            if (a->ops[i] != b->ops[i]) return false;
        return true;
    }

    bool areEquivalent(ir_types.IrInst* a, ir_types.IrInst* b)
    {
        if (a->opcode != b->opcode) return false;
        if (a->base.type != b->base.type) return false;
        if (a->nops != b->nops) return false;
        if (a->opcode == ir_opcodes.IrOpcode::ICmp && a->icmpPred != b->icmpPred) return false;
        if (a->opcode == ir_opcodes.IrOpcode::FCmp && a->fcmpPred != b->fcmpPred) return false;

        if (sameOperands(a, b)) return true;

        if (a->nops == 2 && ir_opcodes.irOpcodeIsCommutative(a->opcode))
        {
            if (a->ops[0] == b->ops[1] && a->ops[1] == b->ops[0])
                return true;
        }

        return false;
    }

    u64 eliminatedCount()
    {
        return self.eliminated;
    }
}

pub bool irPassCse(ir_types.IrFunc* func, void* userdata)
{
    ir_types.IrContext* ctx = (ir_types.IrContext*)userdata;
    if (!ctx || !func) return false;
    CSEPass pass = CSEPass::new(ctx);
    return pass.run(func);
}
