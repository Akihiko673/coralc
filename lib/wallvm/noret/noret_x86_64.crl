@[no_warn_unsafe]
mod mman = import("std/memory/mman.crl");

pub struct NoretX86_64
{
    u64 exitCode;
    char* out;
    u32 outLen;
    u32 outCap;

    NoretX86_64 new(u64 exitCode)
    {
        NoretX86_64 n;
        n.exitCode = exitCode;
        n.out = null;
        n.outLen = 0;
        n.outCap = 0;
        return n;
    }

    void ensureCap(NoretX86_64*, u32 needed)
    {
        if (self.outLen + needed <= self.outCap) return;
        u32 newCap = self.outCap ? self.outCap * 2 : 64;
        while (self.outLen + needed > newCap) newCap *= 2;
        char* newOut = mman.alloc<char>(newCap);
        if (self.out)
        {
            mman.copy<char>(newOut, self.out, self.outLen);
            mman.dealloc<char>(self.out);
        }
        self.out = newOut;
        self.outCap = newCap;
    }

    void c(NoretX86_64*, char ch)
    {
        self.ensureCap(1);
        self.out[self.outLen++] = ch;
    }

    void s(NoretX86_64*, const char* str)
    {
        u32 len = 0;
        while (str[len]) len++;
        self.ensureCap(len);
        for (u32 i = 0; i < len; i++)
            self.out[self.outLen++] = str[i];
    }

    const char* getString(NoretX86_64*)
    {
        self.ensureCap(1);
        self.out[self.outLen] = 0;
        return self.out;
    }

    void clear(NoretX86_64*)
    {
        self.outLen = 0;
    }

    void destroy(NoretX86_64*)
    {
        if (self.out) mman.dealloc<char>(self.out);
    }
}

static bool platformMatch(const char* platform, const char* known)
{
    if (!platform || !known) return false;
    u32 i = 0;
    while (platform[i] && known[i])
    {
        char a = platform[i];
        char k = known[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
        i++;
    }
    return platform[i] == 0 && known[i] == 0;
}

pub void emitLinuxSyscall(NoretX86_64*)
{
    self.emitMovRegImm64("rax", 60);
    self.c('\n');
    self.emitMovRegImm64("rdi", self->exitCode);
    self.c('\n');
    self.emitSyscall();
    self.c('\n');
}

pub void emitWindowsTerminate(NoretX86_64*)
{
    self.emitMovRegImm32("ecx", (u32)self->exitCode);
    self.c('\n');
    self.emitCall("ExitProcess");
    self.c('\n');
}

pub void emitMacOSExit(NoretX86_64*)
{
    self.s("mov $0x2000001, %rax");
    self.c('\n');
    self.emitMovRegImm64("rdi", self->exitCode);
    self.c('\n');
    self.emitSyscall();
    self.c('\n');
}

pub void emitBareMetalHalt(NoretX86_64*)
{
    self.emitCli();
    self.c('\n');
    self.emitLabel(".halt");
    self.c('\n');
    self.emitHlt();
    self.c('\n');
    self.emitJmp(".halt");
    self.c('\n');
}

pub void emitNoretPlatform(NoretX86_64*, const char* platform)
{
    if (platformMatch(platform, "LINUX"))
        self.emitLinuxSyscall();
    else if (platformMatch(platform, "WINDOWS"))
        self.emitWindowsTerminate();
    else if (platformMatch(platform, "MACOS"))
        self.emitMacOSExit();
    else
        self.emitBareMetalHalt();
}

static void emitMovRegImm64(NoretX86_64*, const char* reg, u64 imm)
{
    self->s(self, "mov ");
    self->s(self, "$");
    u64 val = imm;
    char buf[24];
    u32 n = 0;
    if (val == 0) buf[n++] = '0';
    else { while (val) { buf[n++] = (char)('0' + val % 10); val /= 10; } }
    for (i32 i = (i32)n - 1; i >= 0; i--) self->c(self, buf[i]);
    self->s(self, ", %");
    self->s(self, reg);
}

static void emitMovRegImm32(NoretX86_64*, const char* reg, u32 imm)
{
    self->s(self, "mov $");
    u32 val = imm;
    char buf[16];
    u32 n = 0;
    if (val == 0) buf[n++] = '0';
    else { while (val) { buf[n++] = (char)('0' + val % 10); val /= 10; } }
    for (i32 i = (i32)n - 1; i >= 0; i--) self->c(self, buf[i]);
    self->s(self, ", %");
    self->s(self, reg);
}

static void emitSyscall(NoretX86_64*)
{
    self->s(self, "\tsyscall");
}

static void emitCall(NoretX86_64*, const char* target)
{
    self->s(self, "\tcall ");
    self->s(self, target);
}

static void emitCli(NoretX86_64*)
{
    self->s(self, "\tcli");
}

static void emitHlt(NoretX86_64*)
{
    self->s(self, "\thlt");
}

static void emitLabel(NoretX86_64*, const char* label)
{
    self->s(self, label);
    self->c(self, ':');
}

static void emitJmp(NoretX86_64*, const char* target)
{
    self->s(self, "\tjmp ");
    self->s(self, target);
}