void* _mmap(void* addr, u64 length, i32 prot, i32 flags, i32 fd, i64 offset)
{
    flag (platform) {
    LINUX:
        flag (ARCH) {
        x86_64:
            u64 ret;
            asm volatile {
                "movq %2, %%rdi\n\t"
                "movq %3, %%rsi\n\t"
                "movq %4, %%rdx\n\t"
                "movq %5, %%r10\n\t"
                "movq %6, %%r8\n\t"
                "movq %7, %%r9\n\t"
                "syscall\n\t"
                "movq %%rax, %0"
                : "=a"(ret)
                : "0"(9u), "D"((u64)addr), "S"(length), "d"((u64)prot),
                  "r"((u64)flags), "r"((u64)fd), "r"((u64)offset)
                : "rcx", "r8", "r9", "r10", "r11", "memory"
            }
            if ((i64)ret < 0 && (i64)ret >= -4095) return null;
            return (void*)ret;
        x86:
            u32 ret_x86;
            u32 pgoffset_x86 = (u32)((u64)offset >> 12);
            asm volatile {
                "movl %2, %%ebx\n\t"
                "movl %3, %%ecx\n\t"
                "movl %4, %%edx\n\t"
                "movl %5, %%esi\n\t"
                "movl %6, %%edi\n\t"
                "movl %7, %%ebp\n\t"
                "int $0x80\n\t"
                "movl %%eax, %0"
                : "=a"(ret_x86)
                : "0"(192u), "b"((u32)(size_t)addr), "c"((u32)length), "d"((u32)prot),
                  "S"((u32)flags), "D"((u32)fd), "r"(pgoffset_x86)
                : "memory"
            }
            if ((i32)ret_x86 < 0 && (i32)ret_x86 >= -4095) return null;
            return (void*)(size_t)ret_x86;
        arm64:
            u64 ret;
            asm volatile {
                "mov x8, #222\n\t"
                "mov x0, %1\n\t"
                "mov x1, %2\n\t"
                "mov x2, %3\n\t"
                "mov x3, %4\n\t"
                "mov x4, %5\n\t"
                "mov x5, %6\n\t"
                "svc #0\n\t"
                "mov %0, x0"
                : "=r"(ret)
                : "r"((u64)addr), "r"(length), "r"((u64)prot),
                  "r"((u64)flags), "r"((u64)fd), "r"((u64)offset)
                : "x0", "x1", "x2", "x3", "x4", "x5", "x8", "memory"
            }
            if ((i64)ret < 0 && (i64)ret >= -4095) return null;
            return (void*)ret;
        arm32:
            u32 ret_arm32;
            u32 pgoffset_arm32 = (u32)((u64)offset >> 12);
            asm volatile {
                "mov r7, #192\n\t"
                "mov r0, %1\n\t"
                "mov r1, %2\n\t"
                "mov r2, %3\n\t"
                "mov r3, %4\n\t"
                "mov r4, %5\n\t"
                "mov r5, %6\n\t"
                "svc #0\n\t"
                "mov %0, r0"
                : "=r"(ret_arm32)
                : "r"((u32)(size_t)addr), "r"((u32)length), "r"((u32)prot),
                  "r"((u32)flags), "r"((u32)fd), "r"(pgoffset_arm32)
                : "r0", "r1", "r2", "r3", "r4", "r5", "r7", "memory"
            }
            if ((i32)ret_arm32 < 0 && (i32)ret_arm32 >= -4095) return null;
            return (void*)(size_t)ret_arm32;
        riscv64:
            u64 ret;
            asm volatile {
                "li a7, 222\n\t"
                "mv a0, %1\n\t"
                "mv a1, %2\n\t"
                "mv a2, %3\n\t"
                "mv a3, %4\n\t"
                "mv a4, %5\n\t"
                "mv a5, %6\n\t"
                "ecall\n\t"
                "mv %0, a0"
                : "=r"(ret)
                : "r"((u64)addr), "r"(length), "r"((u64)prot),
                  "r"((u64)flags), "r"((u64)fd), "r"((u64)offset)
                : "a0", "a1", "a2", "a3", "a4", "a5", "a7", "memory"
            }
            if ((i64)ret < 0 && (i64)ret >= -4095) return null;
            return (void*)ret;
        riscv32:
            u32 ret_riscv32;
            u32 off_l = (u32)((u64)offset & 0xFFFFFFFFu);
            asm volatile {
                "li a7, 222\n\t"
                "mv a0, %1\n\t"
                "mv a1, %2\n\t"
                "mv a2, %3\n\t"
                "mv a3, %4\n\t"
                "mv a4, %5\n\t"
                "mv a5, %6\n\t"
                "ecall\n\t"
                "mv %0, a0"
                : "=r"(ret_riscv32)
                : "r"((u32)(size_t)addr), "r"((u32)length), "r"((u32)prot),
                  "r"((u32)flags), "r"((u32)fd), "r"(off_l)
                : "a0", "a1", "a2", "a3", "a4", "a5", "a7", "memory"
            }
            if ((i32)ret_riscv32 < 0 && (i32)ret_riscv32 >= -4095) return null;
            return (void*)(size_t)ret_riscv32;
        mips64:
            u64 ret;
            asm volatile {
                "li $v0, 5009\n\t"
                "move $a0, %1\n\t"
                "move $a1, %2\n\t"
                "move $a2, %3\n\t"
                "move $a3, %4\n\t"
                "move $a4, %5\n\t"
                "move $a5, %6\n\t"
                "syscall\n\t"
                "move %0, $v0"
                : "=r"(ret)
                : "r"((u64)addr), "r"(length), "r"((u64)prot),
                  "r"((u64)flags), "r"((u64)fd), "r"((u64)offset)
                : "a0", "a1", "a2", "a3", "a4", "a5", "v0", "memory"
            }
            if ((i64)ret < 0 && (i64)ret >= -4095) return null;
            return (void*)ret;
        mips:
            u32 ret_mips;
            u32 pgoffset_mips = (u32)((u64)offset >> 12);
            asm volatile {
                "addiu $sp, $sp, -32\n\t"
                "move $a0, %1\n\t"
                "move $a1, %2\n\t"
                "move $a2, %3\n\t"
                "move $a3, %4\n\t"
                "sw %5, 16($sp)\n\t"
                "sw %6, 20($sp)\n\t"
                "li $v0, 4210\n\t"
                "syscall\n\t"
                "addiu $sp, $sp, 32\n\t"
                "move %0, $v0"
                : "=r"(ret_mips)
                : "r"((u32)(size_t)addr), "r"((u32)length), "r"((u32)prot),
                  "r"((u32)flags), "r"((u32)fd), "r"(pgoffset_mips)
                : "a0", "a1", "a2", "a3", "v0", "memory"
            }
            if ((i32)ret_mips < 0 && (i32)ret_mips >= -4095) return null;
            return (void*)(size_t)ret_mips;
        ppc64:
            u64 ret;
            asm volatile {
                "li 0, 192\n\t"
                "mr 3, %1\n\t"
                "mr 4, %2\n\t"
                "mr 5, %3\n\t"
                "mr 6, %4\n\t"
                "mr 7, %5\n\t"
                "mr 8, %6\n\t"
                "sc\n\t"
                "mr %0, 3"
                : "=r"(ret)
                : "r"((u64)addr), "r"(length), "r"((u64)prot),
                  "r"((u64)flags), "r"((u64)fd), "r"((u64)offset)
                : "r3", "r4", "r5", "r6", "r7", "r8", "r0", "memory"
            }
            if ((i64)ret < 0 && (i64)ret >= -4095) return null;
            return (void*)ret;
        ppc:
            u32 ret_ppc;
            u32 pgoffset_ppc = (u32)((u64)offset >> 12);
            asm volatile {
                "li 0, 192\n\t"
                "mr 3, %1\n\t"
                "mr 4, %2\n\t"
                "mr 5, %3\n\t"
                "mr 6, %4\n\t"
                "mr 7, %5\n\t"
                "mr 8, %6\n\t"
                "sc\n\t"
                "mr %0, 3"
                : "=r"(ret_ppc)
                : "r"((u32)(size_t)addr), "r"((u32)length), "r"((u32)prot),
                  "r"((u32)flags), "r"((u32)fd), "r"(pgoffset_ppc)
                : "r3", "r4", "r5", "r6", "r7", "r8", "r0", "memory"
            }
            if ((i32)ret_ppc < 0 && (i32)ret_ppc >= -4095) return null;
            return (void*)(size_t)ret_ppc;
        }
    MACOS:
        flag (ARCH) {
        x86_64:
            u64 ret;
            u8 carry;
            asm volatile {
                "movq %2, %%rdi\n\t"
                "movq %3, %%rsi\n\t"
                "movq %4, %%rdx\n\t"
                "movq %5, %%r10\n\t"
                "movq %6, %%r8\n\t"
                "movq %7, %%r9\n\t"
                "syscall\n\t"
                "setc %1\n\t"
                "movq %%rax, %0"
                : "=a"(ret), "=qm"(carry)
                : "0"(0x20000C5u), "D"((u64)addr), "S"(length), "d"((u64)prot),
                  "r"((u64)flags), "r"((u64)fd), "r"((u64)offset)
                : "rcx", "r8", "r9", "r10", "r11", "memory"
            }
            if (carry) return null;
            return (void*)ret;
        arm64:
            u64 ret;
            u32 carry;
            asm volatile {
                "mov x0, %2\n\t"
                "mov x1, %3\n\t"
                "mov x2, %4\n\t"
                "mov x3, %5\n\t"
                "mov x4, %6\n\t"
                "mov x5, %7\n\t"
                "mov x16, %8\n\t"
                "svc #0x80\n\t"
                "cset %w1, cs\n\t"
                "mov %0, x0"
                : "=r"(ret), "=r"(carry)
                : "r"((u64)addr), "r"(length), "r"((u64)prot),
                  "r"((u64)flags), "r"((u64)fd), "r"((u64)offset),
                  "r"(0x20000C5u)
                : "x0", "x1", "x2", "x3", "x4", "x5", "x16", "memory"
            }
            if (carry) return null;
            return (void*)ret;

        }
    WINDOWS:
        (void)prot;
        (void)flags;
        (void)fd;
        (void)offset;
        return (void*)VirtualAlloc(addr, length, 0x3000u, 0x04u);
    }
    return null;
}

i32 main() {
    void* addr = null;
    u64 length = 7u;
    i32 prot = 3;
    i32 flags = 34;
    i32 fd = -1;

    _mmap(addr, length, prot, flags, fd, 0);

    return 0;
}
